# FWB-REG-04D-R1 — configuration example, NOT an active deployment.
# Use a real dedicated staging domain (no production or example.org hosts).
# Never commit a filled-in file. Secrets must come from a managed runtime vault.
FWB_REG04_STAGING=enabled
FWB_REG04_PROVIDER=keycloak
FWB_REG04_ISSUER=https://auth-stage.YOUR-STAGING-DOMAIN.tld/realms/fwb_stage
FWB_REG04_JWKS_URL=https://auth-stage.YOUR-STAGING-DOMAIN.tld/realms/fwb_stage/protocol/openid-connect/certs
FWB_REG04_RESOURCE=https://mcp-stage.YOUR-STAGING-DOMAIN.tld/api/gateway-mcp
FWB_REG04_ALLOWED_WP_HOSTS=wp-stage.YOUR-STAGING-DOMAIN.tld
FWB_REG04_ENCRYPTION_KEY_B64URL=
FWB_REG04B_PG_STORAGE=enabled
FWB_REG04B_DATABASE_URL=
FWB_REG04C_FEDERATION=enabled
FWB_REG04D_R1_SERVICE=enabled
FWB_REG04D_R1_CLIENT_ID=fwb-onboarding
FWB_REG04D_R1_CLIENT_SECRET=
FWB_REG04D_R1_ALLOWED_SUBJECTS=
FWB_REG04D_R1_EGRESS=enabled
FWB_REG04D_R1_PUBLIC_STAGING=candidate
FWB_REG04D_R1_TLS_REVIEWED=no
FWB_REG04D_R1_EGRESS_REVIEWED=no
FWB_REG04D_R1_SECRETS_REVIEWED=no
# Forbidden in public staging:
# FWB_REG04C_ADMIN_BEARER
# FWB_REG04B_INSECURE_DB_TEST_ONLY
# FWB_REG04D_R1_PRIVATE_EGRESS_TEST
