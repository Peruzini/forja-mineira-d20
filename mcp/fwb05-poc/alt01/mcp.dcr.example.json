{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "forja_bridge_auth0_staging": {
      "type": "streamable-http",
      "url": "https://mcp-staging.example.org/api/gateway-mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "baseScopes": [
              "posts:read"
            ]
          }
        }
      }
    }
  }
}
