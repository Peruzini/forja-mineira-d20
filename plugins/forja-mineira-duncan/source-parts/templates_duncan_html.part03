<figure class="duncan-final-hero-art">
<div aria-label="Duncan cavaleiro consagrado montado após a batalha" class="duncan-verified-art-slot has-image" data-duncan-art-file="assets/duncan-art-level-20-cavaleiro-consagrado-v1-aprovada.webp" data-duncan-art-slot="20" data-duncan-art-status="aprovada-arquivada" data-duncan-art-type="personagem" role="img"><img alt="Duncan cavaleiro consagrado montado após a batalha" class="duncan-verified-image" decoding="async" height="1402" loading="lazy" src="data:image/webp;base64,