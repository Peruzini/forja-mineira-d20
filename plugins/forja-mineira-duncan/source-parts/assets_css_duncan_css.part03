");}
.fmb-build-root--duncan .duncan-shield-05{background-image:url("data:image/webp;base64,");}


/* DUNCAN-UX-01 / BLOCO 1 — somente fluxo, espaçamento e legibilidade.
   Sem remoção de campos, mudança mecânica ou troca de arte.
   Escopo restrito às barras laterais de progressão. */
.fmb-build-root--duncan .progress-side,
.fmb-build-root--duncan .progress-side *{box-sizing:border-box}
.fmb-build-root--duncan .progress-side .fm-side-sheet{
  position:relative!important;display:flex!important;flex-direction:column!important;
  align-items:stretch!important;gap:15px!important;
  width:100%!important;min-width:0!important;height:auto!important;
  margin-top:18px!important;padding:17px 0 0!important;
}
.fmb-build-root--duncan .progress-side .fm-side-sheet > .fm-side-section,
.fmb-build-root--duncan .progress-side .fm-side-sheet > .wish-section{
  position:relative!important;display:block!important;flex:0 0 auto!important;
  width:100%!important;min-width:0!important;height:auto!important;
  margin:0!important;
}
.fmb-build-root--duncan .progress-side .fm-side-section.fm-panel{
  padding:12px 10px!important;
  overflow:visible!important;
}
.fmb-build-root--duncan .progress-side .fm-side-label{
  display:block!important;position:relative!important;
  width:100%!important;min-width:0!important;height:auto!important;
  margin:0 0 10px!important;padding:0!important;
  line-height:1.3!important;overflow-wrap:break-word!important;
}
.fmb-build-root--duncan .progress-side .fm-stats-grid{
  min-width:0!important;width:100%!important;
  column-gap:6px!important;row-gap:7px!important;
}
.fmb-build-root--duncan .progress-side .fm-stat{min-width:0!important}
.fmb-build-root--duncan .progress-side .fm-row{
  display:flex!important;flex-wrap:nowrap!important;align-items:flex-start!important;
  justify-content:space-between!important;gap:8px!important;
  position:relative!important;width:100%!important;min-width:0!important;height:auto!important;
  margin:0!important;padding:8px 0!important;
}
.fmb-build-root--duncan .progress-side .fm-row small{
  display:block!important;flex:1 1 58%!important;min-width:0!important;
  max-width:none!important;width:auto!important;
  overflow-wrap:break-word!important;word-break:normal!important;
  white-space:normal!important;line-height:1.45!important;
}
.fmb-build-root--duncan .progress-side .fm-row strong{
  display:block!important;flex:0 1 48%!important;min-width:0!important;
  max-width:48%!important;width:auto!important;
  overflow-wrap:break-word!important;white-space:normal!important;
  text-align:right!important;line-height:1.45!important;
}
/* Duas colunas de ~65px faziam os títulos se sobreporem nos cards de recursos.
   Uma coluna mantém os mesmos dados, legíveis e com espaço real. */
.fmb-build-root--duncan .progress-side .fm-resource-mini{
  display:grid!important;grid-template-columns:minmax(0,1fr)!important;
  gap:8px!important;width:100%!important;min-width:0!important;
  margin:3px 0 8px!important;
}
.fmb-build-root--duncan .progress-side .fm-resource-mini > div{
  display:flex!important;flex-direction:column!important;align-items:center!important;
  justify-content:center!important;gap:3px!important;
  min-width:0!important;width:100%!important;height:auto!important;
  padding:8px 7px!important;margin:0!important;
}
.fmb-build-root--duncan .progress-side .fm-resource-mini :is(small,strong){
  display:block!important;position:static!important;
  width:auto!important;max-width:100%!important;height:auto!important;
  min-width:0!important;margin:0!important;
  text-align:center!important;white-space:normal!important;
  overflow-wrap:break-word!important;line-height:1.35!important;
}
/* Inventário ainda presente; remoção/redução do conteúdo fica para BLOCO 2. */
.fmb-build-root--duncan .progress-side .wish-section{
  padding:13px 0 0!important;
}
.fmb-build-root--duncan .progress-side .wish-title{
  display:block!important;position:static!important;
  margin:0 0 8px!important;width:100%!important;height:auto!important;
  line-height:1.35!important;overflow-wrap:break-word!important;
}
.fmb-build-root--duncan .progress-side .wish-note{
  display:block!important;margin:0 0 11px!important;
  line-height:1.45!important;height:auto!important;
}
.fmb-build-root--duncan .progress-side .wish-item{
  position:relative!important;display:block!important;
  width:100%!important;min-width:0!important;height:auto!important;
  margin:0!important;overflow:visible!important;
  padding:12px 10px!important;
}
.fmb-build-root--duncan .progress-side .wish-head{
  display:flex!important;position:relative!important;flex-direction:column!important;
  justify-content:flex-start!important;align-items:flex-start!important;
  flex-wrap:nowrap!important;gap:7px!important;
  width:100%!important;height:auto!important;min-height:0!important;
  margin:0 0 10px!important;
}
.fmb-build-root--duncan .progress-side .wish-head > strong{
  display:block!important;position:static!important;
  width:100%!important;max-width:100%!important;min-width:0!important;height:auto!important;
  margin:0!important;overflow-wrap:break-word!important;
  white-space:normal!important;line-height:1.25!important;
}
.fmb-build-root--duncan .progress-side .wish-head > .wish-tag{
  display:inline-block!important;position:static!important;flex:0 0 auto!important;
  align-self:flex-start!important;max-width:100%!important;width:auto!important;
  height:auto!important;margin:0!important;line-height:1.25!important;
}
.fmb-build-root--duncan .progress-side .wish-item :is(small,p){
  display:block!important;position:static!important;
  margin:0 0 7px!important;line-height:1.55!important;
  overflow-wrap:break-word!important;white-space:normal!important;
}
.fmb-build-root--duncan .progress-side .wish-item :is(small,p):last-child{margin-bottom:0!important}
@media (max-width:760px){
 .fmb-build-root--duncan .progress-side .fm-side-sheet{max-width:420px!important;margin:18px auto 0!important}
}


/* DUNCAN-UX-01 / BLOCO 2: limpeza da sidebar e Wishlist editorial.
   Mantém os níveis, as artes, os escudos e a mecânica intactos. */
.fmb-build-root--duncan .progress-side .duncan-ca-only{padding:12px 10px!important}
.fmb-build-root--duncan .progress-side .duncan-ca-only .fm-side-label{margin-bottom:5px!important}
.fmb-build-root--duncan .progress-side .duncan-ca-only .fm-row{border:0!important;padding:3px 0 0!important;align-items:center!important}
.fmb-build-root--duncan .progress-side .duncan-ca-only .fm-row small{font-size:11px!important;font-weight:800!important;max-width:45%!important}
.fmb-build-root--duncan .progress-side .duncan-ca-only .fm-row strong{font-size:23px!important;font-weight:900!important;line-height:1.2!important;max-width:55%!important}
.fmb-build-root--duncan .progress-side .duncan-sidebar-wishlist{padding:12px 10px!important;border:1px solid rgba(214,174,102,.52)!important;border-radius:11px!important;background:linear-gradient(155deg,#133428,#214938)!important;color:#f4ead3!important}
.fmb-build-root--duncan .progress-side .duncan-sidebar-wishlist .wish-title{color:#f0d7a0!important;font:800 11px/1.2 Arial,sans-serif!important;letter-spacing:.1em!important;margin:0 0 5px!important}
.fmb-build-root--duncan .progress-side .duncan-sidebar-wishlist .wish-note{font:10px/1.35 Arial,sans-serif!important;color:#b8cfc0!important;margin:0 0 10px!important}
.fmb-build-root--duncan .progress-side .duncan-sidebar-wishlist .wish-item{padding:0!important;margin:0!important;border:0!important;background:transparent!important;box-shadow:none!important;min-height:0!important}
.fmb-build-root--duncan .progress-side .duncan-sidebar-wishlist .du-sidebar-primary{display:block!important;margin:0 0 8px!important;color:#f7ead0!important;font:700 13px/1.34 Georgia,serif!important;overflow-wrap:anywhere!important}
.fmb-build-root--duncan .progress-side .duncan-sidebar-wishlist .du-sidebar-alt{display:block!important;margin:0 0 8px!important;color:#d8e2d7!important;font:11px/1.42 Arial,sans-serif!important;overflow-wrap:break-word!important}
.fmb-build-root--duncan .progress-side .duncan-sidebar-wishlist .du-sidebar-secondary{font:10px/1.4 Arial,sans-serif!important;color:#e4e4d4!important;margin:0 0 10px!important}
.fmb-build-root--duncan .progress-side .duncan-sidebar-wishlist :is(.du-sidebar-secondary a,.du-sidebar-cta){color:#f1d292!important;text-decoration:underline!important;text-underline-offset:3px!important}
.fmb-build-root--duncan .progress-side .duncan-sidebar-wishlist .du-sidebar-cta{display:block!important;margin-top:9px!important;padding-top:8px!important;border-top:1px solid rgba(231,194,125,.35)!important;font:700 11px/1.4 Arial,sans-serif!important;overflow-wrap:normal!important}
/* Level 20 has a main artwork and must not receive Wishlist, despite its sidebar. */

/* DUNCAN-UX-01 · BLOCO 3 · v1.8 — escudo White Cloak na sidebar, arte consagrada na abertura principal. */
.fmb-build-root--duncan #nivel-20 .snake-wrap:has(.duncan-shield-figure) {
  overflow:visible!important;
  padding:0!important;
}
.fmb-build-root--duncan #nivel-20 .duncan-final-hero {
  display:grid;
  grid-template-columns:minmax(235px,36%) minmax(0,1fr);
  gap:0;
  border:1px solid #b9a078;
  border-radius:17px;
  overflow:hidden;
  background:linear-gradient(130deg,#f8f0df,#f1e7d4);
  margin:0 0 24px;
  align-items:stretch;
}
.fmb-build-root--duncan #nivel-20 .duncan-final-hero-art {
  position:relative;
  display:block;
  min-height:450px;
  margin:0!important;
  padding:0!important;
  border:0!important;
  overflow:hidden;
  background:#213c2c;
}
.fmb-build-root--duncan #nivel-20 .duncan-final-hero-art > .duncan-verified-art-slot {
  position:absolute!important;
  inset:0!important;
  width:100%!important;
  height:100%!important;
  min-height:0!important;
  display:block!important;
  border:0!important;
  padding:0!important;
  margin:0!important;
}
.fmb-build-root--duncan #nivel-20 .duncan-final-hero-art .duncan-verified-art-slot img {
  position:absolute!important;
  inset:0!important;
  width:100%!important;
  height:100%!important;
  object-fit:cover!important;
  object-position:50% 24%!important;
  display:block!important;
}
.fmb-build-root--duncan #nivel-20 .duncan-final-hero-caption {
  position:absolute;
  z-index:2;
  bottom:0;
  left:0;
  right:0;
  padding:34px 15px 13px;
  color:#fff3d9;
  background:linear-gradient(transparent,rgba(9,30,21,.84));
  text-align:center;
  font:700 12px/1.4 Georgia,serif;
  letter-spacing:.02em;
}
.fmb-build-root--duncan #nivel-20 .duncan-final-hero-copy {
  min-width:0;
  padding:25px 26px 27px;
  display:flex;
  flex-direction:column;
  justify-content:center;
  gap:0;
}
.fmb-build-root--duncan #nivel-20 .duncan-final-hero-copy > .kicker {margin-top:0!important;}
.fmb-build-root--duncan #nivel-20 .duncan-final-hero-copy > h1 {
  overflow-wrap:break-word;
  font-size:clamp(30px,3.1vw,44px)!important;
  line-height:1.12!important;
  margin:10px 0 12px!important;
}
.fmb-build-root--duncan #nivel-20 .duncan-final-hero-copy > .lead {
  max-width:100%;
  font-size:clamp(14px,1.12vw,16px)!important;
  line-height:1.65!important;
  margin:0 0 14px!important;
}
.fmb-build-root--duncan #nivel-20 .duncan-final-hero-copy > .duncan-stat-strip {
  margin:0 0 14px!important;
  display:flex!important;
  gap:6px!important;
  flex-wrap:wrap!important;
}
.fmb-build-root--duncan #nivel-20 .duncan-final-hero-copy > .duncan-level-callout {
  margin:0!important;
  max-width:100%;
  padding:13px 14px!important;
  font-size:13px!important;
  line-height:1.55!important;
}
@media(max-width:1150px){
  .fmb-build-root--duncan #nivel-20 .duncan-final-hero{grid-template-columns:minmax(0,1fr)}
  .fmb-build-root--duncan #nivel-20 .duncan-final-hero-art{min-height:350px;height:350px}
  .fmb-build-root--duncan #nivel-20 .duncan-final-hero-art .duncan-verified-art-slot img{object-position:50% 26%!important;}
  .fmb-build-root--duncan #nivel-20 .duncan-final-hero-copy{padding:24px 24px 27px}
}
@media(min-width:761px) and (max-width:1150px){
  .fmb-build-root--duncan #nivel-20 .duncan-final-hero{grid-template-columns:minmax(225px,36%) minmax(0,1fr)}
  .fmb-build-root--duncan #nivel-20 .duncan-final-hero-art{height:auto;min-height:475px}
  .fmb-build-root--duncan #nivel-20 .duncan-final-hero-copy{padding:20px 19px 22px}
  .fmb-build-root--duncan #nivel-20 .duncan-final-hero-copy > h1{font-size:32px!important}
}
@media(max-width:760px){
  .fmb-build-root--duncan #nivel-20 .duncan-final-hero-art{height:360px;min-height:360px}
  .fmb-build-root--duncan #nivel-20 .duncan-final-hero-art .duncan-verified-art-slot img{object-position:50% 9%!important}
}
@media(max-width:650px){
  .fmb-build-root--duncan #nivel-20 .duncan-final-hero{border-radius:13px;margin-bottom:18px}
  .fmb-build-root--duncan #nivel-20 .duncan-final-hero-art{height:335px;min-height:335px}
  .fmb-build-root--duncan #nivel-20 .duncan-final-hero-copy{padding:21px 17px 24px}
  .fmb-build-root--duncan #nivel-20 .duncan-final-hero-copy > h1{font-size:32px!important}
  .fmb-build-root--duncan #nivel-20 .duncan-final-hero-copy > .duncan-level-callout{font-size:12.5px!important}
}


/* DUNCAN-UX-02 · v1.9 — Wishlist sob demanda. Sem faixas soltas entre níveis.
   A progressão continua pelo stepper anterior/próximo existente. */
.fmb-build-root--duncan dialog.duncan-wishlist-dialog {
  box-sizing:border-box; width:min(880px,calc(100vw - 30px));
  max-width:880px; max-height:min(88vh,860px); margin:auto; padding:0;
  border:1px solid #c5a66d; border-radius:17px;
  box-shadow:0 24px 80px rgba(5,20,13,.55);
  background:#f2e8d5; color:#253a2d; overflow-y:auto;
  overscroll-behavior:contain;
}
.fmb-build-root--duncan dialog.duncan-wishlist-dialog:not([open]) { display:none; }
.fmb-build-root--duncan dialog.duncan-wishlist-dialog::backdrop { background:rgba(6,21,15,.74); backdrop-filter:blur(3px); }
.fmb-build-root--duncan .dw-dialog-head {
  position:relative; padding:24px 72px 19px 26px;
  background:linear-gradient(115deg,#17382a,#25513a);
  color:#fff4dc; border-bottom:3px solid #b88a45;
}
.fmb-build-root--duncan .dw-dialog-kicker {
  font:700 10px/1.4 Arial,sans-serif; letter-spacing:.11em; text-transform:uppercase; color:#e2c594;
}
.fmb-build-root--duncan .dw-dialog-title {
  margin:8px 0 10px; color:#fff1d0; font:700 clamp(21px,3vw,30px)/1.2 Georgia,serif;
}
.fmb-build-root--duncan .dw-dialog-meta { display:flex; flex-wrap:wrap; gap:7px; }
.fmb-build-root--duncan .dw-dialog-meta span {
  border:1px solid rgba(226,198,148,.6); border-radius:5px; padding:5px 9px;
  color:#f6e8ce; font:700 10px/1.35 Arial,sans-serif;
}
.fmb-build-root--duncan button.dw-dialog-close {
  position:absolute; right:17px; top:17px; display:grid; place-items:center;
  width:40px; height:40px; padding:0; border:1px solid rgba(244,216,163,.67);
  border-radius:10px; background:rgba(0,0,0,.23); color:#ffe6b5;
  font:700 27px/1 Arial,sans-serif; cursor:pointer;
}
.fmb-build-root--duncan button.dw-dialog-close:hover,
.fmb-build-root--duncan button.dw-dialog-close:focus-visible { background:#38684c; outline:2px solid #d8b677; outline-offset:2px; }
.fmb-build-root--duncan dialog.duncan-wishlist-dialog .dw-content {
  border:0; padding:24px 26px 23px; background:#f2e8d5;
}
.fmb-build-root--duncan dialog.duncan-wishlist-dialog .dw-grid { gap:15px; }
.fmb-build-root--duncan .dw-dialog-actions {
  border-top:1px solid #cbb791; padding:14px 26px 20px; background:#eee1ca;
}
.fmb-build-root--duncan .dw-back-to-level {
  display:inline-flex; padding:9px 12px; border:1px solid #a88858;
  border-radius:8px; background:#204b35; color:#fff0d2!important;
  text-decoration:none!important; font:700 12px/1.3 Arial,sans-serif;
}
.fmb-build-root--duncan .dw-back-to-level:hover,
.fmb-build-root--duncan .dw-back-to-level:focus-visible { background:#37694b; outline:2px solid #9e793d; }
@media(max-width:640px){
  .fmb-build-root--duncan dialog.duncan-wishlist-dialog {
    width:calc(100vw - 16px); max-height:92dvh; border-radius:12px;
  }
  .fmb-build-root--duncan .dw-dialog-head {padding:18px 60px 15px 17px}
  .fmb-build-root--duncan .dw-dialog-title {font-size:21px}
  .fmb-build-root--duncan button.dw-dialog-close {right:10px;top:10px;width:37px;height:37px}
  .fmb-build-root--duncan dialog.duncan-wishlist-dialog .dw-content {padding:17px}
  .fmb-build-root--duncan .dw-dialog-actions {padding:12px 17px 18px}
  .fmb-build-root--duncan dialog.duncan-wishlist-dialog .dw-grid {grid-template-columns:1fr}
}


/* DUNCAN-UX-06 v2.3 — reparo estrutural dos níveis 18–20.
   O elemento .duncan-mastery carrega um contorno verde da regra herdada
   .duncan-fact-card, ausente na referência do nível 16. A v2.2 tratava
   apenas os filhos e a borda SUPERIOR, deixando as bordas laterais.
   Resetar a moldura do CONTÊINER, preservar os cards e não alterar dados. */
.fmb-build-root--duncan :is(.fmb-block-18,.fmb-block-19,.fmb-block-20)
  .duncan-fact-card.duncan-mastery {
  border:0!important;
  outline:0!important;
  box-shadow:none!important;
  background:transparent!important;
  padding:0!important;
}
/* Itens com contorno único, sem acentos laterais nem pseudos. */
.fmb-build-root--duncan :is(.fmb-block-18,.fmb-block-19,.fmb-block-20)
  .duncan-mastery .duncan-facts > div {
  border:1px solid #c0ab80!important;
  outline:0!important;
  box-shadow:none!important;
  background-clip:padding-box;
}
.fmb-build-root--duncan :is(.fmb-block-18,.fmb-block-19,.fmb-block-20)
  .duncan-mastery .duncan-facts > div::before,
.fmb-build-root--duncan :is(.fmb-block-18,.fmb-block-19,.fmb-block-20)
  .duncan-mastery .duncan-facts > div::after {
  content:none!important;
  display:none!important;
}

/* A barra FORJA NAV fica fixa. Somente o mascote se move sobre a linha. */
#duncan-forja-nav-v2 .fmb-journey-dock { cursor:default; touch-action:auto; user-select:auto; }
#duncan-forja-nav-v2 .fmb-dock-status::after {
  content:'ARRASTE O PÃO DE QUEIJO PARA NAVEGAR';
  display:block;
  margin-top:5px;
  color:#d1bb89;
  font:700 8px/1.3 Arial,sans-serif;
  letter-spacing:.045em;
}
#duncan-forja-nav-v2 .fmb-progress-wrap {
  cursor:pointer;
  touch-action:none;
  user-select:none;
  -webkit-user-select:none;
  border-radius:12px;
}
#duncan-forja-nav-v2 .fmb-progress-wrap:focus-visible {
  outline:2px solid #e1bb73;
  outline-offset:3px;
}
#duncan-forja-nav-v2 .fmb-progress-cheese {
  pointer-events:auto !important;
  cursor:grab;
  user-select:none;
  -webkit-user-drag:none;
  touch-action:none;
}
#duncan-forja-nav-v2 .fmb-progress-wrap.is-scrubbing .fmb-progress-cheese {
  cursor:grabbing;
  transition:none !important;
  animation:none !important;
  filter:drop-shadow(0 0 9px rgba(247,205,100,.82)) drop-shadow(0 4px 6px rgba(0,0,0,.36));
}
#duncan-forja-nav-v2 .fmb-progress-wrap.is-scrubbing .fmb-progress-fill {
  transition:none !important;
}
@media(max-width:700px){
  #duncan-forja-nav-v2 .fmb-dock-status::after{font-size:7px;margin-top:3px;}
}
@media(prefers-reduced-motion:reduce){
  #duncan-forja-nav-v2 .fmb-progress-cheese{animation:none!important;}
}



/* DUNCAN-UX-07 — causa raiz: a cascata dos niveis 18-20 retirou
   margin/padding de .duncan-fact-card, mas manteve bordas externas.
   Restauramos paineis individuais e eliminamos a linha de contorno
   continua. Escopo: SOMENTE os 3 paineis dos niveis 18, 19 e 20. */
.fmb-build-root--duncan :is(#nivel-18,#nivel-19,#nivel-20)
  > .duncan-compact-content > .duncan-fact-card {
  display:block!important;
  position:relative;
  box-sizing:border-box;
  min-width:0;
  margin:20px 0!important;
  padding:20px 22px!important;
  border:0!important;
  outline:0!important;
  border-radius:12px!important;
  background:linear-gradient(160deg,#e1e9db,#d4e0d3)!important;
  box-shadow:0 7px 18px rgba(24,47,32,.09)!important;
}
/* Mesmo tratamento para o painel de Maestrias: o reset da v2.3
   nao pode colar o terceiro painel aos dois anteriores. */
.fmb-build-root--duncan :is(#nivel-18,#nivel-19,#nivel-20)
  > .duncan-compact-content > .duncan-fact-card.duncan-mastery {
  margin:20px 0!important;
  padding:20px 22px!important;
  background:linear-gradient(160deg,#e1e9db,#d4e0d3)!important;
}
@media(max-width:700px){
  .fmb-build-root--duncan :is(#nivel-18,#nivel-19,#nivel-20)
    > .duncan-compact-content > .duncan-fact-card {
    margin:18px 0!important;
    padding:17px 15px!important;
  }
}


/* DUNCAN-UX-08: o dock permanece fixo; somente a imagem sobre o trilho
   recebe pointerdown e acompanha o cursor/dedo durante a captura. */
#duncan-forja-nav-v2 .fmb-progress-wrap {
  cursor:default;
  touch-action:auto;
  user-select:none;
  -webkit-user-select:none;
}
#duncan-forja-nav-v2 .fmb-progress-track { pointer-events:none; }
#duncan-forja-nav-v2 .fmb-progress-cheese {
  pointer-events:auto!important;
  cursor:grab;
  touch-action:none;
  user-select:none;
  -webkit-user-select:none;
  -webkit-user-drag:none;
}
#duncan-forja-nav-v2 .fmb-progress-wrap.is-scrubbing .fmb-progress-cheese {
  cursor:grabbing;
  transition:none!important;
  animation:none!important;
}
#duncan-forja-nav-v2 .fmb-progress-wrap.is-scrubbing .fmb-progress-fill {
  transition:none!important;
}


/* DUNCAN-WP-UX-09 · full-bleed like the approved Voldemort build.
   Only the shortcode root is affected; inner approved 1360px panels, grids and media queries stay intact.
   Inline !important on the root is a compatibility fallback for WordPress themes that apply
   layout constraints with !important to shortcode output. */
html body .fmb-build-root.fmb-build-root--duncan {
  position:relative!important;
  display:block!important;
  left:50%!important;
  right:auto!important;
  width:100vw!important;
  max-width:none!important;
  min-width:0!important;
  margin-left:-50vw!important;
  margin-right:0!important;
  float:none!important;
}
