.fmb-build-root--duncan .fmb-block-20 .wish-section{border-top:1px solid #c5a16b}
.fmb-build-root--duncan .fmb-block-20 .wish-title{color:#eac58d}
.fmb-build-root--duncan .fmb-block-20 .wish-note{color:#cbd5c5}
.fmb-build-root--duncan .fmb-block-20 .wish-item{background:rgba(9,29,20,.55);border:1px solid #8c957b}
.fmb-build-root--duncan .fmb-block-20 .wish-item :is(strong,small,p){color:#f0dfc1}
