.fmb-build-root--duncan :is(.fmb-block-18,.fmb-block-19) .card .item strong{display:block!important;max-width:none;white-space:normal;overflow-wrap:break-word;font:700 16px/1.35 Georgia,serif;color:#204d32;margin:0 0 6px}
.fmb-build-root--duncan :is(.fmb-block-18,.fmb-block-19) .card .item p{margin:0!important;font:14px/1.65 Arial,sans-serif;color:#465047}
