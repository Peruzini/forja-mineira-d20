@media(max-width:700px){.fmb-build-root--duncan .fmb-block-20 .duncan-core-two,.fmb-build-root--duncan .fmb-block-20 .duncan-maneuver-list,.fmb-build-root--duncan .fmb-block-20 .duncan-facts{grid-template-columns:1fr}.fmb-build-root--duncan .fmb-block-20 .combat{padding:20px 14px}}


/* DUNCAN 18–19: revisão visual de legibilidade e sidebar. Mantém estrutura aprovada. */
 reintroduz a estrutura fm-* de ficha lateral ausente no original do bloco 12. */
/* Forja sidebar sheet — standardized compact levels */
.fmb-build-root--duncan .fmb-block-20 .fm-side-sheet{
  position:relative;
  z-index:5;
  width:100%;
  margin-top:18px;
  padding:16px 0 0;
  border-top:1px solid rgba(221,205,169,.24);
  background:#102419;
}
.fmb-build-root--duncan .fmb-block-20 .fm-side-section + .fm-side-section{margin-top:16px}
.fmb-build-root--duncan .fmb-block-20 .fm-side-label{
  display:block;
  margin-bottom:8px;
  color:#ddcda9;
  font:800 9px/1.2 Arial,sans-serif;
  letter-spacing:.14em;
  text-transform:uppercase;
  text-align:left;
}
.fmb-build-root--duncan .fmb-block-20 .fm-stats-grid{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:6px;
}
.fmb-build-root--duncan .fmb-block-20 .fm-stat{
  padding:7px 5px 6px;
  border:1px solid rgba(255,255,255,.12);
  border-radius:9px;
  background:rgba(255,255,255,.045);
  text-align:center;
}
.fmb-build-root--duncan .fmb-block-20 .fm-stat small{
  display:block;
  color:#b8c6bd;
  font:800 8px/1 Arial,sans-serif;
}
.fmb-build-root--duncan .fmb-block-20 .fm-stat strong{
  display:block;
  margin-top:3px;
  color:#fff;
  font-size:18px;
  line-height:1;
}
.fmb-build-root--duncan .fmb-block-20 .fm-stat span{
  display:block;
  margin-top:3px;
  color:#8fb09d;
  font:700 9px/1 Arial,sans-serif;
}
.fmb-build-root--duncan .fmb-block-20 .fm-panel{
  padding:11px 12px;
  border:1px solid rgba(255,255,255,.11);
  border-radius:11px;
  background:rgba(255,255,255,.04);
}
.fmb-build-root--duncan .fmb-block-20 .fm-row{
  display:flex;
  align-items:flex-start;
  justify-content:space-between;
  gap:10px;
  padding:6px 0;
  border-top:1px solid rgba(255,255,255,.08);
}
.fmb-build-root--duncan .fmb-block-20 .fm-row:first-of-type{border-top:0}
.fmb-build-root--duncan .fmb-block-20 .fm-row small{
  color:#b8c6bd;
  font:700 9px/1.25 Arial,sans-serif;
}
.fmb-build-root--duncan .fmb-block-20 .fm-row strong{
  max-width:92px;
  color:#fff;
  font-size:11px;
  line-height:1.2;
  text-align:right;
}
.fmb-build-root--duncan .fmb-block-20 .fm-resource-mini{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:8px;
}
.fmb-build-root--duncan .fmb-block-20 .fm-resource-mini > div{
  padding:9px 7px;
  border:1px solid rgba(255,255,255,.09);
  border-radius:9px;
  background:rgba(255,255,255,.035);
  text-align:center;
}
.fmb-build-root--duncan .fmb-block-20 .fm-resource-mini small{
  display:block;
  color:#b8c6bd;
  font:700 8px/1.25 Arial,sans-serif;
}
.fmb-build-root--duncan .fmb-block-20 .fm-resource-mini strong{
  display:block;
  margin-top:5px;
  color:#fff;
  font-size:20px;
  line-height:1;
}
.fmb-build-root--duncan .fmb-block-20 .fm-timeline-resume{
  position:relative;
  z-index:1;
  width:2px;
  height:110px;
  margin:0 auto -24px;
  background:linear-gradient(#6b8374,#244a37);
  opacity:.78;
}
@media (max-width:760px){.fmb-build-root--duncan .fmb-block-20 .fm-side-sheet{max-width:420px;margin:18px auto 0}
.fmb-build-root--duncan .fmb-block-20 .fm-timeline-resume{display:none}}


.fmb-build-root--duncan .fmb-block-20 .card,
.fmb-build-root--duncan .fmb-block-20 .core .card{
  background:linear-gradient(145deg,#f9f0e1,#e5d9c5)!important;
  color:#283b2d!important;
  border:1px solid #bb9966!important;
  border-top:4px solid #345941!important;
  box-shadow:0 12px 24px rgba(0,0,0,.13)!important;
  padding:20px!important;
  border-radius:12px!important;
}
.fmb-build-root--duncan .fmb-block-20 .card.primary,
.fmb-build-root--duncan .fmb-block-20 .core .card.primary{
  background:linear-gradient(145deg,#dce9d8,#d3ddce)!important;
  border-top-color:#22583a!important;
}
.fmb-build-root--duncan .fmb-block-20 .card h2{
  color:#163c29!important;
  font-size:clamp(20px,2vw,25px)!important;
  line-height:1.27!important;
  margin:10px 0 14px!important;
}
.fmb-build-root--duncan .fmb-block-20 .card .mini-label{color:#9a522e!important}
.fmb-build-root--duncan .fmb-block-20 .card .item{
  padding:12px 0 11px!important;
  border-bottom:1px solid rgba(126,103,68,.25)!important;
}
.fmb-build-root--duncan .fmb-block-20 .card .item strong{
  display:block!important;
  color:#214d32!important;
  font:700 16px/1.35 Georgia,serif!important;
  margin:0 0 7px!important;
  white-space:normal!important;
}
.fmb-build-root--duncan .fmb-block-20 .card .item p{
  color:#465047!important;
  font:14px/1.6 Arial,sans-serif!important;
  margin:0!important;
  line-height:1.65!important;
}
.fmb-build-root--duncan .fmb-block-20 .card .item p strong{
  display:inline!important;
  color:#244a32!important;
  font-weight:700!important;
  margin:0!important;
}
.fmb-build-root--duncan .fmb-block-20 .combat h2{color:#fff0d0!important}
.fmb-build-root--duncan .fmb-block-20 .combat .mini-label{color:#eac18a!important}
.fmb-build-root--duncan .fmb-block-20 .combat p strong{color:#ffe3ac!important;display:inline!important}
.fmb-build-root--duncan .fmb-block-20 .fm-side-sheet{
   background:transparent!important;
   border-top:2px solid #c3a16e!important;
   padding:20px 0 0!important;
}
.fmb-build-root--duncan .fmb-block-20 .fm-stat strong{color:#fff8ea!important}
.fmb-build-root--duncan .fmb-block-20 .fm-stat small{color:#cdd9d6!important}
.fmb-build-root--duncan .fmb-block-20 .fm-stat span{color:#eac78a!important}
.fmb-build-root--duncan .fmb-block-20 .fm-panel{background:rgba(7,27,20,.67)!important;border-color:#c1a16d!important}
.fmb-build-root--duncan .fmb-block-20 .fm-row strong{color:#fff3d7!important}
.fmb-build-root--duncan .fmb-block-20 .fm-resource-mini strong{color:#fff3d7!important}
.fmb-build-root--duncan .fmb-block-20 .duncan-continuity-note strong{color:#1c4d32!important}
.fmb-build-root--duncan .fmb-block-20 .wish-item strong{color:#fff1cb!important}
@media(max-width:760px){
  .fmb-build-root--duncan .fmb-block-20 .fm-side-sheet{max-width:420px;margin:18px auto 0}
  .fmb-build-root--duncan .fmb-block-20 .fm-timeline-resume{display:none}
}


/* DUNCAN 18–19: consolidação final responsiva e legenda de destaque. */
.fmb-build-root--duncan .fmb-block-20 .duncan-level-callout{
  display:block!important;
  padding:16px 20px!important;
  margin:16px 0 20px!important;
  background:linear-gradient(110deg,#163629,#325740)!important;
  color:#fff0d4!important;
  border:1px solid #c69f65!important;
  border-left:6px solid #dba860!important;
  border-radius:11px!important;
  box-shadow:0 10px 19px rgba(22,38,26,.20)!important;
  font:600 14px/1.6 Arial,sans-serif!important;
}
.fmb-build-root--duncan .fmb-block-20 .duncan-level-callout strong{color:#ffe7ae!important}
.fmb-build-root--duncan .fmb-block-20 .wish-title{color:#f1d6a6!important;font-size:11px!important}
.fmb-build-root--duncan .fmb-block-20 .wish-note{font-size:10px!important;color:#cbd5c5!important}
.fmb-build-root--duncan .fmb-block-20 .wish-item {padding:12px!important;background:rgba(9,29,20,.5)!important}
.fmb-build-root--duncan .fmb-block-20 .wish-item :is(small,p){font-size:10px!important;line-height:1.5!important}
@media(max-width:700px){
  .fmb-build-root--duncan .fmb-block-20 .duncan-core-two{grid-template-columns:minmax(0,1fr)!important;gap:14px!important}
  .fmb-build-root--duncan .fmb-block-20 .core .card{padding:18px!important}
  .fmb-build-root--duncan .fmb-block-20 .card .item p{font-size:14px!important}
}

.fmb-build-root--duncan .fmb-block-17 .phase-open{border-color:#c6a065}
.fmb-build-root--duncan .fmb-block-17 .phase-tag{background:linear-gradient(140deg,#153d2b,#244a36);color:#f6e2b5;border:1px solid #ddaf67}
.fmb-build-root--duncan .fmb-block-17 .duncan-phase-art{background:linear-gradient(140deg,rgba(8,24,16,.64),rgba(44,78,54,.50));border-color:#ddb273}
.fmb-build-root--duncan .fmb-block-17 .phase-open .art{background:radial-gradient(circle at 50% 37%,rgba(233,190,102,.15),transparent 40%),linear-gradient(145deg,#0b2118,#173a29 65%,#345363)}
.fmb-build-root--duncan .fmb-block-20 .duncan-maneuver-footnote{margin:14px 0 0;color:#3c5941;font:600 13px/1.55 Arial,sans-serif}
.fmb-build-root--duncan .fmb-block-17 .duncan-maneuver-footnote{margin:14px 0 0;color:#3c5941;font:600 13px/1.55 Arial,sans-serif}
@media(max-width:700px){
.fmb-build-root--duncan :is(.fmb-block-17,.fmb-block-20) .duncan-maneuver-list,.fmb-build-root--duncan :is(.fmb-block-17,.fmb-block-20) .duncan-facts{grid-template-columns:minmax(0,1fr)!important}
.fmb-build-root--duncan .fmb-block-17 .changes{grid-template-columns:minmax(0,1fr)!important}
}


/* DUNCAN 17–19 — resolves Voldemort block 18/19 inherited specificity */
.fmb-build-root--duncan .fmb-block-20 .fm-side-sheet{position:relative!important;display:block!important;width:100%!important;padding:16px 0 0!important;margin-top:18px!important;background:transparent!important;border-top:2px solid #c3a16e!important}
.fmb-build-root--duncan .fmb-block-20 .fm-side-section{display:block!important;position:relative!important}
.fmb-build-root--duncan .fmb-block-20 .fm-stats-grid{display:grid!important;grid-template-columns:repeat(3,minmax(0,1fr))!important;gap:6px!important;width:100%!important;margin:0!important;padding:0!important}
.fmb-build-root--duncan .fmb-block-20 .fm-stat{display:block!important;width:auto!important;min-width:0!important;padding:7px 4px!important;background:rgba(122,147,154,.18)!important;border:1px solid rgba(199,168,103,.42)!important;border-radius:9px!important;text-align:center!important}
.fmb-build-root--duncan .fmb-block-20 .fm-stat small,.fmb-build-root--duncan .fmb-block-20 .fm-stat strong,.fmb-build-root--duncan .fmb-block-20 .fm-stat span{display:block!important;margin:3px 0!important;font-family:Arial,sans-serif!important;line-height:1.12!important;white-space:normal!important;text-align:center!important}
.fmb-build-root--duncan .fmb-block-20 .fm-stat small{font-size:8px!important;color:#d2ded7!important}
.fmb-build-root--duncan .fmb-block-20 .fm-stat strong{font-size:18px!important;color:#fff8e9!important}
.fmb-build-root--duncan .fmb-block-20 .fm-stat span{font-size:10px!important;color:#e9c58c!important}
.fmb-build-root--duncan .fmb-block-20 .fm-row{display:flex!important;justify-content:space-between!important;align-items:center!important;gap:7px!important;width:100%!important;margin:0!important;padding:7px 0!important;border-bottom:1px solid rgba(220,187,126,.17)!important}
.fmb-build-root--duncan .fmb-block-20 .fm-row small{display:block!important;line-height:1.3!important;color:#cbdacf!important;font-size:10px!important;flex:1 1 55%!important}
.fmb-build-root--duncan .fmb-block-20 .fm-row strong{display:block!important;line-height:1.25!important;color:#fff0d0!important;flex:0 0 auto!important;font-size:12px!important;text-align:right!important;max-width:46%!important}
.fmb-build-root--duncan .fmb-block-20 .fm-resource-mini{display:grid!important;grid-template-columns:repeat(2,minmax(0,1fr))!important;gap:7px!important}
.fmb-build-root--duncan .fmb-block-20 .fm-resource-mini>div{display:block!important;width:auto!important;min-width:0!important;padding:9px 6px!important;text-align:center!important}
.fmb-build-root--duncan .fmb-block-20 .fm-resource-mini small,.fmb-build-root--duncan .fmb-block-20 .fm-resource-mini strong{display:block!important;color:#fae6c5!important;line-height:1.2!important}
.fmb-build-root--duncan .fmb-block-20 .fm-panel{background:rgba(8,28,20,.74)!important;border:1px solid rgba(204,172,111,.43)!important;border-radius:11px!important;padding:12px!important}
.fmb-build-root--duncan .fmb-block-20 .wish-section{padding:13px 0 0!important;margin:16px 0 0!important}
.fmb-build-root--duncan .fmb-block-20 .wish-item{padding:12px!important;background:rgba(8,28,20,.67)!important;border:1px solid #be9f69!important}
.fmb-build-root--duncan .fmb-block-20 .wish-item :is(small,p){color:#f4e5cb!important;line-height:1.5!important;font:10px/1.5 Arial,sans-serif!important}
.fmb-build-root--duncan .fmb-block-20 .duncan-core-two{display:grid!important;grid-template-columns:repeat(2,minmax(0,1fr))!important;gap:16px!important;margin:20px 0!important}
.fmb-build-root--duncan .fmb-block-20 .card{display:block!important;background:linear-gradient(150deg,#f9f1e3,#e8dec9)!important;color:#243e30!important;border:1px solid #bd9f70!important;border-top:4px solid #366447!important;box-shadow:0 12px 24px rgba(30,40,27,.12)!important;border-radius:12px!important;padding:20px!important;min-width:0!important}
.fmb-build-root--duncan .fmb-block-20 .card.primary{background:linear-gradient(150deg,#dfebdb,#d5e2d0)!important;border-top-color:#255b3c!important}
.fmb-build-root--duncan .fmb-block-20 .card h2{color:#183d2a!important;font:700 25px/1.14 Georgia,serif!important;margin:12px 0 20px!important}
.fmb-build-root--duncan .fmb-block-20 .card .item{display:block!important;margin:0!important;padding:12px 0!important;border-bottom:1px solid rgba(108,88,56,.22)!important}
.fmb-build-root--duncan .fmb-block-20 .card .item strong{display:block!important;color:#23523b!important;margin:0 0 5px!important;line-height:1.35!important;font:700 16px/1.35 Georgia,serif!important}
.fmb-build-root--duncan .fmb-block-20 .card .item p{color:#405244!important;margin:0!important;line-height:1.65!important;font:14px/1.65 Arial,sans-serif!important}
.fmb-build-root--duncan .fmb-block-20 .card .item p strong{display:inline!important;color:#23523b!important;font:700 inherit!important;margin:0!important}
.fmb-build-root--duncan .fmb-block-20 .duncan-level-callout{background:linear-gradient(105deg,#17392a,#2c5a40)!important;color:#fff2d5!important;border-left:6px solid #e1ad63!important;padding:16px 20px!important;line-height:1.55!important}
.fmb-build-root--duncan .fmb-block-20 .duncan-level-callout strong{color:#fff1c5!important}
.fmb-build-root--duncan .fmb-block-20 .duncan-stat-strip>span{display:inline-block!important;background:linear-gradient(135deg,#173c2a,#295441)!important;color:#faedd7!important;border:1px solid #cda56b!important;border-radius:99px!important;padding:9px 14px!important;margin:2px!important}
.fmb-build-root--duncan .fmb-block-20 .duncan-stat-strip strong{color:#fff2d2!important}
.fmb-build-root--duncan .fmb-block-20 .combat{background:linear-gradient(110deg,#10291e,#214c38 60%,#315741)!important;color:#fff2d6!important;border-top:5px solid #d1a460!important}
.fmb-build-root--duncan .fmb-block-20 .combat h2{color:#ffe5ad!important}
.fmb-build-root--duncan .fmb-block-20 .combat p,.fmb-build-root--duncan .fmb-block-20 .combat p strong{color:#f6edda!important}
.fmb-build-root--duncan .fmb-block-20 .combat .priority{background:rgba(228,190,127,.11)!important;color:#fff0d3!important;border:1px solid #bd9b60!important;border-left:5px solid #ddb171!important}
.fmb-build-root--duncan .fmb-block-20 .duncan-fact-card{background:linear-gradient(150deg,#e1e9db,#d1dfd0)!important;border:1px solid #9ab08c!important;border-top:4px solid #2d6645!important}
.fmb-build-root--duncan .fmb-block-20 .duncan-fact-card h2{color:#1c4430!important}
.fmb-build-root--duncan .fmb-block-20 .duncan-maneuver-list{display:grid!important;grid-template-columns:repeat(2,minmax(0,1fr))!important;gap:7px 14px!important}
.fmb-build-root--duncan .fmb-block-20 .duncan-maneuver-list span{color:#254e37!important;line-height:1.45!important}
.fmb-build-root--duncan .fmb-block-20 .duncan-facts{display:grid!important;grid-template-columns:repeat(2,minmax(0,1fr))!important;gap:10px!important}
.fmb-build-root--duncan .fmb-block-20 .duncan-facts>div{background:#f9f2e5!important;border:1px solid #c5aa7c!important;color:#274531!important;min-width:0!important}
.fmb-build-root--duncan .fmb-block-20 .duncan-facts>div strong{color:#214e32!important}
.fmb-build-root--duncan .fmb-block-20 .duncan-facts>div p{color:#465847!important}
.fmb-build-root--duncan .fmb-block-20 .duncan-continuity-note{background:#dce8d6!important;border:1px solid #99a98c!important;border-left:5px solid #d1a660!important;color:#274335!important}
.fmb-build-root--duncan .fmb-block-20 .progress-side .fm-side-label{color:#f0cd91!important}
@media(max-width:700px){
.fmb-build-root--duncan .fmb-block-20 .duncan-core-two,.fmb-build-root--duncan .fmb-block-20 .duncan-maneuver-list,.fmb-build-root--duncan .fmb-block-20 .duncan-facts{grid-template-columns:minmax(0,1fr)!important}
.fmb-build-root--duncan .fmb-block-20 .card{padding:17px!important}
.fmb-build-root--duncan .fmb-block-20 .combat{padding:22px 16px!important}
}


/* DUNCAN 20 — conclusão da build sem novos assets. */

/* Encerramento discreto da progressão; não interfere nos blocos aprovados */
.fmb-build-root--duncan .fmb-block-20 .duncan-level20-endmark{
  display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;
  margin:24px 0 22px;padding:30px 18px;
  background:linear-gradient(135deg,#142d22,#234a36 57%,#365441);
  border:2px solid #cda76b;border-radius:16px;
  box-shadow:0 14px 30px rgba(13,35,23,.25);gap:8px;
}
.fmb-build-root--duncan .fmb-block-20 .duncan-level20-endmark span{
  font:800 10px/1.35 Arial,sans-serif;color:#e9c387;letter-spacing:.22em;
}
.fmb-build-root--duncan .fmb-block-20 .duncan-level20-endmark strong{
  font:700 clamp(22px,3.3vw,35px)/1.15 Georgia,serif;color:#fff5dc;
}
.fmb-build-root--duncan .fmb-block-20 .duncan-level20-endmark small{
  font:500 12px/1.5 Arial,sans-serif;color:#ebddc4;
}
.fmb-build-root--duncan .fmb-block-20 .duncan-stat-strip{display:flex!important;flex-wrap:wrap!important;gap:6px!important}
.fmb-build-root--duncan .fmb-block-20 .duncan-stat-strip>span{flex:0 1 auto!important}
@media(max-width:760px){
.fmb-build-root--duncan .fmb-block-20 .duncan-level20-endmark{margin:18px 0;padding:24px 12px}
}


/* DUNCAN WISHLIST: interface de referência, sem itens inventados. */
.fmb-build-root--duncan .duncan-wishlist-slot{
  box-sizing:border-box; margin:14px auto 24px; max-width:1120px; padding:18px 22px;
  border:1px solid #d2ad6b; border-left:7px solid #c79d53; border-radius:12px;
  background:linear-gradient(120deg,#183b2b,#244b37 68%,#253d37);
  box-shadow:0 10px 23px rgba(0,0,0,.23); color:#f4ead4;
}
.fmb-build-root--duncan .duncan-wishlist-slot summary{
  cursor:pointer; list-style:revert; color:#ffe3ae; font:700 17px/1.4 Georgia,serif;
}
.fmb-build-root--duncan .duncan-wishlist-slot summary::marker{color:#efc57e}
.fmb-build-root--duncan .duncan-wishlist-slot p{
  margin:10px 0 12px; color:#e6e6d6; font:14px/1.65 Arial,sans-serif;
}
.fmb-build-root--duncan .duncan-wishlist-slot strong{color:#ffe5b4}
.fmb-build-root--duncan .duncan-wishlist-slot .duncan-wishlist-state{
  display:inline-block; padding:7px 11px; border:1px solid #bca477;
  border-radius:6px; background:rgba(3,18,13,.32); color:#f5e5c8;
  font:600 12px/1.5 Arial,sans-serif;
}
.fmb-build-root--duncan .duncan-wishlist-slot:focus-within{outline:2px solid #edc783;outline-offset:2px}
@media(max-width:700px){
  .fmb-build-root--duncan .duncan-wishlist-slot{margin:12px 12px 16px;padding:15px 14px}
  .fmb-build-root--duncan .duncan-wishlist-slot summary{font-size:15px}
}


/* DUNCAN · Wishlist 2024. Blocos fechados por padrão; não alteram as fichas. */
.fmb-build-root--duncan .duncan-wishlist-slot{box-sizing:border-box;margin:16px auto 24px;max-width:1140px;padding:0;
  border:1px solid #c6a56e;border-left:5px solid #b58a45;border-radius:12px;overflow:hidden;
  background:linear-gradient(115deg,#16382a,#254c39 72%,#172c27);color:#fff1d8;
  box-shadow:0 10px 22px rgba(13,31,20,.19)}
.fmb-build-root--duncan .duncan-wishlist-slot,.fmb-build-root--duncan .duncan-wishlist-slot *{box-sizing:border-box}
.fmb-build-root--duncan .duncan-wishlist-slot>summary{cursor:pointer;list-style:none;display:flex;gap:12px;align-items:center;
  padding:15px 19px;min-height:75px;position:relative}
.fmb-build-root--duncan .duncan-wishlist-slot>summary::-webkit-details-marker{display:none}
.fmb-build-root--duncan .dw-numeral{display:flex;flex-shrink:0;align-items:center;justify-content:center;width:41px;height:41px;
  border:1px solid #ddb779;border-radius:10px;background:#0c291d;color:#f5d29b;font:bold 14px Arial,sans-serif}
.fmb-build-root--duncan .dw-heading{display:block;flex:1 1 auto;min-width:0}
.fmb-build-root--duncan .dw-overline{display:block;color:#c7ddcb;font:bold 10px/1.35 Arial,sans-serif;letter-spacing:.07em;text-transform:uppercase;margin-bottom:3px}
.fmb-build-root--duncan .dw-title{display:block;color:#ffe6ae;font:bold 17px/1.3 Georgia,serif;overflow-wrap:anywhere}
.fmb-build-root--duncan .dw-rarity{flex-shrink:0;display:inline-block;padding:6px 10px;background:#d7b47a;border-radius:6px;
  color:#253527;font:bold 10px/1.35 Arial,sans-serif;letter-spacing:.03em;text-transform:uppercase}
.fmb-build-root--duncan .dw-chevron{flex-shrink:0;display:inline-flex;width:20px;height:20px;align-items:center;justify-content:center;
  color:#ffe9b7;font:22px Arial,sans-serif;transition:transform .16s ease}
.fmb-build-root--duncan .duncan-wishlist-slot[open] .dw-chevron{transform:rotate(45deg)}
.fmb-build-root--duncan .duncan-wishlist-slot>summary:hover{background:rgba(255,255,255,.07)}
.fmb-build-root--duncan .duncan-wishlist-slot>summary:focus-visible{outline:3px solid #ffdc9d;outline-offset:-3px}
.fmb-build-root--duncan .dw-content{border-top:1px solid rgba(236,192,119,.43);padding:18px 19px 20px;
  background:linear-gradient(170deg,#f6eddb,#e7dac2);color:#26392d}
.fmb-build-root--duncan .dw-grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:12px;margin-top:13px}
.fmb-build-root--duncan .dw-panel{min-width:0;border:1px solid #c9b18a;border-top:3px solid #356343;border-radius:9px;
  padding:14px 15px;background:#fff9ed}
.fmb-build-root--duncan .dw-panel:nth-child(2){border-top-color:#ad8049}
.fmb-build-root--duncan .dw-panel h4{font:bold 15px/1.3 Georgia,serif;color:#1d402e;margin:0 0 7px}
.fmb-build-root--duncan .dw-panel p,.fmb-build-root--duncan .dw-content>p{color:#364637;font:13px/1.63 Arial,sans-serif;margin:0}
.fmb-build-root--duncan .dw-panel strong{color:#1d4b35}
.fmb-build-root--duncan .dw-tags{display:flex;gap:7px;flex-wrap:wrap}
.fmb-build-root--duncan .dw-tag{display:inline-block;padding:6px 10px;color:#205039;background:#e0e8d7;border:1px solid #abc0a2;
  border-radius:7px;font:bold 11px/1.3 Arial,sans-serif}
.fmb-build-root--duncan .dw-tag--gold{color:#694723;background:#f1e3c7;border-color:#d1b781}
.fmb-build-root--duncan .dw-foot{border-top:1px solid #cbb999;padding-top:11px;margin-top:12px!important;color:#4e584e!important;
  font:12px/1.55 Arial,sans-serif!important}
.fmb-build-root--duncan .dw-foot strong{color:#214932!important}
.fmb-build-root--duncan .dw-foot a{color:#205b40;text-decoration:underline}
.fmb-build-root--duncan .dw-phase-intro{max-width:1140px;margin:15px auto 7px;border-left:5px solid #a87939;
  background:#efe4d0;padding:11px 16px;color:#314935;font:bold 14px/1.5 Georgia,serif}
@media(max-width:800px){
  .fmb-build-root--duncan .duncan-wishlist-slot{margin:12px 12px 18px}
  .fmb-build-root--duncan .dw-grid{grid-template-columns:1fr}
  .fmb-build-root--duncan .duncan-wishlist-slot>summary{padding:13px;gap:9px;min-height:70px}
  .fmb-build-root--duncan .dw-numeral{width:35px;height:35px;font-size:12px}
  .fmb-build-root--duncan .dw-title{font-size:15px}
  .fmb-build-root--duncan .dw-rarity{padding:5px 6px;font-size:9px}
  .fmb-build-root--duncan .dw-content{padding:14px}
  .fmb-build-root--duncan .dw-panel{padding:13px}
  .fmb-build-root--duncan .dw-phase-intro{margin:12px 12px 7px;font-size:13px}
}
@media(max-width:360px){.fmb-build-root--duncan .dw-rarity{display:none}}


/* WISHLIST POR MARCOS · REVISÃO APROVADA 2024 — sem alterações mecânicas */
.fmb-build-root--duncan .duncan-wishlist-slot{scroll-margin-top:22px}
.fmb-build-root--duncan .dw-panel--alternativa{border-top-color:#b99256;background:linear-gradient(165deg,#fff8e9,#efe0c7)}
.fmb-build-root--duncan .dw-upgrade,.fmb-build-root--duncan .dw-caution{margin-top:12px!important;padding-top:10px;border-top:1px solid #d2c0a4;font-size:12px!important}
.fmb-build-root--duncan .dw-panel--alternativa h4{color:#654724}
.fmb-build-root--duncan .dw-phase-intro{margin-top:20px}
.fmb-build-root--duncan .duncan-wishlist-slot summary .dw-title small{font-family:Georgia,serif;font-size:.8em;font-weight:400;opacity:.93}
@media(max-width:700px){.fmb-build-root--duncan .dw-upgrade,.fmb-build-root--duncan .dw-caution{font-size:12px!important}}


/* DUNCAN ART-01: encaixe candidato para o nível 1, sem tocar nos escudos. */
.fmb-build-root--duncan .fmb-block-1 figure.art > img.duncan-character-art {
  display:block;width:100%;height:100%;min-height:610px;object-fit:cover;
  object-position:52% 18%;filter:saturate(.95) contrast(1.05);
}
.fmb-build-root--duncan .fmb-block-1 figure.art:after{
  content:"";position:absolute;inset:0;pointer-events:none;
  background:linear-gradient(0deg,rgba(10,25,19,.52),transparent 26%,transparent 77%,rgba(12,26,19,.09)),
             linear-gradient(90deg,transparent 67%,rgba(218,195,142,.12));
}
@media(max-width:700px){
  .fmb-build-root--duncan .fmb-block-1 figure.art > img.duncan-character-art{
    min-height:450px;object-position:50% 14%;
  }
}


/* DUNCAN-ART-01 v1.1 — arte de fundação cobre integralmente a coluna visual.
   Contrato PADRAO_VISUAL_BUILDS.md: nivel 1 40%/60%, arte >=610px no desktop,
   tamanho da imagem independente do slot; sem moldura ou padding verde. */
.fmb-build-root--duncan #nivel-1 figure.art {
  display:block!important;
  position:relative!important;
  width:100%!important;
  height:100%!important;
  min-height:610px!important;
  margin:0!important;
  padding:0!important;
  border:0!important;
  border-radius:0!important;
  box-shadow:none!important;
  overflow:hidden!important;
  align-self:stretch!important;
}
.fmb-build-root--duncan #nivel-1 figure.art > img.duncan-character-art {
  display:block!important;
  position:absolute!important;
  inset:0!important;
  width:100%!important;
  height:100%!important;
  min-width:100%!important;
  min-height:0!important;
  margin:0!important;
  padding:0!important;
  border:0!important;
  border-radius:0!important;
  object-fit:cover!important;
  object-position:52% 18%!important;
}
.fmb-build-root--duncan #nivel-1 figure.art:after {
  border:0!important;
  box-shadow:none!important;
  background:linear-gradient(0deg,rgba(9,23,15,.33),transparent 23%)!important;
}
@media (max-width:1050px) {
  .fmb-build-root--duncan #nivel-1 figure.art {height:430px!important;min-height:430px!important;}
  .fmb-build-root--duncan #nivel-1 figure.art > img.duncan-character-art {object-position:50% 13%!important;}
}
@media (max-width:720px) {
  .fmb-build-root--duncan #nivel-1 figure.art {height:330px!important;min-height:330px!important;}
  .fmb-build-root--duncan #nivel-1 figure.art > img.duncan-character-art {object-position:50% 13%!important;}
}


/* DUNCAN-ART-01A: apenas layout visual e slots; sem imagem substituta. */
.fmb-build-root--duncan #nivel-1 .top,
.fmb-build-root--duncan #nivel-5 .phase-open,
.fmb-build-root--duncan #nivel-9 .phase-open,
.fmb-build-root--duncan #nivel-13 .phase-open,
.fmb-build-root--duncan #nivel-17 .phase-open {
  padding:0!important; gap:0!important; align-items:stretch!important;
}
/* O filete de 8px da copy era a faixa verde que aparecia no topo, ao lado da arte. */
.fmb-build-root--duncan #nivel-1 .top > .copy {
  border-top:0!important; margin-top:0!important;
  background-image:linear-gradient(160deg,#f5edde,#e8ddcb)!important;
}
.fmb-build-root--duncan #nivel-5 .phase-open > .content,
.fmb-build-root--duncan #nivel-9 .phase-open > .content,
.fmb-build-root--duncan #nivel-13 .phase-open > .content,
.fmb-build-root--duncan #nivel-17 .phase-open > .content {
 background-image:linear-gradient(180deg,#f4e9d6,#e9ddc9)!important;
}
.fmb-build-root--duncan #nivel-1 figure.art,
.fmb-build-root--duncan #nivel-5 .phase-open > figure.art,
.fmb-build-root--duncan #nivel-9 .phase-open > figure.art,
.fmb-build-root--duncan #nivel-13 .phase-open > figure.art,
.fmb-build-root--duncan #nivel-17 .phase-open > figure.art {
 position:relative!important; display:block!important; align-self:stretch!important;
 margin:0!important; padding:0!important; border:0!important;
 border-radius:0!important; box-shadow:none!important; outline:0!important; overflow:hidden!important;
}
.fmb-build-root--duncan #nivel-1 .duncan-verified-art-slot,
.fmb-build-root--duncan #nivel-5 .duncan-verified-art-slot,
.fmb-build-root--duncan #nivel-9 .duncan-verified-art-slot,
.fmb-build-root--duncan #nivel-13 .duncan-verified-art-slot,
.fmb-build-root--duncan #nivel-17 .duncan-verified-art-slot {
 display:block!important; position:absolute!important; inset:0!important;
 width:100%!important; height:100%!important; min-height:0!important;
 margin:0!important; padding:0!important; border:0!important; border-radius:0!important;
 background:#1e3328!important; overflow:hidden!important;
}
.fmb-build-root--duncan .duncan-verified-art-slot .duncan-art-fallback {
 position:absolute; inset:0; display:flex; flex-direction:column;
 align-items:center; justify-content:center; text-align:center;
 padding:30px; color:#f3ead8; gap:16px;
 background:radial-gradient(ellipse at 50% 35%,#42604b 0%,#253c2d 42%,#162820 100%);
}
.fmb-build-root--duncan .duncan-verified-art-slot .duncan-art-fallback small {
 color:#dcc092; text-transform:uppercase; letter-spacing:.15em;
 font:700 11px Arial,sans-serif;
}
.fmb-build-root--duncan .duncan-verified-art-slot .duncan-art-fallback strong {
 color:#fff0cf;font:700 clamp(22px,2.6vw,33px)/1.24 Georgia,serif;
}
.fmb-build-root--duncan .duncan-verified-art-slot .duncan-art-fallback span {
 font:12px/1.5 Arial,sans-serif;color:#e4d8be;
}
/* 20: slot na sidebar, sem reformular a página mecânica já aprovada. */
.fmb-build-root--duncan #nivel-20 .snake-wrap {padding:0!important;overflow:hidden!important;}
.fmb-build-root--duncan #nivel-20 .duncan-verified-art-slot {
 display:block;position:relative;width:100%;height:100%;min-height:220px;
 margin:0!important;padding:0!important;border:0!important;overflow:hidden;
}
.fmb-build-root--duncan .duncan-verified-art-slot img.duncan-verified-image {
 position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:50% 30%;display:block;
}
.fmb-build-root--duncan .duncan-verified-art-slot.has-image .duncan-art-fallback{display:none!important;}
@media(max-width:720px){
 .fmb-build-root--duncan #nivel-1 figure.art{height:330px!important;min-height:330px!important;}
 .fmb-build-root--duncan #nivel-1 .duncan-verified-art-slot .duncan-art-fallback{padding:18px;}
}
@media(min-width:721px) and (max-width:1050px){
 .fmb-build-root--duncan #nivel-1 figure.art{height:430px!important;min-height:430px!important;}
}


/* DUNCAN-ART-01B: imagens originais aprovadas, sem molduras nem bordas internas */
.fmb-build-root--duncan #nivel-1 .duncan-verified-art-slot.has-image,
.fmb-build-root--duncan #nivel-5 .duncan-verified-art-slot.has-image,
.fmb-build-root--duncan #nivel-9 .duncan-verified-art-slot.has-image,
.fmb-build-root--duncan #nivel-13 .duncan-verified-art-slot.has-image,
.fmb-build-root--duncan #nivel-17 .duncan-verified-art-slot.has-image {inset:0!important;overflow:hidden!important;}
.fmb-build-root--duncan .duncan-verified-art-slot.has-image img.duncan-verified-image {width:100%!important;height:100%!important;display:block!important;object-fit:cover!important;object-position:50% 24%!important;}
.fmb-build-root--duncan #nivel-1 .top > .copy {border-top:0!important;margin-top:0!important;}
.fmb-build-root--duncan #nivel-1 figure.art {margin:0!important;border:0!important;}
.fmb-build-root--duncan #nivel-20 .duncan-verified-art-slot.has-image img {object-position:50% 20%!important;}


/* DUNCAN-ART-01C: alinhar os cinco valores sem alterar cores, tamanhos ou layout */
.fmb-build-root--duncan .fmb-block-1 .status > .status-card{
  display:flex;
  flex-direction:column;
  justify-content:space-between;
}
.fmb-build-root--duncan .fmb-block-1 .status > .status-card > span{
  display:flex;
  flex:1 1 auto;
  align-items:center;
  justify-content:center;
  margin-bottom:3px;
}
.fmb-build-root--duncan .fmb-block-1 .status > .status-card > strong{
  display:block;
  flex:0 0 auto;
  line-height:1.15;
}


/* DUNCAN-ART-02 v1.5 — escudos de fase aprovados, sem alterar blocos mecânicos.
   As imagens aparecem somente nas sidebars de níveis regulares. Não substituem
   as seis artes de personagem/marcos, inclusive a do nível 20. */
.fmb-build-root--duncan .progress-side .snake-wrap .duncan-shield-figure {
 display:block!important; position:relative; width:100%!important; height:100%!important;
 min-height:0!important; max-height:100%!important; flex:0 0 100%;
 background-position:center center; background-size:contain; background-repeat:no-repeat;
 margin:0!important; padding:0!important; border:0!important; box-shadow:none!important;
 filter:drop-shadow(0 9px 14px rgba(0,0,0,.26));
}
.fmb-build-root--duncan .progress-side .snake-wrap:has(.duncan-shield-figure){
 overflow:visible!important; isolation:isolate;
}

.fmb-build-root--duncan .duncan-shield-01{background-image:url("data:image/webp;base64,