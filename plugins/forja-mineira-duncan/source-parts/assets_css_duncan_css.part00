/* ===== BLOCO 7 ===== */
.fmb-block-7{
  --paper:#fbfaf6;--white:#fff;--ink:#1f1b17;--body:#403a33;--muted:#70675e;
  --line:#ddd4c5;--gold:#9b6b18;--green:#28513e;--green-soft:#f2f7f3;--silver:#eef1ef;
}
.fmb-block-7 *{box-sizing:border-box}
.fmb-block-7{margin:0;background:#f1f0ec;color:var(--body);font-family:Georgia,"Times New Roman",serif}
.fmb-block-7 .preview{width:min(1360px,calc(100% - 48px));margin:34px auto}
.fmb-block-7 .level{
  display:grid;grid-template-columns:210px minmax(0,1fr);
  border:1px solid var(--line);border-radius:24px;overflow:hidden;background:var(--paper)
}
.fmb-block-7 .progress-side{
  position:relative;height:100%;padding:28px 18px 24px;
  background:radial-gradient(circle at 50% 45%,rgba(81,122,96,.22),transparent 25%),linear-gradient(180deg,#14231c,#0d1712);
  color:#fff;display:flex;flex-direction:column;align-items:center;overflow:hidden
}
.fmb-block-7 .phase{position:relative;z-index:4;font:800 10px/1.25 Arial,sans-serif;letter-spacing:.16em;text-transform:uppercase;color:#ddcda9;text-align:center}
.fmb-block-7 .level-no{position:relative;z-index:4;margin-top:14px;width:76px;height:76px;border-radius:50%;display:grid;place-items:center;background:#f6f3eb;border:3px solid #a8792d;color:#1f1b17;font:bold 34px/1 Georgia,serif}
.fmb-block-7 .timeline{position:absolute;z-index:1;top:118px;height:300px;left:50%;width:2px;transform:translateX(-50%);background:linear-gradient(#c5b79c,#73877a 56%,#2e493c);opacity:.72}
.fmb-block-7 .snake-wrap{position:relative;z-index:3;width:158px;margin-top:auto;margin-bottom:42px}
.fmb-block-7 .snake-wrap img{display:block;width:100%;height:auto;filter:drop-shadow(0 15px 22px rgba(0,0,0,.46))}
.fmb-block-7 .content{padding:30px 34px 32px}
.fmb-block-7 .kicker,.fmb-block-7 .mini-label{color:var(--gold);font:800 10px/1.2 Arial,sans-serif;letter-spacing:.14em;text-transform:uppercase}
.fmb-block-7 h1,.fmb-block-7 h2{margin:0;color:var(--ink)}
.fmb-block-7 h1{margin-top:7px;font-size:42px;line-height:1}
.fmb-block-7 .lead{margin:13px 0 0;max-width:920px;font-size:16px;line-height:1.62}
.fmb-block-7 .strip{margin-top:18px;display:flex;flex-wrap:wrap;gap:8px}
.fmb-block-7 .strip span{padding:8px 11px;border:1px solid var(--line);border-radius:999px;background:#fff;font:700 11px/1 Arial,sans-serif;color:var(--muted)}
.fmb-block-7 .strip strong{color:var(--ink)}
.fmb-block-7 .core{margin-top:22px;display:grid;grid-template-columns:.95fr 1.05fr;gap:12px}
.fmb-block-7 .card{padding:17px 18px;border:1px solid var(--line);border-radius:16px;background:#fff}
.fmb-block-7 .card.primary{border-color:#9fb5a8;background:linear-gradient(180deg,#fff,var(--green-soft))}
.fmb-block-7 .card h2{margin-top:4px;font-size:24px}
.fmb-block-7 .card p{margin:7px 0 0;font-size:14px;line-height:1.56}
.fmb-block-7 .item{padding:10px 0;border-top:1px solid #ece6dc}
.fmb-block-7 .item:first-of-type{border-top:0}
.fmb-block-7 .item strong{display:block;color:var(--ink);font-size:16px}
.fmb-block-7 .item span{display:block;margin-top:4px;color:var(--muted);font-size:12px;line-height:1.45}
.fmb-block-7 .spell-row{margin-top:12px;display:grid;grid-template-columns:1fr 1fr;gap:12px}
.fmb-block-7 .spell-box{padding:15px 16px;border:1px solid var(--line);border-radius:14px;background:#fff}
.fmb-block-7 .spell-box.primary{border-color:#a9bbae;background:#f4f8f5}
.fmb-block-7 .spell-box strong{display:block;color:var(--ink);font-size:17px}
.fmb-block-7 .spell-box p{margin:5px 0 0;font-size:13px;line-height:1.52}
.fmb-block-7 .combat{margin-top:18px;padding:16px 17px;border-left:4px solid var(--gold);background:#fff}
.fmb-block-7 .combat h2{margin-top:4px;font-size:23px}
.fmb-block-7 .combat p{margin:8px 0 0;font-size:14px;line-height:1.6}
.fmb-block-7 .priority{margin-top:10px;padding:10px 12px;border-radius:10px;background:var(--silver);color:#36433b;font:800 11px/1.45 Arial,sans-serif}
@media (max-width:760px){.fmb-block-7 .preview{width:calc(100% - 20px);margin:10px auto}
.fmb-block-7 .level{grid-template-columns:1fr}
.fmb-block-7 .progress-side{min-height:330px}
.fmb-block-7 .snake-wrap{width:135px;margin-bottom:22px}
.fmb-block-7 .content{padding:24px 20px 26px}
.fmb-block-7 .core,.fmb-block-7 .spell-row{grid-template-columns:1fr}
.fmb-block-7 h1{font-size:35px}}
/* Forja sidebar sheet — standardized compact levels */
.fmb-block-7 .fm-side-sheet{
  position:relative;
  z-index:5;
  width:100%;
  margin-top:18px;
  padding:16px 0 0;
  border-top:1px solid rgba(221,205,169,.24);
  background:#102419;
}
.fmb-block-7 .fm-side-section + .fm-side-section{margin-top:16px}
.fmb-block-7 .fm-side-label{
  display:block;
  margin-bottom:8px;
  color:#ddcda9;
  font:800 9px/1.2 Arial,sans-serif;
  letter-spacing:.14em;
  text-transform:uppercase;
  text-align:left;
}
.fmb-block-7 .fm-stats-grid{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:6px;
}
.fmb-block-7 .fm-stat{
  padding:7px 5px 6px;
  border:1px solid rgba(255,255,255,.12);
  border-radius:9px;
  background:rgba(255,255,255,.045);
  text-align:center;
}
.fmb-block-7 .fm-stat small{
  display:block;
  color:#b8c6bd;
  font:800 8px/1 Arial,sans-serif;
}
.fmb-block-7 .fm-stat strong{
  display:block;
  margin-top:3px;
  color:#fff;
  font-size:18px;
  line-height:1;
}
.fmb-block-7 .fm-stat span{
  display:block;
  margin-top:3px;
  color:#8fb09d;
  font:700 9px/1 Arial,sans-serif;
}
.fmb-block-7 .fm-panel{
  padding:11px 12px;
  border:1px solid rgba(255,255,255,.11);
  border-radius:11px;
  background:rgba(255,255,255,.04);
}
.fmb-block-7 .fm-row{
  display:flex;
  align-items:flex-start;
  justify-content:space-between;
  gap:10px;
  padding:6px 0;
  border-top:1px solid rgba(255,255,255,.08);
}
.fmb-block-7 .fm-row:first-of-type{border-top:0}
.fmb-block-7 .fm-row small{
  color:#b8c6bd;
  font:700 9px/1.25 Arial,sans-serif;
}
.fmb-block-7 .fm-row strong{
  max-width:92px;
  color:#fff;
  font-size:11px;
  line-height:1.2;
  text-align:right;
}
.fmb-block-7 .fm-resource-mini{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:8px;
}
.fmb-block-7 .fm-resource-mini > div{
  padding:9px 7px;
  border:1px solid rgba(255,255,255,.09);
  border-radius:9px;
  background:rgba(255,255,255,.035);
  text-align:center;
}
.fmb-block-7 .fm-resource-mini small{
  display:block;
  color:#b8c6bd;
  font:700 8px/1.25 Arial,sans-serif;
}
.fmb-block-7 .fm-resource-mini strong{
  display:block;
  margin-top:5px;
  color:#fff;
  font-size:20px;
  line-height:1;
}
.fmb-block-7 .fm-timeline-resume{
  position:relative;
  z-index:1;
  width:2px;
  height:110px;
  margin:0 auto -24px;
  background:linear-gradient(#6b8374,#244a37);
  opacity:.78;
}
@media (max-width:760px){.fmb-block-7 .fm-side-sheet{max-width:420px;margin:18px auto 0}
.fmb-block-7 .fm-timeline-resume{display:none}}
.fmb-block-7 .progress-side .timeline{bottom:auto!important;height:300px!important}
/* === Sidebar compacta padronizada: cobra + wishlist === */
.fmb-block-7 .progress-side .snake-wrap{
  width:158px !important;
  height:215px !important;
  min-height:215px !important;
  margin:12px auto 8px !important;
  display:flex !important;
  align-items:flex-start !important;
  justify-content:center !important;
  flex:0 0 215px !important;
}
.fmb-block-7 .progress-side .snake-wrap img{
  display:block !important;
  width:100% !important;
  height:100% !important;
  max-height:215px !important;
  object-fit:contain !important;
  object-position:center top !important;
}
.fmb-block-7 .progress-side .timeline{
  bottom:auto !important;
  height:170px !important;
}
