.fmb-build-root--duncan .fmb-block-20 .fm-row small,.fmb-build-root--duncan .fmb-block-20 .fm-resource-mini small{color:#cedbd0}
.fmb-build-root--duncan .fmb-block-20 .fm-row strong,.fmb-build-root--duncan .fmb-block-20 .fm-resource-mini strong{color:#fff3d7}
.fmb-build-root--duncan .fmb-block-20 .fm-resource-mini>div{border-color:rgba(209,177,119,.35);background:rgba(100,119,133,.2)}
.fmb-build-root--duncan .fmb-block-20 .snake-wrap .duncan-sidebar-empty{background:linear-gradient(160deg,rgba(190,164,113,.16),rgba(64,94,77,.24));border:1px solid rgba(224,189,126,.68);box-shadow:inset 0 0 0 4px rgba(7,29,19,.27);color:#fff0d2}
.fmb-build-root--duncan .fmb-block-20 .duncan-sidebar-empty :is(small,strong,span){color:#f7e6c5}
.fmb-build-root--duncan .fmb-block-20 .wish-title{color:#eac58d}
.fmb-build-root--duncan .fmb-block-20 .wish-note{color:#cbd5c5}
.fmb-build-root--duncan .fmb-block-20 .wish-item{background:rgba(9,29,20,.55);border:1px solid #8c957b}
.fmb-build-root--duncan .fmb-block-20 .wish-item :is(strong,small,p){color:#f0dfc1}
.fmb-build-root--duncan .fmb-block-20 .wish-tag{background:#f0d39b;color:#1b3728}
