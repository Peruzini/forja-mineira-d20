.fmb-build-root--duncan .fmb-block-6 .card.primary,.fmb-build-root--duncan .fmb-block-7 .card.primary{background:linear-gradient(145deg,#e0e9d8,#d1decf);border-top-color:#245b3a}
.fmb-build-root--duncan :is(.fmb-block-6,.fmb-block-7) .effects .effect b{background:#254f38;color:#ffe4ad;border:1px solid #d3aa69}
