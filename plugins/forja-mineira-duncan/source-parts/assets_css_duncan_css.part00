.fmb-build-root--duncan .fmb-block-20 .duncan-stat-strip>span{background:linear-gradient(135deg,#193a2b,#244a38 70%,#2d523d);border:1px solid #d1aa69;border-top:3px solid #f1c87e;color:#fff9e8;box-shadow:0 9px 17px rgba(0,0,0,.14);border-radius:100px;padding:9px 13px}
.fmb-build-root--duncan .fmb-block-20 .duncan-stat-strip strong{color:#fff6e4}
.fmb-build-root--duncan .fmb-block-20 .progress-side :is(.fm-side-label,.phase){color:#e9c58c}
.fmb-build-root--duncan .fmb-block-20 .fm-stat{background:rgba(122,147,154,.17);border:1px solid rgba(199,168,103,.34)}
.fmb-build-root--duncan .fmb-block-20 .fm-stat strong{color:#fff8ea}
