/* DUNCAN 18–19: revisão visual de legibilidade e sidebar. Mantém estrutura aprovada. */
 reintroduz a estrutura fm-* de ficha lateral ausente no original do bloco 12. */
/* Forja sidebar sheet — standardized compact levels */
.fmb-build-root--duncan :is(.fmb-block-18,.fmb-block-19) .fm-side-sheet{
  position:relative;
  z-index:5;
  width:100%;
  margin-top:18px;
  padding:16px 0 0;
  border-top:1px solid rgba(221,205,169,.24);
  background:#102419;
}
.fmb-build-root--duncan :is(.fmb-block-18,.fmb-block-19) .fm-side-section + .fm-side-section{margin-top:16px}
.fmb-build-root--duncan :is(.fmb-block-18,.fmb-block-19) .fm-side-label{
  display:block;
  margin-bottom:8px;
  color:#ddcda9;
  font:800 9px/1.2 Arial,sans-serif;
  letter-spacing:.14em;
  text-transform:uppercase;
  text-align:left;
}
.fmb-build-root--duncan :is(.fmb-block-18,.fmb-block-19) .fm-stats-grid{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:6px;
}
.fmb-build-root--duncan :is(.fmb-block-18,.fmb-block-19) .fm-stat{
  padding:7px 5px 6px;
  border:1px solid rgba(255,255,255,.12);
  border-radius:9px;
  background:rgba(255,255,255,.045);
  text-align:center;
}
.fmb-build-root--duncan :is(.fmb-block-18,.fmb-block-19) .fm-stat small{
  display:block;
  color:#b8c6bd;
  font:800 8px/1 Arial,sans-serif;
}
.fmb-build-root--duncan :is(.fmb-block-18,.fmb-block-19) .fm-stat strong{
  display:block;
  margin-top:3px;
  color:#fff;
  font-size:18px;
  line-height:1;
}
.fmb-build-root--duncan :is(.fmb-block-18,.fmb-block-19) .fm-stat span{
  display:block;
  margin-top:3px;
  color:#8fb09d;
  font:700 9px/1 Arial,sans-serif;
}
.fmb-build-root--duncan :is(.fmb-block-18,.fmb-block-19) .fm-panel{
  padding:11px 12px;
  border:1px solid rgba(255,255,255,.11);
  border-radius:11px;
  background:rgba(255,255,255,.04);
}
.fmb-build-root--duncan :is(.fmb-block-18,.fmb-block-19) .fm-row{
  display:flex;
  align-items:flex-start;
  justify-content:space-between;
  gap:10px;
  padding:6px 0;
  border-top:1px solid rgba(255,255,255,.08);
}
.fmb-build-root--duncan :is(.fmb-block-18,.fmb-block-19) .fm-row:first-of-type{border-top:0}
.fmb-build-root--duncan :is(.fmb-block-18,.fmb-block-19) .fm-row small{
  color:#b8c6bd;
  font:700 9px/1.25 Arial,sans-serif;
}
.fmb-build-root--duncan :is(.fmb-block-18,.fmb-block-19) .fm-row strong{
  max-width:92px;
  color:#fff;
  font-size:11px;
  line-height:1.2;
  text-align:right;
}
.fmb-build-root--duncan :is(.fmb-block-18,.fmb-block-19) .fm-resource-mini{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:8px;
}
.fmb-build-root--duncan :is(.fmb-block-18,.fmb-block-19) .fm-resource-mini > div{
  padding:9px 7px;
  border:1px solid rgba(255,255,255,.09);
  border-radius:9px;
  background:rgba(255,255,255,.035);
  text-align:center;
}
.fmb-build-root--duncan :is(.fmb-block-18,.fmb-block-19) .fm-resource-mini small{
  display:block;
  color:#b8c6bd;
  font:700 8px/1.25 Arial,sans-serif;
}
.fmb-build-root--duncan :is(.fmb-block-18,.fmb-block-19) .fm-resource-mini strong{
  display:block;
  margin-top:5px;
  color:#fff;
  font-size:20px;
  line-height:1;
}
.fmb-build-root--duncan :is(.fmb-block-18,.fmb-block-19) .fm-timeline-resume{
  position:relative;
  z-index:1;
  width:2px;
  height:110px;
  margin:0 auto -24px;
  background:linear-gradient(#6b8374,#244a37);
  opacity:.78;
}
@media (max-width:760px){.fmb-build-root--duncan :is(.fmb-block-18,.fmb-block-19) .fm-side-sheet{max-width:420px;margin:18px auto 0}
.fmb-build-root--duncan :is(.fmb-block-18,.fmb-block-19) .fm-timeline-resume{display:none}}


.fmb-build-root--duncan :is(.fmb-block-18,.fmb-block-19) .card,
.fmb-build-root--duncan :is(.fmb-block-18,.fmb-block-19) .core .card{
  background:linear-gradient(145deg,#f9f0e1,#e5d9c5)!important;
  color:#283b2d!important;
  border:1px solid #bb9966!important;
  border-top:4px solid #345941!important;
  box-shadow:0 12px 24px rgba(0,0,0,.13)!important;
  padding:20px!important;
  border-radius:12px!important;
}
.fmb-build-root--duncan :is(.fmb-block-18,.fmb-block-19) .card.primary,
.fmb-build-root--duncan :is(.fmb-block-18,.fmb-block-19) .core .card.primary{
  background:linear-gradient(145deg,#dce9d8,#d3ddce)!important;
  border-top-color:#22583a!important;
}
.fmb-build-root--duncan :is(.fmb-block-18,.fmb-block-19) .card h2{
  color:#163c29!important;
