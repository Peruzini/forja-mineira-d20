.fmb-block-legacy-voldemort-20 .arcana-row em{display:block;margin-top:2px;color:#b8c6bd;font:italic 8px/1.2 Georgia,serif}
.fmb-block-legacy-voldemort-20 .wishlist-panel{border-color:rgba(166,198,178,.26);background:rgba(41,84,61,.18)}
.fmb-block-legacy-voldemort-20 .wishlist-item{padding:10px;border:1px solid rgba(255,255,255,.10);border-radius:10px;background:rgba(255,255,255,.035)}
.fmb-block-legacy-voldemort-20 .wishlist-head{display:flex;justify-content:space-between;align-items:flex-start;gap:8px}
.fmb-block-legacy-voldemort-20 .wishlist-head strong{color:#fff;font-size:12px;line-height:1.25}
.fmb-block-legacy-voldemort-20 .wishlist-head span{flex:0 0 auto;padding:3px 6px;border:1px solid rgba(215,190,130,.35);border-radius:999px;color:#ddcda9;font:800 7px/1 Arial,sans-serif;text-transform:uppercase;letter-spacing:.08em}
.fmb-block-legacy-voldemort-20 .wishlist-item>small{display:block;margin-top:3px;color:#9ab4a4;font:700 8px/1.2 Arial,sans-serif}
.fmb-block-legacy-voldemort-20 .wishlist-item p{margin:8px 0 0;color:#d4ded8;font-size:10px;line-height:1.45}
.fmb-block-legacy-voldemort-20 .wishlist-note{margin-top:9px;padding-top:8px;border-top:1px solid rgba(255,255,255,.08);color:#b9cbc0;font-size:9px;line-height:1.4}
.fmb-block-legacy-voldemort-20 .wishlist-note strong{display:block;margin-bottom:3px;color:#fff;font-size:9px}
.fmb-block-legacy-voldemort-20 .timeline-resume{position:relative;z-index:1;width:2px;height:110px;margin:0 auto -24px;background:linear-gradient(#6b8374,#244a37);opacity:.78}
.fmb-block-legacy-voldemort-20 .content{padding:30px 34px 32px 22px}
.fmb-block-legacy-voldemort-20 .kicker,.fmb-block-legacy-voldemort-20 .mini-label{color:var(--gold);font:800 10px/1.2 Arial,sans-serif;letter-spacing:.14em;text-transform:uppercase}
.fmb-block-legacy-voldemort-20 h1,.fmb-block-legacy-voldemort-20 h2,.fmb-block-legacy-voldemort-20 h3{margin:0;color:var(--ink)}
.fmb-block-legacy-voldemort-20 h1{margin-top:7px;font-size:42px;line-height:1}
.fmb-block-legacy-voldemort-20 .lead{margin:13px 0 0;max-width:1080px;font-size:16px;line-height:1.62}
.fmb-block-legacy-voldemort-20 .strip{margin-top:18px;display:flex;flex-wrap:wrap;gap:8px}
.fmb-block-legacy-voldemort-20 .strip span{padding:8px 11px;border:1px solid var(--line);border-radius:999px;background:#fff;font:700 11px/1 Arial,sans-serif;color:var(--muted)}
.fmb-block-legacy-voldemort-20 .strip strong{color:var(--ink)}
.fmb-block-legacy-voldemort-20 .master-card{margin-top:22px;padding:19px 20px;border:1px solid #91ad9d;border-radius:16px;background:linear-gradient(180deg,#fff,var(--green-soft))}
.fmb-block-legacy-voldemort-20 .master-card h2{margin-top:4px;font-size:27px}
.fmb-block-legacy-voldemort-20 .master-card p{margin:8px 0 0;font-size:14px;line-height:1.58}
.fmb-block-legacy-voldemort-20 .master-grid{display:grid;grid-template-columns:.72fr 1.28fr;gap:12px;margin-top:13px}
.fmb-block-legacy-voldemort-20 .ritual-box{display:flex;flex-direction:column;justify-content:center;align-items:center;padding:16px;border:1px solid #d6c39d;border-radius:12px;background:#faf7ef;text-align:center}
.fmb-block-legacy-voldemort-20 .ritual-box small{color:var(--gold);font:800 9px/1.2 Arial,sans-serif;text-transform:uppercase;letter-spacing:.08em}
.fmb-block-legacy-voldemort-20 .ritual-box strong{display:block;margin-top:5px;color:var(--ink);font-size:35px;line-height:1}
.fmb-block-legacy-voldemort-20 .ritual-box span{display:block;margin-top:5px;color:var(--muted);font-size:11px;line-height:1.35}
.fmb-block-legacy-voldemort-20 .master-explain{padding:14px 15px;border:1px solid #c7d3cb;border-radius:12px;background:#fff}
.fmb-block-legacy-voldemort-20 .master-explain strong{display:block;color:var(--ink);font-size:18px}
.fmb-block-legacy-voldemort-20 .master-explain p{margin:6px 0 0;font-size:13px;line-height:1.52}
.fmb-block-legacy-voldemort-20 .master-highlight{margin-top:10px;padding:10px 12px;border-left:4px solid var(--green);border-radius:9px;background:#f3f7f4;font-size:12px;line-height:1.5}
.fmb-block-legacy-voldemort-20 .section-break{margin-top:20px;padding-top:14px;border-top:1px solid var(--line)}
.fmb-block-legacy-voldemort-20 .section-break span{color:var(--gold);font:800 10px/1.2 Arial,sans-serif;letter-spacing:.14em;text-transform:uppercase}
.fmb-block-legacy-voldemort-20 .final-grid{margin-top:12px;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:9px}
.fmb-block-legacy-voldemort-20 .final-card{padding:14px;border:1px solid var(--line);border-radius:12px;background:#fff}
.fmb-block-legacy-voldemort-20 .final-card small{display:block;color:var(--green);font:800 9px/1.2 Arial,sans-serif;text-transform:uppercase;letter-spacing:.08em}
.fmb-block-legacy-voldemort-20 .final-card strong{display:block;margin-top:4px;color:var(--ink);font-size:16px}
.fmb-block-legacy-voldemort-20 .final-card p{margin:6px 0 0;font-size:12px;line-height:1.48}
.fmb-block-legacy-voldemort-20 .combat{margin-top:18px;padding:16px 17px;border-left:4px solid var(--green);background:#fff}
.fmb-block-legacy-voldemort-20 .combat h2{margin-top:4px;font-size:23px}
.fmb-block-legacy-voldemort-20 .combat p{margin:8px 0 0;font-size:14px;line-height:1.6}
.fmb-block-legacy-voldemort-20 .tactic-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:9px;margin-top:12px}
.fmb-block-legacy-voldemort-20 .tactic{padding:12px;border:1px solid #cad3cd;border-radius:11px;background:var(--silver)}
.fmb-block-legacy-voldemort-20 .tactic small{display:block;color:var(--green);font:800 9px/1.2 Arial,sans-serif;text-transform:uppercase;letter-spacing:.08em}
.fmb-block-legacy-voldemort-20 .tactic strong{display:block;margin-top:4px;color:var(--ink);font-size:14px}
.fmb-block-legacy-voldemort-20 .tactic p{margin:5px 0 0;font-size:12px;line-height:1.45}
.fmb-block-legacy-voldemort-20 .priority{margin-top:11px;padding:10px 12px;border-radius:10px;background:#17261f;color:#edf3ef;font:800 11px/1.45 Arial,sans-serif}
.fmb-block-legacy-voldemort-20 .dark-lord-line{margin-top:11px;padding:11px 13px;border-left:3px solid var(--green);border-radius:9px;background:var(--green-soft);color:#35483e;font-size:13px;line-height:1.52;font-style:italic}
@media (max-width:900px){.fmb-block-legacy-voldemort-20 .master-grid{grid-template-columns:1fr}}
@media (max-width:760px){.fmb-block-legacy-voldemort-20 .preview{width:calc(100% - 20px);margin:10px auto}
.fmb-block-legacy-voldemort-20 .level{grid-template-columns:1fr}
.fmb-block-legacy-voldemort-20 .progress-side{min-height:800px}
.fmb-block-legacy-voldemort-20 .snake-wrap{width:145px;height:195px;min-height:195px;flex-basis:195px;margin:10px auto 6px}
.fmb-block-legacy-voldemort-20 .side-sheet{max-width:420px;margin:8px auto 0}
.fmb-block-legacy-voldemort-20 .timeline-resume{display:none}
.fmb-block-legacy-voldemort-20 .content{padding:24px 20px 26px}
.fmb-block-legacy-voldemort-20 .final-grid,.fmb-block-legacy-voldemort-20 .tactic-grid{grid-template-columns:1fr}
.fmb-block-legacy-voldemort-20 h1{font-size:35px}}
.fmb-block-legacy-voldemort-20 .optional-cap{
  margin-top:12px;
  padding:16px 17px;
  border:1px solid #9fb5a8;
  border-radius:14px;
  background:linear-gradient(180deg,#f8fbf9,#edf5f0);
}
.fmb-block-legacy-voldemort-20 .optional-cap h2{margin-top:4px;font-size:22px}
.fmb-block-legacy-voldemort-20 .optional-cap p{margin:7px 0 0;font-size:13px;line-height:1.58}


/* ==================================================================
   FORJA NAV · PÃO DE QUEIJO D20 — UX DA BUILD 1–20
   ================================================================== */
.fmb-build-root [id^="nivel-"]{scroll-margin-top:96px}
.fmb-build-root .fmb-sr-only{
  position:absolute!important;width:1px!important;height:1px!important;padding:0!important;
  margin:-1px!important;overflow:hidden!important;clip:rect(0,0,0,0)!important;
  white-space:nowrap!important;border:0!important
}
.fmb-nav-shell{
  --fmb-nav-green:#0d3326;
  --fmb-nav-green-2:#174d39;
  --fmb-nav-gold:#c69b4b;
  --fmb-nav-paper:#f7f3e8;
  --fmb-progress:0%;
  position:fixed;
  left:50%;
  bottom:18px;
  width:min(790px,calc(100vw - 150px));
  transform:translateX(-50%) translateY(20px);
  z-index:99990;
  opacity:0;
  pointer-events:none;
  transition:opacity .22s ease,transform .22s ease;
  font-family:Arial,sans-serif;
}
.fmb-nav-shell.is-visible{
  opacity:1;
  transform:translateX(-50%) translateY(0);
  pointer-events:auto;
}
.fmb-journey-dock{
  position:relative;
  display:grid;
  grid-template-columns:minmax(160px,.8fr) minmax(220px,1.4fr) auto;
  align-items:center;
  gap:14px;
  min-height:64px;
  padding:10px 11px 10px 16px;
  border:1px solid rgba(198,155,75,.55);
  border-radius:18px;
  background:linear-gradient(135deg,rgba(7,23,17,.96),rgba(12,49,36,.95));
  color:#fff;
  box-shadow:0 14px 40px rgba(0,0,0,.26);
  backdrop-filter:blur(15px);
}
.fmb-dock-status{min-width:0}
.fmb-dock-phase{
  display:block;
  color:#d7bb83;
  font:800 9px/1.15 Arial,sans-serif;
  letter-spacing:.14em;
  text-transform:uppercase;
  white-space:nowrap;
  overflow:hidden;
  text-overflow:ellipsis;
}
.fmb-dock-level{
  display:block;
  margin-top:3px;
  color:#fff;
  font:800 13px/1.2 Arial,sans-serif;
}
.fmb-progress-wrap{
  position:relative;
  min-width:0;
  height:34px;
  display:flex;
  align-items:center;
}
.fmb-progress-track{
  position:relative;
  width:100%;
  height:7px;
  border:1px solid rgba(255,255,255,.16);
  border-radius:99px;
  background:rgba(255,255,255,.09);
  box-shadow:inset 0 1px 3px rgba(0,0,0,.35);
}
.fmb-progress-fill{
  position:absolute;left:0;top:-1px;bottom:-1px;
  width:var(--fmb-progress);
  border-radius:99px;
  background:linear-gradient(90deg,#a8792d,#d5ba78 35%,#75b98d 72%,#48a86c);
  box-shadow:0 0 12px rgba(72,168,108,.25);
  transition:width .18s linear;
}
.fmb-progress-cheese{
  position:absolute;
  z-index:3;
  top:50%;
  left:var(--fmb-progress);
  width:34px;height:34px;
  transform:translate(-50%,-50%);
  object-fit:contain;
  filter:drop-shadow(0 4px 6px rgba(0,0,0,.36));
  transition:left .18s linear;
  pointer-events:none;
}
.fmb-progress-cheese.is-bouncing{animation:fmb-cheese-bob .48s ease}
@keyframes fmb-cheese-bob{
  0%,100%{transform:translate(-50%,-50%) rotate(0)}
  35%{transform:translate(-50%,-65%) rotate(-8deg)}
  68%{transform:translate(-50%,-52%) rotate(7deg)}
}
.fmb-level-menu-toggle{
  min-height:42px;
  padding:0 14px;
  border:1px solid rgba(207,179,118,.58);
  border-radius:12px;
  background:rgba(255,255,255,.055);
  color:#fff;
  font:800 11px/1 Arial,sans-serif;
  letter-spacing:.04em;
  cursor:pointer;
  transition:background .18s ease,border-color .18s ease,transform .18s ease;
}
.fmb-level-menu-toggle:hover,.fmb-level-menu-toggle:focus-visible{
  background:rgba(120,190,146,.14);
  border-color:#8dbca0;
  outline:none;
}
.fmb-level-menu-toggle:active{transform:translateY(1px)}
.fmb-level-menu{
  position:absolute;
  right:0;
  bottom:74px;
  width:min(430px,calc(100vw - 28px));
  padding:14px;
  border:1px solid rgba(198,155,75,.46);
  border-radius:17px;
  background:linear-gradient(180deg,rgba(8,27,20,.985),rgba(5,19,14,.985));
  color:#fff;
  box-shadow:0 18px 50px rgba(0,0,0,.38);
  transform:translateY(8px) scale(.985);
  transform-origin:bottom right;
  opacity:0;
  visibility:hidden;
  transition:opacity .18s ease,transform .18s ease,visibility .18s;
}
.fmb-level-menu.is-open{opacity:1;visibility:visible;transform:translateY(0) scale(1)}
.fmb-level-menu-head{
  display:flex;align-items:center;justify-content:space-between;gap:12px;
  padding-bottom:10px;border-bottom:1px solid rgba(255,255,255,.10)
}
.fmb-level-menu-head strong{font:800 12px/1.2 Arial,sans-serif}
.fmb-level-menu-close{
  width:30px;height:30px;border:0;border-radius:50%;
  background:rgba(255,255,255,.08);color:#fff;cursor:pointer;font-size:18px;line-height:1
}
.fmb-phase-jumps{
  display:grid;grid-template-columns:repeat(5,1fr);gap:6px;margin-top:11px
}
.fmb-phase-jump{
  padding:8px 4px;border:1px solid rgba(255,255,255,.1);border-radius:9px;
  background:rgba(255,255,255,.035);color:#cbd8d0;text-align:center;cursor:pointer
}
.fmb-phase-jump strong{
  display:block;color:#d9c18d;font:800 10px/1 Arial,sans-serif
}
.fmb-phase-jump span{
  display:block;margin-top:4px;font:700 7px/1.2 Arial,sans-serif;text-transform:uppercase
}
.fmb-phase-jump:hover,.fmb-phase-jump:focus-visible,.fmb-phase-jump.is-current{
  outline:none;border-color:#6fa184;background:rgba(75,141,100,.16);color:#fff
}
.fmb-level-grid{
  display:grid;grid-template-columns:repeat(10,1fr);gap:6px;margin-top:11px
}
.fmb-level-grid button{
  aspect-ratio:1/1;border:1px solid rgba(255,255,255,.10);border-radius:9px;
  background:rgba(255,255,255,.04);color:#d5ded9;cursor:pointer;
  font:800 10px/1 Arial,sans-serif
}
.fmb-level-grid button:hover,.fmb-level-grid button:focus-visible{
  outline:none;border-color:#8dbca0;background:rgba(120,190,146,.13);color:#fff
}
.fmb-level-grid button.is-current{
  border-color:#d0ad67;background:#184f3a;color:#fff;
  box-shadow:0 0 0 1px rgba(208,173,103,.16) inset
}
.fmb-level-menu-tip{
  margin:10px 2px 0;color:#93a79b;font:700 8px/1.45 Arial,sans-serif
}
.fmb-backtop{
  position:fixed;
  right:22px;
  bottom:18px;
  z-index:99991;
  width:68px;height:68px;
  padding:0;
  border:1px solid rgba(198,155,75,.65);
  border-radius:50%;
  background:radial-gradient(circle at 50% 35%,#194a37,#071a13 72%);
  box-shadow:0 12px 30px rgba(0,0,0,.28);
  cursor:pointer;
  opacity:0;
  transform:translateY(14px) scale(.94);
  pointer-events:none;
  transition:opacity .2s ease,transform .2s ease,border-color .2s ease;
}
.fmb-backtop.is-visible{opacity:1;transform:translateY(0) scale(1);pointer-events:auto}
.fmb-backtop:hover,.fmb-backtop:focus-visible{outline:none;border-color:#e0bd76;transform:translateY(-2px) scale(1.03)}
.fmb-backtop img{
  position:absolute;inset:5px;
  width:58px;height:58px;object-fit:contain;
  filter:drop-shadow(0 4px 7px rgba(0,0,0,.35))
}
.fmb-backtop-arrow{
  position:absolute;right:-2px;top:-3px;
  display:grid;place-items:center;
  width:25px;height:25px;border-radius:50%;
  background:#f5efe0;color:#173d2d;
  border:2px solid #a8792d;
  font:900 16px/1 Arial,sans-serif;
  box-shadow:0 3px 8px rgba(0,0,0,.22)
}
.fmb-backtop-label{
  position:absolute;right:76px;top:50%;
  transform:translateY(-50%) translateX(6px);
  width:max-content;max-width:150px;
  padding:7px 9px;border-radius:9px;
  background:#10251c;color:#fff;
  border:1px solid rgba(198,155,75,.38);
  font:800 9px/1.2 Arial,sans-serif;
  opacity:0;visibility:hidden;
  transition:opacity .16s ease,transform .16s ease
}
.fmb-backtop:hover .fmb-backtop-label,.fmb-backtop:focus-visible .fmb-backtop-label{
  opacity:1;visibility:visible;transform:translateY(-50%) translateX(0)
}

/* Previous / next level controls injected at the end of each level */
.fmb-level-stepper{
  width:min(1360px,calc(100% - 48px));
  margin:0 auto 26px;
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:10px;
  font-family:Arial,sans-serif
}
.fmb-level-step{
  min-height:62px;
  display:flex;align-items:center;gap:12px;
  padding:10px 15px;
  border:1px solid #9a7a42;
  border-radius:13px;
  background:linear-gradient(135deg,#10261d,#081711);
  color:#fff!important;
  box-shadow:0 8px 22px rgba(0,0,0,.10);
  transition:transform .16s ease,border-color .16s ease,background .16s ease
}
.fmb-level-step:hover,.fmb-level-step:focus-visible{
  outline:none;transform:translateY(-1px);border-color:#d4b269;background:linear-gradient(135deg,#163426,#0a1f17)
}
.fmb-level-step--next{justify-content:flex-end;text-align:right}
.fmb-level-step-arrow{
  flex:0 0 auto;color:#d7bb83;font-size:25px;line-height:1
}
.fmb-level-step-copy{min-width:0}
.fmb-level-step-copy small{
  display:block;color:#9db0a5;font:800 8px/1.1 Arial,sans-serif;
  letter-spacing:.1em;text-transform:uppercase
}
.fmb-level-step-copy strong{
  display:block;margin-top:4px;color:#fff;
  font:800 12px/1.2 Arial,sans-serif;
  white-space:nowrap;overflow:hidden;text-overflow:ellipsis
}

/* Subtle page-top progress line */
.fmb-scroll-line{
  position:fixed;z-index:99989;left:0;top:0;height:3px;width:100%;
  pointer-events:none;background:transparent
}
.fmb-scroll-line span{
  display:block;height:100%;width:var(--fmb-progress);
  background:linear-gradient(90deg,#a8792d,#d5ba78,#48a86c);
  box-shadow:0 0 8px rgba(72,168,108,.35);
  transition:width .12s linear
}

@media(max-width:900px){
  .fmb-nav-shell{width:min(690px,calc(100vw - 120px))}
  .fmb-journey-dock{grid-template-columns:150px 1fr auto}
}
@media(max-width:700px){
  .fmb-build-root{padding-bottom:92px}
  .fmb-build-root [id^="nivel-"]{scroll-margin-top:76px}
  .fmb-nav-shell{
    left:10px;right:10px;bottom:10px;width:auto;
    transform:translateY(20px)
  }
  .fmb-nav-shell.is-visible{transform:translateY(0)}
  .fmb-journey-dock{
    grid-template-columns:1fr auto;
    gap:8px;
    min-height:62px;
    padding:8px 9px 8px 12px;
    border-radius:16px
  }
  .fmb-dock-status{grid-column:1/2}
  .fmb-progress-wrap{grid-column:1/3;grid-row:2;height:24px}
  .fmb-level-menu-toggle{grid-column:2/3;grid-row:1;min-height:38px;padding:0 11px;font-size:10px}
  .fmb-level-menu{left:0;right:0;bottom:78px;width:100%}
  .fmb-phase-jumps{grid-template-columns:repeat(5,1fr)}
  .fmb-level-grid{grid-template-columns:repeat(5,1fr)}
  .fmb-backtop{right:13px;bottom:93px;width:58px;height:58px}
  .fmb-backtop img{inset:4px;width:50px;height:50px}
  .fmb-backtop-arrow{width:22px;height:22px;font-size:14px}
  .fmb-backtop-label{display:none}
  .fmb-level-stepper{width:calc(100% - 20px);grid-template-columns:1fr;margin-bottom:18px}
  .fmb-level-step--next{justify-content:flex-start;text-align:left}
  .fmb-level-step--next .fmb-level-step-arrow{order:-1}
}
@media(prefers-reduced-motion:reduce){
  .fmb-nav-shell,.fmb-level-menu,.fmb-backtop,.fmb-progress-fill,.fmb-progress-cheese,.fmb-level-step{
    transition:none!important;animation:none!important
  }
}

.fmb-progress-cheese--fallback{
  display:grid!important;place-items:center;color:#d7bb83;font-size:22px;
}
.fmb-backtop-fallback{
  position:absolute;inset:8px;display:grid;place-items:center;
  color:#d7bb83;font-size:30px;
}




/* ==================================================================
   HUB DE BUILDS — vitrine estilo lançamento de personagem
   ================================================================== */
.fmb-hub{
  --hub-ink:#1f1b17;
  --hub-body:#4a433b;
  --hub-muted:#72685d;
  --hub-paper:#f7f3eb;
  --hub-line:#d9cfbf;
  --hub-gold:#a8792d;
  --hub-green:#1f5a42;
  --hub-green-2:#0d2f23;
  position:relative;
  left:50%;
  width:100vw;
  margin-left:-50vw;
  background:#f6f2e9;
  color:var(--hub-body);
  font-family:Georgia,"Times New Roman",serif;
  overflow:hidden;
}
.fmb-hub *{box-sizing:border-box}
.fmb-hub a{text-decoration:none}
.fmb-hub-intro{
  width:min(1320px,calc(100% - 48px));
  margin:0 auto;
  padding:52px 0 24px;
}
.fmb-hub-eyebrow{
  display:block;
  color:var(--hub-gold);
  font:800 11px/1.2 Arial,sans-serif;
  letter-spacing:.16em;
  text-transform:uppercase;
}
.fmb-hub-intro h1{
  margin:8px 0 0;
  color:var(--hub-ink);
  font-size:clamp(38px,5vw,72px);
  line-height:.96;
  letter-spacing:-.035em;
}
.fmb-hub-intro p{
  max-width:760px;
  margin:16px 0 0;
  color:var(--hub-muted);
  font-size:17px;
  line-height:1.65;
}

.fmb-featured-build{
  position:relative;
  width:min(1440px,calc(100% - 32px));
  min-height:650px;
  margin:0 auto;
  border:1px solid rgba(192,159,99,.55);
  border-radius:26px;
  overflow:hidden;
  background:#081510;
  color:#fff;
  box-shadow:0 26px 70px rgba(27,20,12,.18);
}
.fmb-featured-bg{
  position:absolute;inset:0;
  width:100%;height:100%;
  object-fit:cover;
  object-position:center center;
}
.fmb-featured-shade{
  position:absolute;inset:0;
  background:
    linear-gradient(90deg,rgba(4,13,9,.97) 0%,rgba(5,18,12,.90) 28%,rgba(5,18,12,.56) 51%,rgba(5,18,12,.12) 76%,rgba(5,18,12,.06) 100%),
    linear-gradient(0deg,rgba(3,10,7,.48),transparent 55%);
}
.fmb-featured-content{
  position:relative;z-index:2;
  width:min(650px,56%);
  min-height:650px;
  display:flex;
  flex-direction:column;
  justify-content:center;
  padding:56px 60px;
}
.fmb-featured-label{
  display:inline-flex;
  align-items:center;
  gap:8px;
  width:max-content;
  padding:7px 10px;
  border:1px solid rgba(221,199,153,.26);
  border-radius:999px;
  background:rgba(255,255,255,.055);
  color:#e1c98e;
  font:800 9px/1 Arial,sans-serif;
  letter-spacing:.12em;
}
.fmb-live-dot{
  width:7px;height:7px;border-radius:50%;
  background:#63b982;
  box-shadow:0 0 0 4px rgba(99,185,130,.13);
}
.fmb-featured-kicker{
  margin-top:22px;
  color:#a7c3b0;
  font:800 10px/1.2 Arial,sans-serif;
  letter-spacing:.14em;
}
.fmb-featured-content h2{
  margin:8px 0 0;
  color:#f4efe5;
  font-size:clamp(54px,7vw,102px);
  line-height:.84;
  letter-spacing:-.055em;
  text-shadow:0 6px 24px rgba(0,0,0,.22);
}
.fmb-featured-sub{
  margin:14px 0 0;
  color:#d6bc7e;
  font-size:23px;
  font-style:italic;
}
.fmb-featured-copy{
  max-width:610px;
  margin:18px 0 0;
  color:#dbe5de;
  font-size:15px;
  line-height:1.65;
}
.fmb-featured-tags{
  display:flex;flex-wrap:wrap;gap:7px;
  margin-top:18px;
}
.fmb-featured-tags span{
  padding:7px 9px;
  border:1px solid rgba(255,255,255,.14);
  border-radius:999px;
  background:rgba(255,255,255,.055);
  color:#d9e1dc;
  font:700 9px/1 Arial,sans-serif;
}
.fmb-featured-actions{
  display:flex;flex-wrap:wrap;gap:10px;
  margin-top:26px;
}
.fmb-hub-btn{
  display:inline-flex;align-items:center;justify-content:center;gap:12px;
  min-height:46px;padding:0 18px;border-radius:11px;
  font:800 11px/1 Arial,sans-serif;
  transition:transform .16s ease,box-shadow .16s ease,background .16s ease;
}
.fmb-hub-btn:hover,.fmb-hub-btn:focus-visible{transform:translateY(-2px);outline:none}
.fmb-hub-btn--primary{
  background:#f2ead9;color:#173628!important;
  border:1px solid #e5d4ad;
  box-shadow:0 7px 22px rgba(0,0,0,.18);
}
.fmb-hub-btn--ghost{
  border:1px solid rgba(255,255,255,.22);
  background:rgba(255,255,255,.045);
  color:#fff!important;
}
.fmb-featured-side{
  position:absolute;z-index:3;
  right:22px;top:22px;
  display:grid;place-items:center;
  width:110px;height:110px;
  border:1px solid rgba(220,194,139,.35);
  border-radius:50%;
  background:rgba(7,23,17,.82);
  backdrop-filter:blur(10px);
  color:#fff;
  text-align:center;
}
.fmb-featured-side span,.fmb-featured-side small{
  font:800 7px/1 Arial,sans-serif;
  color:#d6bc7e;
  letter-spacing:.1em;
}
.fmb-featured-side strong{
  margin:-5px 0;
  font-size:34px;
  line-height:1;
}

.fmb-build-catalog{
  width:min(1320px,calc(100% - 48px));
  margin:72px auto 0;
  padding-bottom:64px;
}
.fmb-catalog-head{
  display:grid;
  grid-template-columns:minmax(0,.75fr) minmax(320px,1fr);
  gap:40px;
  align-items:end;
  padding-bottom:22px;
  border-bottom:1px solid var(--hub-line);
}
.fmb-catalog-head h2{
  margin:6px 0 0;
  color:var(--hub-ink);
  font-size:42px;
  line-height:1;
}
.fmb-catalog-head p{
  margin:0;
  color:var(--hub-muted);
  font-size:14px;
  line-height:1.6;
}
.fmb-build-grid{
  display:grid;
  grid-template-columns:minmax(0,1fr) minmax(300px,.46fr);
  gap:18px;
  margin-top:24px;
}
.fmb-build-card{
  min-width:0;
  border:1px solid var(--hub-line);
  border-radius:18px;
  overflow:hidden;
  background:#fff;
  box-shadow:0 10px 28px rgba(41,31,19,.06);
}
.fmb-build-card-link{
  display:grid;
  grid-template-columns:42% minmax(0,58%);
  min-height:390px;
  color:inherit!important;
}
.fmb-build-card-art{position:relative;overflow:hidden;background:#0a1611}
.fmb-build-card-art img{
  display:block;width:100%;height:100%;
  object-fit:cover;object-position:center 18%;
  transition:transform .35s ease;
}
.fmb-build-card:hover .fmb-build-card-art img{transform:scale(1.035)}
.fmb-card-badge{
  position:absolute;left:14px;top:14px;
  padding:6px 8px;border-radius:999px;
  background:rgba(9,38,27,.88);
  color:#e3c98c;
  border:1px solid rgba(227,201,140,.32);
  font:800 8px/1 Arial,sans-serif;
  letter-spacing:.1em;
}
.fmb-build-card-body{
  display:flex;flex-direction:column;justify-content:center;
  padding:30px 34px;
}
.fmb-build-card-meta{
  color:var(--hub-gold);
  font:800 9px/1.2 Arial,sans-serif;
  letter-spacing:.13em;
}
.fmb-build-card-body h3{
  margin:7px 0 0;color:var(--hub-ink);
  font-size:37px;line-height:1;
}
.fmb-build-card-body p{
  margin:11px 0 0;color:var(--hub-muted);
  font-size:14px;line-height:1.58;
}
.fmb-card-tags{
  display:flex;flex-wrap:wrap;gap:6px;
  margin-top:16px;
}
.fmb-card-tags span{
  padding:6px 8px;
  border:1px solid #d8ded9;
  border-radius:999px;
  background:#f3f7f4;
  color:#315443;
  font:700 8px/1 Arial,sans-serif;
}
.fmb-card-cta{
  margin-top:22px;
  color:#254f3b;
  font:800 10px/1 Arial,sans-serif;
}
.fmb-build-card--future{
  display:grid;place-items:center;
  min-height:390px;
  background:
    linear-gradient(135deg,rgba(17,48,35,.98),rgba(7,23,17,.98));
  border-color:#476452;
  color:#fff;
}
.fmb-future-inner{
  max-width:300px;
  padding:28px;
  text-align:center;
}
.fmb-future-inner img{
  width:92px;height:92px;object-fit:contain;
  filter:drop-shadow(0 10px 18px rgba(0,0,0,.3));
}
.fmb-future-inner>span{
  display:block;margin-top:14px;color:#d6bc7e;
  font:800 9px/1.2 Arial,sans-serif;letter-spacing:.14em
}
.fmb-future-inner h3{
  margin:8px 0 0;color:#fff;font-size:26px;line-height:1.05
}
.fmb-future-inner p{
  margin:10px 0 0;color:#b9c9bf;font-size:12px;line-height:1.55
}
.fmb-hub-future{
  width:min(1320px,calc(100% - 48px));
  margin:0 auto 70px;
  padding:22px 0 0;
  border-top:1px solid var(--hub-line);
}
.fmb-hub-future-copy{
  max-width:790px;
  padding:26px 0;
}
.fmb-hub-future h2{
  margin:6px 0 0;color:var(--hub-ink);font-size:30px
}
.fmb-hub-future p{
  margin:10px 0 0;color:var(--hub-muted);font-size:14px;line-height:1.62
}

@media(max-width:900px){
  .fmb-featured-build{min-height:610px}
  .fmb-featured-content{width:72%;min-height:610px;padding:46px 38px}
  .fmb-featured-shade{
    background:
      linear-gradient(90deg,rgba(4,13,9,.96),rgba(5,18,12,.78) 48%,rgba(5,18,12,.22)),
      linear-gradient(0deg,rgba(3,10,7,.48),transparent 55%)
  }
  .fmb-catalog-head{grid-template-columns:1fr;gap:14px}
  .fmb-build-grid{grid-template-columns:1fr}
  .fmb-build-card--future{min-height:280px}
}
@media(max-width:680px){
  .fmb-hub-intro,.fmb-build-catalog,.fmb-hub-future{width:calc(100% - 24px)}
  .fmb-hub-intro{padding-top:34px}
  .fmb-featured-build{
    width:calc(100% - 16px);
    min-height:660px;border-radius:18px
  }
  .fmb-featured-bg{object-position:67% center}
  .fmb-featured-shade{
    background:
      linear-gradient(0deg,rgba(4,13,9,.98) 0%,rgba(4,13,9,.89) 54%,rgba(4,13,9,.18) 100%)
  }
  .fmb-featured-content{
    width:100%;min-height:660px;
    justify-content:flex-end;
    padding:30px 24px 34px
  }
  .fmb-featured-content h2{font-size:58px}
  .fmb-featured-side{width:82px;height:82px;right:12px;top:12px}
  .fmb-featured-side strong{font-size:27px}
  .fmb-build-catalog{margin-top:50px}
  .fmb-build-card-link{grid-template-columns:1fr;min-height:auto}
  .fmb-build-card-art{height:300px}
  .fmb-build-card-body{padding:24px 22px}
  .fmb-catalog-head h2{font-size:34px}
}


/* Featured Build v2.2.2 — arte de progressão em cinco fases */
.fmb-featured-build--progression{
  min-height:0;
  overflow:hidden;
  background:#07130e;
}
.fmb-featured-art-wrap{
  position:relative;
  overflow:hidden;
  background:#07130e;
  border-bottom:1px solid rgba(198,155,75,.35);
}
.fmb-featured-art-link{
  display:block;
  color:inherit;
  text-decoration:none!important;
  cursor:pointer;
}
.fmb-featured-art-link .fmb-featured-art-full{
  transition:transform .28s ease,filter .28s ease;
}
@media (hover:hover) and (pointer:fine){
  .fmb-featured-art-link:hover .fmb-featured-art-full{
    transform:scale(1.012);
    filter:brightness(1.06);
  }
}
.fmb-featured-art-link:focus-visible{
  outline:3px solid #d6b66c;
  outline-offset:-3px;
}
.fmb-featured-art-full{
  display:block;
  width:100%;
  height:auto;
  aspect-ratio:2.5/1;
  object-fit:cover;
  object-position:center center;
}
.fmb-featured-art-glow{
  position:absolute;
  inset:0;
  pointer-events:none;
  background:
    linear-gradient(180deg,rgba(4,12,8,.06) 0%,rgba(4,12,8,0) 58%,rgba(4,12,8,.34) 100%),
    linear-gradient(90deg,rgba(4,12,8,.08),transparent 12%,transparent 88%,rgba(4,12,8,.08));
}
.fmb-featured-topline{
  position:absolute;
  inset:18px 18px auto 18px;
  z-index:3;
  display:flex;
  align-items:flex-start;
  justify-content:space-between;
  gap:16px;
}
.fmb-featured-counter{
  display:flex;
  align-items:center;
  gap:9px;
  padding:7px 10px;
  border:1px solid rgba(221,199,153,.28);
  border-radius:999px;
  background:rgba(6,22,15,.78);
  color:#fff;
  backdrop-filter:blur(9px);
}
.fmb-featured-counter span{
  color:#d7bd83;
  font:800 8px/1 Arial,sans-serif;
  letter-spacing:.1em;
}
.fmb-featured-counter strong{
  color:#fff;
  font:800 12px/1 Arial,sans-serif;
}
.fmb-featured-footer{
  position:relative;
  z-index:2;
  display:grid;
  grid-template-columns:minmax(0,1fr) auto;
  gap:28px;
  align-items:end;
  padding:26px 30px 28px;
  background:
    linear-gradient(135deg,rgba(11,35,25,.99),rgba(5,20,14,.99));
}
.fmb-featured-footer-copy{min-width:0}
.fmb-featured-footer h2{
  margin:6px 0 0;
  color:#f4efe5;
  font-size:38px;
  line-height:.95;
  letter-spacing:-.025em;
}
.fmb-featured-footer .fmb-featured-sub{
  margin-top:8px;
  font-size:18px;
}
.fmb-featured-footer .fmb-featured-copy{
  max-width:800px;
  margin-top:10px;
}
.fmb-featured-actions--footer{
  margin-top:0;
  justify-content:flex-end;
}
@media(max-width:900px){
  .fmb-featured-art-full{aspect-ratio:2.05/1}
  .fmb-featured-footer{grid-template-columns:1fr}
  .fmb-featured-actions--footer{justify-content:flex-start}
}
@media(max-width:680px){
  .fmb-featured-art-full{
    aspect-ratio:1.35/1;
    object-fit:cover;
    object-position:center top;
  }
  .fmb-featured-topline{inset:10px 10px auto 10px}
  .fmb-featured-footer{padding:22px 20px 24px}
  .fmb-featured-footer h2{font-size:34px}
}



/* ===== HOME · ÚLTIMO DA FORJA ===== */
.fmb-home-featured,
.fmb-home-featured *{box-sizing:border-box}
.fmb-home-featured{
  position:relative;
  left:50%;
  width:100vw;
  margin-left:-50vw;
  padding:64px 0 70px;
  background:#f7f3ea;
  color:#241f1a;
  font-family:Georgia,"Times New Roman",serif;
  border-top:1px solid #e6dccd;
  border-bottom:1px solid #e6dccd;
}
.fmb-home-featured-shell{
  width:min(1460px,calc(100% - 56px));
  margin:0 auto;
}
.fmb-home-featured-head{
  display:flex;
  align-items:end;
  justify-content:space-between;
  gap:28px;
  margin-bottom:24px;
}
.fmb-home-featured-eyebrow{
  display:block;
  margin-bottom:10px;
  color:#a96708;
  font:800 11px/1.2 Arial,sans-serif;
  letter-spacing:.17em;
  text-transform:uppercase;
}
.fmb-home-featured-head h2{
  margin:0;
  max-width:900px;
  color:#211c18;
  font-size:clamp(38px,4.4vw,68px);
  line-height:.98;
  letter-spacing:-.035em;
}
.fmb-home-featured-all{
  flex:0 0 auto;
  padding-bottom:5px;
  color:#2b261f;
  border-bottom:1px solid #b78b42;
  font:800 12px/1.2 Arial,sans-serif;
  letter-spacing:.03em;
  text-decoration:none;
}
.fmb-home-featured-card{
  display:grid;
  grid-template-columns:minmax(0,1.72fr) minmax(330px,.68fr);
  overflow:hidden;
  border:1px solid #b79864;
  border-radius:28px;
  background:#0a1711;
  box-shadow:0 24px 60px rgba(38,29,17,.10);
}
.fmb-home-featured-art{
  position:relative;
  display:block;
  min-height:460px;
  overflow:hidden;
  background:#06140e;
}
.fmb-home-featured-art img{
  display:block;
  width:100%;
  height:100%;
  min-height:460px;
  object-fit:cover;
  object-position:center;
  transition:transform .45s ease;
}
.fmb-home-featured-art:hover img{transform:scale(1.018)}
.fmb-home-featured-art:after{
  content:"";
  position:absolute;
  inset:0;
  background:linear-gradient(90deg,transparent 74%,rgba(6,20,14,.72) 100%),
             linear-gradient(0deg,rgba(4,14,10,.18),transparent 35%);
  pointer-events:none;
}
.fmb-home-featured-badge{
  position:absolute;
  z-index:2;
  left:20px;
  top:20px;
  padding:9px 12px;
  border:1px solid rgba(228,197,137,.55);
  border-radius:999px;
  background:rgba(4,18,12,.78);
  color:#e8c47d;
  backdrop-filter:blur(8px);
  font:900 9px/1 Arial,sans-serif;
  letter-spacing:.15em;
  text-transform:uppercase;
}
.fmb-home-featured-copy{
  position:relative;
  display:flex;
  flex-direction:column;
  justify-content:center;
  padding:38px 34px;
  background:
    radial-gradient(circle at 85% 16%,rgba(32,104,70,.18),transparent 34%),
    linear-gradient(160deg,#0b1e16,#07130e);
  color:#eee8dc;
}
.fmb-home-featured-copy:before{
  content:"";
  position:absolute;
  left:0;
  top:32px;
  bottom:32px;
  width:1px;
  background:linear-gradient(transparent,#c49a54,transparent);
}
.fmb-home-featured-meta{
  color:#c6a467;
  font:800 10px/1.4 Arial,sans-serif;
  letter-spacing:.12em;
  text-transform:uppercase;
}
.fmb-home-featured-copy h3{
  margin:13px 0 0;
  color:#fffaf0;
  font-size:clamp(30px,3vw,46px);
  line-height:1.02;
  letter-spacing:-.02em;
}
.fmb-home-featured-copy p{
  margin:18px 0 0;
  color:#cbc5b9;
  font:400 16px/1.65 Arial,sans-serif;
}
.fmb-home-featured-tags{
  display:flex;
  flex-wrap:wrap;
  gap:7px;
  margin-top:20px;
}
.fmb-home-featured-tags span{
  padding:7px 9px;
  border:1px solid rgba(216,193,148,.25);
  border-radius:999px;
  color:#ded5c4;
  background:rgba(255,255,255,.035);
  font:700 10px/1 Arial,sans-serif;
}
.fmb-home-featured-actions{
  display:flex;
  flex-wrap:wrap;
  gap:9px;
  margin-top:26px;
}
.fmb-home-featured-btn{
  display:inline-flex;
  min-height:46px;
  align-items:center;
  justify-content:center;
  padding:0 16px;
  border-radius:10px;
  font:800 11px/1 Arial,sans-serif;
  letter-spacing:.04em;
  text-decoration:none!important;
}
.fmb-home-featured-btn--primary{
  background:#a96508;
  border:1px solid #b87512;
  color:#fff!important;
}
.fmb-home-featured-btn--ghost{
  background:transparent;
  border:1px solid rgba(228,205,163,.36);
  color:#eee8dc!important;
}
@media(max-width:1050px){
  .fmb-home-featured-card{grid-template-columns:1fr}
  .fmb-home-featured-art{min-height:360px}
  .fmb-home-featured-art img{min-height:360px}
  .fmb-home-featured-art:after{background:linear-gradient(0deg,rgba(6,20,14,.6),transparent 26%)}
  .fmb-home-featured-copy:before{display:none}
}
@media(max-width:700px){
  .fmb-home-featured{padding:42px 0 48px}
  .fmb-home-featured-shell{width:min(100% - 28px,680px)}
  .fmb-home-featured-head{display:block}
  .fmb-home-featured-all{display:inline-block;margin-top:18px}
  .fmb-home-featured-card{border-radius:20px}
  .fmb-home-featured-art{min-height:300px}
  .fmb-home-featured-art img{min-height:300px;object-position:center top}
  .fmb-home-featured-copy{padding:28px 22px 30px}
  .fmb-home-featured-actions{display:grid;grid-template-columns:1fr}
}


/* HOME v2.3.1 — mascote e resiliência de mídia */
.fmb-home-featured-art img,
.fmb-home-featured-mascot img{
  visibility:visible!important;
  opacity:1!important;
}
.fmb-home-featured-mascot{
  display:flex;
  align-items:center;
  gap:12px;
  margin-top:24px;
  padding-top:20px;
  border-top:1px solid rgba(228,205,163,.18);
}
.fmb-home-featured-mascot img{
  flex:0 0 58px;
  width:58px;
  height:58px;
  object-fit:contain;
  filter:drop-shadow(0 7px 14px rgba(0,0,0,.24));
}
.fmb-home-featured-mascot div{
  display:grid;
  gap:4px;
}
.fmb-home-featured-mascot strong{
  color:#e8c47d;
  font:800 11px/1.2 Arial,sans-serif;
  letter-spacing:.04em;
}
.fmb-home-featured-mascot span{
  color:#bdb5a7;
  font:400 12px/1.35 Arial,sans-serif;
}
@media(max-width:700px){
  .fmb-home-featured-mascot img{
    flex-basis:52px;
    width:52px;
    height:52px;
  }
}


/* ===== HOME HERO · NA FORJA AGORA ===== */
.fmb-home-hero,
.fmb-home-hero *{box-sizing:border-box}
.fmb-home-hero{
  position:relative;
  left:50%;
  width:100vw;
  margin-left:-50vw;
  padding:62px 0 58px;
  background:#f8f5ee;
  color:#211c18;
  border-bottom:1px solid #e8ddcc;
}
.fmb-home-hero-shell{
  width:min(1460px,calc(100% - 56px));
  margin:0 auto;
  display:grid;
  grid-template-columns:minmax(0,1.12fr) minmax(420px,.88fr);
  gap:56px;
  align-items:center;
}
.fmb-home-hero-copy{min-width:0}
.fmb-home-hero-eyebrow{
  display:block;
  margin-bottom:18px;
  color:#a96708;
  font:900 11px/1.2 Arial,sans-serif;
  letter-spacing:.18em;
  text-transform:uppercase;
}
.fmb-home-hero h1{
  margin:0;
  max-width:790px;
  color:#211c18;
  font:700 clamp(54px,5.3vw,84px)/.98 Georgia,"Times New Roman",serif;
  letter-spacing:-.045em;
}
.fmb-home-hero-copy p{
  max-width:760px;
  margin:24px 0 0;
  color:#62594f;
  font:400 19px/1.55 Arial,sans-serif;
}
.fmb-home-hero-actions{
  display:flex;
  flex-wrap:wrap;
  gap:12px;
  margin-top:28px;
}
.fmb-home-hero-btn{
  display:inline-flex;
  min-height:52px;
  align-items:center;
  justify-content:center;
  padding:0 22px;
  border-radius:10px;
  font:800 13px/1 Arial,sans-serif;
  text-decoration:none!important;
}
.fmb-home-hero-btn--primary{
  color:#fff!important;
  background:#aa6708;
  border:1px solid #aa6708;
}
.fmb-home-hero-btn--ghost{
  color:#211c18!important;
  background:#fffaf2;
  border:1px solid #d9c8ae;
}

.fmb-forja-now{
  position:relative;
  overflow:hidden;
  padding:22px 22px 16px;
  border:1px solid rgba(192,142,62,.72);
  border-radius:22px;
  background:
    radial-gradient(circle at 28% 48%,rgba(143,78,23,.17),transparent 38%),
    linear-gradient(145deg,#20140d 0%,#160e09 58%,#120b08 100%);
  color:#f4ede2;
  box-shadow:0 24px 58px rgba(42,27,12,.16);
}
.fmb-forja-now-title{
  display:flex;
  align-items:center;
  gap:10px;
  min-height:34px;
  padding-bottom:13px;
  border-bottom:1px solid rgba(220,180,108,.16);
  color:#e4bf77;
  font:900 18px/1 Georgia,"Times New Roman",serif;
  letter-spacing:.035em;
}
.fmb-forja-now-title > span{
  font-size:18px;
  line-height:1;
}
.fmb-forja-now-body{
  display:grid;
  grid-template-columns:minmax(150px,.85fr) minmax(250px,1.15fr);
  gap:16px;
  align-items:center;
  padding:10px 0 6px;
}
.fmb-forja-now-art{
  position:relative;
  align-self:stretch;
  display:flex;
  align-items:center;
  justify-content:center;
  min-height:320px;
  overflow:hidden;
}
.fmb-forja-now-art:after{
  content:"";
  position:absolute;
  left:12%;
  right:12%;
  bottom:14px;
  height:18px;
  border-radius:50%;
  background:rgba(203,136,55,.20);
  filter:blur(13px);
  pointer-events:none;
}
.fmb-forja-now-art img{
  position:relative;
  z-index:1;
  display:block;
  width:100%;
  max-width:285px;
  height:auto;
  object-fit:contain;
  mix-blend-mode:screen;
  filter:drop-shadow(0 12px 22px rgba(0,0,0,.34));
}
.fmb-forja-now-list{
  display:grid;
}
.fmb-forja-now-item{
  display:grid;
  grid-template-columns:38px 1fr;
  gap:11px;
  align-items:start;
  padding:16px 0;
  border-bottom:1px solid rgba(220,180,108,.14);
  color:#f3ecdf;
  text-decoration:none!important;
}
.fmb-forja-now-item:last-child{border-bottom:0}
.fmb-forja-now-item--live{
  border-radius:10px;
  transition:background .18s ease,transform .18s ease;
}
.fmb-forja-now-item--live:hover{
  background:rgba(255,255,255,.025);
  transform:translateX(2px);
}
.fmb-forja-now-icon{
  display:grid;
  place-items:center;
  width:34px;
  height:34px;
  border-radius:50%;
  background:#241811;
  border:1px solid rgba(222,189,129,.12);
  color:#d8c39a;
  font:800 17px/1 Arial,sans-serif;
}
.fmb-forja-now-icon--green{
  color:#53b978;
  background:#0b2519;
}
.fmb-forja-now-item-copy{
  display:grid;
  gap:4px;
  min-width:0;
}
.fmb-forja-now-status{
  justify-self:start;
  padding:6px 8px 5px;
  border-radius:6px;
  background:#c99b3f;
  color:#20130b;
  font:900 9px/1 Arial,sans-serif;
  letter-spacing:.04em;
}
.fmb-forja-now-status--green{
  background:#49ae6d;
  color:#082114;
}
.fmb-forja-now-item strong{
  color:#fff7eb;
  font:700 16px/1.22 Georgia,"Times New Roman",serif;
}
.fmb-forja-now-item small{
  color:#c0b4a3;
  font:400 11px/1.35 Arial,sans-serif;
}
.fmb-forja-now-link{
  margin-top:3px;
  color:#e7dbc8;
  font:700 11px/1.2 Arial,sans-serif;
  text-decoration:underline;
  text-underline-offset:3px;
}
.fmb-forja-now-footer{
  padding-top:13px;
  border-top:1px solid rgba(220,180,108,.16);
  color:#d6c9b7;
  text-align:center;
  font:italic 15px/1.2 Georgia,"Times New Roman",serif;
}

@media(max-width:1020px){
  .fmb-home-hero-shell{
    grid-template-columns:1fr;
    gap:36px;
  }
  .fmb-forja-now{max-width:760px}
}
@media(max-width:700px){
  .fmb-home-hero{padding:44px 0 42px}
  .fmb-home-hero-shell{width:min(100% - 28px,680px)}
  .fmb-home-hero h1{font-size:clamp(46px,14vw,64px)}
  .fmb-home-hero-copy p{font-size:17px}
  .fmb-home-hero-actions{display:grid;grid-template-columns:1fr}
  .fmb-forja-now{padding:22px 20px;border-radius:20px}
  .fmb-forja-now-head{grid-template-columns:1fr 68px}
  .fmb-forja-now-head img{width:68px;height:68px}
}


/* ===== HOME · PRÓXIMA BUILD / TEASER ===== */
.fmb-next-build,
.fmb-next-build *{box-sizing:border-box}
.fmb-next-build{
  position:relative;
  left:50%;
  width:100vw;
  margin-left:-50vw;
  padding:68px 0 74px;
  background:#f8f5ee;
  color:#211c18;
}
.fmb-next-build-shell{
  width:min(1460px,calc(100% - 56px));
  margin:0 auto;
}
.fmb-next-build-card{
  display:grid;
  grid-template-columns:minmax(0,1.02fr) minmax(470px,.98fr);
  overflow:hidden;
  border:1px solid #7d6748;
  border-radius:28px;
  background:#07130e;
  box-shadow:0 28px 70px rgba(29,22,14,.12);
}
.fmb-next-build-visual{
  position:relative;
  min-height:620px;
  overflow:hidden;
  background:#05100c;
}
.fmb-next-build-visual img{
  display:block;
  width:100%;
  height:100%;
  min-height:620px;
  object-fit:cover;
  object-position:center;
}
.fmb-next-build-visual-shade{
  position:absolute;
  inset:0;
  background:
    linear-gradient(90deg,rgba(2,9,6,.02) 42%,rgba(3,12,8,.78) 100%),
    linear-gradient(0deg,rgba(2,9,6,.45),transparent 32%);
  pointer-events:none;
}
.fmb-next-build-stamp{
  position:absolute;
  left:22px;
  top:22px;
  display:inline-grid;
  gap:4px;
  padding:10px 13px;
  border:1px solid rgba(226,191,124,.45);
  border-radius:12px;
  background:rgba(4,17,12,.78);
  backdrop-filter:blur(9px);
}
.fmb-next-build-stamp span{
  color:#deb76d;
  font:900 9px/1 Arial,sans-serif;
  letter-spacing:.14em;
}
.fmb-next-build-stamp strong{
  color:#fff7e8;
  font:800 11px/1.2 Arial,sans-serif;
  letter-spacing:.04em;
}
.fmb-next-build-content{
  position:relative;
  padding:42px 38px 34px;
  background:
    radial-gradient(circle at 100% 0%,rgba(38,112,73,.22),transparent 34%),
    linear-gradient(155deg,#0a1d15,#06110d 75%);
  color:#eee7da;
}
.fmb-next-build-content:before{
  content:"";
  position:absolute;
  left:0;
  top:42px;
  bottom:42px;
  width:1px;
  background:linear-gradient(transparent,#b9934e,transparent);
}
.fmb-next-build-eyebrow{
  display:block;
  color:#c8a25d;
  font:900 10px/1.2 Arial,sans-serif;
  letter-spacing:.17em;
}
.fmb-next-build-copy h2{
  margin:12px 0 0;
  max-width:580px;
  color:#fffaf0;
  font:700 clamp(40px,3.9vw,62px)/.98 Georgia,"Times New Roman",serif;
  letter-spacing:-.035em;
}
.fmb-next-build-copy p{
  max-width:640px;
  margin:18px 0 0;
  color:#c9c0b2;
  font:400 16px/1.6 Arial,sans-serif;
}
.fmb-next-build-hints{
  display:grid;
  gap:0;
  margin-top:30px;
  border-top:1px solid rgba(217,190,139,.18);
}
.fmb-next-build-hint{
  display:grid;
  grid-template-columns:46px 1fr;
  gap:13px;
  align-items:center;
  padding:15px 0;
  border-bottom:1px solid rgba(217,190,139,.14);
}
.fmb-next-build-hint > span{
  display:grid;
  place-items:center;
  width:38px;
  height:38px;
  border:1px solid rgba(205,166,92,.38);
  border-radius:50%;
  color:#d3ad65;
  background:rgba(255,255,255,.03);
  font:900 10px/1 Arial,sans-serif;
}
.fmb-next-build-hint div{
  display:grid;
  gap:4px;
}
.fmb-next-build-hint small{
  color:#9c7d46;
  font:900 8px/1 Arial,sans-serif;
  letter-spacing:.17em;
}
.fmb-next-build-hint strong{
  color:#ece5d8;
  font:600 14px/1.4 Arial,sans-serif;
}
.fmb-next-build-footer{
  display:flex;
  flex-wrap:wrap;
  align-items:center;
  gap:8px 10px;
  margin-top:24px;
  padding-top:18px;
  color:#9f9688;
  border-top:1px solid rgba(217,190,139,.14);
  font:600 11px/1.35 Arial,sans-serif;
}
.fmb-next-build-footer strong{
  color:#d5b06a;
  letter-spacing:.08em;
}
.fmb-next-build-status-dot{
  width:8px;
  height:8px;
  border-radius:50%;
  background:#3e9d6b;
  box-shadow:0 0 0 4px rgba(62,157,107,.12);
}
@media(max-width:1040px){
  .fmb-next-build-card{grid-template-columns:1fr}
  .fmb-next-build-visual{min-height:430px}
  .fmb-next-build-visual img{min-height:430px}
  .fmb-next-build-content:before{display:none}
}
@media(max-width:700px){
  .fmb-next-build{padding:46px 0 50px}
  .fmb-next-build-shell{width:min(100% - 28px,680px)}
  .fmb-next-build-card{border-radius:20px}
  .fmb-next-build-visual{min-height:350px}
  .fmb-next-build-visual img{min-height:350px}
  .fmb-next-build-content{padding:30px 22px 26px}
  .fmb-next-build-copy h2{font-size:clamp(38px,12vw,54px)}
  .fmb-next-build-hint{grid-template-columns:40px 1fr}
}

@media(max-width:1180px){
  .fmb-forja-now-body{
    grid-template-columns:180px 1fr;
  }
  .fmb-forja-now-art{
    min-height:280px;
  }
}
@media(max-width:700px){
  .fmb-forja-now{
    padding:18px 16px 14px;
  }
  .fmb-forja-now-body{
    grid-template-columns:1fr;
  }
  .fmb-forja-now-art{
    min-height:220px;
  }
  .fmb-forja-now-art img{
    max-width:230px;
  }
  .fmb-forja-now-title{
    font-size:17px;
  }
}


/* ===== HOME v2.3.6 · CALOR + ÍCONES PADRONIZADOS ===== */
.fmb-forja-now{
  isolation:isolate;
}
.fmb-forja-now-body{
  grid-template-columns:minmax(190px,.9fr) minmax(325px,1.28fr) !important;
  gap:20px !important;
}
.fmb-forja-now-art{
  position:relative;
  min-height:340px !important;
  overflow:visible !important;
  isolation:isolate;
}
.fmb-forja-now-art:before{
  content:"";
  position:absolute;
  z-index:0;
  left:50%;
  top:50%;
  width:118%;
  height:112%;
  transform:translate(-50%,-48%);
  background:
    radial-gradient(circle at 50% 65%,rgba(232,136,38,.30) 0%,rgba(179,84,24,.18) 26%,rgba(103,48,20,.08) 48%,transparent 72%),
    radial-gradient(circle at 50% 18%,rgba(211,130,57,.15),transparent 54%);
  filter:blur(18px);
  pointer-events:none;
}
.fmb-forja-now-art:after{
  content:"";
  position:absolute;
  z-index:0;
  left:15%;
  right:15%;
  bottom:24px;
  height:24px;
  border-radius:50%;
  background:radial-gradient(ellipse at center,rgba(255,174,62,.42),rgba(187,89,20,.18) 42%,transparent 72%);
  filter:blur(11px);
  pointer-events:none;
}
.fmb-forja-now-art img{
  z-index:2 !important;
  width:112% !important;
  max-width:320px !important;
  margin-top:10px;
  transform:translateY(4px);
  mix-blend-mode:screen;
  filter:
    drop-shadow(0 0 18px rgba(214,124,40,.18))
    drop-shadow(0 18px 26px rgba(0,0,0,.34)) !important;
  -webkit-mask-image:linear-gradient(to bottom,transparent 0%,#000 8%,#000 90%,transparent 100%);
  mask-image:linear-gradient(to bottom,transparent 0%,#000 8%,#000 90%,transparent 100%);
}
.fmb-forja-now-heat{
  position:absolute;
  z-index:1;
  display:block;
  left:50%;
  border-radius:50%;
  pointer-events:none;
  filter:blur(16px);
  opacity:.72;
}
.fmb-forja-now-heat--1{
  top:8%;
  width:72%;
  height:42%;
  transform:translateX(-50%);
  background:radial-gradient(ellipse at center,rgba(196,112,49,.24),rgba(149,73,29,.10) 42%,transparent 73%);
}
.fmb-forja-now-heat--2{
  bottom:3%;
  width:82%;
  height:30%;
  transform:translateX(-50%);
  background:radial-gradient(ellipse at center,rgba(239,151,52,.24),rgba(181,87,24,.10) 50%,transparent 76%);
}
.fmb-forja-now-ember{
  position:absolute;
  z-index:3;
  width:4px;
  height:4px;
  border-radius:50%;
  background:#e7a64b;
  box-shadow:0 0 9px rgba(231,166,75,.82);
  opacity:.76;
}
.fmb-forja-now-ember--1{left:23%;top:33%}
.fmb-forja-now-ember--2{left:69%;top:26%;width:3px;height:3px;opacity:.52}
.fmb-forja-now-ember--3{left:67%;bottom:22%;width:2px;height:2px;opacity:.46}

.fmb-forja-now-item{
  grid-template-columns:46px minmax(0,1fr) !important;
  gap:14px !important;
}
.fmb-forja-now-icon{
  width:42px !important;
  height:42px !important;
  border:1px solid rgba(222,189,129,.18) !important;
  background:#21150f !important;
}
.fmb-forja-now-icon svg{
  display:block;
  width:22px;
  height:22px;
  fill:none;
  stroke:currentColor;
  stroke-width:1.65;
  stroke-linecap:round;
  stroke-linejoin:round;
}
.fmb-forja-now-icon--build{
  color:#59c47f !important;
  background:#0a281b !important;
  border-color:rgba(89,196,127,.22) !important;
}
.fmb-forja-now-icon--guide{
  color:#e3c17b !important;
}
.fmb-forja-now-icon--vote{
  color:#e7bd62 !important;
}
.fmb-forja-now-item-copy strong{
  display:block;
  max-width:none !important;
  white-space:normal;
}
.fmb-forja-now-item--live .fmb-forja-now-item-copy strong{
  font-size:16px !important;
}
.fmb-forja-now-list{
  min-width:0;
}
@media(min-width:1080px){
  .fmb-forja-now{
    min-width:570px;
  }
  .fmb-forja-now-item--live .fmb-forja-now-item-copy strong{
    white-space:nowrap;
  }
}
@media(max-width:1180px){
  .fmb-forja-now-body{
    grid-template-columns:minmax(170px,.82fr) minmax(300px,1.18fr) !important;
  }
}
@media(max-width:700px){
  .fmb-forja-now-body{
    grid-template-columns:1fr !important;
  }
  .fmb-forja-now-art{
    min-height:250px !important;
  }
  .fmb-forja-now-art img{
    width:100% !important;
    max-width:250px !important;
    margin-inline:auto;
  }
}


/* ===== HOME v2.3.7 · ARTE INTEGRADA + MOBILE ===== */

/* O asset agora possui alpha real: não precisamos esconder as bordas com máscara/blend. */
.fmb-forja-now-art{
  overflow:visible!important;
}
.fmb-forja-now-art img{
  mix-blend-mode:normal!important;
  -webkit-mask-image:none!important;
  mask-image:none!important;
  opacity:1!important;
  width:min(112%,320px)!important;
  height:auto!important;
}

/* O calor pertence ao card, não à imagem. */
.fmb-forja-now-art:before{
  width:135%!important;
  height:125%!important;
  background:
    radial-gradient(circle at 50% 64%,
      rgba(238,145,45,.28) 0%,
      rgba(181,84,25,.17) 30%,
      rgba(96,43,17,.08) 52%,
      transparent 74%)!important;
}
.fmb-forja-now-art:after{
  left:8%!important;
  right:8%!important;
  bottom:17px!important;
  background:
    radial-gradient(ellipse at center,
      rgba(255,178,66,.38) 0%,
      rgba(184,83,21,.16) 46%,
      transparent 74%)!important;
}

/* Desktop: mais ar para a arte e conteúdo sem esmagamento. */
@media(min-width:1181px){
  .fmb-forja-now-body{
    grid-template-columns:minmax(205px,.92fr) minmax(330px,1.28fr)!important;
  }
  .fmb-forja-now-art{
    min-height:360px!important;
  }
}

/* Tablet */
@media(max-width:1020px){
  .fmb-home-hero-shell{
    grid-template-columns:1fr!important;
    gap:34px!important;
  }
  .fmb-forja-now{
    width:100%;
    max-width:760px;
  }
}

/* Celular: card vira fluxo vertical e mantém legibilidade/touch targets. */
@media(max-width:700px){
  .fmb-home-hero{
    padding:38px 0 40px!important;
  }
  .fmb-home-hero-shell{
    width:min(100% - 24px,680px)!important;
    gap:28px!important;
  }
  .fmb-home-hero h1{
    font-size:clamp(43px,13vw,58px)!important;
    line-height:.98!important;
  }
  .fmb-home-hero-copy p{
    font-size:16px!important;
    line-height:1.5!important;
  }

  .fmb-forja-now{
    width:100%!important;
    min-width:0!important;
    padding:17px 15px 13px!important;
    border-radius:18px!important;
  }
  .fmb-forja-now-title{
    min-height:32px!important;
    padding:0 2px 12px!important;
    font-size:16px!important;
  }
  .fmb-forja-now-body{
    display:block!important;
    padding-top:4px!important;
  }

  .fmb-forja-now-art{
    min-height:245px!important;
    height:245px!important;
    margin:0 auto 2px!important;
    display:flex!important;
    align-items:center!important;
    justify-content:center!important;
  }
  .fmb-forja-now-art img{
    width:min(76vw,260px)!important;
    max-width:260px!important;
    margin:0 auto!important;
    transform:none!important;
  }
  .fmb-forja-now-heat--1{
    width:74%!important;
    height:58%!important;
    top:2%!important;
  }
  .fmb-forja-now-heat--2{
    width:74%!important;
    height:34%!important;
    bottom:2%!important;
  }

  .fmb-forja-now-list{
    margin-top:2px!important;
  }
  .fmb-forja-now-item{
    grid-template-columns:40px minmax(0,1fr)!important;
    gap:11px!important;
    padding:14px 0!important;
  }
  .fmb-forja-now-icon{
    width:38px!important;
    height:38px!important;
  }
  .fmb-forja-now-icon svg{
    width:20px!important;
    height:20px!important;
  }
  .fmb-forja-now-status{
    padding:5px 7px 4px!important;
    font-size:8px!important;
  }
  .fmb-forja-now-item strong,
  .fmb-forja-now-item--live .fmb-forja-now-item-copy strong{
    white-space:normal!important;
    font-size:17px!important;
    line-height:1.18!important;
  }
  .fmb-forja-now-item small{
    font-size:11px!important;
  }
  .fmb-forja-now-link{
    font-size:11px!important;
  }
  .fmb-forja-now-footer{
    padding-top:12px!important;
    font-size:14px!important;
  }
}

/* Telefones estreitos */
@media(max-width:390px){
  .fmb-home-hero-shell{
    width:calc(100% - 18px)!important;
  }
  .fmb-forja-now{
    padding-left:13px!important;
    padding-right:13px!important;
  }
  .fmb-forja-now-art{
    height:225px!important;
    min-height:225px!important;
  }
  .fmb-forja-now-art img{
    width:min(78vw,235px)!important;
  }
  .fmb-forja-now-item strong,
  .fmb-forja-now-item--live .fmb-forja-now-item-copy strong{
    font-size:16px!important;
  }
}


/* ===== HOME v2.3.8 · COMPOSIÇÃO CASTELO + TEXTO ===== */
.fmb-home-hero{
  min-height:650px;
  overflow:hidden;
  isolation:isolate;
  background:#f8f5ee!important;
}
.fmb-home-hero-landscape{
  position:absolute;
  z-index:-3;
  top:0;
  right:0;
  width:72%;
  height:100%;
  object-fit:cover;
  object-position:50% 52%;
  pointer-events:none;
  user-select:none;
}
.fmb-home-hero:before{
  content:"";
  position:absolute;
  z-index:-2;
  inset:0;
  pointer-events:none;
  background:
    linear-gradient(90deg,
      #f8f5ee 0%,
      #f8f5ee 28%,
      rgba(248,245,238,.97) 38%,
      rgba(248,245,238,.80) 48%,
      rgba(248,245,238,.34) 60%,
      rgba(248,245,238,.04) 72%,
      rgba(248,245,238,0) 82%),
    linear-gradient(0deg,
      #f8f5ee 0%,
      rgba(248,245,238,.90) 5%,
      rgba(248,245,238,.30) 17%,
      rgba(248,245,238,0) 34%);
}
.fmb-home-hero:after{
  content:"";
  position:absolute;
  z-index:-1;
  inset:0;
  pointer-events:none;
  background:
    radial-gradient(circle at 64% 24%,rgba(255,238,202,.18),transparent 26%),
    linear-gradient(90deg,transparent 60%,rgba(32,23,15,.04) 100%);
}
.fmb-home-hero-shell{
  position:relative;
  z-index:2;
}
.fmb-home-hero-copy{
  position:relative;
  z-index:3;
  align-self:center;
  padding:18px 0 24px;
  text-shadow:0 1px 0 rgba(255,255,255,.50);
}
.fmb-home-hero-copy p{
  max-width:650px!important;
}
.fmb-home-hero-quote{
  position:absolute;
  z-index:2;
  left:49%;
  bottom:78px;
  display:grid;
  gap:1px;
  transform:rotate(-6deg);
  color:rgba(255,255,255,.88);
  text-shadow:0 2px 10px rgba(20,14,9,.42);
  font:italic 28px/1.05 "Segoe Script","Brush Script MT",cursive;
  pointer-events:none;
}
.fmb-home-hero-quote i{
  display:block;
  width:64px;
  height:3px;
  margin-top:13px;
  background:#c8891f;
  border-radius:999px;
  box-shadow:0 1px 5px rgba(74,43,8,.20);
}
.fmb-forja-now{
  position:relative;
  z-index:4;
  backdrop-filter:blur(2px);
}
@media(max-width:1200px){
  .fmb-home-hero-landscape{
    width:78%;
    object-position:52% 50%;
  }
  .fmb-home-hero-quote{
    left:45%;
    bottom:62px;
    font-size:24px;
  }
}
@media(max-width:1020px){
  .fmb-home-hero{
    min-height:0;
  }
  .fmb-home-hero-landscape{
    width:100%;
    height:58%;
    top:0;
    object-position:61% 45%;
    opacity:.86;
  }
  .fmb-home-hero:before{
    background:
      linear-gradient(90deg,#f8f5ee 0%,rgba(248,245,238,.94) 42%,rgba(248,245,238,.42) 70%,rgba(248,245,238,.12) 100%),
      linear-gradient(0deg,#f8f5ee 0%,rgba(248,245,238,.95) 46%,rgba(248,245,238,.20) 74%,transparent 100%);
  }
  .fmb-home-hero-quote{
    display:none;
  }
  .fmb-forja-now{
    margin-top:14px;
  }
}
@media(max-width:700px){
  .fmb-home-hero-landscape{
    height:44%;
    width:118%;
    right:-18%;
    object-position:66% 44%;
    opacity:.52;
  }
  .fmb-home-hero:before{
    background:
      linear-gradient(90deg,#f8f5ee 0%,rgba(248,245,238,.96) 64%,rgba(248,245,238,.56) 100%),
      linear-gradient(0deg,#f8f5ee 0%,rgba(248,245,238,.96) 52%,rgba(248,245,238,.45) 77%,rgba(248,245,238,.06) 100%);
  }
}


/* ===== HOME v2.3.9 · MONTANHA COMO CHARME DO TEXTO ===== */

/* Desktop: a paisagem não invade mais a área do card "Na Forja Agora". */
.fmb-home-hero-landscape{
  left:30%!important;
  right:auto!important;
  width:34%!important;
  height:100%!important;
  object-fit:cover!important;
  object-position:58% 52%!important;
  opacity:.94!important;
  -webkit-mask-image:
    linear-gradient(90deg,transparent 0%,#000 14%,#000 76%,transparent 100%),
    linear-gradient(0deg,transparent 0%,#000 12%,#000 88%,transparent 100%)!important;
  mask-image:
    linear-gradient(90deg,transparent 0%,#000 14%,#000 76%,transparent 100%),
    linear-gradient(0deg,transparent 0%,#000 12%,#000 88%,transparent 100%)!important;
  -webkit-mask-composite:source-in!important;
  mask-composite:intersect!important;
}

/* Fade claro concentrado no lado do texto; a área do card fica limpa. */
.fmb-home-hero:before{
  background:
    linear-gradient(90deg,
      #f8f5ee 0%,
      #f8f5ee 26%,
      rgba(248,245,238,.95) 34%,
      rgba(248,245,238,.66) 43%,
      rgba(248,245,238,.20) 53%,
      rgba(248,245,238,0) 61%,
      rgba(248,245,238,0) 100%),
    linear-gradient(0deg,
      #f8f5ee 0%,
      rgba(248,245,238,.88) 5%,
      rgba(248,245,238,.24) 18%,
      rgba(248,245,238,0) 35%)!important;
}

/* A frase decorativa fica dentro da própria área da montanha. */
.fmb-home-hero-quote{
  left:41%!important;
  bottom:72px!important;
  font-size:24px!important;
}

/* Em telas desktop um pouco menores, reduz o texto antes de apertar o card. */
@media(max-width:1400px) and (min-width:1021px){
  .fmb-home-hero-shell{
    grid-template-columns:minmax(0,1.02fr) minmax(500px,.98fr)!important;
    gap:34px!important;
  }
  .fmb-home-hero h1{
    font-size:clamp(48px,4.55vw,68px)!important;
    line-height:.98!important;
    max-width:680px!important;
  }
  .fmb-home-hero-copy p{
    font-size:17px!important;
    max-width:600px!important;
  }
  .fmb-home-hero-landscape{
    left:31%!important;
    width:31%!important;
    object-position:60% 52%!important;
  }
  .fmb-home-hero-quote{
    left:42%!important;
    bottom:64px!important;
    font-size:21px!important;
  }
  .fmb-forja-now{
    min-width:0!important;
  }
}

/* Tablet: o card desce; a montanha continua só como charme do topo/texto. */
@media(max-width:1020px){
  .fmb-home-hero-landscape{
    left:auto!important;
    right:0!important;
    width:62%!important;
    height:50%!important;
    top:0!important;
    object-position:62% 46%!important;
    opacity:.62!important;
    -webkit-mask-image:linear-gradient(90deg,transparent 0%,#000 24%,#000 100%)!important;
    mask-image:linear-gradient(90deg,transparent 0%,#000 24%,#000 100%)!important;
  }
  .fmb-home-hero:before{
    background:
      linear-gradient(90deg,#f8f5ee 0%,rgba(248,245,238,.96) 48%,rgba(248,245,238,.46) 76%,rgba(248,245,238,.08) 100%),
      linear-gradient(0deg,#f8f5ee 0%,rgba(248,245,238,.96) 46%,rgba(248,245,238,.26) 76%,transparent 100%)!important;
  }
}

/* Celular: reduz ainda mais a presença da paisagem para priorizar leitura. */
@media(max-width:700px){
  .fmb-home-hero-landscape{
    width:68%!important;
    height:36%!important;
    right:-10%!important;
    opacity:.34!important;
    object-position:66% 44%!important;
  }
}


/* ===== HOME v2.3.10 · PAISAGEM MAIS FUNDO DO TEXTO ===== */

/* A paisagem passa a começar mais cedo e terminar antes do card. */
.fmb-home-hero-landscape{
  left:23%!important;
  width:40%!important;
  object-position:56% 52%!important;
}

/* O fade claro mantém o H1 legível, mas deixa a montanha aparecer por trás dele. */
.fmb-home-hero:before{
  background:
    linear-gradient(90deg,
      #f8f5ee 0%,
      #f8f5ee 20%,
      rgba(248,245,238,.95) 28%,
      rgba(248,245,238,.77) 36%,
      rgba(248,245,238,.44) 45%,
      rgba(248,245,238,.12) 55%,
      rgba(248,245,238,0) 62%,
      rgba(248,245,238,0) 100%),
    linear-gradient(0deg,
      #f8f5ee 0%,
      rgba(248,245,238,.88) 5%,
      rgba(248,245,238,.24) 18%,
      rgba(248,245,238,0) 35%)!important;
}

/* A frase fica mais para dentro, sobre a base da paisagem, sem ser cortada pelo card. */
.fmb-home-hero-quote{
  left:34.5%!important;
  bottom:66px!important;
  font-size:23px!important;
  max-width:250px;
}

/* Desktop médio: mantém a mesma lógica sem apertar texto/card. */
@media(max-width:1400px) and (min-width:1021px){
  .fmb-home-hero-landscape{
    left:24%!important;
    width:38%!important;
    object-position:57% 52%!important;
  }
  .fmb-home-hero-quote{
    left:35.5%!important;
    bottom:58px!important;
    font-size:20px!important;
    max-width:220px;
  }
}

/* Tablet: a paisagem vira só atmosfera atrás do topo textual. */
@media(max-width:1020px){
  .fmb-home-hero-landscape{
    left:auto!important;
    right:0!important;
    width:68%!important;
    height:48%!important;
    object-position:60% 46%!important;
  }
}

/* Mobile: presença mínima, sem interferir no texto. */
@media(max-width:700px){
  .fmb-home-hero-landscape{
    width:74%!important;
    height:34%!important;
    right:-14%!important;
    opacity:.30!important;
  }
}


/* ===== HOME · CICLO DE BUILDS + VOTAÇÃO ===== */
.fmb-build-cycle,
.fmb-build-cycle *{box-sizing:border-box}
.fmb-build-cycle{
  position:relative;
  left:50%;
  width:100vw;
  margin-left:-50vw;
  padding:66px 0 76px;
  background:#f8f5ee;
  color:#221d18;
  border-top:1px solid #e8ddcc;
}
.fmb-build-cycle-shell{
  width:min(1460px,calc(100% - 56px));
  margin:0 auto;
}
.fmb-build-cycle-heading{
  margin-bottom:24px;
}
.fmb-build-cycle-eyebrow{
  display:block;
  margin-bottom:8px;
  color:#a9680b;
  font:900 10px/1 Arial,sans-serif;
  letter-spacing:.17em;
}
.fmb-build-cycle-heading h2{
  margin:0;
  color:#221d18;
  font:700 clamp(36px,4vw,58px)/1 Georgia,"Times New Roman",serif;
  letter-spacing:-.03em;
}
.fmb-build-cycle-grid{
  display:grid;
  grid-template-columns:minmax(0,.92fr) minmax(0,1.32fr) minmax(330px,.82fr);
  gap:16px;
  align-items:stretch;
}
.fmb-cycle-card,
.fmb-cycle-vote{
  overflow:hidden;
  border:1px solid #d9c7a7;
  border-radius:22px;
  background:#fffaf2;
  box-shadow:0 18px 44px rgba(51,37,20,.07);
}
.fmb-cycle-card{
  display:flex;
  flex-direction:column;
}
.fmb-cycle-current-media,
.fmb-cycle-next-media{
  position:relative;
  display:block;
  min-height:315px;
  overflow:hidden;
  background:#0a1510;
}
.fmb-cycle-current-media img,
.fmb-cycle-next-media img{
  display:block;
  width:100%;
  height:315px;
  object-fit:cover;
}
.fmb-cycle-current-media:after,
.fmb-cycle-next-media:not(.is-placeholder):after{
  content:"";
  position:absolute;
  inset:0;
  background:linear-gradient(0deg,rgba(6,12,9,.62),transparent 56%);
  pointer-events:none;
}
.fmb-cycle-badge{
  position:absolute;
  z-index:2;
  left:14px;
  top:14px;
  padding:8px 10px;
  border-radius:999px;
  border:1px solid rgba(226,192,125,.45);
  background:rgba(10,20,14,.80);
  color:#e8c57e;
  font:900 8px/1 Arial,sans-serif;
  letter-spacing:.11em;
}
.fmb-cycle-badge--next{
  background:rgba(13,36,25,.86);
  color:#b9d8c3;
}
.fmb-cycle-card-copy{
  flex:1;
  padding:22px 22px 24px;
}
.fmb-cycle-kicker{
  display:block;
  color:#9a6710;
  font:900 9px/1 Arial,sans-serif;
  letter-spacing:.14em;
}
.fmb-cycle-card-copy h3{
  margin:10px 0 0;
  color:#241f1a;
  font:700 28px/1.05 Georgia,"Times New Roman",serif;
  letter-spacing:-.02em;
}
.fmb-cycle-card-copy p{
  margin:12px 0 0;
  color:#665d53;
  font:400 14px/1.55 Arial,sans-serif;
}
.fmb-cycle-cta{
  display:inline-flex;
  margin-top:20px;
  min-height:43px;
  align-items:center;
  padding:0 14px;
  border:1px solid #b98a3c;
  border-radius:9px;
  color:#2c241c!important;
  font:800 11px/1 Arial,sans-serif;
  text-decoration:none!important;
}
.fmb-cycle-next{
  background:#091711;
  border-color:#6e684e;
}
.fmb-cycle-next .fmb-cycle-card-copy{
  background:
    radial-gradient(circle at 85% 10%,rgba(42,119,77,.20),transparent 30%),
    #091711;
}
.fmb-cycle-next .fmb-cycle-kicker{color:#c9a55f}
.fmb-cycle-next .fmb-cycle-card-copy h3{color:#fff8eb}
.fmb-cycle-next .fmb-cycle-card-copy p{color:#bdb5a9}
.fmb-cycle-next-media.is-placeholder{
  display:grid;
  place-items:center;
  min-height:315px;
  background:
    radial-gradient(circle at 50% 40%,rgba(38,111,72,.18),transparent 34%),
    linear-gradient(145deg,#0b1d15,#07110d);
}
.fmb-cycle-next-placeholder{
  max-width:280px;
  padding:24px;
  text-align:center;
  color:#d9cfbf;
}
.fmb-cycle-next-placeholder span{
  display:block;
  color:#b99553;
  font:900 9px/1 Arial,sans-serif;
  letter-spacing:.14em;
}
.fmb-cycle-next-placeholder strong{
  display:block;
  margin-top:9px;
  color:#fff7e9;
  font:700 30px/1 Georgia,"Times New Roman",serif;
}
.fmb-cycle-next-placeholder small{
  display:block;
  margin-top:11px;
  color:#9e9689;
  font:400 12px/1.45 Arial,sans-serif;
}
.fmb-cycle-clues{
  display:flex;
  flex-wrap:wrap;
  gap:7px;
  margin-top:16px;
}
.fmb-cycle-clues span{
  padding:7px 9px;
  border:1px solid rgba(216,185,126,.20);
  border-radius:999px;
  color:#d8cfbe;
  background:rgba(255,255,255,.035);
  font:700 10px/1 Arial,sans-serif;
}
.fmb-cycle-next-note{
  color:#938b7f!important;
  font-size:12px!important;
}
.fmb-cycle-vote{
  padding:20px 18px 18px;
  background:#fffaf2;
}
.fmb-cycle-vote-head{
  display:grid;
  grid-template-columns:42px 1fr;
  gap:10px;
  align-items:start;
}
.fmb-cycle-vote-icon{
  display:grid;
  place-items:center;
  width:40px;
  height:40px;
  color:#99620c;
}
.fmb-cycle-vote-icon svg{
  width:26px;
  height:26px;
  fill:none;
  stroke:currentColor;
  stroke-width:1.9;
  stroke-linecap:round;
}
.fmb-cycle-vote-head span{
  color:#7e5b26;
  font:900 9px/1 Arial,sans-serif;
  letter-spacing:.10em;
}
.fmb-cycle-vote-head h3{
  margin:6px 0 0;
  color:#241f1a;
  font:700 25px/1.05 Georgia,"Times New Roman",serif;
}
.fmb-cycle-vote-intro{
  margin:14px 0 14px;
  color:#6a6157;
  font:400 13px/1.45 Arial,sans-serif;
}
.fmb-cycle-vote-form{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:8px;
}
.fmb-cycle-candidate{
  position:relative;
  display:block;
  cursor:pointer;
}
.fmb-cycle-candidate input{
  position:absolute;
  opacity:0;
  pointer-events:none;
}
.fmb-cycle-candidate-card{
  display:block;
  overflow:hidden;
  min-height:206px;
  border:1px solid #ddcdb3;
  border-radius:12px;
  background:#fff;
  transition:border-color .18s ease,transform .18s ease,box-shadow .18s ease;
}
.fmb-cycle-candidate input:checked + .fmb-cycle-candidate-card{
  border-color:#a9680b;
  transform:translateY(-2px);
  box-shadow:0 8px 20px rgba(90,56,14,.12);
}
.fmb-cycle-candidate-card img{
  display:block;
  width:100%;
  aspect-ratio:4/5;
  object-fit:cover;
  object-position:center top;
}
.fmb-cycle-candidate-card strong{
  display:block;
  padding:9px 7px 0;
  color:#241f1a;
  text-align:center;
  font:700 13px/1.1 Georgia,"Times New Roman",serif;
}
.fmb-cycle-candidate-card small{
  display:block;
  padding:3px 6px 9px;
  color:#7b7165;
  text-align:center;
  font:600 9px/1 Arial,sans-serif;
}
.fmb-cycle-vote-button{
  grid-column:1/-1;
  min-height:48px;
  margin-top:4px;
  border:0;
  border-radius:9px;
  background:#b87207;
  color:#fff;
  font:900 12px/1 Arial,sans-serif;
  cursor:pointer;
}
.fmb-cycle-vote-note{
  grid-column:1/-1;
  margin:0!important;
  color:#988f83!important;
  text-align:center;
  font:400 10px/1.4 Arial,sans-serif!important;
}
@media(max-width:1180px){
  .fmb-build-cycle-grid{
    grid-template-columns:1fr 1fr;
  }
  .fmb-cycle-vote{
    grid-column:1/-1;
  }
  .fmb-cycle-vote-form{
    grid-template-columns:repeat(3,minmax(0,1fr));
  }
}
@media(max-width:760px){
  .fmb-build-cycle{
    padding:46px 0 54px;
  }
  .fmb-build-cycle-shell{
    width:min(100% - 24px,680px);
  }
  .fmb-build-cycle-grid{
    grid-template-columns:1fr;
  }
  .fmb-cycle-vote{
    grid-column:auto;
  }
  .fmb-cycle-current-media,
  .fmb-cycle-next-media,
  .fmb-cycle-current-media img,
  .fmb-cycle-next-media img{
    min-height:280px;
    height:280px;
  }
}
@media(max-width:520px){
  .fmb-cycle-vote-form{
    grid-template-columns:1fr;
  }
  .fmb-cycle-candidate-card{
    display:grid;
    grid-template-columns:108px 1fr;
    align-items:center;
    min-height:0;
  }
  .fmb-cycle-candidate-card img{
    width:108px;
    height:135px;
    aspect-ratio:auto;
  }
  .fmb-cycle-candidate-card strong,
  .fmb-cycle-candidate-card small{
    text-align:left;
    padding-left:12px;
  }
  .fmb-cycle-candidate-card strong{
    align-self:end;
  }
  .fmb-cycle-candidate-card small{
    align-self:start;
  }
}


/* ===== HOME v2.3.12 · DISTRIBUIÇÃO DO CICLO ===== */

/* Desktop: 2 cards editoriais em cima + votação larga embaixo. */
.fmb-build-cycle-grid{
  grid-template-columns:minmax(0,.78fr) minmax(0,1.22fr)!important;
  gap:18px!important;
  align-items:stretch!important;
}

.fmb-cycle-current,
.fmb-cycle-next{
  min-height:650px;
}

.fmb-cycle-vote{
  grid-column:1 / -1!important;
  display:grid!important;
  grid-template-columns:minmax(250px,.72fr) minmax(0,2.28fr)!important;
  gap:24px!important;
  align-items:start!important;
  padding:24px!important;
}

.fmb-cycle-vote-head{
  grid-column:1!important;
}
.fmb-cycle-vote-intro{
  grid-column:1!important;
  margin-top:10px!important;
  max-width:280px;
}

.fmb-cycle-vote-form{
  grid-column:2!important;
  display:grid!important;
  grid-template-columns:minmax(0,1fr) 190px!important;
  gap:16px!important;
  align-items:stretch!important;
}

.fmb-cycle-vote-options{
  display:grid;
  grid-template-columns:repeat(3,minmax(0,1fr));
  gap:10px;
}

.fmb-cycle-vote-action{
  display:flex;
  flex-direction:column;
  justify-content:flex-end;
  gap:10px;
  min-width:0;
}

.fmb-cycle-vote-button{
  grid-column:auto!important;
  min-height:54px!important;
  width:100%;
  margin-top:0!important;
}

.fmb-cycle-vote-note{
  grid-column:auto!important;
  margin:0!important;
  text-align:left!important;
  line-height:1.45!important;
}

/* Cards da votação mais equilibrados e com nomes legíveis. */
.fmb-cycle-candidate-card{
  min-height:0!important;
  height:100%;
}
.fmb-cycle-candidate-card img{
  aspect-ratio:4/5!important;
  min-height:0!important;
}
.fmb-cycle-candidate-card strong{
  min-height:36px;
  display:flex!important;
  align-items:center;
  justify-content:center;
  padding:9px 7px 2px!important;
  font-size:14px!important;
}
.fmb-cycle-candidate-card small{
  padding-bottom:10px!important;
}

/* Build atual: mais compacta; Próxima build: mais espaço para arte e pistas. */
.fmb-cycle-current-media,
.fmb-cycle-current-media img{
  min-height:365px!important;
  height:365px!important;
}
.fmb-cycle-next-media,
.fmb-cycle-next-media img{
  min-height:390px!important;
  height:390px!important;
}
.fmb-cycle-card-copy{
  padding:24px!important;
}
.fmb-cycle-next .fmb-cycle-card-copy{
  display:flex;
  flex-direction:column;
  justify-content:center;
}
.fmb-cycle-clues{
  margin-top:18px!important;
}

/* Placeholder mais editorial e menos "caixa vazia". */
.fmb-cycle-next-placeholder{
  position:relative;
  width:min(78%,430px);
  max-width:none!important;
  padding:24px!important;
}
.fmb-cycle-next-placeholder:before{
  content:"";
  position:absolute;
  inset:-42px;
  border:1px solid rgba(187,149,82,.12);
  border-radius:50%;
  box-shadow:
    0 0 0 28px rgba(187,149,82,.035),
    0 0 0 56px rgba(187,149,82,.018);
}
.fmb-cycle-next-placeholder span,
.fmb-cycle-next-placeholder strong,
.fmb-cycle-next-placeholder small{
  position:relative;
  z-index:1;
}
.fmb-cycle-next-placeholder strong{
  font-size:82px!important;
  line-height:.9!important;
  color:#d0b16f!important;
  opacity:.74;
}
.fmb-cycle-next-placeholder small{
  max-width:310px;
  margin-inline:auto;
}

/* Tablet */
@media(max-width:1180px){
  .fmb-build-cycle-grid{
    grid-template-columns:1fr 1fr!important;
  }
  .fmb-cycle-vote{
    grid-column:1 / -1!important;
    grid-template-columns:1fr!important;
    gap:16px!important;
  }
  .fmb-cycle-vote-head,
  .fmb-cycle-vote-intro,
  .fmb-cycle-vote-form{
    grid-column:1!important;
  }
  .fmb-cycle-vote-intro{
    max-width:none;
  }
  .fmb-cycle-vote-form{
    grid-template-columns:1fr!important;
  }
  .fmb-cycle-vote-action{
    display:grid;
    grid-template-columns:minmax(180px,260px) 1fr;
    align-items:center;
  }
}

/* Mobile */
@media(max-width:760px){
  .fmb-build-cycle-grid{
    grid-template-columns:1fr!important;
  }
  .fmb-cycle-current,
  .fmb-cycle-next{
    min-height:0;
  }
  .fmb-cycle-vote{
    grid-column:auto!important;
    padding:20px 16px!important;
  }
  .fmb-cycle-vote-options{
    grid-template-columns:1fr!important;
  }
  .fmb-cycle-vote-action{
    grid-template-columns:1fr!important;
  }
  .fmb-cycle-current-media,
  .fmb-cycle-current-media img,
  .fmb-cycle-next-media,
  .fmb-cycle-next-media img{
    min-height:300px!important;
    height:300px!important;
  }
  .fmb-cycle-candidate-card{
    display:grid!important;
    grid-template-columns:112px 1fr!important;
    align-items:center!important;
  }
  .fmb-cycle-candidate-card img{
    width:112px!important;
    height:140px!important;
    aspect-ratio:auto!important;
  }
  .fmb-cycle-candidate-card strong,
  .fmb-cycle-candidate-card small{
    text-align:left!important;
    justify-content:flex-start!important;
    padding-left:13px!important;
  }
}


/* ===== HOME v2.3.13 · ENQUADRAMENTO BUILD ATUAL ===== */
.fmb-cycle-current-media img{
  object-position:center top!important;
}


/* ===== HOME v2.3.15 · PRÓXIMA BUILD MISTERIOSA ===== */
.fmb-cycle-next-media{
  background:#07110d!important;
}
.fmb-cycle-next-media img{
  object-fit:cover!important;
  object-position:center 38%!important;
  filter:saturate(.92) contrast(1.04) brightness(.86);
}
.fmb-cycle-next-media:not(.is-placeholder):after{
  background:
    linear-gradient(0deg,rgba(5,14,10,.74) 0%,rgba(5,14,10,.18) 42%,rgba(5,14,10,.05) 100%),
    linear-gradient(90deg,rgba(7,17,13,.06),rgba(7,17,13,.22))!important;
}
@media(max-width:760px){
  .fmb-cycle-next-media img{
    object-position:center 32%!important;
  }
}


/* ===== HOME v2.3.16 · BUILD ATUAL + VOTAÇÃO REFINADA ===== */

/* Build Atual: continuidade escura com a arte, sem grande bloco creme vazio. */
.fmb-cycle-current{
  background:
    radial-gradient(circle at 78% 0%,rgba(31,99,67,.18),transparent 34%),
    linear-gradient(180deg,#101a15 0%,#0b130f 100%)!important;
  border-color:#6f7051!important;
}
.fmb-cycle-current-media:after{
  background:
    linear-gradient(0deg,#0d1611 0%,rgba(13,22,17,.72) 16%,rgba(13,22,17,.08) 52%,transparent 100%)!important;
}
.fmb-cycle-current .fmb-cycle-card-copy{
  position:relative;
  background:
    linear-gradient(180deg,#0d1611 0%,#101812 100%)!important;
  color:#eee7dc;
}
.fmb-cycle-current .fmb-cycle-kicker{
  color:#d3aa5f!important;
}
.fmb-cycle-current .fmb-cycle-card-copy h3{
  color:#fff7ea!important;
}
.fmb-cycle-current .fmb-cycle-card-copy p{
  color:#c6bdae!important;
  max-width:540px;
}
.fmb-cycle-current .fmb-cycle-cta{
  border-color:rgba(216,176,101,.48)!important;
  background:rgba(255,255,255,.025)!important;
  color:#f4e8d3!important;
}
.fmb-cycle-current .fmb-cycle-cta:hover{
  background:rgba(215,173,92,.11)!important;
  border-color:#d0a354!important;
}

/* Votação: área mais coesa, CTA conectado aos candidatos e menos espaço "morto". */
.fmb-cycle-vote{
  position:relative;
  background:
    radial-gradient(circle at 86% 12%,rgba(193,139,47,.08),transparent 32%),
    linear-gradient(180deg,#fffaf2 0%,#fbf4e9 100%)!important;
}
.fmb-cycle-vote:before{
  content:"";
  position:absolute;
  left:0;
  right:0;
  top:0;
  height:3px;
  background:linear-gradient(90deg,#a9680b,#d2a34c,#a9680b);
  opacity:.78;
}

.fmb-cycle-vote-options{
  align-items:stretch;
}
.fmb-cycle-candidate{
  position:relative;
}
.fmb-cycle-candidate-card{
  position:relative;
  height:100%;
  overflow:hidden;
  border:1px solid #dbc7a6!important;
  background:#fffdf9!important;
  box-shadow:0 8px 18px rgba(66,45,20,.04);
  transition:
    transform .18s ease,
    box-shadow .18s ease,
    border-color .18s ease,
    background .18s ease;
}
.fmb-cycle-candidate:hover .fmb-cycle-candidate-card{
  transform:translateY(-4px);
  border-color:#b97a1e!important;
  box-shadow:0 14px 28px rgba(78,51,14,.11);
}
.fmb-cycle-candidate-card:before{
  content:"";
  position:absolute;
  z-index:3;
  inset:0;
  border:2px solid transparent;
  border-radius:inherit;
  pointer-events:none;
  transition:border-color .18s ease,box-shadow .18s ease;
}
.fmb-cycle-candidate-card:after{
  content:"";
  position:absolute;
  z-index:4;
  top:10px;
  right:10px;
  width:28px;
  height:28px;
  border-radius:50%;
  border:1px solid rgba(255,255,255,.70);
  background:rgba(20,16,11,.48);
  box-shadow:0 3px 10px rgba(0,0,0,.18);
  pointer-events:none;
}
.fmb-cycle-candidate input:checked + .fmb-cycle-candidate-card{
  transform:translateY(-5px);
  border-color:#b26c06!important;
  background:#fff9ed!important;
  box-shadow:
    0 16px 30px rgba(91,56,12,.15),
    0 0 0 3px rgba(178,108,6,.10);
}
.fmb-cycle-candidate input:checked + .fmb-cycle-candidate-card:before{
  border-color:#b26c06;
  box-shadow:inset 0 0 0 1px rgba(255,226,172,.35);
}
.fmb-cycle-candidate input:checked + .fmb-cycle-candidate-card:after{
  content:"✓";
  display:grid;
  place-items:center;
  border-color:#1f6a49;
  background:#1f6a49;
  color:white;
  font:900 16px/1 Arial,sans-serif;
}
.fmb-cycle-candidate input:focus-visible + .fmb-cycle-candidate-card{
  outline:3px solid rgba(31,106,73,.30);
  outline-offset:3px;
}
.fmb-cycle-candidate input:checked + .fmb-cycle-candidate-card strong{
  color:#7b4800!important;
}
.fmb-cycle-candidate-card img{
  transition:transform .25s ease,filter .2s ease;
}
.fmb-cycle-candidate:hover .fmb-cycle-candidate-card img{
  transform:scale(1.018);
}
.fmb-cycle-candidate input:checked + .fmb-cycle-candidate-card img{
  filter:saturate(1.08) contrast(1.03);
}

.fmb-cycle-vote-action{
  align-self:stretch;
  justify-content:center!important;
}
.fmb-cycle-vote-button{
  position:relative;
  overflow:hidden;
  min-height:56px!important;
  border:1px solid #a9680b!important;
  background:linear-gradient(180deg,#bd770c,#a9680b)!important;
  box-shadow:0 9px 18px rgba(127,76,4,.14);
  transition:
    transform .18s ease,
    box-shadow .18s ease,
    opacity .18s ease,
    background .18s ease;
}
.fmb-cycle-vote-button:not(:disabled):hover{
  transform:translateY(-2px);
  box-shadow:0 13px 24px rgba(127,76,4,.20);
}
.fmb-cycle-vote-button:disabled{
  cursor:not-allowed;
  opacity:.56;
  background:#b9a88d!important;
  border-color:#ad9c82!important;
  box-shadow:none;
}
.fmb-cycle-vote-button.is-confirmed{
  opacity:1!important;
  background:linear-gradient(180deg,#256f4f,#185c3f)!important;
  border-color:#185c3f!important;
  cursor:default;
}
.fmb-cycle-vote-note{
  color:#81766a!important;
  font-size:11px!important;
}

/* Em desktop, título/explicação + opções formam uma composição única e mais compacta. */
@media(min-width:1181px){
  .fmb-cycle-vote{
    grid-template-columns:minmax(250px,.62fr) minmax(0,2.38fr)!important;
    padding:28px 28px 24px!important;
  }
  .fmb-cycle-vote-form{
    grid-template-columns:minmax(0,1fr) minmax(200px,235px)!important;
    gap:20px!important;
  }
  .fmb-cycle-vote-intro{
    max-width:260px!important;
  }
}

/* Mobile: seleção continua evidente sem depender de hover. */
@media(max-width:760px){
  .fmb-cycle-candidate:hover .fmb-cycle-candidate-card{
    transform:none;
  }
  .fmb-cycle-candidate input:checked + .fmb-cycle-candidate-card{
    transform:none;
  }
  .fmb-cycle-candidate-card:after{
    width:26px;
    height:26px;
  }
}


/* ===== HOME v2.3.17 · VOTAÇÃO CENTRALIZADA ===== */

.fmb-cycle-vote{
  grid-column:1 / -1!important;
  display:block!important;
  padding:34px clamp(22px,4vw,54px) 30px!important;
  background:
    radial-gradient(circle at 50% 12%,rgba(194,139,47,.075),transparent 38%),
    linear-gradient(180deg,#fffaf2 0%,#fbf4e9 100%)!important;
}

.fmb-cycle-vote-head{
  display:flex!important;
  justify-content:center!important;
  align-items:flex-start!important;
  gap:13px!important;
  max-width:760px;
  margin:0 auto!important;
  text-align:center;
}
.fmb-cycle-vote-icon{
  flex:0 0 auto;
  margin-top:4px;
}
.fmb-cycle-vote-heading-copy{
  min-width:0;
}
.fmb-cycle-vote-heading-copy > span{
  display:block;
  color:#8b5a0c;
  font:900 9px/1 Arial,sans-serif;
  letter-spacing:.14em;
}
.fmb-cycle-vote-heading-copy h3{
  margin:8px 0 0!important;
  color:#241f1a;
  font:700 clamp(30px,3vw,44px)/1 Georgia,"Times New Roman",serif!important;
  letter-spacing:-.025em;
}
.fmb-cycle-vote-heading-copy p{
  max-width:620px;
  margin:13px auto 0;
  color:#6f6458;
  font:400 14px/1.5 Arial,sans-serif;
}

.fmb-cycle-vote-status{
  display:flex;
  align-items:center;
  justify-content:center;
  gap:8px;
  min-height:28px;
  margin:22px auto 14px;
  color:#8a6a38;
  font:900 10px/1 Arial,sans-serif;
  letter-spacing:.12em;
  text-transform:uppercase;
}
.fmb-cycle-vote-status-dot{
  width:7px;
  height:7px;
  border-radius:50%;
  background:#b77916;
  box-shadow:0 0 0 4px rgba(183,121,22,.10);
}
.fmb-cycle-vote.has-selection .fmb-cycle-vote-status{
  color:#1d6848;
}
.fmb-cycle-vote.has-selection .fmb-cycle-vote-status-dot{
  background:#2a8a60;
  box-shadow:0 0 0 4px rgba(42,138,96,.11);
}

.fmb-cycle-vote-form{
  display:block!important;
  max-width:1080px;
  margin:0 auto!important;
}
.fmb-cycle-vote-options{
  display:grid!important;
  grid-template-columns:repeat(3,minmax(0,1fr))!important;
  gap:16px!important;
  max-width:1040px;
  margin:0 auto!important;
}

.fmb-cycle-candidate-card{
  height:100%;
  min-height:0!important;
  border-radius:16px!important;
}
.fmb-cycle-candidate-card img{
  display:block;
  width:100%;
  aspect-ratio:4/5!important;
  object-fit:cover!important;
  object-position:center top!important;
}
.fmb-cycle-candidate-copy{
  display:block;
  min-height:65px;
  padding:12px 10px 10px;
  background:#fffdf9;
}
.fmb-cycle-candidate-copy strong{
  display:block!important;
  min-height:0!important;
  padding:0!important;
  color:#261f18;
  text-align:center;
  font:700 17px/1.1 Georgia,"Times New Roman",serif!important;
}
.fmb-cycle-candidate-copy small{
  display:block!important;
  padding:5px 0 0!important;
  color:#7b7165;
  text-align:center;
  font:600 10px/1 Arial,sans-serif!important;
}

.fmb-cycle-candidate-check{
  position:absolute;
  z-index:6;
  top:12px;
  right:12px;
  display:grid;
  place-items:center;
  width:32px;
  height:32px;
  border-radius:50%;
  border:1px solid rgba(255,255,255,.72);
  background:rgba(24,20,15,.46);
  color:transparent;
  font:900 17px/1 Arial,sans-serif;
  box-shadow:0 4px 12px rgba(0,0,0,.20);
  transition:
    background .18s ease,
    border-color .18s ease,
    color .18s ease,
    transform .18s ease;
}
.fmb-cycle-candidate input:checked + .fmb-cycle-candidate-card .fmb-cycle-candidate-check{
  background:#238259;
  border-color:#238259;
  color:#fff;
  transform:scale(1.06);
}

/* Disable the old pseudo-radio circle from the previous iteration. */
.fmb-cycle-candidate-card:after{
  display:none!important;
}

.fmb-cycle-vote-action{
  display:flex!important;
  flex-direction:column!important;
  align-items:center!important;
  justify-content:center!important;
  gap:10px!important;
  max-width:470px;
  margin:22px auto 0!important;
}
.fmb-cycle-vote-button{
  width:min(100%,420px)!important;
  min-height:56px!important;
  margin:0!important;
}
.fmb-cycle-vote-note{
  width:100%;
  margin:0!important;
  color:#82766a!important;
  text-align:center!important;
  font:400 11px/1.45 Arial,sans-serif!important;
}

.fmb-cycle-vote.is-confirmed .fmb-cycle-candidate:not(.is-selected){
  opacity:.58;
}
.fmb-cycle-vote.is-confirmed .fmb-cycle-candidate:not(.is-selected) .fmb-cycle-candidate-card{
  filter:saturate(.70);
}
.fmb-cycle-vote.is-confirmed .fmb-cycle-candidate.is-selected .fmb-cycle-candidate-card{
  transform:translateY(-4px);
  border-color:#238259!important;
  box-shadow:
    0 18px 34px rgba(35,130,89,.14),
    0 0 0 3px rgba(35,130,89,.10);
}
.fmb-cycle-vote.is-confirmed .fmb-cycle-vote-status{
  color:#1d6848;
}
.fmb-cycle-vote.is-confirmed .fmb-cycle-vote-status-dot{
  background:#238259;
}

@media(max-width:760px){
  .fmb-cycle-vote{
    padding:26px 16px 24px!important;
  }
  .fmb-cycle-vote-head{
    text-align:left;
    justify-content:flex-start!important;
  }
  .fmb-cycle-vote-heading-copy p{
    margin-left:0;
    margin-right:0;
  }
  .fmb-cycle-vote-status{
    justify-content:flex-start;
    margin-left:52px;
  }
  .fmb-cycle-vote-options{
    grid-template-columns:1fr!important;
    gap:12px!important;
  }
  .fmb-cycle-candidate-card{
    display:grid!important;
    grid-template-columns:118px minmax(0,1fr)!important;
    align-items:center!important;
  }
  .fmb-cycle-candidate-card img{
    width:118px!important;
    height:148px!important;
    aspect-ratio:auto!important;
  }
  .fmb-cycle-candidate-copy{
    min-height:0;
    padding:14px;
  }
  .fmb-cycle-candidate-copy strong,
  .fmb-cycle-candidate-copy small{
    text-align:left!important;
  }
  .fmb-cycle-candidate-check{
    top:10px;
    right:10px;
  }
  .fmb-cycle-vote-action{
    max-width:none;
    margin-top:18px!important;
  }
  .fmb-cycle-vote-button{
    width:100%!important;
  }
}


/* ===== HOME · GUIA EM DESTAQUE ===== */
.fmb-featured-guide,
.fmb-featured-guide *{box-sizing:border-box}

.fmb-featured-guide{
  position:relative;
  left:50%;
  width:100vw;
  margin-left:-50vw;
  padding:18px 0 70px;
  background:#f8f5ee;
  color:#fff;
}

.fmb-featured-guide-shell{
  width:min(1460px,calc(100% - 56px));
  margin:0 auto;
}

.fmb-featured-guide-card{
  position:relative;
  min-height:250px;
  overflow:hidden;
  border:1px solid rgba(168,122,49,.72);
  border-radius:22px;
  background:#07110d;
  box-shadow:0 20px 48px rgba(50,35,17,.10);
}

.fmb-featured-guide-art{
  position:absolute;
  inset:0 0 0 auto;
  width:72%;
  height:100%;
  object-fit:cover;
  object-position:center 48%;
}

.fmb-featured-guide-overlay{
  position:absolute;
  inset:0;
  background:
    linear-gradient(90deg,
      #07110d 0%,
      #07110d 31%,
      rgba(7,17,13,.95) 40%,
      rgba(7,17,13,.70) 52%,
      rgba(7,17,13,.24) 67%,
      rgba(7,17,13,.06) 100%),
    linear-gradient(0deg,rgba(3,8,6,.24),transparent 52%);
}

.fmb-featured-guide-content{
  position:relative;
  z-index:2;
  min-height:250px;
  display:grid;
  grid-template-columns:58px minmax(0,1fr) auto;
  gap:20px;
  align-items:center;
  padding:34px 38px;
}

.fmb-featured-guide-icon{
  display:grid;
  place-items:center;
  width:52px;
  height:52px;
  border:1px solid rgba(226,188,116,.30);
  border-radius:50%;
  background:rgba(12,20,16,.74);
  color:#e3bf75;
  box-shadow:0 8px 20px rgba(0,0,0,.18);
}
.fmb-featured-guide-icon svg{
  width:25px;
  height:25px;
  fill:none;
  stroke:currentColor;
  stroke-width:1.7;
  stroke-linecap:round;
  stroke-linejoin:round;
}

.fmb-featured-guide-copy{
  max-width:720px;
}
.fmb-featured-guide-kicker{
  display:block;
  color:#c89e51;
  font:900 10px/1 Arial,sans-serif;
  letter-spacing:.15em;
}
.fmb-featured-guide-copy h2{
  margin:9px 0 0;
  color:#fff8ea;
  font:700 clamp(30px,3.1vw,48px)/1.02 Georgia,"Times New Roman",serif;
  letter-spacing:-.025em;
}
.fmb-featured-guide-copy p{
  margin:12px 0 0;
  max-width:640px;
  color:#cbbfae;
  font:400 15px/1.5 Arial,sans-serif;
}

.fmb-featured-guide-action{
  align-self:center;
  justify-self:end;
}
.fmb-featured-guide-button{
  display:inline-flex;
  min-width:146px;
  min-height:50px;
  align-items:center;
  justify-content:center;
  gap:8px;
  padding:0 18px;
  border:1px solid rgba(222,181,102,.58);
  border-radius:10px;
  background:rgba(7,17,13,.72);
  color:#f8ead1!important;
  font:800 12px/1 Arial,sans-serif;
  text-decoration:none!important;
  backdrop-filter:blur(5px);
  transition:transform .18s ease,background .18s ease,border-color .18s ease;
}
a.fmb-featured-guide-button:hover{
  transform:translateY(-2px);
  background:rgba(180,112,13,.88);
  border-color:#d5a754;
}
.fmb-featured-guide-button.is-disabled{
  opacity:.62;
  cursor:default;
}

@media(max-width:980px){
  .fmb-featured-guide-art{
    width:84%;
  }
  .fmb-featured-guide-overlay{
    background:
      linear-gradient(90deg,#07110d 0%,rgba(7,17,13,.96) 40%,rgba(7,17,13,.56) 70%,rgba(7,17,13,.16) 100%),
      linear-gradient(0deg,rgba(3,8,6,.34),transparent 54%);
  }
  .fmb-featured-guide-content{
    grid-template-columns:52px minmax(0,1fr);
  }
  .fmb-featured-guide-action{
    grid-column:2;
    justify-self:start;
  }
}

@media(max-width:700px){
  .fmb-featured-guide{
    padding:12px 0 48px;
  }
  .fmb-featured-guide-shell{
    width:min(100% - 24px,680px);
  }
  .fmb-featured-guide-card{
    min-height:430px;
  }
  .fmb-featured-guide-art{
    width:100%;
    height:55%;
    top:auto;
    bottom:0;
    object-position:62% 48%;
  }
  .fmb-featured-guide-overlay{
    background:
      linear-gradient(180deg,#07110d 0%,#07110d 44%,rgba(7,17,13,.78) 62%,rgba(7,17,13,.18) 100%);
  }
  .fmb-featured-guide-content{
    min-height:430px;
    display:block;
    padding:26px 22px;
  }
  .fmb-featured-guide-icon{
    width:46px;
    height:46px;
    margin-bottom:18px;
  }
  .fmb-featured-guide-copy h2{
    font-size:34px;
  }
  .fmb-featured-guide-copy p{
    font-size:14px;
  }
  .fmb-featured-guide-action{
    margin-top:20px;
  }
}


/* ===== HOME v2.3.19 · BANNER DE GUIA INTEIRO CLICÁVEL ===== */
.fmb-featured-guide-card--link{
  display:block;
  color:inherit!important;
  text-decoration:none!important;
  cursor:pointer;
  outline:none;
  transition:
    transform .18s ease,
    border-color .18s ease,
    box-shadow .18s ease;
}

.fmb-featured-guide-card--link .fmb-featured-guide-art{
  transition:transform .35s ease, filter .25s ease;
}

.fmb-featured-guide-card--link .fmb-featured-guide-button{
  transition:
    transform .18s ease,
    background .18s ease,
    border-color .18s ease,
    color .18s ease;
}

.fmb-featured-guide-card--link:hover{
  transform:translateY(-2px);
  border-color:#d3a24e;
  box-shadow:
    0 24px 58px rgba(50,35,17,.16),
    0 0 0 1px rgba(211,162,78,.10);
}

.fmb-featured-guide-card--link:hover .fmb-featured-guide-art{
  transform:scale(1.018);
  filter:saturate(1.04) contrast(1.02);
}

.fmb-featured-guide-card--link:hover .fmb-featured-guide-button{
  transform:translateY(-1px);
  background:rgba(180,112,13,.90);
  border-color:#d5a754;
  color:#fff8e9!important;
}

.fmb-featured-guide-card--link:focus-visible{
  box-shadow:
    0 0 0 3px #f8f5ee,
    0 0 0 6px #b77916,
    0 20px 48px rgba(50,35,17,.12);
}

.fmb-featured-guide-card--link:active{
  transform:translateY(0);
}

@media (prefers-reduced-motion: reduce){
  .fmb-featured-guide-card--link,
  .fmb-featured-guide-card--link .fmb-featured-guide-art,
  .fmb-featured-guide-card--link .fmb-featured-guide-button{
    transition:none!important;
  }
}


/* ===== HOME v2.3.20 · LINKS DO PAINEL "NA FORJA AGORA" ===== */
#votacao-proxima-build{
  scroll-margin-top:110px;
}

@media (prefers-reduced-motion: no-preference){
  html{
    scroll-behavior:smooth;
  }
}


/* ===== HOME v2.3.21 · VOTAÇÃO REAL/PERSISTENTE ===== */
.fmb-cycle-vote.is-loading .fmb-cycle-vote-button{
  cursor:wait!important;
  opacity:.78!important;
}

.fmb-cycle-vote.is-confirmed .fmb-cycle-candidate{
  cursor:default;
}

.fmb-cycle-vote.is-confirmed .fmb-cycle-candidate input,
.fmb-cycle-vote.is-closed .fmb-cycle-candidate input{
  pointer-events:none;
}

.fmb-cycle-vote.is-confirmed .fmb-cycle-candidate.is-selected{
  opacity:1!important;
}

.fmb-cycle-vote.is-closed .fmb-cycle-vote-status{
  color:#7d7368!important;
}

.fmb-cycle-vote.is-closed .fmb-cycle-vote-status-dot{
  background:#8f8579!important;
  box-shadow:0 0 0 4px rgba(143,133,121,.10)!important;
}

.fmb-cycle-vote.is-closed .fmb-cycle-candidate{
  opacity:.62;
  cursor:not-allowed;
}

.fmb-cycle-vote.is-closed .fmb-cycle-candidate:hover .fmb-cycle-candidate-card{
  transform:none!important;
  border-color:#dbc7a6!important;
  box-shadow:0 8px 18px rgba(66,45,20,.04)!important;
}

.fmb-cycle-vote.is-closed .fmb-cycle-candidate:hover .fmb-cycle-candidate-card img{
  transform:none!important;
}


/* ===== HOME 2.3.23 · Guia de Invocações em destaque ===== */
.fmb-featured-guide-shell{display:grid;gap:18px}
.fmb-featured-guide-card--invocations .fmb-featured-guide-art{object-position:center 52%}
.fmb-featured-guide-card--invocations .fmb-featured-guide-overlay{
  background:
    linear-gradient(90deg,rgba(2,15,10,.99) 0%,rgba(2,15,10,.94) 25%,rgba(3,18,12,.78) 47%,rgba(3,18,12,.26) 70%,rgba(3,18,12,.04) 100%),
    linear-gradient(180deg,rgba(0,0,0,.08),rgba(0,0,0,.16))
}
.fmb-forja-now-icon--invocations{
  color:#63d58e!important;background:#0a2c1d!important;border-color:rgba(99,213,142,.24)!important
}
.fmb-forja-now-item--invocations .fmb-forja-now-item-copy strong{
  white-space:normal!important;max-width:310px
}
@media(min-width:1080px){
  .fmb-forja-now-item--invocations .fmb-forja-now-item-copy strong{font-size:15px;line-height:1.08}
}
@media(max-width:760px){.fmb-featured-guide-shell{gap:14px}}


/* ===== HOME v2.3.25 · Guia de Magias / Spells ===== */
.fmb-featured-guide-card--spells .fmb-featured-guide-art{
  object-position:center 48%;
}
.fmb-featured-guide-card--spells .fmb-featured-guide-overlay{
  background:
    linear-gradient(90deg,
      #06110d 0%,
      #06110d 29%,
      rgba(6,17,13,.97) 38%,
      rgba(6,17,13,.76) 50%,
      rgba(6,17,13,.28) 66%,
      rgba(6,17,13,.04) 100%),
    linear-gradient(0deg,rgba(2,8,5,.22),transparent 54%);
}
.fmb-forja-now-icon--spells{
  color:#70e49b!important;
  background:#082a1b!important;
  border-color:rgba(112,228,155,.26)!important;
}
.fmb-forja-now-item--spells .fmb-forja-now-item-copy strong{
  white-space:normal!important;
  max-width:310px;
}
@media(min-width:1080px){
  .fmb-forja-now-item--spells .fmb-forja-now-item-copy strong{
    font-size:15px;
    line-height:1.08;
  }
}
@media(max-width:700px){
  .fmb-featured-guide-card--spells .fmb-featured-guide-art{
    object-position:66% 48%;
  }
}


/* ===== HOME v2.3.27 · ALINHAMENTO DOS CARDS DO CICLO ===== */
/* Desktop/tablet: Build Atual e Próxima Build passam a iniciar o conteúdo textual
   na mesma linha visual. Mobile preserva a geometria aprovada de 300px. */
@media(min-width:761px){
  .fmb-build-cycle .fmb-cycle-current-media,
  .fmb-build-cycle .fmb-cycle-current-media img,
  .fmb-build-cycle .fmb-cycle-next-media,
  .fmb-build-cycle .fmb-cycle-next-media img{
    min-height:390px!important;
    height:390px!important;
  }

  .fmb-build-cycle .fmb-cycle-current .fmb-cycle-card-copy,
  .fmb-build-cycle .fmb-cycle-next .fmb-cycle-card-copy{
    display:flex!important;
    flex-direction:column!important;
    justify-content:flex-start!important;
  }
}


/* ===== HUB BUILDS v2.3.28-TESTE · PREVIEW APROVADA ===== */
/* Escopo restrito ao Hub de Builds. Não altera Home, Build Voldemort ou votação. */
.fmb-hub .fmb-hub-intro{
  padding:30px 0 18px;
}

.fmb-hub .fmb-featured-art-full{
  aspect-ratio:2.45/1;
  object-fit:cover;
  object-position:center 32%;
}

.fmb-hub .fmb-featured-footer{
  padding:22px 26px 24px;
}

.fmb-hub .fmb-build-catalog{
  margin:40px auto 0;
  padding-bottom:18px;
}

.fmb-hub .fmb-catalog-head{
  gap:32px;
  padding-bottom:17px;
}

.fmb-hub .fmb-build-grid{
  grid-template-columns:minmax(0,1fr) minmax(280px,.43fr);
  gap:16px;
  margin-top:18px;
}

.fmb-hub .fmb-build-card-link{
  grid-template-columns:40% minmax(0,60%);
  min-height:318px;
}

.fmb-hub .fmb-build-card-body{
  padding:24px 28px;
}

.fmb-hub .fmb-build-card--future{
  min-height:318px;
}

.fmb-hub .fmb-future-inner{
  padding:24px;
}

.fmb-hub .fmb-future-inner img{
  width:74px;
  height:74px;
}

/* Continue na Forja — padrão canônico do Hub de Builds. */
.fmb-builds-continue{
  width:min(1320px,calc(100% - 40px));
  margin:14px auto 46px;
  color:var(--hub-body);
}

.fmb-builds-divider{
  display:grid;
  grid-template-columns:minmax(0,1fr) 18px minmax(0,1fr);
  align-items:center;
  gap:10px;
  width:100%;
  margin:5px 0 16px;
}

.fmb-builds-divider-line{
  display:block;
  height:1px;
}

.fmb-builds-divider-line--left{
  background:linear-gradient(90deg,rgba(201,149,63,0) 0%,rgba(201,149,63,.28) 18%,rgba(201,149,63,.58) 72%,rgba(216,179,106,.88) 100%);
}

.fmb-builds-divider-line--right{
  background:linear-gradient(90deg,rgba(216,179,106,.88) 0%,rgba(201,149,63,.58) 28%,rgba(201,149,63,.28) 82%,rgba(201,149,63,0) 100%);
}

.fmb-builds-divider-diamond{
  display:grid;
  place-items:center;
  width:18px;
  height:18px;
}

.fmb-builds-divider-diamond svg{
  display:block;
  width:14px;
  height:14px;
  fill:none;
  stroke:#c9953f;
  stroke-width:1.2;
  stroke-linejoin:round;
}

.fmb-builds-continue-head{
  max-width:860px;
  margin:0 auto 18px;
  text-align:center;
}

.fmb-builds-continue-head .fmb-hub-eyebrow{
  text-align:center;
}

.fmb-builds-continue-head h2{
  margin:6px 0 0;
  color:var(--hub-ink);
  font-size:36px;
  line-height:1.02;
}

.fmb-builds-continue-head p{
  max-width:720px;
  margin:10px auto 0;
  color:var(--hub-muted);
  font-size:13px;
  line-height:1.55;
}

.fmb-builds-continue-grid{
  display:grid;
  grid-template-columns:repeat(3,minmax(0,1fr));
  gap:12px;
}

.fmb-builds-continue-card{
  position:relative;
  display:grid;
  grid-template-columns:82px minmax(0,1fr);
  gap:14px;
  align-items:center;
  min-height:132px;
  padding:15px 16px;
  overflow:hidden;
  border:1px solid #d7cfbd;
  border-radius:15px;
  background:#fffdfa;
  color:inherit!important;
  box-shadow:0 7px 20px rgba(43,34,23,.04);
  transition:transform .16s ease,border-color .16s ease,box-shadow .16s ease;
}

.fmb-builds-continue-card:before{
  content:"";
  position:absolute;
  left:0;
  top:12px;
  bottom:12px;
  width:3px;
  border-radius:3px;
  background:linear-gradient(#b98939,#d3b36e);
}

.fmb-builds-continue-card:hover,
.fmb-builds-continue-card:focus-visible{
  transform:translateY(-2px);
  border-color:#c8b68e;
  box-shadow:0 10px 26px rgba(43,34,23,.08);
  outline:none;
}

.fmb-builds-icon-frame{
  display:grid;
  place-items:center;
  width:76px;
  height:76px;
  overflow:hidden;
  border:1px solid #d9c79d;
  border-radius:14px;
  background:#F7F0DF;
}

.fmb-builds-icon-frame img{
  display:block;
  width:70px;
  height:70px;
  object-fit:contain;
  transform:scale(1.10);
}

.fmb-builds-card-copy{
  display:block;
  min-width:0;
}

.fmb-builds-card-kicker{
  display:block;
  color:var(--hub-gold);
  font:800 8px/1.15 Arial,sans-serif;
  letter-spacing:.12em;
  text-transform:uppercase;
}

.fmb-builds-card-copy>strong{
  display:block;
  margin-top:4px;
  color:var(--hub-ink);
  font:700 20px/1.05 Georgia,"Times New Roman",serif;
}

.fmb-builds-card-copy>span:not(.fmb-builds-card-kicker){
  display:block;
  margin-top:6px;
  color:var(--hub-muted);
  font:400 11px/1.45 Arial,sans-serif;
}

.fmb-builds-card-copy>b{
  display:block;
  margin-top:8px;
  color:var(--hub-green);
  font:800 9px/1 Arial,sans-serif;
}

.fmb-builds-return-strip{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:14px;
  margin-top:12px;
  padding:11px 14px;
  border:1px solid #d8cfbf;
  border-radius:12px;
  background:#f3ede1;
}

.fmb-builds-return-strip span{
  color:#6a5f53;
  font:800 9px/1.2 Arial,sans-serif;
  letter-spacing:.08em;
  text-transform:uppercase;
}

.fmb-builds-return-strip a{
  color:var(--hub-green)!important;
  font:800 10px/1 Arial,sans-serif;
}

@media(max-width:900px){
  .fmb-hub .fmb-build-grid{
    grid-template-columns:1fr;
  }
  .fmb-hub .fmb-build-card--future{
    min-height:230px;
  }
  .fmb-builds-continue-grid{
    grid-template-columns:1fr 1fr;
  }
  .fmb-builds-continue-card:last-child{
    grid-column:1/-1;
  }
}

@media(max-width:680px){
  .fmb-hub .fmb-hub-intro{
    padding-top:24px;
  }
  .fmb-hub .fmb-featured-art-full{
    aspect-ratio:1.2/1;
    object-position:center 26%;
  }
  .fmb-hub .fmb-featured-footer{
    padding:19px 17px 21px;
  }
  .fmb-hub .fmb-build-catalog{
    margin-top:30px;
  }
  .fmb-hub .fmb-build-card-link{
    grid-template-columns:1fr;
    min-height:auto;
  }
  .fmb-hub .fmb-build-card-art{
    height:260px;
  }
  .fmb-hub .fmb-build-card-body{
    padding:21px 18px;
  }
  .fmb-builds-continue{
    width:calc(100% - 22px);
    margin-top:8px;
  }
  .fmb-builds-divider{
    gap:7px;
    margin:3px 0 12px;
  }
  .fmb-builds-continue-head h2{
    font-size:29px;
  }
  .fmb-builds-continue-grid{
    grid-template-columns:1fr;
  }
  .fmb-builds-continue-card:last-child{
    grid-column:auto;
  }
  .fmb-builds-continue-card{
    grid-template-columns:72px minmax(0,1fr);
    min-height:118px;
    padding:12px;
  }
  .fmb-builds-icon-frame{
    width:66px;
    height:66px;
  }
  .fmb-builds-icon-frame img{
    width:60px;
    height:60px;
  }
  .fmb-builds-return-strip{
    align-items:flex-start;
    flex-direction:column;
  }
}



/* Structural clone: approved level 19 -> level 20 */
.fmb-block-20{
  --paper:#fbfaf6;--white:#fff;--ink:#1f1b17;--body:#403a33;--muted:#70675e;
  --line:#ddd4c5;--gold:#9b6b18;--green:#28513e;--green-soft:#f2f7f3;
  --silver:#eef1ef;--dark:#08100c;
}
.fmb-block-20 *{box-sizing:border-box}
.fmb-block-20{margin:0;background:#f1f0ec;color:var(--body);font-family:Georgia,"Times New Roman",serif}
.fmb-block-20 .preview{width:min(1360px,calc(100% - 48px));margin:34px auto}
.fmb-block-20 .level{
  display:grid;grid-template-columns:210px minmax(0,1fr);
  border:1px solid var(--line);border-radius:24px;overflow:hidden;background:var(--paper)
}
.fmb-block-20 .progress-side{
  position:relative;height:auto;min-height:100%;padding:28px 18px 24px;
  background:radial-gradient(circle at 50% 35%,rgba(58,125,84,.36),transparent 29%),
             linear-gradient(180deg,#0d1c14,#07100b);
  color:#fff;display:flex;flex-direction:column;align-items:center;overflow:hidden
}
.fmb-block-20 .phase{position:relative;z-index:4;font:800 10px/1.25 Arial,sans-serif;letter-spacing:.16em;text-transform:uppercase;color:#ddcda9;text-align:center}
.fmb-block-20 .level-no{position:relative;z-index:4;margin-top:14px;width:76px;height:76px;border-radius:50%;display:grid;place-items:center;background:#f6f3eb;border:3px solid #a8792d;color:#1f1b17;font:bold 34px/1 Georgia,serif}
.fmb-block-20 .timeline{position:absolute;z-index:1;top:118px;height:170px;left:50%;width:2px;transform:translateX(-50%);background:linear-gradient(#c5b79c,#6b8374 55%,#244a37);opacity:.78}
.fmb-block-20 .snake-wrap{position:relative;z-index:3;width:158px;height:215px;min-height:215px;margin:12px auto 8px;display:flex;align-items:flex-start;justify-content:center;flex:0 0 215px}
.fmb-block-20 .snake-wrap img{display:block;width:100%;height:100%;max-height:215px;object-fit:contain;object-position:center top;filter:drop-shadow(0 15px 22px rgba(0,0,0,.48))}
.fmb-block-20 .side-sheet{position:relative;z-index:5;width:100%;margin-top:4px;padding:16px 0 0;border-top:1px solid rgba(221,205,169,.24);background:#102419}
.fmb-block-20 .side-section + .side-section{margin-top:16px}
.fmb-block-20 .side-label{display:block;margin-bottom:8px;color:#ddcda9;font:800 9px/1.2 Arial,sans-serif;letter-spacing:.14em;text-transform:uppercase;text-align:left}
.fmb-block-20 .stats-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:6px}
.fmb-block-20 .stat{padding:7px 5px 6px;border:1px solid rgba(255,255,255,.12);border-radius:9px;background:rgba(255,255,255,.045);text-align:center}
.fmb-block-20 .stat small{display:block;color:#b8c6bd;font:800 8px/1 Arial,sans-serif}
.fmb-block-20 .stat strong{display:block;margin-top:3px;color:#fff;font-size:18px;line-height:1}
.fmb-block-20 .stat span{display:block;margin-top:3px;color:#8fb09d;font:700 9px/1 Arial,sans-serif}
.fmb-block-20 .panel{padding:11px 12px;border:1px solid rgba(255,255,255,.11);border-radius:11px;background:rgba(255,255,255,.04)}
.fmb-block-20 .row{display:flex;align-items:flex-start;justify-content:space-between;gap:10px;padding:6px 0;border-top:1px solid rgba(255,255,255,.08)}
.fmb-block-20 .row:first-of-type{border-top:0}
.fmb-block-20 .row small{color:#b8c6bd;font:700 9px/1.25 Arial,sans-serif}
.fmb-block-20 .row strong{max-width:92px;color:#fff;font-size:11px;line-height:1.2;text-align:right}
.fmb-block-20 .resource-mini{display:grid;grid-template-columns:1fr 1fr;gap:8px}
.fmb-block-20 .resource-mini > div{padding:9px 7px;border:1px solid rgba(255,255,255,.09);border-radius:9px;background:rgba(255,255,255,.035);text-align:center}
.fmb-block-20 .resource-mini small{display:block;color:#b8c6bd;font:700 8px/1.25 Arial,sans-serif}
.fmb-block-20 .resource-mini strong{display:block;margin-top:5px;color:#fff;font-size:20px;line-height:1}
.fmb-block-20 .arcana-list{display:grid;gap:7px}
.fmb-block-20 .arcana-row{padding:8px 9px;border:1px solid rgba(255,255,255,.09);border-radius:9px;background:rgba(255,255,255,.035)}
.fmb-block-20 .arcana-row small{display:block;color:#9ab4a4;font:700 7.5px/1.2 Arial,sans-serif;text-transform:uppercase}
.fmb-block-20 .arcana-row strong{display:block;margin-top:4px;color:#fff;font-size:11px;line-height:1.25}
.fmb-block-20 .arcana-row em{display:block;margin-top:2px;color:#b8c6bd;font:italic 8px/1.2 Georgia,serif}
.fmb-block-20 .wishlist-panel{border-color:rgba(166,198,178,.26);background:rgba(41,84,61,.18)}
.fmb-block-20 .wishlist-item{padding:10px;border:1px solid rgba(255,255,255,.10);border-radius:10px;background:rgba(255,255,255,.035)}
.fmb-block-20 .wishlist-head{display:flex;justify-content:space-between;align-items:flex-start;gap:8px}
.fmb-block-20 .wishlist-head strong{color:#fff;font-size:12px;line-height:1.25}
.fmb-block-20 .wishlist-head span{flex:0 0 auto;padding:3px 6px;border:1px solid rgba(215,190,130,.35);border-radius:999px;color:#ddcda9;font:800 7px/1 Arial,sans-serif;text-transform:uppercase;letter-spacing:.08em}
.fmb-block-20 .wishlist-item>small{display:block;margin-top:3px;color:#9ab4a4;font:700 8px/1.2 Arial,sans-serif}
.fmb-block-20 .wishlist-item p{margin:8px 0 0;color:#d4ded8;font-size:10px;line-height:1.45}
.fmb-block-20 .wishlist-note{margin-top:9px;padding-top:8px;border-top:1px solid rgba(255,255,255,.08);color:#b9cbc0;font-size:9px;line-height:1.4}
.fmb-block-20 .wishlist-note strong{display:block;margin-bottom:3px;color:#fff;font-size:9px}
.fmb-block-20 .timeline-resume{position:relative;z-index:1;width:2px;height:110px;margin:0 auto -24px;background:linear-gradient(#6b8374,#244a37);opacity:.78}
.fmb-block-20 .content{padding:30px 34px 32px 22px}
.fmb-block-20 .kicker,.fmb-block-20 .mini-label{color:var(--gold);font:800 10px/1.2 Arial,sans-serif;letter-spacing:.14em;text-transform:uppercase}
.fmb-block-20 h1,.fmb-block-20 h2,.fmb-block-20 h3{margin:0;color:var(--ink)}
.fmb-block-20 h1{margin-top:7px;font-size:42px;line-height:1}
.fmb-block-20 .lead{margin:13px 0 0;max-width:1080px;font-size:16px;line-height:1.62}
.fmb-block-20 .strip{margin-top:18px;display:flex;flex-wrap:wrap;gap:8px}
.fmb-block-20 .strip span{padding:8px 11px;border:1px solid var(--line);border-radius:999px;background:#fff;font:700 11px/1 Arial,sans-serif;color:var(--muted)}
.fmb-block-20 .strip strong{color:var(--ink)}
.fmb-block-20 .boon-card{margin-top:22px;padding:19px 20px;border:1px solid #91ad9d;border-radius:16px;background:linear-gradient(180deg,#fff,var(--green-soft))}
.fmb-block-20 .boon-card h2{margin-top:4px;font-size:26px}
.fmb-block-20 .boon-card p{margin:8px 0 0;font-size:14px;line-height:1.58}
.fmb-block-20 .boon-grid{display:grid;grid-template-columns:.72fr 1.28fr;gap:12px;margin-top:13px}
.fmb-block-20 .ability-box{display:flex;align-items:center;gap:12px;padding:14px;border:1px solid #d6c39d;border-radius:12px;background:#faf7ef}
.fmb-block-20 .score{width:66px;height:66px;border-radius:50%;display:grid;place-items:center;flex:0 0 auto;background:#fff;border:2px solid var(--gold);font:bold 21px/1.05 Georgia,serif;color:var(--ink);text-align:center}
.fmb-block-20 .ability-box strong{display:block;color:var(--ink);font-size:16px}
.fmb-block-20 .ability-box span{display:block;margin-top:4px;color:var(--muted);font-size:12px;line-height:1.45}
.fmb-block-20 .fate-box{padding:14px 15px;border:1px solid #c7d3cb;border-radius:12px;background:#fff}
.fmb-block-20 .fate-box strong{display:block;color:var(--ink);font-size:18px}
.fmb-block-20 .fate-box p{margin:6px 0 0;font-size:13px;line-height:1.52}
.fmb-block-20 .fate-highlight{margin-top:10px;padding:10px 12px;border-left:4px solid var(--green);border-radius:9px;background:#f3f7f4;font-size:12px;line-height:1.5}
.fmb-block-20 .section-break{margin-top:20px;padding-top:14px;border-top:1px solid var(--line)}
.fmb-block-20 .section-break span{color:var(--gold);font:800 10px/1.2 Arial,sans-serif;letter-spacing:.14em;text-transform:uppercase}
.fmb-block-20 .spell-section{margin-top:12px;display:grid;grid-template-columns:1.1fr .9fr;gap:12px}
.fmb-block-20 .card{padding:17px 18px;border:1px solid var(--line);border-radius:15px;background:#fff}
.fmb-block-20 .card.green{border-color:#a9bdb1;background:#f3f7f4}
.fmb-block-20 .card.gold{border-color:#d5bf95;background:#faf7ef}
.fmb-block-20 .card h2{margin-top:4px;font-size:22px}
.fmb-block-20 .card p{margin:7px 0 0;font-size:13px;line-height:1.56}
.fmb-block-20 .storm-stats{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-top:11px}
.fmb-block-20 .storm-stat{padding:10px;border:1px solid #cad5ce;border-radius:10px;background:#fff;text-align:center}
.fmb-block-20 .storm-stat small{display:block;color:var(--green);font:800 8px/1.2 Arial,sans-serif;text-transform:uppercase}
.fmb-block-20 .storm-stat strong{display:block;margin-top:4px;color:var(--ink);font-size:15px}
.fmb-block-20 .storm-stat span{display:block;margin-top:3px;color:var(--muted);font-size:10px;line-height:1.35}
.fmb-block-20 .combat{margin-top:18px;padding:16px 17px;border-left:4px solid var(--green);background:#fff}
.fmb-block-20 .combat h2{margin-top:4px;font-size:23px}
.fmb-block-20 .combat p{margin:8px 0 0;font-size:14px;line-height:1.6}
.fmb-block-20 .tactic-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:9px;margin-top:12px}
.fmb-block-20 .tactic{padding:12px;border:1px solid #cad3cd;border-radius:11px;background:var(--silver)}
.fmb-block-20 .tactic small{display:block;color:var(--green);font:800 9px/1.2 Arial,sans-serif;text-transform:uppercase;letter-spacing:.08em}
.fmb-block-20 .tactic strong{display:block;margin-top:4px;color:var(--ink);font-size:14px}
.fmb-block-20 .tactic p{margin:5px 0 0;font-size:12px;line-height:1.45}
.fmb-block-20 .priority{margin-top:11px;padding:10px 12px;border-radius:10px;background:#17261f;color:#edf3ef;font:800 11px/1.45 Arial,sans-serif}
.fmb-block-20 .dark-lord-line{margin-top:11px;padding:11px 13px;border-left:3px solid var(--green);border-radius:9px;background:var(--green-soft);color:#35483e;font-size:13px;line-height:1.52;font-style:italic}
@media  (max-width:900px){.fmb-block-20 .boon-grid,.fmb-block-20 .spell-section{grid-template-columns:1fr}}
@media  (max-width:760px){.fmb-block-20 .preview{width:calc(100% - 20px);margin:10px auto}.fmb-block-20 .level{grid-template-columns:1fr}.fmb-block-20 .progress-side{min-height:780px}.fmb-block-20 .snake-wrap{width:145px;height:195px;min-height:195px;flex-basis:195px;margin:10px auto 6px}.fmb-block-20 .side-sheet{max-width:420px;margin:8px auto 0}.fmb-block-20 .timeline-resume{display:none}.fmb-block-20 .content{padding:24px 20px 26px}.fmb-block-20 .storm-stats,.fmb-block-20 .tactic-grid{grid-template-columns:1fr}.fmb-block-20 h1{font-size:35px}}
.fmb-block-20 .tome-synergy{
  margin-top:12px;
  padding:16px 17px;
  border:1px solid #9fb5a8;
  border-radius:14px;
  background:linear-gradient(180deg,#f8fbf9,#edf5f0);
}
.fmb-block-20 .tome-synergy h2{margin-top:4px;font-size:22px}
.fmb-block-20 .tome-synergy p{margin:7px 0 0;font-size:13px;line-height:1.58}

/* Duncan · aprovada para TESTE visual dos níveis 1–2; sobreposição sobre Builds CSS original.
   Paleta proposta em conversa: verde-oliva #354A35, azul-aço #647785, âmbar #A96239,
   ouro envelhecido #B99B65, pergaminho #EDE4D2. Não altera o CSS-base. */
:root{--dk-green:#354A35;--dk-steel:#647785;--dk-amber:#A96239;--dk-gold:#B99B65;--dk-parchment:#EDE4D2}
html{scroll-behavior:smooth}
body{margin:0;background:#e9e4d9;color:#252a24;font-family:Georgia,serif}
.duncan-prototype-header{width:min(1360px,calc(100% - 48px));margin:24px auto 3px;display:flex;align-items:center;flex-wrap:wrap;gap:14px 25px;justify-content:space-between;padding:19px 22px;background:#263a2c;border:1px solid #5f685c;border-radius:16px;color:#f6efe2;box-shadow:0 16px 34px rgba(21,29,24,.12)}
.dp-name{font:bold 22px/1 Georgia,serif;letter-spacing:.09em}.dp-name span{font:700 10px Arial,sans-serif;letter-spacing:.22em;color:#ddc8a4}
.duncan-prototype-header nav{display:flex;gap:8px}.duncan-prototype-header nav a{padding:10px 13px;color:#fdfaf3;text-decoration:none;border:1px solid #9a976e;border-radius:99px;background:#425843;font:700 11px Arial,sans-serif}
.duncan-prototype-header nav a:hover{background:#647785}
.duncan-prototype-header p{margin:0;font:700 10px Arial,sans-serif;letter-spacing:.07em;color:#ece6d8}.dp-dot{display:inline-block;width:7px;height:7px;margin-right:4px;background:#B99B65;border-radius:50%}
.fmb-build-root--duncan{background:#e9e4d9;width:100%;left:auto;margin:0;isolation:auto;overflow:visible}
.fmb-build-root--duncan .fmb-block{--paper:#f8f4eb;--white:#fffefb;--ink:#28352b;--body:#45423a;--muted:#6b695f;--line:#d6c9b5;--gold:#A96239;--gold-soft:#B99B65;--green:#354A35;--green-deep:#354A35;--green-soft:#e9eee9;--silver:#e6e9e7;--silver-line:#adbdc5;background:#e9e4d9}
.fmb-build-root--duncan .preview{margin-top:26px;margin-bottom:24px}
.fmb-block-1 .top{background:#fffdf7}
.fmb-build-root--duncan .fmb-block-1 .block,.fmb-build-root--duncan .fmb-block-2 .level{box-shadow:0 18px 48px rgba(33,43,31,.09);border-color:#c9b9a1}
.fmb-build-root--duncan .fmb-block-1 .copy{background:linear-gradient(145deg,#fffef9,#f4f1e9)}
.fmb-build-root--duncan .fmb-block-1 .art{background:linear-gradient(148deg,#374b3b,#647785 66%,#2e3f36)}
.fmb-build-root--duncan .fmb-block-1 .art:after{background:linear-gradient(90deg,transparent 60%,rgba(236,229,215,.12))}
.duncan-empty-art{position:absolute;inset:0;min-height:610px;display:flex;align-items:center;justify-content:center;flex-direction:column;gap:17px;padding:30px;text-align:center;color:#f7f1e4;background:radial-gradient(ellipse at 40% 50%,rgba(237,228,210,.14),transparent 63%)}
.duncan-empty-art:before{content:'';position:absolute;inset:27px;border:1px solid rgba(237,228,210,.42);border-radius:10px;pointer-events:none}
.duncan-empty-art span{font:700 10px Arial,sans-serif;letter-spacing:.2em;color:#efcfa9}.duncan-empty-art strong{font:500 clamp(44px,5vw,65px)/1 Georgia,serif}.duncan-empty-art small{font:700 10px Arial,sans-serif;letter-spacing:.06em;color:#e6e0d5}
.fmb-build-root--duncan .fmb-block-1 .stage-tag{background:#253a2bcf;border-color:#b99b65}
.fmb-build-root--duncan .fmb-block-1 .attr.primary{background:#e9efe8;border-color:#94a692}
.fmb-build-root--duncan .fmb-block-1 .progression{background:#e8ebea;border-color:#a6b9c1;border-left-color:#647785}
.fmb-build-root--duncan .fmb-block-1 .tome{background:linear-gradient(180deg,#fff,#edf1ec);border-color:#a3b3a3}
.fmb-build-root--duncan .fmb-block-1 .tome-badge{background:#e2e9e0;color:#354A35;border-color:#92a88f}
.fmb-build-root--duncan .fmb-block-1 .magic-card,.fmb-build-root--duncan .fmb-block-1 .attr,.fmb-build-root--duncan .fmb-block-1 .info{box-shadow:0 5px 12px rgba(60,56,40,.03)}
.fmb-build-root--duncan .fmb-block-1 .play-box{border-left-color:#A96239}
.fmb-build-root--duncan .fmb-block-2 .progress-side{background:radial-gradient(circle at 50% 33%,rgba(100,119,133,.23),transparent 45%),linear-gradient(180deg,#354A35,#26392d)}
.fmb-build-root--duncan .fmb-block-2 .progress-side .level-no{border-color:#B99B65;background:#EDE4D2;color:#354A35}
.fmb-build-root--duncan .fmb-block-2 .progress-side .phase,.fmb-build-root--duncan .fmb-block-2 .fm-side-label{color:#e8c9a0}
.fmb-build-root--duncan .fmb-block-2 .progress-side .timeline{background:linear-gradient(#B99B65,#647785 70%,#c8d4ca)}
.fmb-build-root--duncan .fmb-block-2 .fm-side-sheet{background:#273c2f;border-top-color:#8e9d99}
.fmb-build-root--duncan .fmb-block-2 .fm-stat span{color:#b2c7cd}
.fmb-build-root--duncan .fmb-block-2 .fm-row strong{max-width:110px}
.duncan-sidebar-empty{display:flex;flex-direction:column;align-items:center;gap:8px;min-height:95px;padding:14px 8px;color:#f1e8d5;text-align:center;border:1px dashed rgba(237,228,210,.38);border-radius:9px;background:rgba(100,119,133,.15)}
.duncan-sidebar-empty small{font:700 9px Arial,sans-serif;letter-spacing:.15em;color:#d2b67f}.duncan-sidebar-empty strong{font:600 15px Georgia,serif}.duncan-sidebar-empty span{font:600 9px Arial,sans-serif;color:#e8e1d5}
.fmb-build-root--duncan .fmb-block-2 .compact-combat{border-left-color:#A96239;background:#fdfcf7}
.fmb-build-root--duncan .fmb-block-2 .compact-strip span{background:#fffefb}
.fmb-build-root--duncan .fmb-level-step{border-color:#B99B65;background:linear-gradient(120deg,#354A35,#293d30)}
.fmb-build-root--duncan .fmb-level-step-arrow{color:#EDE4D2}.fmb-build-root--duncan .fmb-level-step-copy small{color:#c6c9b3}
.fmb-build-root--duncan .fmb-level-step--disabled{opacity:.62;pointer-events:none}
.duncan-prototype-footer{width:min(1360px,calc(100% - 48px));margin:26px auto 55px;text-align:center;font:600 11px/1.7 Arial,sans-serif;color:#6b6658}
.fmb-build-root--duncan [id^="nivel-"]{scroll-margin-top:28px}
@media(max-width:850px){.duncan-prototype-header{width:calc(100% - 26px);margin-top:14px}.fmb-block-1 .art{min-height:370px}.duncan-empty-art{min-height:370px}}
@media(max-width:640px){.fmb-build-root--duncan .preview{width:calc(100% - 20px);margin-top:14px}.duncan-prototype-header{padding:14px;gap:14px}.dp-name{font-size:18px}.duncan-prototype-header nav{order:3;width:100%;justify-content:center}.duncan-prototype-header nav a{flex:1;text-align:center}.duncan-prototype-header p{font-size:9px}.duncan-empty-art{min-height:310px}.fmb-build-root--duncan .fmb-block-1 .art{min-height:310px}.duncan-prototype-footer{width:calc(100% - 28px)}}
/* Containment for narrow mobile viewports in the isolated preview. */
html,body{max-width:100%;overflow-x:clip}



/* DUNCAN-COLOR-REFINE-01 — camada de reskin forte sobre a página do plugin Builds.
   Escopo único: .fmb-build-root--duncan, cabeçalho e rodapé da PRÉVIA.
   CSS original da build intacto, estrutura HTML dos níveis 1 e 2 preservada.
   Identidade: aço escuro, verde heráldico profundo, ouro envelhecido, âmbar e pergaminho.
   Sem novas imagens e sem efeitos rasterizados: todos os relevos são CSS. */
:root {
  --duncan-forest:#20372b;
  --duncan-dark:#13231e;
  --duncan-olive:#354a35;
  --duncan-steel:#647785;
  --duncan-steel-dark:#344954;
  --duncan-amber:#a96239;
  --duncan-gold:#d2b277;
  --duncan-parchment:#ede4d2;
  --duncan-paper:#fcf8ef;
  --duncan-ink:#233127;
  --duncan-rule:#c6a16a;
}
html {scroll-behavior:smooth}
body {
  background:
    radial-gradient(ellipse 75% 30% at 9% 4%, rgba(100,119,133,.17),transparent 75%),
    radial-gradient(ellipse 58% 30% at 92% 79%, rgba(119,92,51,.11),transparent 75%),
    linear-gradient(180deg,#263a30 0%,#13251d 46%,#172820 100%);
  color:var(--duncan-parchment);
}
.duncan-prototype-header {
  background:linear-gradient(115deg,#101f1a 0%,#223b2c 61%,#394b3f 100%);
  border:1px solid rgba(210,178,119,.68);
  border-top:3px solid var(--duncan-gold);
  box-shadow:0 14px 35px rgba(4,13,10,.34),inset 0 1px rgba(255,255,255,.1);
}
.duncan-prototype-header .dp-name {color:#f7f0de;text-shadow:0 1px 0 #000}
.duncan-prototype-header .dp-name span {color:#eac991}
.duncan-prototype-header nav a {
  color:#f8ead1;
  background:#2d4536;
  border-color:#b99b65;
  box-shadow:inset 0 1px rgba(255,255,255,.1);
}
.duncan-prototype-header nav a:hover,.duncan-prototype-header nav a:focus-visible {background:#a96239;color:#fff;border-color:#e2bd81;outline:2px solid #f2d7a4;outline-offset:2px}
.duncan-prototype-header p {color:#eee1c8}
.dp-dot {background:#dfb778;box-shadow:0 0 0 3px rgba(223,183,120,.18)}
/* Escopo e tons base; painéis de leitura com alto contraste sobre um entorno forte */
.fmb-build-root--duncan {background:transparent}
.fmb-build-root--duncan .fmb-block {
  --paper:#fbf6eb;--white:#fffdf6;--ink:#203127;
  --body:#3d4037;--muted:#62665e;--line:#cbbda3;
  --gold:#9d542e;--gold-soft:#c7a46c;--green:#354a35;
  --green-deep:#254333;--green-soft:#e8e8da;
  --silver:#e4e6de;--silver-line:#8d9d9e;
  background:transparent;
}
.fmb-build-root--duncan .preview {margin-top:30px;margin-bottom:18px}
.fmb-build-root--duncan .fmb-block-1 .block,
.fmb-build-root--duncan .fmb-block-2 .level {
  border:2px solid #c2a371;
  box-shadow:0 28px 75px rgba(0,0,0,.37),0 3px 0 rgba(210,178,119,.16);
}
/* NÍVEL 1 — abertura em dois painéis da estrutura original */
.fmb-build-root--duncan .fmb-block-1 .top {background:#faf6e9}
.fmb-build-root--duncan .fmb-block-1 .art {
  background:
    radial-gradient(ellipse 54% 55% at 46% 44%,rgba(148,177,175,.3),transparent 73%),
    linear-gradient(128deg,rgba(214,175,103,.14) 0%,transparent 39%),
    repeating-linear-gradient(126deg,rgba(255,255,255,.015) 0px,rgba(255,255,255,.015) 1px,transparent 1px,transparent 8px),
    linear-gradient(150deg,#10231d,#314943 49%,#536c77 100%);
  border-right:6px solid #bd9c65;
}
.fmb-build-root--duncan .fmb-block-1 .art:after {background:linear-gradient(0deg,rgba(9,25,21,.38),transparent 48%)}
.fmb-build-root--duncan .duncan-empty-art {
  background:transparent;
  color:#f2e6cf;
}
.fmb-build-root--duncan .duncan-empty-art:before {
  border:1px solid rgba(222,189,131,.7);
  border-top:3px solid #cba465;
  box-shadow:inset 0 0 0 9px rgba(14,37,30,.17),0 0 30px rgba(13,24,21,.12);
}
.fmb-build-root--duncan .duncan-empty-art:after {
  content:"";
  position:absolute;
  inset:42px 43px;
  border-left:1px solid rgba(241,224,184,.18);
  border-right:1px solid rgba(241,224,184,.18);
  pointer-events:none;
}
.fmb-build-root--duncan .duncan-empty-art span {color:#e7bc79;letter-spacing:.25em}
.fmb-build-root--duncan .duncan-empty-art strong {color:#fff9e9;text-shadow:0 5px 20px rgba(5,16,14,.65);font-size:clamp(56px,6vw,86px)}
.fmb-build-root--duncan .duncan-empty-art small {color:#e5d5b8}
.fmb-build-root--duncan .fmb-block-1 .stage-tag {background:#142e23;color:#f7e3be;border-color:#d5a866;padding:11px 15px;box-shadow:0 8px 20px rgba(0,0,0,.3)}
.fmb-build-root--duncan .fmb-block-1 .copy {
  background:linear-gradient(160deg,#fffaf0,#f2e9d8);
  border-top:8px solid #314b3a;
  border-bottom:1px solid #d0b487;
}
.fmb-build-root--duncan .fmb-block-1 .copy h1 {color:#1c3427;letter-spacing:-.025em}
.fmb-build-root--duncan .fmb-block-1 .kicker,
.fmb-build-root--duncan .fmb-block-2 .kicker {color:#93502e}
.fmb-build-root--duncan .fmb-block-1 .copy .subtitle {color:#3d5940}
.fmb-build-root--duncan .fmb-block-1 .intro {color:#363d37}
.fmb-build-root--duncan .fmb-block-1 .status {gap:9px}
.fmb-build-root--duncan .fmb-block-1 .status-card {
  background:linear-gradient(155deg,#335343,#1c3529);
  border:1px solid #bfa16b;
  border-top:3px solid #dfbd7d;
  box-shadow:0 7px 16px rgba(17,45,30,.15);
  padding:13px 6px;
}
.fmb-build-root--duncan .fmb-block-1 .status-card span {color:#e9d9b9;line-height:1.28;font-weight:700}
.fmb-build-root--duncan .fmb-block-1 .status-card strong {color:#fff9ed;font-size:21px;text-shadow:0 1px rgba(0,0,0,.3)}
.fmb-build-root--duncan .fmb-block-1 .origin-grid .info {
  border:1px solid #ad9771;
  border-top:4px solid #476250;
  background:linear-gradient(180deg,#fffcf5,#efe5d2);
  box-shadow:0 9px 20px rgba(55,39,22,.09);
}
.fmb-build-root--duncan .fmb-block-1 .origin-grid .info:nth-child(2){border-top-color:#647785}
.fmb-build-root--duncan .fmb-block-1 .info h3{color:#244330}
.fmb-build-root--duncan .fmb-block-1 .feat{border-top-color:#b7a078}
.fmb-build-root--duncan .fmb-block-1 .feat-name {color:#254333}
/* Nível 1 — placas, atributos e ações */
.fmb-build-root--duncan .fmb-block-1 .section {
  background:linear-gradient(180deg,#f7f0e2,#ece2ce);
  border-top:3px solid #bda575;
}
.fmb-build-root--duncan .fmb-block-1 .section:nth-of-type(3) {background:linear-gradient(180deg,#f4ecda,#f9f4e8)}
.fmb-build-root--duncan .fmb-block-1 .section-head {padding-bottom:9px;border-bottom:1px solid #bfa876}
.fmb-build-root--duncan .fmb-block-1 .section h2 {color:#243d2c}
.fmb-build-root--duncan .fmb-block-1 .attr {
  background:#fffbf2;
  border:1px solid #c2ad86;
  border-top:3px solid #8c9ca0;
  box-shadow:0 5px 12px rgba(50,47,32,.08);
}
.fmb-build-root--duncan .fmb-block-1 .attr.primary {
  border:2px solid #44654b;
  border-top:5px solid #1f4930;
  background:linear-gradient(180deg,#d8e3d1,#f3f0df);
  box-shadow:0 7px 16px rgba(36,73,47,.14);
}
.fmb-build-root--duncan .fmb-block-1 .attr .score {color:#253f31;font-size:34px}
.fmb-build-root--duncan .fmb-block-1 .attr .mod {color:#516554}
.fmb-build-root--duncan .fmb-block-1 .attr.primary .score {color:#1e3d2b}
.fmb-build-root--duncan .fmb-block-1 .progression {
  background:linear-gradient(105deg,#203e31,#3b5647);
  border:1px solid #c3a26b;
  border-left:6px solid #d9ae64;
  color:#f6eede;
  box-shadow:0 8px 16px rgba(31,55,37,.16);
  padding:16px 17px;
}
.fmb-build-root--duncan .fmb-block-1 .progression strong {color:#fff2cf}
.fmb-build-root--duncan .fmb-block-1 .magic-card {
  background:linear-gradient(180deg,#fffbf3,#f4ead8);
  border:1px solid #baa17d;
  border-top:4px solid #647785;
  box-shadow:0 8px 20px rgba(55,39,22,.08);
}
.fmb-build-root--duncan .fmb-block-1 .magic-card.tome {
  border-top-color:#2c5839;
  background:linear-gradient(180deg,#f5f2e5,#dde4d5);
}
.fmb-build-root--duncan .fmb-block-1 .magic-card h3 {color:#21382a}
.fmb-build-root--duncan .fmb-block-1 .tome-badge {background:#244333;color:#fceac5;border:1px solid #bda16e}
.fmb-build-root--duncan .fmb-block-1 .source {color:#97572f}
.fmb-build-root--duncan .fmb-block-1 .play {
  background:linear-gradient(135deg,#213a2e,#172a22);
  border-top:4px solid #c39c5c;
  color:#f7ecdb;
}
.fmb-build-root--duncan .fmb-block-1 .play-box{border-left-color:#d3a866}
.fmb-build-root--duncan .fmb-block-1 .play h2,
.fmb-build-root--duncan .fmb-block-1 .play strong {color:#fff3d7}
.fmb-build-root--duncan .fmb-block-1 .play .kicker{color:#e8bc7a}
.fmb-build-root--duncan .fmb-block-1 .play p{color:#f5eedd}
.fmb-build-root--duncan .fmb-block-1 .combat-priority {
  background:rgba(128,153,128,.2);
  border:1px solid #769582;
  border-left:5px solid #dfb77c;
  color:#fff5e0;
}
.fmb-build-root--duncan .fmb-block-1 .combat-quote {background:rgba(251,239,210,.1);color:#f1dec1;border-left-color:#e2b778}
/* NÍVEL 2 — mesma geometria com aço, emblema de nível e sidebar heráldica */
.fmb-build-root--duncan .fmb-block-2 .level {background:#fbf6ea}
.fmb-build-root--duncan .fmb-block-2 .progress-side {
  background:
    radial-gradient(circle at 50% 13%,rgba(160,177,168,.24),transparent 30%),
    repeating-linear-gradient(155deg,rgba(255,255,255,.025) 0,rgba(255,255,255,.025) 1px,transparent 1px,transparent 9px),
    linear-gradient(165deg,#203a2d,#10241d 66%,#2c4551);
  border-right:4px solid #c4a16b;
}
.fmb-build-root--duncan .fmb-block-2 .progress-side .phase {color:#e9c58c;line-height:1.45}
.fmb-build-root--duncan .fmb-block-2 .progress-side .level-no {
  background:linear-gradient(140deg,#fff6d9,#d2ad71);
  color:#203527;
  border:4px double #8f6835;
  box-shadow:0 0 0 5px rgba(230,189,121,.21),0 9px 23px rgba(0,0,0,.3);
}
.fmb-build-root--duncan .fmb-block-2 .progress-side .timeline {background:linear-gradient(#d2b277,#8fa3a9 65%,#294d39);opacity:.85}
.fmb-build-root--duncan .fmb-block-2 .fm-side-sheet {background:transparent;border-top:2px solid #c3a16e;padding-top:21px}
.fmb-build-root--duncan .fmb-block-2 .fm-side-label {color:#e9c58c}
.fmb-build-root--duncan .fmb-block-2 .fm-stat {
  background:rgba(122,147,154,.17);
  border:1px solid rgba(199,168,103,.34);
}
.fmb-build-root--duncan .fmb-block-2 .fm-stat strong {color:#fff8ea}
.fmb-build-root--duncan .fmb-block-2 .fm-stat small {color:#cdd9d6}
.fmb-build-root--duncan .fmb-block-2 .fm-stat span {color:#eac78a}
.fmb-build-root--duncan .fmb-block-2 .fm-panel {border-color:#8b876a;background:rgba(10,29,23,.6)}
.fmb-build-root--duncan .fmb-block-2 .fm-row small,
.fmb-build-root--duncan .fmb-block-2 .fm-resource-mini small {color:#cedbd0}
.fmb-build-root--duncan .fmb-block-2 .fm-row strong,
.fmb-build-root--duncan .fmb-block-2 .fm-resource-mini strong {color:#fff3d7}
.fmb-build-root--duncan .fmb-block-2 .fm-resource-mini > div {border-color:rgba(209,177,119,.35);background:rgba(100,119,133,.2)}
.fmb-build-root--duncan .duncan-sidebar-empty {
  background:linear-gradient(160deg,rgba(190,164,113,.16),rgba(64,94,77,.24));
  border:1px solid rgba(224,189,126,.68);
  box-shadow:inset 0 0 0 4px rgba(7,29,19,.27);
  color:#fff0d2;
}
.fmb-build-root--duncan .duncan-sidebar-empty small{color:#e9c58c}
.fmb-build-root--duncan .duncan-sidebar-empty strong{color:#fff7e5;font-size:21px}
.fmb-build-root--duncan .duncan-sidebar-empty span{color:#e2d5be}
.fmb-build-root--duncan .fmb-block-2 .compact-content {
  background:linear-gradient(165deg,#fff9ed,#f1e7d5);
  border-top:8px solid #344e3c;
}
.fmb-build-root--duncan .fmb-block-2 h1 {color:#21392b}
.fmb-build-root--duncan .fmb-block-2 .lead {color:#37433a}
.fmb-build-root--duncan .fmb-block-2 .compact-strip span {
  color:#fff2d5;
  background:linear-gradient(135deg,#365646,#213b30);
  border:1px solid #bd9a5b;
  box-shadow:0 4px 12px rgba(19,39,28,.16);
}
.fmb-build-root--duncan .fmb-block-2 .compact-strip strong {color:#fff9ef;font-size:15px}
.fmb-build-root--duncan .fmb-block-2 .compact-block {border-top:2px solid #b99b65}
.fmb-build-root--duncan .fmb-block-2 .compact-block h2 {color:#263f30}
.fmb-build-root--duncan .fmb-block-2 .compact-row {border-color:#c9b590}
.fmb-build-root--duncan .fmb-block-2 .compact-row strong {color:#254333}
.fmb-build-root--duncan .fmb-block-2 .mini-label {color:#92512d}
.fmb-build-root--duncan .fmb-block-2 .compact-combat {
  background:linear-gradient(130deg,#203d30,#2d4c3d);
  border:1px solid #af915d;
  border-left:6px solid #d4a360;
  border-radius:12px;
  color:#f8edda;
  padding:22px;
  box-shadow:0 9px 18px rgba(14,40,25,.19);
}
.fmb-build-root--duncan .fmb-block-2 .compact-combat .mini-label{color:#eac58d}
.fmb-build-root--duncan .fmb-block-2 .compact-combat strong{color:#fff1d3}
.fmb-build-root--duncan .fmb-block-2 .compact-combat p{color:#f5eddf}
/* Navegação: próxima peça não esmaecida. Desabilitado só por ser o recorte de teste. */
.fmb-build-root--duncan .fmb-level-step {
  background:linear-gradient(125deg,#1d3529,#314c3b 55%,#233b36);
  border:1px solid #c5a06a;
  box-shadow:0 8px 18px rgba(4,16,11,.34);
}
.fmb-build-root--duncan .fmb-level-step:not(.fmb-level-step--disabled):hover,
.fmb-build-root--duncan .fmb-level-step:not(.fmb-level-step--disabled):focus-visible {
  background:linear-gradient(125deg,#345d42,#2d5341);
  border-color:#f1cb89;
  outline:2px solid #d4b67d;outline-offset:2px;
}
.fmb-build-root--duncan .fmb-level-step-arrow {color:#eaca91}
.fmb-build-root--duncan .fmb-level-step-copy small {color:#e4d0a7}
.fmb-build-root--duncan .fmb-level-step-copy strong {color:#fff9ea}
.fmb-build-root--duncan .fmb-level-step--disabled{opacity:.65}
.duncan-prototype-footer {color:#d3c9b5}
.fmb-build-root--duncan [id^='nivel-'] {scroll-margin-top:28px}
@media(max-width:850px){
  .fmb-build-root--duncan .fmb-block-1 .art {border-right:0;border-bottom:5px solid #c7a36b}
  .fmb-build-root--duncan .fmb-block-2 .progress-side{border-right:0;border-bottom:5px solid #c7a36b}
}
@media(max-width:640px){
  .fmb-build-root--duncan .fmb-block-1 .copy{border-top-width:5px}
  .fmb-build-root--duncan .fmb-block-1 .status-card span{font-size:10px}
  .fmb-build-root--duncan .fmb-block-1 .status-card strong{font-size:19px}
  .fmb-build-root--duncan .duncan-empty-art strong{font-size:54px}
  .fmb-build-root--duncan .fmb-block-1 .art {min-height:310px}
  .fmb-build-root--duncan .fmb-block-2 .compact-content{border-top-width:5px}
}
@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}}

/* ===== REFINO 02 — aplicação mais forte da identidade de Duncan ===== */
body{
  background:
    radial-gradient(circle at top left, rgba(33,77,58,.45), transparent 24%),
    radial-gradient(circle at top right, rgba(180,142,74,.18), transparent 18%),
    linear-gradient(180deg,#09120f 0%, #102019 28%, #14261f 100%);
}
.duncan-prototype-header{
  background:linear-gradient(135deg,#10251d,#1d3b2d 55%,#162c26 100%);
  border-bottom:3px solid #d0a865;
  box-shadow:0 14px 30px rgba(0,0,0,.34);
}
.duncan-prototype-header .dp-name{color:#f6ead3;letter-spacing:.16em}
.duncan-prototype-header .dp-name span{color:#e2b36b}
.duncan-prototype-header nav a{
  background:linear-gradient(135deg,#264637,#1a3429);
  border:1px solid #c79c58;
  color:#fff2d5;
  box-shadow:0 8px 20px rgba(0,0,0,.25);
}
.duncan-prototype-header nav a:hover,
.duncan-prototype-header nav a:focus-visible{background:linear-gradient(135deg,#325844,#234236);border-color:#efc680}
.duncan-prototype-header p{color:#ead9bb}
.duncan-prototype-header .dp-dot{background:#dfb36a; box-shadow:0 0 0 6px rgba(223,179,106,.18)}

.fmb-build-root--duncan{
  box-shadow:0 22px 55px rgba(0,0,0,.42);
  border-width:2px;
  border-color:#d1ab6a;
  overflow:hidden;
}

/* Nível 1 — puxar layout para Duncan */
.fmb-build-root--duncan .fmb-block-1{
  background:linear-gradient(180deg,#11231b,#162922 100%);
}
.fmb-build-root--duncan .fmb-block-1 .top{background:linear-gradient(90deg,#173127 0 40%, #e8ddcb 40% 100%)}
.fmb-build-root--duncan .fmb-block-1 .art{
  background:
    radial-gradient(circle at 48% 32%,rgba(228,183,100,.13),transparent 26%),
    linear-gradient(160deg,rgba(218,177,104,.12),transparent 38%),
    repeating-linear-gradient(126deg,rgba(255,255,255,.02) 0px,rgba(255,255,255,.02) 1px,transparent 1px,transparent 8px),
    linear-gradient(145deg,#0c1915,#143127 42%,#284a3b 72%,#3d5f69 100%);
  box-shadow:inset -10px 0 25px rgba(0,0,0,.15);
}
.fmb-build-root--duncan .fmb-block-1 .copy{
  background:
    linear-gradient(180deg,rgba(16,38,28,.96) 0, rgba(16,38,28,.96) 14px, transparent 14px),
    linear-gradient(160deg,#f5edde,#e8ddcb);
  box-shadow:inset 0 1px 0 rgba(255,255,255,.35);
}
.fmb-build-root--duncan .fmb-block-1 .copy h1{color:#173828;text-shadow:0 1px 0 rgba(255,255,255,.3)}
.fmb-build-root--duncan .fmb-block-1 .copy .subtitle{color:#5a6b39;font-weight:700}
.fmb-build-root--duncan .fmb-block-1 .status-card{
  background:linear-gradient(145deg,#173627,#1f4635 60%,#244e39);
  border-color:#d0aa6a;
  border-top:4px solid #efc06f;
  box-shadow:0 12px 24px rgba(7,23,16,.28);
}
.fmb-build-root--duncan .fmb-block-1 .origin-grid .info{
  background:linear-gradient(180deg,#f3ead9,#e4d8c4);
  border-color:#b39061;
  box-shadow:0 12px 24px rgba(24,26,18,.12);
}
.fmb-build-root--duncan .fmb-block-1 .section{
  background:linear-gradient(180deg,#efe4d0,#e7dbc7);
  border-top:4px solid #c6a162;
  box-shadow:inset 0 8px 0 rgba(25,54,39,.05);
}
.fmb-build-root--duncan .fmb-block-1 .section-head{
  position:relative;
  padding-top:8px;
}
.fmb-build-root--duncan .fmb-block-1 .section-head::before{
  content:"";
  position:absolute;left:0;top:0;width:84px;height:4px;
  background:linear-gradient(90deg,#215239,#d1a85f);
  border-radius:999px;
}
.fmb-build-root--duncan .fmb-block-1 .attr{
  background:linear-gradient(180deg,#fcf6ea,#eadfcb);
  border-color:#bda37f;
  border-top-color:#70868c;
}
.fmb-build-root--duncan .fmb-block-1 .attr.primary{
  background:linear-gradient(180deg,#d9e4d1,#ece4cc);
  border-color:#28553a;
  box-shadow:0 10px 20px rgba(22,60,38,.18);
}
.fmb-build-root--duncan .fmb-block-1 .progression{
  background:linear-gradient(90deg,#183428 0%,#264c39 50%,#274938 100%);
  border-left-width:8px;
  box-shadow:0 12px 24px rgba(11,30,20,.24);
}
.fmb-build-root--duncan .fmb-block-1 .magic-card{
  background:linear-gradient(180deg,#efe5d2,#e5dac6);
  border-color:#b29167;
  box-shadow:0 12px 24px rgba(29,31,23,.1);
}
.fmb-build-root--duncan .fmb-block-1 .magic-card.tome{
  background:linear-gradient(180deg,#dde6d9,#cedbcf);
  border-top-color:#1c5637;
}
.fmb-build-root--duncan .fmb-block-1 .play{
  background:linear-gradient(110deg,#10251d 0%,#15392d 40%,#244d3b 100%);
  border-top:5px solid #d0a463;
  box-shadow:inset 0 1px 0 rgba(255,255,255,.05);
}
.fmb-build-root--duncan .fmb-block-1 .combat-priority,
.fmb-build-root--duncan .fmb-block-1 .combat-quote{
  box-shadow:0 8px 18px rgba(0,0,0,.16);
}

/* Nível 2 — conteúdo menos neutro e sidebar mais Duncan */
.fmb-build-root--duncan .fmb-block-2{
  background:linear-gradient(180deg,#13261f 0,#102019 100%);
}
.fmb-build-root--duncan .fmb-block-2 .level{background:linear-gradient(90deg,#183125 0 15%, #e9dfcf 15% 100%)}
.fmb-build-root--duncan .fmb-block-2 .progress-side{
  background:
    radial-gradient(circle at 50% 12%,rgba(242,204,132,.14),transparent 26%),
    repeating-linear-gradient(155deg,rgba(255,255,255,.028) 0,rgba(255,255,255,.028) 1px,transparent 1px,transparent 9px),
    linear-gradient(160deg,#0d1c16,#143127 44%,#234639 76%,#345563 100%);
  box-shadow:inset -12px 0 24px rgba(0,0,0,.18);
}
.fmb-build-root--duncan .fmb-block-2 .progress-side .level-no{
  background:linear-gradient(140deg,#faefcf,#cfaa67);
  box-shadow:0 0 0 6px rgba(224,182,111,.22),0 12px 24px rgba(0,0,0,.38);
}
.fmb-build-root--duncan .fmb-block-2 .fm-panel{
  background:linear-gradient(180deg,rgba(5,20,16,.78),rgba(8,29,22,.58));
  border-color:#c39f67;
  box-shadow:inset 0 1px 0 rgba(255,255,255,.03),0 10px 18px rgba(0,0,0,.16);
}
.fmb-build-root--duncan .fmb-block-2 .fm-resource-mini > div{
  background:linear-gradient(180deg,rgba(27,62,47,.42),rgba(22,42,33,.42));
  border-color:rgba(216,178,108,.52);
}
.fmb-build-root--duncan .fmb-block-2 .compact-content{
  background:
    linear-gradient(180deg,rgba(16,38,28,.96) 0, rgba(16,38,28,.96) 14px, transparent 14px),
    linear-gradient(160deg,#f5edde,#e7dbc9);
  box-shadow:inset 0 1px 0 rgba(255,255,255,.35);
}
.fmb-build-root--duncan .fmb-block-2 .compact-strip span{
  background:linear-gradient(135deg,#193a2b,#244a38 70%,#2d523d);
  border-color:#d1aa69;
  border-top:3px solid #f1c87e;
  box-shadow:0 10px 18px rgba(0,0,0,.18);
}
.fmb-build-root--duncan .fmb-block-2 .compact-block{
  background:linear-gradient(180deg,rgba(255,255,255,.2),rgba(255,255,255,.08));
  border-top:3px solid #bd9a61;
  padding:16px 18px 6px;
  margin-top:10px;
  border-radius:12px;
}
.fmb-build-root--duncan .fmb-block-2 .compact-row{
  border-color:#b89c71;
}
.fmb-build-root--duncan .fmb-block-2 .compact-combat{
  background:linear-gradient(110deg,#11271e 0%,#1b412f 48%,#315642 100%);
  border-color:#d1a45f;
  border-top:4px solid #efc576;
  box-shadow:0 16px 28px rgba(11,25,18,.24);
}
.fmb-build-root--duncan .fmb-level-step{
  background:linear-gradient(125deg,#123024,#244736 55%,#18342b);
  border-width:2px;
}
@media(max-width:850px){
  .fmb-build-root--duncan .fmb-block-1 .top,
  .fmb-build-root--duncan .fmb-block-2 .level{background:linear-gradient(180deg,#173127 0 32%, #e8ddcb 32% 100%)}
}



/* DUNCAN-LEVEL-01-02 — Consolidação informativa; não redefine a paleta ou a geometria de Voldemort. */
.fmb-build-root--duncan .duncan-section-train,.fmb-build-root--duncan .duncan-section-gear{border-top:4px solid #c6a162}
.fmb-build-root--duncan .duncan-fact-strip{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px;margin:15px 0 22px}
.fmb-build-root--duncan .duncan-fact-strip>div{padding:14px 12px;border-radius:10px;text-align:center;background:linear-gradient(145deg,#153b2b,#264936);border:1px solid #c49f63;box-shadow:0 7px 14px rgba(0,0,0,.12)}
.fmb-build-root--duncan .duncan-fact-strip small{display:block;color:#e9d1a3;font:700 11px/1.3 Arial,sans-serif;margin-bottom:7px}
.fmb-build-root--duncan .duncan-fact-strip strong{color:#fff5de;font:700 25px/1.1 Georgia,serif}
.fmb-build-root--duncan .duncan-data-grid,.fmb-build-root--duncan .duncan-l2-checklist{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}
.fmb-build-root--duncan .duncan-data-card,.fmb-build-root--duncan .duncan-l2-checklist article{padding:18px;background:linear-gradient(180deg,#f4ebd9,#e6dbc6);border:1px solid #b69c71;border-top:4px solid #29563b;border-radius:12px;min-width:0;box-shadow:0 9px 20px rgba(27,32,19,.08)}
.fmb-build-root--duncan .duncan-data-card:nth-child(2),.fmb-build-root--duncan .duncan-l2-checklist article:nth-child(2){border-top-color:#657d83}
.fmb-build-root--duncan .duncan-data-card:nth-child(3),.fmb-build-root--duncan .duncan-l2-checklist article:nth-child(3){border-top-color:#b99055}
.fmb-build-root--duncan .duncan-small-label{font:800 10px/1.4 Arial,sans-serif;text-transform:uppercase;letter-spacing:.10em;color:#92512d;display:block;margin-bottom:8px}
