  font-weight:700!important;
  margin:0!important;
}
.fmb-build-root--duncan :is(.fmb-block-14,.fmb-block-15,.fmb-block-16) .combat h2{color:#fff0d0!important}
.fmb-build-root--duncan :is(.fmb-block-14,.fmb-block-15,.fmb-block-16) .combat .mini-label{color:#eac18a!important}
.fmb-build-root--duncan :is(.fmb-block-14,.fmb-block-15,.fmb-block-16) .combat p strong{color:#ffe3ac!important;display:inline!important}
.fmb-build-root--duncan :is(.fmb-block-14,.fmb-block-15,.fmb-block-16) .fm-side-sheet{
   background:transparent!important;
   border-top:2px solid #c3a16e!important;
   padding:20px 0 0!important;
}
.fmb-build-root--duncan :is(.fmb-block-14,.fmb-block-15,.fmb-block-16) .fm-stat strong{color:#fff8ea!important}
.fmb-build-root--duncan :is(.fmb-block-14,.fmb-block-15,.fmb-block-16) .fm-stat small{color:#cdd9d6!important}
.fmb-build-root--duncan :is(.fmb-block-14,.fmb-block-15,.fmb-block-16) .fm-stat span{color:#eac78a!important}
