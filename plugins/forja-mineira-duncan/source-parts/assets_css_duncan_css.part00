.fmb-build-root--duncan :is(.fmb-block-6,.fmb-block-7) .card .item p{font:14px/1.65 Arial,sans-serif;margin-top:5px;color:#465047}
.fmb-build-root--duncan .duncan-maneuver{display:flex;gap:12px;align-items:flex-start;border-top:1px solid #b9a67e;padding:14px 0}
.fmb-build-root--duncan .duncan-maneuver>b{background:#24523a;border:1px solid #c7a163;border-radius:100%;color:#ffdf9e;width:32px;height:32px;flex:0 0 32px;display:flex;align-items:center;justify-content:center}
.fmb-build-root--duncan .duncan-maneuver strong{color:#234c32;display:block;font:700 16px Georgia,serif}
.fmb-build-root--duncan .duncan-maneuver p{color:#475244;font:13px/1.65 Arial,sans-serif;margin:6px 0 0}
.fmb-build-root--duncan .duncan-maneuver-list{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}
.fmb-build-root--duncan .duncan-maneuver-list span{font:700 12px/1.4 Arial,sans-serif;padding:10px 12px;background:#f4eedf;border:1px solid #b4a37e;border-left:3px solid #296541;border-radius:6px;color:#2f4c35}
.fmb-build-root--duncan .duncan-fact-foot{color:#3a4f3f;line-height:1.55;margin:13px 0 0}
