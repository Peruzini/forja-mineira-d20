@media (max-width:760px){.fmb-block-11 .fm-side-sheet{max-width:420px;margin:18px auto 0}
.fmb-block-11 .fm-timeline-resume{display:none}}
.fmb-block-11 .progress-side .timeline{bottom:auto!important;height:300px!important}
/* === Sidebar compacta padronizada: cobra + wishlist === */
.fmb-block-11 .progress-side .snake-wrap{
  width:158px !important;
  height:215px !important;
  min-height:215px !important;
  margin:12px auto 8px !important;
  display:flex !important;
  align-items:flex-start !important;
  justify-content:center !important;
  flex:0 0 215px !important;
}
.fmb-block-11 .progress-side .snake-wrap img{
  display:block !important;
  width:100% !important;
  height:100% !important;
  max-height:215px !important;
  object-fit:contain !important;
  object-position:center top !important;
}
.fmb-block-11 .progress-side .timeline{
  bottom:auto !important;
  height:170px !important;
}
.fmb-block-11 .wish-section,.fmb-block-11 .arcana-standard{
  position:relative;
  z-index:6;
  width:100%;
  margin-top:16px;
  padding:11px 12px;
  border:1px solid rgba(255,255,255,.11);
  border-radius:11px;
  background:rgba(255,255,255,.04);
}
.fmb-block-11 .wish-title,.fmb-block-11 .arcana-standard-title{
  display:block;
  margin-bottom:8px;
  color:#ddcda9;
  font:800 9px/1.2 Arial,sans-serif;
  letter-spacing:.14em;
  text-transform:uppercase;
}
.fmb-block-11 .wish-note{
  margin:0 0 9px;
  color:#9fb2a6;
  font:700 8px/1.4 Arial,sans-serif;
}
.fmb-block-11 .wish-item{
  padding:8px 9px;
  border:1px solid rgba(255,255,255,.09);
  border-radius:9px;
  background:rgba(255,255,255,.035);
}
.fmb-block-11 .wish-item + .wish-item{margin-top:7px}
.fmb-block-11 .wish-head{display:flex;gap:7px;align-items:flex-start;justify-content:space-between}
.fmb-block-11 .wish-head strong{color:#fff;font-size:11px;line-height:1.25}
.fmb-block-11 .wish-tag{
  flex:0 0 auto;padding:3px 5px;border:1px solid rgba(215,190,130,.32);
  border-radius:999px;color:#ddcda9;font:800 6.5px/1 Arial,sans-serif;
  letter-spacing:.06em;text-transform:uppercase
}
.fmb-block-11 .wish-item small{display:block;margin-top:3px;color:#9ab4a4;font:700 7.5px/1.25 Arial,sans-serif}
.fmb-block-11 .wish-item p{margin:6px 0 0;color:#d2ddd6;font-size:9px;line-height:1.42}
.fmb-block-11 .arcana-standard-row{
  padding:8px 9px;border:1px solid rgba(255,255,255,.09);border-radius:9px;
  background:rgba(255,255,255,.035)
}
.fmb-block-11 .arcana-standard-row + .arcana-standard-row{margin-top:7px}
.fmb-block-11 .arcana-standard-row small{display:block;color:#9ab4a4;font:700 7.5px/1.2 Arial,sans-serif;text-transform:uppercase}
.fmb-block-11 .arcana-standard-row strong{display:block;margin-top:4px;color:#fff;font-size:11px;line-height:1.25}
.fmb-block-11 .arcana-standard-row em{display:block;margin-top:2px;color:#b8c6bd;font:italic 8px/1.2 Georgia,serif}
@media (max-width:760px){.fmb-block-11 .progress-side .snake-wrap{
    width:145px !important;height:195px !important;min-height:195px !important;
    flex-basis:195px !important;margin:10px auto 6px !important
  }}
/* === Wishlist minimalista: somente próximo item prioritário === */
.fmb-block-11 .wish-section{
  position:relative;
  z-index:6;
  width:100%;
  margin-top:16px;
  padding:11px 12px;
  border:1px solid rgba(255,255,255,.11);
  border-radius:11px;
  background:rgba(255,255,255,.04);
}
.fmb-block-11 .wish-title{
  display:block;
  margin-bottom:7px;
  color:#ddcda9;
  font:800 9px/1.2 Arial,sans-serif;
  letter-spacing:.14em;
  text-transform:uppercase;
}
.fmb-block-11 .wish-note{
  margin:0 0 9px;
  color:#9fb2a6;
  font:700 8px/1.45 Arial,sans-serif;
}
.fmb-block-11 .wish-item{
  padding:9px 10px;
  border:1px solid rgba(255,255,255,.09);
  border-radius:9px;
  background:rgba(255,255,255,.035);
}
.fmb-block-11 .wish-head{
  display:flex;
  gap:7px;
  align-items:flex-start;
  justify-content:space-between;
}
.fmb-block-11 .wish-head strong{
  color:#fff;
  font-size:11px;
  line-height:1.25;
}
.fmb-block-11 .wish-tag{
  flex:0 0 auto;
  padding:3px 5px;
  border:1px solid rgba(215,190,130,.32);
  border-radius:999px;
  color:#ddcda9;
  font:800 6.5px/1 Arial,sans-serif;
  letter-spacing:.06em;
  text-transform:uppercase;
}
.fmb-block-11 .wish-item small{
  display:block;
  margin-top:3px;
  color:#9ab4a4;
  font:700 7.5px/1.25 Arial,sans-serif;
}
.fmb-block-11 .wish-item p{
  margin:6px 0 0;
  color:#d2ddd6;
  font-size:9px;
  line-height:1.42;
}

/* ===== BLOCO 12 ===== */
.fmb-block-12{
  --paper:#fbfaf6;--white:#fff;--ink:#1f1b17;--body:#403a33;--muted:#70675e;
  --line:#ddd4c5;--gold:#9b6b18;--green:#28513e;--green-soft:#f2f7f3;
  --silver:#eef1ef;--dark:#0e1712;
}
.fmb-block-12 *{box-sizing:border-box}
.fmb-block-12{margin:0;background:#f1f0ec;color:var(--body);font-family:Georgia,"Times New Roman",serif}
.fmb-block-12 .preview{width:min(1360px,calc(100% - 48px));margin:34px auto}
.fmb-block-12 .level{
  display:grid;grid-template-columns:210px minmax(0,1fr);
  border:1px solid var(--line);border-radius:24px;overflow:hidden;background:var(--paper)
}
.fmb-block-12 .progress-side{
  position:relative;height:100%;padding:28px 18px 24px;
  background:
    radial-gradient(circle at 50% 38%,rgba(54,116,80,.30),transparent 29%),
    linear-gradient(180deg,#101d17,#08100c);
  color:#fff;display:flex;flex-direction:column;align-items:center;overflow:hidden
}
.fmb-block-12 .phase{position:relative;z-index:4;font:800 10px/1.25 Arial,sans-serif;letter-spacing:.16em;text-transform:uppercase;color:#ddcda9;text-align:center}
.fmb-block-12 .level-no{position:relative;z-index:4;margin-top:14px;width:76px;height:76px;border-radius:50%;display:grid;place-items:center;background:#f6f3eb;border:3px solid #a8792d;color:#1f1b17;font:bold 34px/1 Georgia,serif}
.fmb-block-12 .timeline{position:absolute;z-index:1;top:118px;height:300px;left:50%;width:2px;transform:translateX(-50%);background:linear-gradient(#c5b79c,#6b8374 55%,#244a37);opacity:.78}
.fmb-block-12 .snake-wrap{position:relative;z-index:3;width:150px;margin-top:38px;margin-bottom:8px}
.fmb-block-12 .snake-wrap img{display:block;width:100%;height:auto;filter:drop-shadow(0 15px 22px rgba(0,0,0,.48))}
.fmb-block-12 .content{padding:30px 34px 32px 22px}
.fmb-block-12 .kicker,.fmb-block-12 .mini-label{color:var(--gold);font:800 10px/1.2 Arial,sans-serif;letter-spacing:.14em;text-transform:uppercase}
.fmb-block-12 h1,.fmb-block-12 h2,.fmb-block-12 h3{margin:0;color:var(--ink)}
.fmb-block-12 h1{margin-top:7px;font-size:42px;line-height:1}
.fmb-block-12 .lead{margin:13px 0 0;max-width:1080px;font-size:16px;line-height:1.62}
.fmb-block-12 .strip{margin-top:18px;display:flex;flex-wrap:wrap;gap:8px}
.fmb-block-12 .strip span{padding:8px 11px;border:1px solid var(--line);border-radius:999px;background:#fff;font:700 11px/1 Arial,sans-serif;color:var(--muted)}
.fmb-block-12 .strip strong{color:var(--ink)}
.fmb-block-12 .top-grid{margin-top:22px;display:grid;grid-template-columns:1fr 1fr;gap:12px;align-items:stretch}
.fmb-block-12 .top-grid.single{grid-template-columns:1fr}
.fmb-block-12 .card{padding:18px 19px;border:1px solid var(--line);border-radius:16px;background:#fff}
.fmb-block-12 .card.primary{border-color:#91ad9d;background:linear-gradient(180deg,#fff,var(--green-soft))}
.fmb-block-12 .card h2{margin-top:4px;font-size:24px}
.fmb-block-12 .card p{margin:8px 0 0;font-size:14px;line-height:1.58}
.fmb-block-12 .feat-stat{margin-top:12px;display:flex;align-items:center;gap:12px;padding:12px 13px;border:1px solid #d6c39d;border-radius:12px;background:#faf7ef}
.fmb-block-12 .feat-stat .score{width:62px;height:62px;border-radius:50%;display:grid;place-items:center;flex:0 0 auto;background:#fff;border:2px solid var(--gold);font:bold 22px/1 Georgia,serif;color:var(--ink)}
.fmb-block-12 .feat-stat strong{display:block;color:var(--ink);font-size:16px}
.fmb-block-12 .feat-stat span{display:block;margin-top:4px;color:var(--muted);font-size:12px;line-height:1.45}
.fmb-block-12 .rule-list{margin-top:11px;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px}
.fmb-block-12 .rule{padding:10px 11px;border:1px solid #cbd6cf;border-radius:10px;background:#fff}
.fmb-block-12 .rule strong{display:block;color:var(--ink);font-size:14px}
.fmb-block-12 .rule span{display:block;margin-top:3px;color:var(--muted);font-size:12px;line-height:1.45}
.fmb-block-12 .invocations{margin-top:12px;padding:18px 19px;border:1px solid var(--line);border-radius:15px;background:#fff}
.fmb-block-12 .invocations h2{margin-top:4px;font-size:23px}
.fmb-block-12 .inv-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:12px}
.fmb-block-12 .inv-card{padding:15px 16px;border-radius:13px}
.fmb-block-12 .inv-card.green{border:1px solid #a8bdb0;background:#f3f7f4}
.fmb-block-12 .inv-card.gold{border:1px solid #d5bf95;background:#faf7ef}
.fmb-block-12 .inv-card strong{display:block;color:var(--ink);font-size:18px}
.fmb-block-12 .inv-card p{margin:6px 0 0;font-size:13px;line-height:1.55}
.fmb-block-12 .swap{margin-top:11px;padding:11px 13px;border-left:4px solid var(--green);border-radius:9px;background:var(--green-soft);font-size:13px;line-height:1.55}
.fmb-block-12 .vision{margin-top:18px;padding:18px 19px;border:1px solid var(--line);border-radius:15px;background:#fff}
.fmb-block-12 .vision h2{margin-top:4px;font-size:23px}
.fmb-block-12 .vision-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:9px;margin-top:12px}
.fmb-block-12 .step{padding:12px;border:1px solid #cad3cd;border-radius:11px;background:var(--silver)}
.fmb-block-12 .step small{display:block;color:var(--green);font:800 9px/1.2 Arial,sans-serif;text-transform:uppercase;letter-spacing:.08em}
.fmb-block-12 .step strong{display:block;margin-top:4px;color:var(--ink);font-size:14px}
.fmb-block-12 .step p{margin:5px 0 0;font-size:12px;line-height:1.45}
.fmb-block-12 .combat{margin-top:18px;padding:16px 17px;border-left:4px solid var(--green);background:#fff}
.fmb-block-12 .combat h2{margin-top:4px;font-size:23px}
.fmb-block-12 .combat p{margin:8px 0 0;font-size:14px;line-height:1.6}
.fmb-block-12 .priority{margin-top:11px;padding:10px 12px;border-radius:10px;background:#17261f;color:#edf3ef;font:800 11px/1.45 Arial,sans-serif}
.fmb-block-12 .dark-lord-line{margin-top:11px;padding:11px 13px;border-left:3px solid var(--green);border-radius:9px;background:var(--green-soft);color:#35483e;font-size:13px;line-height:1.52;font-style:italic}
@media (max-width:900px){.fmb-block-12 .top-grid,.fmb-block-12 .inv-grid,.fmb-block-12 .rule-list{grid-template-columns:1fr}}
@media (max-width:760px){.fmb-block-12 .preview{width:calc(100% - 20px);margin:10px auto}
.fmb-block-12 .level{grid-template-columns:1fr}
.fmb-block-12 .progress-side{min-height:330px}
.fmb-block-12 .snake-wrap{width:138px;margin:26px auto 10px}
.fmb-block-12 .side-sheet{max-width:420px;margin:18px auto 0}
.fmb-block-12 .timeline-resume{display:none}
.fmb-block-12 .content{padding:24px 20px 26px}
.fmb-block-12 .vision-grid{grid-template-columns:1fr}
.fmb-block-12 h1{font-size:35px}}
.fmb-block-12 .side-sheet{
  position:relative;
  z-index:4;
  width:100%;
  margin-top:18px;
  padding:16px 0 0;
  border-top:1px solid rgba(221,205,169,.24);
  background:linear-gradient(180deg,#102419,#102419);
}
.fmb-block-12 .side-section + .side-section{margin-top:16px}
.fmb-block-12 .side-label{
  display:block;
  margin-bottom:8px;
  color:#ddcda9;
  font:800 9px/1.2 Arial,sans-serif;
  letter-spacing:.14em;
  text-transform:uppercase;
  text-align:left;
}
.fmb-block-12 .stats-grid{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:6px;
}
.fmb-block-12 .stat{
  padding:7px 5px 6px;
  border:1px solid rgba(255,255,255,.12);
  border-radius:9px;
  background:rgba(255,255,255,.045);
  text-align:center;
}
.fmb-block-12 .stat small{
  display:block;
  color:#b8c6bd;
  font:800 8px/1 Arial,sans-serif;
}
.fmb-block-12 .stat strong{
  display:block;
  margin-top:3px;
  color:#fff;
  font-size:18px;
  line-height:1;
}
.fmb-block-12 .stat span{
  display:block;
  margin-top:3px;
  color:#8fb09d;
  font:700 9px/1 Arial,sans-serif;
}
.fmb-block-12 .defense{
  padding:11px 12px;
  border:1px solid rgba(255,255,255,.11);
  border-radius:11px;
  background:rgba(255,255,255,.04);
}
.fmb-block-12 .def-line{
  display:flex;
  align-items:flex-start;
  justify-content:space-between;
  gap:10px;
  padding:6px 0;
  border-top:1px solid rgba(255,255,255,.08);
}
.fmb-block-12 .def-line:first-of-type{border-top:0}
.fmb-block-12 .def-line small{
  color:#b8c6bd;
  font:700 9px/1.25 Arial,sans-serif;
}
.fmb-block-12 .def-line strong{
  max-width:92px;
  color:#fff;
  font-size:11px;
  line-height:1.2;
  text-align:right;
}
.fmb-block-12 .resources{
  padding:11px 12px;
  border:1px solid rgba(255,255,255,.11);
  border-radius:11px;
  background:rgba(255,255,255,.04);
}
.fmb-block-12 .resource-mini{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:8px;
}
.fmb-block-12 .resource-mini > div{
  padding:9px 7px;
  border:1px solid rgba(255,255,255,.09);
  border-radius:9px;
  background:rgba(255,255,255,.035);
  text-align:center;
}
.fmb-block-12 .resource-mini small{
  display:block;
  color:#b8c6bd;
  font:700 8px/1.25 Arial,sans-serif;
}
.fmb-block-12 .resource-mini strong{
  display:block;
  margin-top:5px;
  color:#fff;
  font-size:20px;
  line-height:1;
}
.fmb-block-12 .timeline-resume{
  position:relative;
  z-index:1;
  width:2px;
  height:110px;
  margin:0 auto -24px;
  background:linear-gradient(#6b8374,#244a37);
  opacity:.78;
}
