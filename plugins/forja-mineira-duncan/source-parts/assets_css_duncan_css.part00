/* DUNCAN 18–19: camada heráldica aprovada, sem layout novo ou assets externos. */
.fmb-build-root--duncan .fmb-block-20 .level{background:#efe5d1;border:2px solid #d0a663;overflow:hidden}
.fmb-build-root--duncan .fmb-block-20 .content{min-width:0;background:linear-gradient(180deg,#153a2b 0 13px,#f4e9d6 13px,#e9ddc9 100%);color:#2c3a2f}
.fmb-build-root--duncan .fmb-block-20 .content :is(h1,h2){color:#153725}
.fmb-build-root--duncan .fmb-block-20 .progress-side{background:radial-gradient(circle at 50% 12%,rgba(242,204,132,.13),transparent 26%),repeating-linear-gradient(150deg,rgba(255,255,255,.025) 0,rgba(255,255,255,.025) 1px,transparent 1px,transparent 9px),linear-gradient(160deg,#0d1c16,#143127 44%,#234639 76%,#345563 100%);border-right:4px solid #c5a06b}
.fmb-build-root--duncan .fmb-block-20 .progress-side .level-no{background:linear-gradient(140deg,#faefcf,#cfaa67);color:#203527;border:4px double #8f6835;box-shadow:0 0 0 5px rgba(230,189,121,.21),0 9px 23px rgba(0,0,0,.3)}
