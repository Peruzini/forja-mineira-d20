.fmb-build-root--duncan .fmb-block-20 .card{background:linear-gradient(145deg,#f9f0e1,#e5d9c5);border:1px solid #bb9966;border-top:4px solid #345941;box-shadow:0 12px 24px rgba(0,0,0,.13);border-radius:12px;padding:20px;min-width:0}
