.fmb-build-root--duncan .duncan-weapon-box{margin-top:16px;padding:21px;border:1px solid #b39a73;border-top:4px solid #c7a46b;border-radius:12px;background:linear-gradient(180deg,#f0e8d8,#e4dac5)}
