.fmb-build-root--duncan .:is(.fmb-block-5,.fmb-block-6,.fmb-block-7) .spell-row .duncan-carryover{background:linear-gradient(145deg,#183628,#294936);border:1px solid #c9a369;color:#f7ebda}
.fmb-build-root--duncan .:is(.fmb-block-5,.fmb-block-6,.fmb-block-7) .spell-row .duncan-carryover > strong{color:#ffe8bd}
.fmb-build-root--duncan .:is(.fmb-block-5,.fmb-block-6,.fmb-block-7) .spell-row .duncan-carryover .mini-label{color:#e8b877}
.fmb-build-root--duncan .:is(.fmb-block-5,.fmb-block-6,.fmb-block-7) .spell-row .duncan-carryover p{color:#efe8db;font-size:13px;line-height:1.6}
.fmb-build-root--duncan .:is(.fmb-block-5,.fmb-block-6,.fmb-block-7) .spell-row .duncan-carryover p strong{display:inline!important;font:inherit;font-weight:800;color:#ffeac3}
.fmb-build-root--duncan .:is(.fmb-block-5,.fmb-block-6,.fmb-block-7) .point p strong{display:inline!important;font:inherit;font-weight:800;color:#1d482e}
