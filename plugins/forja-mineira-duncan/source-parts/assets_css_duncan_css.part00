.fmb-build-root--duncan .duncan-weapons-grid small{display:block;margin:5px 0;color:#a35b2b;text-transform:uppercase;letter-spacing:.04em;font:bold 10px/1.4 Arial,sans-serif}
.fmb-build-root--duncan .duncan-weapons-grid p{color:#47513f;font:13px/1.6 Arial,sans-serif;margin:0}
.fmb-build-root--duncan .duncan-weapons-grid .duncan-weapon-new{background:linear-gradient(160deg,#d7e6d4,#bfcfbf);border:2px solid #2b653e;border-top:4px solid #1c5a37;box-shadow:0 8px 16px rgba(35,68,39,.14)}
.fmb-build-root--duncan .duncan-weapon-new small{color:#2c5739}
