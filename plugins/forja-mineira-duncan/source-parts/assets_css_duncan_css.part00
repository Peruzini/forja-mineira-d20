.fmb-build-root--duncan .fmb-block-7 .combat p{color:#f4ead9!important}
.fmb-build-root--duncan .fmb-block-6 .combat .mini-label,
.fmb-build-root--duncan .fmb-block-7 .combat .mini-label{color:#e9bb78!important}
.fmb-build-root--duncan .fmb-block-6 .combat .priority,
.fmb-build-root--duncan .fmb-block-7 .combat .priority{
