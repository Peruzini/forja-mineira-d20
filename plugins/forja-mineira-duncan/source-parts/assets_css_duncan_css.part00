.fmb-build-root--duncan .fmb-block-20 .fm-side-sheet{background:transparent;border-top:2px solid #c3a16e;padding-top:21px}
.fmb-build-root--duncan .fmb-block-20 .fm-side-label{color:#e9c58c}
.fmb-build-root--duncan .fmb-block-20 .fm-stat{background:rgba(122,147,154,.17);border:1px solid rgba(199,168,103,.34)}
.fmb-build-root--duncan .fmb-block-20 .fm-stat strong{color:#fff8ea}
.fmb-build-root--duncan .fmb-block-20 .fm-stat small{color:#cdd9d6}
.fmb-build-root--duncan .fmb-block-20 .fm-stat span{color:#eac78a}
.fmb-build-root--duncan .fmb-block-20 .fm-panel{border-color:#c1a16d;background:rgba(7,27,20,.67)}
.fmb-build-root--duncan .fmb-block-20 .fm-row small,.fmb-build-root--duncan .fmb-block-20 .fm-resource-mini small{color:#cedbd0}
.fmb-build-root--duncan .fmb-block-20 .fm-row strong,.fmb-build-root--duncan .fmb-block-20 .fm-resource-mini strong{color:#fff3d7}
.fmb-build-root--duncan .fmb-block-20 .fm-resource-mini>div{border-color:rgba(209,177,119,.35);background:rgba(100,119,133,.2)}
.fmb-build-root--duncan .fmb-block-20 .snake-wrap .duncan-sidebar-empty{background:linear-gradient(160deg,rgba(190,164,113,.16),rgba(64,94,77,.24));border:1px solid rgba(224,189,126,.68);box-shadow:inset 0 0 0 4px rgba(7,29,19,.27);color:#fff0d2}
.fmb-build-root--duncan .fmb-block-20 .duncan-sidebar-empty small{color:#e9c58c}
.fmb-build-root--duncan .fmb-block-20 .duncan-sidebar-empty strong{color:#fff7e5}
