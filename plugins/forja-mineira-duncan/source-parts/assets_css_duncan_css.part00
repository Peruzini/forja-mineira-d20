@media(max-width:700px){.fmb-build-root--duncan .duncan-weapons-grid{grid-template-columns:1fr}.fmb-build-root--duncan .duncan-weapon-box{padding:14px}.fmb-build-root--duncan .:is(.fmb-block-5,.fmb-block-6,.fmb-block-7) .combat,.fmb-build-root--duncan .:is(.fmb-block-5,.fmb-block-6,.fmb-block-7) .combat{padding:16px}}


/* Duncan 5–7: adaptações dos blocos homólogos da build original, sem mexer nos níveis 1–4 */
.fmb-build-root--duncan :is(.fmb-block-5,.fmb-block-6,.fmb-block-7) .level{background:#efe5d1; border:2px solid #d0a663;overflow:hidden;box-shadow:0 18px 35px rgba(0,0,0,.30)}
.fmb-build-root--duncan :is(.fmb-block-5,.fmb-block-6,.fmb-block-7) .content{background:linear-gradient(180deg,#153a2b 0 13px,#f4e9d6 13px,#e9ddc9 100%);color:#2c3a2f}
.fmb-build-root--duncan :is(.fmb-block-5,.fmb-block-6,.fmb-block-7) .content :is(h1,h2){color:#153725}
.fmb-build-root--duncan :is(.fmb-block-5,.fmb-block-6,.fmb-block-7) .content .kicker,
.fmb-build-root--duncan :is(.fmb-block-5,.fmb-block-6,.fmb-block-7) .content .mini-label{color:#96502c}
.fmb-build-root--duncan :is(.fmb-block-5,.fmb-block-6,.fmb-block-7) .content .lead{color:#364739}
.fmb-build-root--duncan .fmb-block-5 .phase-open{background:#efe4d0}
.fmb-build-root--duncan .fmb-block-5 .phase-open .art{border-right:5px solid #d3ab6a; background:radial-gradient(circle at 50% 25%,rgba(222,187,110,.13),transparent 30%),repeating-linear-gradient(143deg,rgba(255,255,255,.02) 0,rgba(255,255,255,.02) 1px,transparent 1px,transparent 9px),linear-gradient(145deg,#0c1c15,#153329 44%,#284c3b 74%,#34535a)}
.fmb-build-root--duncan .fmb-block-5 .phase-open .art:after{pointer-events:none}
.fmb-build-root--duncan .fmb-block-5 .duncan-phase-art{height:100%;min-height:490px;display:flex;align-items:center;justify-content:center;flex-direction:column;color:#f8ead0;gap:16px;border:1px solid #c9a66b;box-shadow:inset 0 0 0 6px rgba(4,23,12,.3);margin:22px;border-radius:8px;text-align:center;padding:32px}
.fmb-build-root--duncan .fmb-block-5 .duncan-phase-art small{font:700 11px Arial,sans-serif;letter-spacing:.25em;color:#ecc27e}
.fmb-build-root--duncan .fmb-block-5 .duncan-phase-art strong{font:normal clamp(55px,6vw,87px) Georgia,serif;color:#fff1d3}
.fmb-build-root--duncan .fmb-block-5 .duncan-phase-art span{font:12px Arial,sans-serif;color:#ded3bc}
.fmb-build-root--duncan .fmb-block-5 .phase-tag{background:#173626;border:1px solid #cfaa6d;color:#ffecc6}
.fmb-build-root--duncan .fmb-block-5 .level-badge{background:linear-gradient(150deg,#fff3d4,#cfab70);color:#213c2a;border-color:#c69d61}
.fmb-build-root--duncan .fmb-block-5 .art-caption{background:linear-gradient(180deg,rgba(9,33,24,.3),rgba(7,28,20,.85));color:#f5e6c5}
.fmb-build-root--duncan .fmb-block-5 .art-caption strong{color:#fff0ce}
.fmb-build-root--duncan .fmb-block-5 .art-caption span{color:#e8dac2}
.fmb-build-root--duncan .fmb-block-5 .subtitle,.fmb-build-root--duncan :is(.fmb-block-6,.fmb-block-7) .subtitle{color:#496c45}
.fmb-build-root--duncan .fmb-block-5 .breakthrough{background:linear-gradient(120deg,#173628,#315440);border:1px solid #c59f67;border-left:6px solid #ddaf64;color:#f6ead1;padding:18px 20px;border-radius:10px;box-shadow:0 12px 24px rgba(0,0,0,.16)}
.fmb-build-root--duncan .fmb-block-5 .breakthrough strong{color:#ffe5ac}
.fmb-build-root--duncan .fmb-block-5 .changes .card{background:linear-gradient(145deg,#f9f0e1,#e5d9c5);border:1px solid #bb9966;border-top:4px solid #345941;box-shadow:0 12px 24px rgba(0,0,0,.13)}
.fmb-build-root--duncan .fmb-block-5 .changes .card.primary{background:linear-gradient(145deg,#dce9d8,#d3ddce);border-top:4px solid #22583a}
.fmb-build-root--duncan .fmb-block-5 .changes .card strong{color:#225136}
.fmb-build-root--duncan .fmb-block-5 .changes .card :is(p,span){color:#3f5142}
.fmb-build-root--duncan .fmb-block-5 .combat{background:linear-gradient(110deg,#10291e,#214c38 60%,#315741);border-top:5px solid #d1a460;color:#f7f0df;padding:28px}
.fmb-build-root--duncan .fmb-block-5 .combat :is(h2,strong){color:#ffecc6}
.fmb-build-root--duncan .fmb-block-5 .combat p{color:#f6ecd7}
.fmb-build-root--duncan .fmb-block-5 .combat .mini-label{color:#e6bd7a}
.fmb-build-root--duncan .fmb-block-5 .priority{background:rgba(230,194,131,.11);border:1px solid rgba(223,180,104,.67);border-left:5px solid #d3a963;color:#ffedc7}
.fmb-build-root--duncan :is(.fmb-block-5,.fmb-block-6,.fmb-block-7) .duncan-fact-card{background:linear-gradient(160deg,#e0e8d9,#d4dfd1);border:1px solid #9aab88;border-top:4px solid #2b6242;box-shadow:0 10px 19px rgba(24,47,32,.11);padding:20px 22px;margin:18px 0;border-radius:12px}
.fmb-build-root--duncan .duncan-fact-card h2{font:700 23px Georgia,serif;margin:6px 0 14px;color:#244530}
.fmb-build-root--duncan .duncan-facts{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}
.fmb-build-root--duncan .duncan-facts>div{background:#f6f1e5;border:1px solid #c0ab80;border-left:4px solid #2e6042;border-radius:9px;padding:12px 13px}
.fmb-build-root--duncan .duncan-facts strong{display:block;font:700 16px Georgia,serif;color:#214632}
