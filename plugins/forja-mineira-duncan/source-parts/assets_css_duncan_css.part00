.fmb-build-root--duncan .duncan-weapons-grid{display:grid;grid-template-columns:1fr 1fr;gap:11px}
.fmb-build-root--duncan .duncan-weapons-grid>div{padding:15px;border:1px solid #b39b73;border-top:3px solid #667e83;border-radius:10px;background:linear-gradient(175deg,#fcf6e8,#e8dcc8)}
