.fmb-build-root--duncan :is(.fmb-block-5,.fmb-block-6,.fmb-block-7) .duncan-continuity-note{background:#dfe7d9;border:1px solid #98a18b;border-left:5px solid #cca362;color:#294132;line-height:1.65;margin:16px 0 8px;padding:17px 19px;border-radius:10px}
.fmb-build-root--duncan :is(.fmb-block-5,.fmb-block-6,.fmb-block-7) .duncan-continuity-note strong{color:#214d32}
