.fmb-build-root--duncan .fmb-block-20 .card .item{padding:12px 0 10px;margin:0;border-bottom:1px solid rgba(126,103,68,.25)}
.fmb-build-root--duncan .fmb-block-20 .card .item:last-child{border-bottom:0;padding-bottom:0}
.fmb-build-root--duncan .fmb-block-20 .card .item strong{display:block!important;max-width:none;white-space:normal;overflow-wrap:break-word;font:700 16px/1.35 Georgia,serif;color:#204d32;margin:0 0 6px}
.fmb-build-root--duncan .fmb-block-20 .card .item p{margin:0!important;font:14px/1.65 Arial,sans-serif;color:#465047}
.fmb-build-root--duncan .fmb-block-20 .card .item p strong{display:inline!important;font:700 inherit!important;margin:0!important}
.fmb-build-root--duncan .fmb-block-20 .duncan-level-callout{padding:16px 20px;margin:15px 0 20px;background:linear-gradient(110deg,#163629,#325740);border:1px solid #c69f65;border-left:6px solid #dba860;color:#fff0d4;border-radius:11px;font:600 14px/1.6 Arial,sans-serif;box-shadow:0 10px 19px rgba(22,38,26,.2)}
.fmb-build-root--duncan .fmb-block-20 .duncan-level-callout strong{color:#ffe7ae}
.fmb-build-root--duncan .fmb-block-20 .duncan-fact-card{background:linear-gradient(160deg,#e0e8d9,#d4dfd1);border:1px solid #9aab88;border-top:4px solid #2b6242;box-shadow:0 10px 19px rgba(24,47,32,.11);padding:20px 22px;margin:18px 0;border-radius:12px;min-width:0}
.fmb-build-root--duncan .fmb-block-20 .duncan-maneuver-list{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:7px 16px}
.fmb-build-root--duncan .fmb-block-20 .duncan-maneuver-list span{font:500 13px/1.5 Arial,sans-serif;color:#2c4d36;border-bottom:1px solid rgba(49,87,58,.14);padding:7px 0}
