/* DUNCAN 14–16: consolidação final responsiva e legenda de destaque. */
.fmb-build-root--duncan :is(.fmb-block-14,.fmb-block-15,.fmb-block-16) .duncan-level-callout{
  display:block!important;
  padding:16px 20px!important;
  margin:16px 0 20px!important;
  background:linear-gradient(110deg,#163629,#325740)!important;
  color:#fff0d4!important;
  border:1px solid #c69f65!important;
  border-left:6px solid #dba860!important;
  border-radius:11px!important;
  box-shadow:0 10px 19px rgba(22,38,26,.20)!important;
  font:600 14px/1.6 Arial,sans-serif!important;
}
.fmb-build-root--duncan :is(.fmb-block-14,.fmb-block-15,.fmb-block-16) .duncan-level-callout strong{color:#ffe7ae!important}
.fmb-build-root--duncan :is(.fmb-block-14,.fmb-block-15,.fmb-block-16) .wish-title{color:#f1d6a6!important;font-size:11px!important}
.fmb-build-root--duncan :is(.fmb-block-14,.fmb-block-15,.fmb-block-16) .wish-note{font-size:10px!important;color:#cbd5c5!important}
.fmb-build-root--duncan :is(.fmb-block-14,.fmb-block-15,.fmb-block-16) .wish-item {padding:12px!important;background:rgba(9,29,20,.5)!important}
.fmb-build-root--duncan :is(.fmb-block-14,.fmb-block-15,.fmb-block-16) .wish-item :is(small,p){font-size:10px!important;line-height:1.5!important}
@media(max-width:700px){
  .fmb-build-root--duncan :is(.fmb-block-14,.fmb-block-15,.fmb-block-16) .duncan-core-two{grid-template-columns:minmax(0,1fr)!important;gap:14px!important}
  .fmb-build-root--duncan :is(.fmb-block-14,.fmb-block-15,.fmb-block-16) .core .card{padding:18px!important}
  .fmb-build-root--duncan :is(.fmb-block-14,.fmb-block-15,.fmb-block-16) .card .item p{font-size:14px!important}
}


/* Níveis 17–19: extensão cromática do padrão homologado dos blocos anteriores */


/* DUNCAN 17 — fase V — estilo heráldico coerente com os níveis 1–7 homologados */
.fmb-build-root--duncan :is(.fmb-block-11,.fmb-block-17,.fmb-block-12) .level{background:#efe5d1;border:2px solid #d0a663;overflow:hidden;box-shadow:0 18px 35px rgba(0,0,0,.30)}
.fmb-build-root--duncan :is(.fmb-block-11,.fmb-block-17,.fmb-block-12) .content{background:linear-gradient(180deg,#153a2b 0 13px,#f4e9d6 13px,#e9ddc9 100%);color:#2c3a2f}
.fmb-build-root--duncan :is(.fmb-block-11,.fmb-block-17,.fmb-block-12) .content :is(h1,h2){color:#153725}
.fmb-build-root--duncan :is(.fmb-block-11,.fmb-block-17,.fmb-block-12) .content .kicker,
.fmb-build-root--duncan :is(.fmb-block-11,.fmb-block-17,.fmb-block-12) .content .mini-label{color:#96502c}
.fmb-build-root--duncan :is(.fmb-block-11,.fmb-block-17,.fmb-block-12) .content .lead{color:#364739}
.fmb-build-root--duncan :is(.fmb-block-11,.fmb-block-12) .progress-side{background:radial-gradient(circle at 50% 12%,rgba(242,204,132,.13),transparent 26%),repeating-linear-gradient(150deg,rgba(255,255,255,.025) 0,rgba(255,255,255,.025) 1px,transparent 1px,transparent 9px),linear-gradient(160deg,#0d1c16,#143127 44%,#234639 76%,#345563 100%);border-right:4px solid #c5a06b}
.fmb-build-root--duncan :is(.fmb-block-11,.fmb-block-12) .progress-side .phase{color:#e9c58c}
.fmb-build-root--duncan :is(.fmb-block-11,.fmb-block-12) .progress-side .level-no{background:linear-gradient(140deg,#faefcf,#cfaa67);color:#203527;border:4px double #8f6835;box-shadow:0 0 0 5px rgba(230,189,121,.21),0 9px 23px rgba(0,0,0,.3)}
.fmb-build-root--duncan :is(.fmb-block-11,.fmb-block-12) .fm-side-sheet{background:transparent;border-top:2px solid #c3a16e;padding-top:21px}
.fmb-build-root--duncan :is(.fmb-block-11,.fmb-block-12) .fm-side-label{color:#e9c58c}
.fmb-build-root--duncan :is(.fmb-block-11,.fmb-block-12) .fm-stat{background:rgba(122,147,154,.17);border:1px solid rgba(199,168,103,.34)}
.fmb-build-root--duncan :is(.fmb-block-11,.fmb-block-12) .fm-stat strong{color:#fff8ea}
.fmb-build-root--duncan :is(.fmb-block-11,.fmb-block-12) .fm-stat small{color:#cdd9d6}
.fmb-build-root--duncan :is(.fmb-block-11,.fmb-block-12) .fm-stat span{color:#eac78a}
.fmb-build-root--duncan :is(.fmb-block-11,.fmb-block-12) .fm-panel{border-color:#c1a16d;background:rgba(7,27,20,.67)}
.fmb-build-root--duncan :is(.fmb-block-11,.fmb-block-12) .fm-row small,.fmb-build-root--duncan :is(.fmb-block-11,.fmb-block-12) .fm-resource-mini small{color:#cedbd0}
.fmb-build-root--duncan :is(.fmb-block-11,.fmb-block-12) .fm-row strong,.fmb-build-root--duncan :is(.fmb-block-11,.fmb-block-12) .fm-resource-mini strong{color:#fff3d7}
.fmb-build-root--duncan :is(.fmb-block-11,.fmb-block-12) .fm-resource-mini>div{border-color:rgba(209,177,119,.35);background:rgba(100,119,133,.2)}
.fmb-build-root--duncan :is(.fmb-block-11,.fmb-block-12) .snake-wrap .duncan-sidebar-empty{background:linear-gradient(160deg,rgba(190,164,113,.16),rgba(64,94,77,.24));border:1px solid rgba(224,189,126,.68);box-shadow:inset 0 0 0 4px rgba(7,29,19,.27);color:#fff0d2}
.fmb-build-root--duncan :is(.fmb-block-11,.fmb-block-12) .duncan-sidebar-empty small{color:#e9c58c}
.fmb-build-root--duncan :is(.fmb-block-11,.fmb-block-12) .duncan-sidebar-empty strong{color:#fff7e5}
.fmb-build-root--duncan :is(.fmb-block-11,.fmb-block-12) .duncan-sidebar-empty span{color:#e2d5be}
.fmb-build-root--duncan :is(.fmb-block-11,.fmb-block-12) .wish-section{border-top:1px solid #c5a16b}
.fmb-build-root--duncan :is(.fmb-block-11,.fmb-block-12) .wish-title{color:#eac58d}
.fmb-build-root--duncan :is(.fmb-block-11,.fmb-block-12) .wish-note{color:#cbd5c5}
.fmb-build-root--duncan :is(.fmb-block-11,.fmb-block-12) .wish-item{background:rgba(9,29,20,.55);border:1px solid #8c957b}
.fmb-build-root--duncan :is(.fmb-block-11,.fmb-block-12) .wish-item :is(strong,small,p){color:#f0dfc1}
.fmb-build-root--duncan :is(.fmb-block-11,.fmb-block-12) .wish-tag{background:#f0d39b;color:#1b3728}
.fmb-build-root--duncan :is(.fmb-block-11,.fmb-block-12) .card,
.fmb-build-root--duncan .fmb-block-17 .changes .card{background:linear-gradient(145deg,#f9f0e1,#e5d9c5);border:1px solid #bb9966;border-top:4px solid #345941;box-shadow:0 12px 24px rgba(0,0,0,.13)}
.fmb-build-root--duncan :is(.fmb-block-11,.fmb-block-12) .card.primary,
.fmb-build-root--duncan .fmb-block-17 .changes .card.primary{background:linear-gradient(145deg,#dce9d8,#d3ddce);border-top:4px solid #22583a}
.fmb-build-root--duncan :is(.fmb-block-11,.fmb-block-17,.fmb-block-12) .card .item strong{display:inline!important;font:700 16px Georgia,serif;color:#204d32}
.fmb-build-root--duncan :is(.fmb-block-11,.fmb-block-17,.fmb-block-12) .card .item p{font:14px/1.65 Arial,sans-serif;margin-top:5px;color:#465047}
.fmb-build-root--duncan :is(.fmb-block-11,.fmb-block-17,.fmb-block-12) .duncan-fact-card{background:linear-gradient(160deg,#e0e8d9,#d4dfd1);border:1px solid #9aab88;border-top:4px solid #2b6242;box-shadow:0 10px 19px rgba(24,47,32,.11);padding:20px 22px;margin:18px 0;border-radius:12px}
.fmb-build-root--duncan :is(.fmb-block-11,.fmb-block-17,.fmb-block-12) .duncan-continuity-note{background:#dfe7d9;border:1px solid #98a18b;border-left:5px solid #cca362;color:#294132;line-height:1.65;margin:16px 0 8px;padding:17px 19px;border-radius:10px}
.fmb-build-root--duncan :is(.fmb-block-11,.fmb-block-17,.fmb-block-12) .duncan-continuity-note strong{color:#214d32}
.fmb-build-root--duncan :is(.fmb-block-11,.fmb-block-12) .combat{background:linear-gradient(110deg,#10291e,#214c38 60%,#315741);border-top:5px solid #d1a460;color:#f7f0df;padding:28px}
.fmb-build-root--duncan :is(.fmb-block-11,.fmb-block-17,.fmb-block-12) .combat h2,.fmb-build-root--duncan :is(.fmb-block-11,.fmb-block-17,.fmb-block-12) .combat strong{color:#ffecc6}
.fmb-build-root--duncan :is(.fmb-block-11,.fmb-block-17,.fmb-block-12) .combat p{color:#f6ecd7;margin-bottom:12px}
.fmb-build-root--duncan :is(.fmb-block-11,.fmb-block-17,.fmb-block-12) .combat .mini-label{color:#e6bd7a}
.fmb-build-root--duncan :is(.fmb-block-11,.fmb-block-17,.fmb-block-12) .priority{background:rgba(230,194,131,.11);border:1px solid rgba(223,180,104,.67);border-left:5px solid #d3a963;color:#ffedc7}
.fmb-build-root--duncan :is(.fmb-block-11,.fmb-block-17,.fmb-block-12) .duncan-stat-strip>span{background:linear-gradient(135deg,#193a2b,#244a38 70%,#2d523d);border:1px solid #d1aa69;border-top:3px solid #f1c87e;color:#fff9e8;box-shadow:0 9px 17px rgba(0,0,0,.14);border-radius:100px;padding:9px 13px}
.fmb-build-root--duncan :is(.fmb-block-11,.fmb-block-17,.fmb-block-12) .duncan-stat-strip strong{color:#fff6e4}
.fmb-build-root--duncan .fmb-block-17 .phase-open{background:#efe4d0}
.fmb-build-root--duncan .fmb-block-17 .phase-open .art{border-right:5px solid #d3ab6a;background:radial-gradient(circle at 50% 25%,rgba(222,187,110,.13),transparent 30%),repeating-linear-gradient(143deg,rgba(255,255,255,.02) 0,rgba(255,255,255,.02) 1px,transparent 1px,transparent 9px),linear-gradient(145deg,#0c1c15,#153329 44%,#284c3b 74%,#34535a)}
.fmb-build-root--duncan .fmb-block-17 .phase-open .art:after{pointer-events:none}
.fmb-build-root--duncan .fmb-block-17 .duncan-phase-art{height:100%;min-height:490px;display:flex;align-items:center;justify-content:center;flex-direction:column;color:#f8ead0;gap:16px;border:1px solid #c9a66b;box-shadow:inset 0 0 0 6px rgba(4,23,12,.3);margin:22px;border-radius:8px;text-align:center;padding:32px}
.fmb-build-root--duncan .fmb-block-17 .duncan-phase-art small{font:700 11px Arial,sans-serif;letter-spacing:.25em;color:#ecc27e}
.fmb-build-root--duncan .fmb-block-17 .duncan-phase-art strong{font:normal clamp(55px,6vw,87px) Georgia,serif;color:#fff1d3}
.fmb-build-root--duncan .fmb-block-17 .duncan-phase-art span{font:12px Arial,sans-serif;color:#ded3bc}
.fmb-build-root--duncan .fmb-block-17 .phase-tag{background:#173626;border:1px solid #cfaa6d;color:#ffecc6}
.fmb-build-root--duncan .fmb-block-17 .level-badge{background:linear-gradient(150deg,#fff3d4,#cfab70);color:#213c2a;border-color:#c69d61}
.fmb-build-root--duncan .fmb-block-17 .art-caption{background:linear-gradient(180deg,rgba(9,33,24,.3),rgba(7,28,20,.85));color:#f5e6c5}
.fmb-build-root--duncan .fmb-block-17 .art-caption strong{color:#fff0ce}
.fmb-build-root--duncan .fmb-block-17 .art-caption span{color:#e8dac2}
.fmb-build-root--duncan .fmb-block-17 .subtitle{color:#496c45}
.fmb-build-root--duncan .fmb-block-17 .breakthrough{background:linear-gradient(120deg,#173628,#315440);border:1px solid #c59f67;border-left:6px solid #ddaf64;color:#f6ead1;padding:18px 20px;border-radius:10px;box-shadow:0 12px 24px rgba(0,0,0,.16)}
.fmb-build-root--duncan .fmb-block-17 .breakthrough strong{color:#ffe5ac}
.fmb-build-root--duncan .fmb-block-17 .combat{background:linear-gradient(110deg,#10291e,#214c38 60%,#315741);border-top:5px solid #d1a460;color:#f7f0df;padding:28px}
.fmb-build-root--duncan :is(.fmb-block-11,.fmb-block-12) .duncan-core-two{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}
.fmb-build-root--duncan .fmb-block-12 .duncan-mastery .duncan-facts>div:last-child{background:#dae8d7;border-color:#a17d4b}
@media(max-width:850px){.fmb-build-root--duncan .fmb-block-17 .phase-open .art{border-right:0;border-bottom:5px solid #cca56c}.fmb-build-root--duncan :is(.fmb-block-11,.fmb-block-12) .progress-side{border-right:0;border-bottom:5px solid #cca56c}}
@media(max-width:700px){.fmb-build-root--duncan :is(.fmb-block-11,.fmb-block-12) .duncan-core-two{grid-template-columns:1fr}.fmb-build-root--duncan .fmb-block-17 .duncan-phase-art{min-height:300px;margin:13px}.fmb-build-root--duncan :is(.fmb-block-11,.fmb-block-17,.fmb-block-12) .combat{padding:20px 14px}}
/* Legibilidade dos cards: separar as escolhas sem alterar o padrão homologado anterior. */
.fmb-build-root--duncan :is(.fmb-block-11,.fmb-block-12) .card .item{padding:12px 0 10px;margin:0;border-bottom:1px solid rgba(126,103,68,.25)}
.fmb-build-root--duncan :is(.fmb-block-11,.fmb-block-12) .card .item:last-child{border-bottom:0;padding-bottom:0}
.fmb-build-root--duncan :is(.fmb-block-11,.fmb-block-12) .card .item strong{display:block!important;margin-bottom:6px}
.fmb-build-root--duncan :is(.fmb-block-11,.fmb-block-12) .card .item p{margin:0!important}

/* Nível 12: reintroduz a estrutura fm-* de ficha lateral ausente no original do bloco 12. */
/* Forja sidebar sheet — standardized compact levels */
.fmb-block-12 .fm-side-sheet{
  position:relative;
  z-index:5;
  width:100%;
  margin-top:18px;
  padding:16px 0 0;
  border-top:1px solid rgba(221,205,169,.24);
  background:#102419;
}
.fmb-block-12 .fm-side-section + .fm-side-section{margin-top:16px}
.fmb-block-12 .fm-side-label{
  display:block;
  margin-bottom:8px;
  color:#ddcda9;
  font:800 9px/1.2 Arial,sans-serif;
  letter-spacing:.14em;
  text-transform:uppercase;
  text-align:left;
}
.fmb-block-12 .fm-stats-grid{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:6px;
}
.fmb-block-12 .fm-stat{
  padding:7px 5px 6px;
  border:1px solid rgba(255,255,255,.12);
  border-radius:9px;
  background:rgba(255,255,255,.045);
  text-align:center;
}
.fmb-block-12 .fm-stat small{
  display:block;
  color:#b8c6bd;
  font:800 8px/1 Arial,sans-serif;
}
.fmb-block-12 .fm-stat strong{
  display:block;
  margin-top:3px;
  color:#fff;
  font-size:18px;
  line-height:1;
}
.fmb-block-12 .fm-stat span{
  display:block;
  margin-top:3px;
  color:#8fb09d;
  font:700 9px/1 Arial,sans-serif;
}
.fmb-block-12 .fm-panel{
  padding:11px 12px;
  border:1px solid rgba(255,255,255,.11);
  border-radius:11px;
  background:rgba(255,255,255,.04);
}
.fmb-block-12 .fm-row{
  display:flex;
  align-items:flex-start;
  justify-content:space-between;
  gap:10px;
  padding:6px 0;
  border-top:1px solid rgba(255,255,255,.08);
}
.fmb-block-12 .fm-row:first-of-type{border-top:0}
.fmb-block-12 .fm-row small{
  color:#b8c6bd;
  font:700 9px/1.25 Arial,sans-serif;
}
.fmb-block-12 .fm-row strong{
  max-width:92px;
  color:#fff;
  font-size:11px;
  line-height:1.2;
  text-align:right;
}
.fmb-block-12 .fm-resource-mini{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:8px;
}
.fmb-block-12 .fm-resource-mini > div{
  padding:9px 7px;
  border:1px solid rgba(255,255,255,.09);
  border-radius:9px;
  background:rgba(255,255,255,.035);
  text-align:center;
}
.fmb-block-12 .fm-resource-mini small{
  display:block;
  color:#b8c6bd;
  font:700 8px/1.25 Arial,sans-serif;
}
.fmb-block-12 .fm-resource-mini strong{
  display:block;
  margin-top:5px;
  color:#fff;
  font-size:20px;
  line-height:1;
}
.fmb-block-12 .fm-timeline-resume{
  position:relative;
  z-index:1;
  width:2px;
  height:110px;
  margin:0 auto -24px;
  background:linear-gradient(#6b8374,#244a37);
  opacity:.78;
}
@media (max-width:760px){.fmb-block-12 .fm-side-sheet{max-width:420px;margin:18px auto 0}
.fmb-block-12 .fm-timeline-resume{display:none}}

/* Novos níveis preservam composição e paleta, com ajustes editoriais dos conteúdos homologados. */
.fmb-build-root--duncan :is(.fmb-block-11,.fmb-block-12,.fmb-block-17) .duncan-fact-card .duncan-facts>div{min-width:0}
.fmb-build-root--duncan :is(.fmb-block-11,.fmb-block-12,.fmb-block-17) .card .item strong{display:inline!important;max-width:none;white-space:normal!important;overflow-wrap:break-word;font:700 16px/1.35 Georgia,serif;color:#204d32}
.fmb-build-root--duncan :is(.fmb-block-11,.fmb-block-12,.fmb-block-17) .card .item p{margin-top:7px;font:14px/1.65 Arial,sans-serif;color:#465047}
.fmb-build-root--duncan :is(.fmb-block-11,.fmb-block-12,.fmb-block-17) .card h2{line-height:1.25}
.fmb-build-root--duncan .fmb-block-17 .phase-open .art{background:radial-gradient(circle at 50% 25%,rgba(222,187,110,.13),transparent 30%),repeating-linear-gradient(143deg,rgba(255,255,255,.02) 0,rgba(255,255,255,.02) 1px,transparent 1px,transparent 9px),linear-gradient(145deg,#0c1c15,#153329 44%,#284c3b 74%,#34535a)}
.fmb-build-root--duncan .fmb-block-17 .duncan-changes{margin:20px 0;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}
.fmb-build-root--duncan .fmb-block-17 .duncan-changes .card{padding:20px}
.fmb-build-root--duncan .fmb-block-17 .duncan-changes .card h2{margin:7px 0 14px}
.fmb-build-root--duncan .fmb-block-17 .duncan-changes .card .item{padding:10px 0;border-top:1px solid rgba(62,91,68,.2)}
.fmb-build-root--duncan .fmb-block-17 .duncan-changes .card .item:first-of-type{border-top:0}
@media(max-width:700px){.fmb-build-root--duncan .fmb-block-17 .duncan-changes{grid-template-columns:1fr}.fmb-build-root--duncan .fmb-block-17 .duncan-changes .card{padding:17px}}


.fmb-build-root--duncan :is(.fmb-block-18,.fmb-block-19) .progress-side{background:radial-gradient(circle at 50% 12%,rgba(242,204,132,.13),transparent 26%),repeating-linear-gradient(150deg,rgba(255,255,255,.025) 0,rgba(255,255,255,.025) 1px,transparent 1px,transparent 9px),linear-gradient(160deg,#0d1c16,#143127 44%,#234639 76%,#345563 100%);border-right:4px solid #c5a06b}
.fmb-build-root--duncan :is(.fmb-block-18,.fmb-block-19) .progress-side .phase{color:#e9c58c}
.fmb-build-root--duncan :is(.fmb-block-18,.fmb-block-19) .progress-side .level-no{background:linear-gradient(140deg,#faefcf,#cfaa67);color:#203527;border:4px double #8f6835;box-shadow:0 0 0 5px rgba(230,189,121,.21),0 9px 23px rgba(0,0,0,.3)}
.fmb-build-root--duncan :is(.fmb-block-18,.fmb-block-19) .fm-side-sheet{background:transparent;border-top:2px solid #c3a16e;padding-top:21px}
.fmb-build-root--duncan :is(.fmb-block-18,.fmb-block-19) .fm-side-label{color:#e9c58c}
.fmb-build-root--duncan :is(.fmb-block-18,.fmb-block-19) .fm-stat{background:rgba(122,147,154,.17);border:1px solid rgba(199,168,103,.34)}
.fmb-build-root--duncan :is(.fmb-block-18,.fmb-block-19) .fm-stat strong{color:#fff8ea}
.fmb-build-root--duncan :is(.fmb-block-18,.fmb-block-19) .fm-stat small{color:#cdd9d6}
.fmb-build-root--duncan :is(.fmb-block-18,.fmb-block-19) .fm-stat span{color:#eac78a}
.fmb-build-root--duncan :is(.fmb-block-18,.fmb-block-19) .fm-panel{border-color:#c1a16d;background:rgba(7,27,20,.67)}
.fmb-build-root--duncan :is(.fmb-block-18,.fmb-block-19) .fm-row small,.fmb-build-root--duncan :is(.fmb-block-18,.fmb-block-19) .fm-resource-mini small{color:#cedbd0}
