.fmb-build-root{position:relative;left:50%;width:100vw;margin-left:-50vw;overflow-x:clip;background:#f1f0ec;padding:1px 0 36px;isolation:isolate}
.fmb-build-root,.fmb-build-root *{box-sizing:border-box}
.fmb-build-root img{max-width:100%}
.fmb-build-root a{text-decoration:none}
.fmb-build-root .fmb-block{position:relative;width:100%}
.fmb-build-root .fmb-block + .fmb-block{margin-top:0}
/* Compatibility guard for editorial highlight blocks that WordPress themes often override. */
.fmb-build-root .optional-cap,.fmb-build-root .tome-synergy{color:#403a33!important;background:linear-gradient(180deg,#f8fbf9,#edf5f0)!important;border:1px solid #9fb5a8!important;border-radius:14px!important}
.fmb-build-root .optional-cap h2,.fmb-build-root .tome-synergy h2{color:#1f1b17!important}
.fmb-build-root .optional-cap p,.fmb-build-root .tome-synergy p{color:#403a33!important}
.fmb-build-root .optional-cap .mini-label,.fmb-build-root .tome-synergy .mini-label{color:#9b6b18!important}
@media(max-width:760px){.fmb-build-root{padding-bottom:18px}}


/* ===== BLOCO 0 ===== */
.fmb-block-0{--bg:#fbf8f2;--card:#fff;--ink:#1e1a17;--body:#463e36;--muted:#6d655c;--line:#ddd2c0;--gold:#a66a10;--green:#0f4735;--green2:#072f23;--silver:#eef0ed;--silverline:#b9bdb8}
.fmb-block-0 *{box-sizing:border-box}
.fmb-block-0{scroll-behavior:smooth}
.fmb-block-0{margin:0;background:#f2efe8;color:var(--ink);font-family:Georgia,"Times New Roman",serif}
.fmb-block-0 .note{padding:9px 16px;background:#16231e;color:#fff;text-align:center;font:700 11px/1.3 Arial,sans-serif;letter-spacing:.06em}
.fmb-block-0 .shell{width:min(1460px,calc(100% - 36px));margin:28px auto 72px}
.fmb-block-0 .hero{display:grid;grid-template-columns:minmax(0,.93fr) minmax(520px,1.07fr);min-height:700px;overflow:hidden;border:1px solid var(--line);border-radius:28px;background:#fff;box-shadow:0 24px 70px rgba(38,31,22,.08);padding:0;gap:0;align-items:stretch}
.fmb-block-0 .copy{position:relative;z-index:5;display:flex;flex-direction:column;justify-content:center;padding:58px 54px 56px 64px;background:radial-gradient(circle at 15% 7%,rgba(166,106,16,.075),transparent 31%),linear-gradient(180deg,#fff,#fdfbf7)}
.fmb-block-0 .kicker{margin:0;color:var(--gold);font:800 12px/1.2 Arial,sans-serif;text-transform:uppercase;letter-spacing:.17em}
.fmb-block-0 .scope{display:inline-flex;width:max-content;margin-top:14px;padding:8px 11px;border:1px solid #c9bda8;border-radius:999px;background:#fff;color:var(--green2);font:800 11px/1 Arial,sans-serif;letter-spacing:.07em;text-transform:uppercase}
.fmb-block-0 h1{margin:25px 0 0;font-size:clamp(64px,5.2vw,94px);line-height:.87;letter-spacing:-.047em;color:var(--ink)}
.fmb-block-0 h1 span{display:block;margin-top:14px;color:var(--green);font:700 .46em/1.03 Arial,sans-serif;letter-spacing:-.028em}
.fmb-block-0 .rule{width:96px;height:3px;margin:25px 0 27px;border:0;border-radius:99px;background:linear-gradient(90deg,var(--gold),#7e9c8b)}
.fmb-block-0 .lead{max-width:650px;margin:0;color:var(--body);font:400 21px/1.58 Arial,sans-serif}
.fmb-block-0 .lead strong{color:var(--green);font-weight:800}
.fmb-block-0 .quote{position:relative;max-width:650px;margin-top:27px;padding:18px 22px 18px 29px;border-top:1px solid var(--silverline);border-bottom:1px solid var(--silverline);background:linear-gradient(90deg,#e9ece9,#f7f8f5 78%,rgba(247,248,245,.3));color:#29302c}
.fmb-block-0 .quote:before{content:"";position:absolute;left:0;top:0;bottom:0;width:5px;background:var(--green)}
.fmb-block-0 .quote p{margin:0;font-size:17px;line-height:1.5;font-style:italic}
.fmb-block-0 .quote small{display:block;margin-top:7px;color:#737973;font:700 10px/1 Arial,sans-serif;letter-spacing:.15em;text-transform:uppercase}
.fmb-block-0 .actions{display:flex;flex-wrap:wrap;gap:12px;margin-top:29px}
.fmb-block-0 .btn{display:inline-flex;align-items:center;justify-content:center;min-height:51px;padding:0 21px;border-radius:12px;text-decoration:none;font:800 12px/1 Arial,sans-serif;letter-spacing:.06em;text-transform:uppercase}
.fmb-block-0 .primary{background:var(--green);color:#fff;border:1px solid var(--green)}
.fmb-block-0 .secondary{background:#fff;color:var(--ink);border:1px solid #cdbfa9}
.fmb-block-0 .visual{position:relative;min-height:700px;overflow:hidden;background:#061c14;isolation:isolate}
.fmb-block-0 .visual img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:50% 6%;filter:saturate(1.04) contrast(1.03)}
.fmb-block-0 .visual:before{content:"";position:absolute;z-index:2;inset:0;background:linear-gradient(90deg,#fdfbf7 0%,rgba(253,251,247,.96) 3%,rgba(253,251,247,.62) 11%,rgba(253,251,247,.08) 25%,transparent 36%),linear-gradient(0deg,rgba(3,16,11,.28),transparent 42%);pointer-events:none}
.fmb-block-0 .visual:after{content:"";position:absolute;z-index:3;left:2%;top:47%;width:58%;height:5px;border-radius:999px;transform:rotate(-7deg);background:linear-gradient(90deg,rgba(72,255,139,0),rgba(72,255,139,.75) 24%,#d9ffe7 52%,rgba(72,255,139,.55) 72%,rgba(72,255,139,0));box-shadow:0 0 16px rgba(72,255,139,.62),0 0 40px rgba(72,255,139,.32);pointer-events:none}
.fmb-block-0 .art-caption{position:absolute;z-index:4;right:24px;bottom:23px;padding:10px 13px;border:1px solid rgba(222,203,166,.52);border-radius:999px;background:rgba(5,27,18,.76);color:#fff;font:800 10px/1 Arial,sans-serif;letter-spacing:.1em;text-transform:uppercase;backdrop-filter:blur(7px)}
.fmb-block-0 .bottom{margin-top:17px;text-align:center;color:#766c62;font:700 10px/1 Arial,sans-serif;letter-spacing:.1em;text-transform:uppercase}
.fmb-block-0 #next{min-height:150px;display:grid;place-items:center;color:#7c7268;font:600 14px Arial,sans-serif}
@media (max-width:1120px){.fmb-block-0 .shell{width:min(980px,calc(100% - 26px))}
.fmb-block-0 .hero{grid-template-columns:1fr;min-height:0}
.fmb-block-0 .copy{padding:52px 44px 18px}
.fmb-block-0 h1{font-size:clamp(58px,9vw,82px)}
.fmb-block-0 .visual{min-height:610px;margin-top:0}
.fmb-block-0 .visual img{object-position:50% 5%}
.fmb-block-0 .visual:before{background:linear-gradient(0deg,rgba(3,16,11,.3),transparent 42%)}
.fmb-block-0 .visual:after{left:18%;top:47%;width:52%}}
@media (max-width:640px){.fmb-block-0 .shell{width:min(100% - 16px,590px);margin-top:8px}
.fmb-block-0 .hero{display:block;min-height:0;border-radius:20px;padding:0;gap:0}
.fmb-block-0 .copy{margin:0;padding:34px 22px 14px}
.fmb-block-0 .scope{font-size:10px}
.fmb-block-0 h1{font-size:clamp(47px,14vw,66px);line-height:.93}
.fmb-block-0 h1 span{font-size:.44em;margin-top:10px}
.fmb-block-0 .lead{font-size:18px;line-height:1.5}
.fmb-block-0 .quote{padding:16px 17px 16px 22px}
.fmb-block-0 .actions{display:grid;grid-template-columns:1fr}
.fmb-block-0 .btn{width:100%}
.fmb-block-0 .visual{position:relative;display:block;height:500px;min-height:500px;margin:0;padding:0;overflow:hidden;background:#061c14}
.fmb-block-0 .visual img{position:absolute;inset:0;width:100%;height:100%;min-height:0;display:block;object-fit:cover;object-position:50% 4%}
.fmb-block-0 .art-caption{left:16px;right:auto;bottom:16px}}

/* ===== BLOCO 1 ===== */
.fmb-block-1{
  --paper:#fbfaf6;
  --white:#ffffff;
  --ink:#1f1b17;
  --body:#3f3932;
  --muted:#6b645b;
  --line:#ded5c6;
  --gold:#9c6a16;
  --gold-soft:#c6a768;
  --silver:#edf0ee;
  --silver-line:#b7bfbc;
  --green:#667c70;
  --green-deep:#264b3a;
}
.fmb-block-1 *{box-sizing:border-box}
.fmb-block-1{
  margin:0;
  background:#f2f1ed;
  color:var(--body);
  font-family:Georgia,"Times New Roman",serif;
}
.fmb-block-1 .preview{
  width:min(1360px,calc(100% - 48px));
  margin:34px auto;
}
.fmb-block-1 .block{
  background:var(--paper);
  border:1px solid var(--line);
  border-radius:26px;
  overflow:hidden;
}
.fmb-block-1 .top{
  display:grid;
  grid-template-columns:minmax(340px,40%) minmax(0,60%);
  background:var(--white);
}
.fmb-block-1 .art{
  position:relative;
  min-height:610px;
  overflow:hidden;
  background:#17211c;
}
.fmb-block-1 .art img{
  display:block;
  width:100%;
  height:100%;
  min-height:610px;
  object-fit:cover;
  object-position:center center;
}
.fmb-block-1 .art:after{
  content:"";
  position:absolute;
  inset:0;
  background:linear-gradient(90deg,rgba(0,0,0,0) 68%,rgba(255,255,255,.08));
  pointer-events:none;
}
.fmb-block-1 .stage-tag{
  position:absolute;
  left:22px;
  bottom:22px;
  background:rgba(15,31,24,.82);
  color:#fff;
  border:1px solid rgba(255,255,255,.22);
  border-radius:999px;
  padding:8px 12px;
  font:700 11px/1 Arial,sans-serif;
  letter-spacing:.08em;
  text-transform:uppercase;
}
.fmb-block-1 .copy{
  padding:42px 44px 36px;
  display:flex;
  flex-direction:column;
  justify-content:center;
}
.fmb-block-1 .kicker{
  color:var(--gold);
  font:700 11px/1.2 Arial,sans-serif;
  letter-spacing:.16em;
  text-transform:uppercase;
}
.fmb-block-1 h1,.fmb-block-1 h2,.fmb-block-1 h3,.fmb-block-1 h4{color:var(--ink);margin:0}
.fmb-block-1 .copy h1{
  margin-top:8px;
  font-size:clamp(35px,4vw,56px);
  line-height:.98;
}
.fmb-block-1 .copy .subtitle{
  margin-top:10px;
  font-size:22px;
  font-style:italic;
  color:var(--green-deep);
}
.fmb-block-1 .intro{
  margin:18px 0 0;
  max-width:780px;
  font-size:17px;
  line-height:1.7;
}
.fmb-block-1 .status{
  display:grid;
  grid-template-columns:repeat(5,minmax(0,1fr));
  gap:8px;
  margin-top:24px;
}
.fmb-block-1 .status-card{
  border:1px solid var(--line);
  background:#fff;
  border-radius:13px;
  padding:12px 8px;
  text-align:center;
  font-family:Arial,sans-serif;
}
.fmb-block-1 .status-card span{
  display:block;
  font-size:11px;
  color:var(--muted);
  margin-bottom:3px;
}
.fmb-block-1 .status-card strong{
  color:var(--ink);
  font-size:17px;
}
.fmb-block-1 .origin-grid{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:13px;
  margin-top:22px;
}
.fmb-block-1 .info{
  border:1px solid var(--line);
  background:#fff;
  border-radius:16px;
  padding:17px 18px;
}
.fmb-block-1 .info h3{
  margin-top:4px;
  font-size:21px;
}
.fmb-block-1 .info p{
  margin:7px 0 0;
  line-height:1.55;
  font-size:14px;
}
.fmb-block-1 .feat{
  margin-top:12px;
  padding-top:12px;
  border-top:1px solid var(--line);
}
.fmb-block-1 .feat-label{
  font:700 10px/1 Arial,sans-serif;
  letter-spacing:.11em;
  text-transform:uppercase;
  color:var(--gold);
}
.fmb-block-1 .feat-name{
  display:block;
  margin-top:5px;
  color:var(--green-deep);
  font-weight:700;
  font-size:18px;
}
.fmb-block-1 .section{
  padding:30px 34px;
  border-top:1px solid var(--line);
  background:var(--paper);
}
.fmb-block-1 .section-head{
  display:flex;
  align-items:end;
  justify-content:space-between;
  gap:20px;
  margin-bottom:16px;
}
.fmb-block-1 .section h2{
  font-size:28px;
}
.fmb-block-1 .note{
  font:600 12px/1.35 Arial,sans-serif;
  color:var(--muted);
}
.fmb-block-1 .attributes{
  display:grid;
  grid-template-columns:repeat(6,minmax(0,1fr));
  gap:10px;
}
.fmb-block-1 .attr{
  background:#fff;
  border:1px solid var(--line);
  border-radius:15px;
  padding:15px 10px;
  text-align:center;
}
.fmb-block-1 .attr .name{
  font:700 11px/1 Arial,sans-serif;
  letter-spacing:.09em;
  text-transform:uppercase;
  color:var(--muted);
}
.fmb-block-1 .attr .score{
  display:block;
  margin-top:7px;
  font-size:30px;
  color:var(--ink);
  font-weight:700;
}
.fmb-block-1 .attr .mod{
  display:block;
  margin-top:3px;
  font:700 12px Arial,sans-serif;
  color:var(--green-deep);
}
.fmb-block-1 .attr .base{
  display:block;
  margin-top:7px;
  font:12px Arial,sans-serif;
  color:var(--muted);
}
.fmb-block-1 .attr.primary{
  border-color:#8ea898;
  background:#f5f9f6;
  box-shadow:inset 0 0 0 1px rgba(38,75,58,.08);
}
.fmb-block-1 .progression{
  margin-top:13px;
  background:var(--silver);
  border:1px solid var(--silver-line);
  border-left:4px solid var(--green-deep);
  border-radius:12px;
  padding:12px 15px;
  font:700 13px/1.45 Arial,sans-serif;
  color:#39433e;
}
.fmb-block-1 .progression strong{color:var(--ink)}
.fmb-block-1 .magic-grid{
  display:grid;
  grid-template-columns:1.05fr 1fr 1fr;
  gap:13px;
}
.fmb-block-1 .magic-card{
  background:#fff;
  border:1px solid var(--line);
  border-radius:16px;
  padding:18px;
}
.fmb-block-1 .magic-card h3{
  font-size:20px;
  margin-top:5px;
}
.fmb-block-1 .magic-card ul{
  margin:12px 0 0 18px;
  padding:0;
  line-height:1.65;
  font-size:14px;
}
.fmb-block-1 .source{
  display:inline-block;
  margin-top:10px;
  font:700 10px/1 Arial,sans-serif;
  letter-spacing:.08em;
  text-transform:uppercase;
  color:var(--gold);
}
.fmb-block-1 .tome{
  border-color:#9fb0a7;
  background:linear-gradient(180deg,#fff,#f7faf8);
}
.fmb-block-1 .tome-badge{
  display:inline-flex;
  margin-top:12px;
  padding:7px 10px;
  border:1px solid #9fb0a7;
  border-radius:999px;
  background:#eef5f1;
  color:var(--green-deep);
  font:700 11px/1 Arial,sans-serif;
  text-transform:uppercase;
  letter-spacing:.07em;
}
.fmb-block-1 .play{
  padding:26px 34px 32px;
  border-top:1px solid var(--line);
  background:#fff;
}
.fmb-block-1 .play-box{
  display:grid;
  grid-template-columns:180px minmax(0,1fr);
  gap:20px;
  align-items:start;
  border-left:4px solid var(--gold);
  padding-left:18px;
}
.fmb-block-1 .play h2{font-size:26px}
.fmb-block-1 .play p{
  margin:0;
  font-size:16px;
  line-height:1.7;
}
.fmb-block-1 .play strong{color:var(--ink)}
@media (max-width:1050px){.fmb-block-1 .top{grid-template-columns:1fr}
.fmb-block-1 .art{min-height:430px}
.fmb-block-1 .art img{min-height:430px;object-position:center 24%}
.fmb-block-1 .copy{padding:34px}
.fmb-block-1 .origin-grid{grid-template-columns:1fr 1fr}
.fmb-block-1 .attributes{grid-template-columns:repeat(3,1fr)}
.fmb-block-1 .magic-grid{grid-template-columns:1fr 1fr}
.fmb-block-1 .magic-grid .tome{grid-column:1/-1}}
@media (max-width:720px){.fmb-block-1 .preview{width:min(100% - 20px,1360px);margin:10px auto}
.fmb-block-1 .block{border-radius:18px}
.fmb-block-1 .art{min-height:330px}
.fmb-block-1 .art img{min-height:330px}
.fmb-block-1 .copy,.fmb-block-1 .section,.fmb-block-1 .play{padding:24px 20px}
.fmb-block-1 .copy h1{font-size:38px}
.fmb-block-1 .origin-grid,.fmb-block-1 .magic-grid{grid-template-columns:1fr}
.fmb-block-1 .magic-grid .tome{grid-column:auto}
.fmb-block-1 .status{grid-template-columns:repeat(2,1fr)}
.fmb-block-1 .attributes{grid-template-columns:repeat(2,1fr)}
.fmb-block-1 .section-head{display:block}
.fmb-block-1 .note{margin-top:6px}
.fmb-block-1 .play-box{grid-template-columns:1fr}}
.fmb-block-1 .combat-priority{
  margin-top:16px;
  padding:12px 14px;
  border:1px solid var(--line);
  border-left:4px solid var(--green-deep);
  border-radius:10px;
  background:var(--silver);
  font:700 13px/1.5 Arial,sans-serif;
  color:#39433e;
}
.fmb-block-1 .combat-quote{
  margin:16px 0 0;
  padding:14px 16px;
  border-left:3px solid var(--gold);
  background:#faf7f0;
  color:var(--body);
  font-size:15px;
  line-height:1.65;
  font-style:italic;
}
.fmb-block-1 .feat-name small,.fmb-block-1 .magic-card h3 small{
  font-size:.62em;
  font-weight:600;
  color:var(--muted);
}

/* ===== BLOCO 2 ===== */
.fmb-block-2{
  --paper:#fbfaf6;
  --white:#fff;
  --ink:#1f1b17;
  --body:#3f3932;
  --muted:#6f675e;
  --line:#ded5c6;
  --gold:#9c6a16;
  --green:#28513e;
  --green-soft:#f3f7f4;
  --silver:#eef1ef;
}
.fmb-block-2 *{box-sizing:border-box}
.fmb-block-2{
  margin:0;
  background:#f2f1ed;
  color:var(--body);
  font-family:Georgia,"Times New Roman",serif;
}
.fmb-block-2 .preview{
  width:min(1360px,calc(100% - 48px));
  margin:34px auto;
}
.fmb-block-2 .level{
  display:grid;
  grid-template-columns:210px minmax(0,1fr);
  border:1px solid var(--line);
  border-radius:24px;
  overflow:hidden;
  background:var(--paper);
}
.fmb-block-2 .visual{
  min-height:560px;
  padding:24px 18px;
  background:
    radial-gradient(circle at 55% 38%,rgba(74,115,90,.22),transparent 30%),
    linear-gradient(180deg,#16221c,#0c1511);
  color:white;
  display:flex;
  flex-direction:column;
  align-items:center;
  text-align:center;
}
.fmb-block-2 .phase{
  font:800 10px/1.25 Arial,sans-serif;
  letter-spacing:.16em;
  text-transform:uppercase;
  color:#d8c9a9;
}
.fmb-block-2 .level-no{
  margin-top:12px;
  width:74px;
  height:74px;
  border-radius:50%;
  display:grid;
  place-items:center;
  background:#f5f2e9;
  border:3px solid #a5782b;
  color:#1f1b17;
  font:bold 34px/1 Georgia,serif;
}
.fmb-block-2 .snake{
  width:160px;
  margin-top:42px;
  filter:drop-shadow(0 14px 22px rgba(0,0,0,.42));
}
.fmb-block-2 .visual-copy{
  margin-top:auto;
}
.fmb-block-2 .visual-copy strong{
  display:block;
  font-size:21px;
}
.fmb-block-2 .visual-copy span{
  display:block;
  margin-top:5px;
  color:#c8d2cc;
  font:700 10px/1.4 Arial,sans-serif;
  letter-spacing:.08em;
  text-transform:uppercase;
}
.fmb-block-2 .content{
  padding:32px 36px 34px;
}
.fmb-block-2 .kicker{
  color:var(--gold);
  font:800 10px/1.2 Arial,sans-serif;
  letter-spacing:.16em;
  text-transform:uppercase;
}
.fmb-block-2 h1,.fmb-block-2 h2,.fmb-block-2 h3{margin:0;color:var(--ink)}
.fmb-block-2 h1{
  margin-top:7px;
  font-size:42px;
  line-height:1;
}
.fmb-block-2 .subtitle{
  margin-top:7px;
  font-size:20px;
  color:var(--green);
  font-style:italic;
}
.fmb-block-2 .lead{
  margin:14px 0 0;
  max-width:880px;
  font-size:16px;
  line-height:1.62;
}
.fmb-block-2 .summary{
  margin-top:20px;
  display:grid;
  grid-template-columns:repeat(4,minmax(0,1fr));
  gap:9px;
}
.fmb-block-2 .sum{
  padding:11px 9px;
  border:1px solid var(--line);
  border-radius:12px;
  background:#fff;
  text-align:center;
  font-family:Arial,sans-serif;
}
.fmb-block-2 .sum span{
  display:block;
  font-size:10px;
  color:var(--muted);
  line-height:1.25;
}
.fmb-block-2 .sum strong{
  display:block;
  margin-top:4px;
  font-size:17px;
  color:var(--ink);
}
.fmb-block-2 .section{
  margin-top:24px;
  padding-top:22px;
  border-top:1px solid var(--line);
}
.fmb-block-2 .section h2{
  margin-top:5px;
  font-size:26px;
}
.fmb-block-2 .grid{
  margin-top:13px;
  display:grid;
  grid-template-columns:repeat(2,minmax(0,1fr));
  gap:11px;
}
.fmb-block-2 .card{
  border:1px solid var(--line);
  border-radius:15px;
  background:#fff;
  padding:16px 17px;
}
.fmb-block-2 .card h3{
  font-size:19px;
}
.fmb-block-2 .card p{
  margin:8px 0 0;
  font-size:14px;
  line-height:1.55;
}
.fmb-block-2 .card.primary{
  border-color:#9eb5aa;
  background:linear-gradient(180deg,#fff,var(--green-soft));
}
.fmb-block-2 .invocations{
  margin-top:13px;
  display:grid;
  grid-template-columns:repeat(3,minmax(0,1fr));
  gap:10px;
}
.fmb-block-2 .inv{
  border:1px solid var(--line);
  border-radius:14px;
  background:#fff;
  padding:14px;
}
.fmb-block-2 .inv small{
  display:block;
  color:var(--gold);
  font:800 9px/1.2 Arial,sans-serif;
  letter-spacing:.1em;
  text-transform:uppercase;
}
.fmb-block-2 .inv strong{
  display:block;
  margin-top:5px;
  color:var(--ink);
  font-size:16px;
  line-height:1.25;
}
.fmb-block-2 .inv p{
  margin:7px 0 0;
  font-size:13px;
  line-height:1.5;
}
.fmb-block-2 .spell{
  margin-top:13px;
  padding:16px 17px;
  border:1px solid #b39a70;
  border-radius:15px;
  background:#fcfaf5;
}
.fmb-block-2 .spell strong{
  color:var(--ink);
  font-size:18px;
}
.fmb-block-2 .spell p{
  margin:7px 0 0;
  font-size:14px;
  line-height:1.55;
}
.fmb-block-2 .reskin{
  margin-top:11px;
  padding:11px 13px;
  border-left:4px solid var(--green);
  background:var(--silver);
  border-radius:10px;
  font-size:13px;
  line-height:1.5;
}
.fmb-block-2 .combat{
  margin-top:24px;
  padding:16px 17px;
  border-left:4px solid var(--gold);
  background:#fff;
}
.fmb-block-2 .combat h2{
  font-size:23px;
}
.fmb-block-2 .combat p{
  margin:8px 0 0;
  font-size:14px;
  line-height:1.6;
}
@media (max-width:760px){.fmb-block-2 .level{grid-template-columns:1fr}
.fmb-block-2 .progress-side{min-height:330px}}
@media (max-width:700px){.fmb-block-2 .preview{width:calc(100% - 20px);margin:10px auto}
.fmb-block-2 .content{padding:24px 20px 26px}
.fmb-block-2 h1{font-size:35px}
.fmb-block-2 .summary,.fmb-block-2 .grid,.fmb-block-2 .invocations{grid-template-columns:1fr}}
.fmb-block-2 .progress-side{
  position:relative;
  height:100%;
  padding:28px 18px 24px;
  background:
    radial-gradient(circle at 50% 36%,rgba(81,122,96,.18),transparent 25%),
    linear-gradient(180deg,#14231c,#0d1712);
  color:#fff;
  display:flex;
  flex-direction:column;
  align-items:center;
  overflow:hidden;
}
.fmb-block-2 .progress-side .phase{
  position:relative;
  z-index:4;
  font:800 10px/1.25 Arial,sans-serif;
  letter-spacing:.16em;
  text-transform:uppercase;
  color:#ddcda9;
  text-align:center;
}
.fmb-block-2 .progress-side .level-no{
  position:relative;
  z-index:4;
  margin-top:14px;
  width:76px;
  height:76px;
  border-radius:50%;
  display:grid;
  place-items:center;
  background:#f6f3eb;
  border:3px solid #a8792d;
  color:#1f1b17;
  font:bold 34px/1 Georgia,serif;
}
.fmb-block-2 .progress-side .timeline{
  position:absolute;
  z-index:1;
  top:118px;
  height:300px;
  left:50%;
  width:2px;
  transform:translateX(-50%);
  background:linear-gradient(#c5b79c,#73877a 56%,#2e493c);
  opacity:.72;
}
.fmb-block-2 .progress-side .snake-wrap{
  position:relative;
  z-index:3;
  width:150px;
  margin-top:auto;
  margin-bottom:34px;
}
.fmb-block-2 .progress-side .snake-wrap img{
  display:block;
  width:100%;
  height:auto;
  filter:drop-shadow(0 15px 22px rgba(0,0,0,.46));
}
.fmb-block-2 .progress-side .side-note{
  position:relative;
  z-index:4;
  margin-top:auto;
  padding-top:24px;
  text-align:center;
}
.fmb-block-2 .progress-side .side-note strong{
  display:block;
  font-size:18px;
}
.fmb-block-2 .progress-side .side-note span{
  display:block;
  margin-top:5px;
  color:#c5d0c9;
  font:700 9px/1.45 Arial,sans-serif;
  letter-spacing:.08em;
  text-transform:uppercase;
}
.fmb-block-2 .compact-content{padding:30px 34px 32px}
.fmb-block-2 .compact-lead{max-width:860px}
.fmb-block-2 .compact-strip{
  margin-top:18px;
  display:flex;
  flex-wrap:wrap;
  gap:8px;
}
.fmb-block-2 .compact-strip span{
  padding:8px 11px;
  border:1px solid var(--line);
  border-radius:999px;
  background:#fff;
  font:700 11px/1 Arial,sans-serif;
  color:var(--muted);
}
.fmb-block-2 .compact-strip strong{color:var(--ink)}
.fmb-block-2 .compact-block{
  margin-top:22px;
  padding-top:20px;
  border-top:1px solid var(--line);
}
.fmb-block-2 .compact-block h2{
  margin:0 0 12px;
  color:var(--ink);
  font-size:25px;
}
.fmb-block-2 .compact-row{
  padding:14px 0;
  border-top:1px solid #ece6dc;
}
.fmb-block-2 .compact-row:first-of-type{border-top:0;padding-top:0}
.fmb-block-2 .compact-row.two{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:18px;
}
.fmb-block-2 .compact-row strong,.fmb-block-2 .compact-combat strong{
  display:block;
  color:var(--ink);
  font-size:17px;
}
.fmb-block-2 .compact-row p,.fmb-block-2 .compact-combat p{
  margin:5px 0 0;
  font-size:14px;
  line-height:1.55;
}
.fmb-block-2 .mini-label{
  display:block;
  margin-bottom:5px;
  color:var(--gold);
  font:800 9px/1.2 Arial,sans-serif;
  text-transform:uppercase;
  letter-spacing:.1em;
}
.fmb-block-2 .compact-combat{
  margin-top:20px;
  padding:16px 17px;
  border-left:4px solid var(--gold);
  background:#fff;
}
@media (max-width:700px){.fmb-block-2 .compact-content{padding:24px 20px 26px}
.fmb-block-2 .compact-row.two{grid-template-columns:1fr}}
/* Forja sidebar sheet — standardized compact levels */
.fmb-block-2 .fm-side-sheet{
  position:relative;
  z-index:5;
  width:100%;
  margin-top:18px;
  padding:16px 0 0;
  border-top:1px solid rgba(221,205,169,.24);
  background:#102419;
}
.fmb-block-2 .fm-side-section + .fm-side-section{margin-top:16px}
.fmb-block-2 .fm-side-label{
  display:block;
  margin-bottom:8px;
  color:#ddcda9;
  font:800 9px/1.2 Arial,sans-serif;
  letter-spacing:.14em;
  text-transform:uppercase;
  text-align:left;
}
.fmb-block-2 .fm-stats-grid{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:6px;
}
.fmb-block-2 .fm-stat{
  padding:7px 5px 6px;
  border:1px solid rgba(255,255,255,.12);
  border-radius:9px;
  background:rgba(255,255,255,.045);
  text-align:center;
}
.fmb-block-2 .fm-stat small{
  display:block;
  color:#b8c6bd;
  font:800 8px/1 Arial,sans-serif;
}
.fmb-block-2 .fm-stat strong{
  display:block;
  margin-top:3px;
  color:#fff;
  font-size:18px;
  line-height:1;
}
.fmb-block-2 .fm-stat span{
  display:block;
  margin-top:3px;
  color:#8fb09d;
  font:700 9px/1 Arial,sans-serif;
}
.fmb-block-2 .fm-panel{
  padding:11px 12px;
  border:1px solid rgba(255,255,255,.11);
  border-radius:11px;
  background:rgba(255,255,255,.04);
}
.fmb-block-2 .fm-row{
  display:flex;
  align-items:flex-start;
  justify-content:space-between;
  gap:10px;
  padding:6px 0;
  border-top:1px solid rgba(255,255,255,.08);
}
.fmb-block-2 .fm-row:first-of-type{border-top:0}
.fmb-block-2 .fm-row small{
  color:#b8c6bd;
  font:700 9px/1.25 Arial,sans-serif;
}
.fmb-block-2 .fm-row strong{
  max-width:92px;
  color:#fff;
  font-size:11px;
  line-height:1.2;
  text-align:right;
}
.fmb-block-2 .fm-resource-mini{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:8px;
}
.fmb-block-2 .fm-resource-mini > div{
  padding:9px 7px;
  border:1px solid rgba(255,255,255,.09);
  border-radius:9px;
  background:rgba(255,255,255,.035);
  text-align:center;
}
.fmb-block-2 .fm-resource-mini small{
  display:block;
  color:#b8c6bd;
  font:700 8px/1.25 Arial,sans-serif;
}
.fmb-block-2 .fm-resource-mini strong{
  display:block;
  margin-top:5px;
  color:#fff;
  font-size:20px;
  line-height:1;
}
.fmb-block-2 .fm-timeline-resume{
  position:relative;
  z-index:1;
  width:2px;
  height:110px;
  margin:0 auto -24px;
  background:linear-gradient(#6b8374,#244a37);
  opacity:.78;
}
@media (max-width:760px){.fmb-block-2 .fm-side-sheet{max-width:420px;margin:18px auto 0}
.fmb-block-2 .fm-timeline-resume{display:none}}
.fmb-block-2 .progress-side .timeline{bottom:auto!important;height:300px!important}
/* === Sidebar compacta padronizada: cobra + wishlist === */
.fmb-block-2 .progress-side .snake-wrap{
  width:158px !important;
  height:215px !important;
  min-height:215px !important;
  margin:12px auto 8px !important;
  display:flex !important;
  align-items:flex-start !important;
  justify-content:center !important;
  flex:0 0 215px !important;
}
.fmb-block-2 .progress-side .snake-wrap img{
  display:block !important;
  width:100% !important;
  height:100% !important;
  max-height:215px !important;
  object-fit:contain !important;
  object-position:center top !important;
}
.fmb-block-2 .progress-side .timeline{
  bottom:auto !important;
  height:170px !important;
}
.fmb-block-2 .wish-section,.fmb-block-2 .arcana-standard{
  position:relative;
  z-index:6;
  width:100%;
  margin-top:16px;
  padding:11px 12px;
  border:1px solid rgba(255,255,255,.11);
  border-radius:11px;
  background:rgba(255,255,255,.04);
}
.fmb-block-2 .wish-title,.fmb-block-2 .arcana-standard-title{
  display:block;
  margin-bottom:8px;
  color:#ddcda9;
  font:800 9px/1.2 Arial,sans-serif;
  letter-spacing:.14em;
  text-transform:uppercase;
}
.fmb-block-2 .wish-note{
  margin:0 0 9px;
  color:#9fb2a6;
  font:700 8px/1.4 Arial,sans-serif;
}
.fmb-block-2 .wish-item{
  padding:8px 9px;
  border:1px solid rgba(255,255,255,.09);
  border-radius:9px;
  background:rgba(255,255,255,.035);
}
.fmb-block-2 .wish-item + .wish-item{margin-top:7px}
.fmb-block-2 .wish-head{display:flex;gap:7px;align-items:flex-start;justify-content:space-between}
.fmb-block-2 .wish-head strong{color:#fff;font-size:11px;line-height:1.25}
.fmb-block-2 .wish-tag{
  flex:0 0 auto;padding:3px 5px;border:1px solid rgba(215,190,130,.32);
  border-radius:999px;color:#ddcda9;font:800 6.5px/1 Arial,sans-serif;
  letter-spacing:.06em;text-transform:uppercase
}
.fmb-block-2 .wish-item small{display:block;margin-top:3px;color:#9ab4a4;font:700 7.5px/1.25 Arial,sans-serif}
.fmb-block-2 .wish-item p{margin:6px 0 0;color:#d2ddd6;font-size:9px;line-height:1.42}
.fmb-block-2 .arcana-standard-row{
  padding:8px 9px;border:1px solid rgba(255,255,255,.09);border-radius:9px;
  background:rgba(255,255,255,.035)
}
.fmb-block-2 .arcana-standard-row + .arcana-standard-row{margin-top:7px}
.fmb-block-2 .arcana-standard-row small{display:block;color:#9ab4a4;font:700 7.5px/1.2 Arial,sans-serif;text-transform:uppercase}
.fmb-block-2 .arcana-standard-row strong{display:block;margin-top:4px;color:#fff;font-size:11px;line-height:1.25}
.fmb-block-2 .arcana-standard-row em{display:block;margin-top:2px;color:#b8c6bd;font:italic 8px/1.2 Georgia,serif}
@media (max-width:760px){.fmb-block-2 .progress-side .snake-wrap{
    width:145px !important;height:195px !important;min-height:195px !important;
    flex-basis:195px !important;margin:10px auto 6px !important
  }}
/* === Wishlist minimalista: somente próximo item prioritário === */
.fmb-block-2 .wish-section{
  position:relative;
  z-index:6;
  width:100%;
  margin-top:16px;
  padding:11px 12px;
  border:1px solid rgba(255,255,255,.11);
  border-radius:11px;
  background:rgba(255,255,255,.04);
}
.fmb-block-2 .wish-title{
  display:block;
  margin-bottom:7px;
  color:#ddcda9;
  font:800 9px/1.2 Arial,sans-serif;
  letter-spacing:.14em;
  text-transform:uppercase;
}
.fmb-block-2 .wish-note{
  margin:0 0 9px;
  color:#9fb2a6;
  font:700 8px/1.45 Arial,sans-serif;
}
.fmb-block-2 .wish-item{
  padding:9px 10px;
  border:1px solid rgba(255,255,255,.09);
  border-radius:9px;
  background:rgba(255,255,255,.035);
}
.fmb-block-2 .wish-head{
  display:flex;
  gap:7px;
  align-items:flex-start;
  justify-content:space-between;
}
.fmb-block-2 .wish-head strong{
  color:#fff;
  font-size:11px;
  line-height:1.25;
}
.fmb-block-2 .wish-tag{
  flex:0 0 auto;
  padding:3px 5px;
  border:1px solid rgba(215,190,130,.32);
  border-radius:999px;
  color:#ddcda9;
  font:800 6.5px/1 Arial,sans-serif;
  letter-spacing:.06em;
  text-transform:uppercase;
}
.fmb-block-2 .wish-item small{
  display:block;
  margin-top:3px;
  color:#9ab4a4;
  font:700 7.5px/1.25 Arial,sans-serif;
}
.fmb-block-2 .wish-item p{
  margin:6px 0 0;
  color:#d2ddd6;
  font-size:9px;
  line-height:1.42;
}

/* ===== BLOCO 3 ===== */
.fmb-block-3{
  --paper:#fbfaf6;--white:#fff;--ink:#1f1b17;--body:#403a33;--muted:#70675e;
  --line:#ddd4c5;--gold:#9b6b18;--green:#28513e;--green-soft:#f2f7f3;--silver:#eef1ef;
}
.fmb-block-3 *{box-sizing:border-box}
.fmb-block-3{margin:0;background:#f1f0ec;color:var(--body);font-family:Georgia,"Times New Roman",serif}
.fmb-block-3 .preview{width:min(1360px,calc(100% - 48px));margin:34px auto}
.fmb-block-3 .level{
  display:grid;grid-template-columns:210px minmax(0,1fr);
  border:1px solid var(--line);border-radius:24px;overflow:hidden;background:var(--paper)
}
.fmb-block-3 .progress-side{
  position:relative;height:100%;padding:28px 18px 24px;
  background:radial-gradient(circle at 50% 42%,rgba(81,122,96,.18),transparent 25%),linear-gradient(180deg,#14231c,#0d1712);
  color:#fff;display:flex;flex-direction:column;align-items:center;overflow:hidden
}
.fmb-block-3 .phase{position:relative;z-index:4;font:800 10px/1.25 Arial,sans-serif;letter-spacing:.16em;text-transform:uppercase;color:#ddcda9;text-align:center}
.fmb-block-3 .level-no{position:relative;z-index:4;margin-top:14px;width:76px;height:76px;border-radius:50%;display:grid;place-items:center;background:#f6f3eb;border:3px solid #a8792d;color:#1f1b17;font:bold 34px/1 Georgia,serif}
.fmb-block-3 .timeline{position:absolute;z-index:1;top:118px;height:300px;left:50%;width:2px;transform:translateX(-50%);background:linear-gradient(#c5b79c,#73877a 56%,#2e493c);opacity:.72}
.fmb-block-3 .snake-wrap{position:relative;z-index:3;width:158px;margin-top:14px;margin-bottom:8px}
.fmb-block-3 .snake-wrap img{display:block;width:100%;height:auto;filter:drop-shadow(0 15px 22px rgba(0,0,0,.46))}
.fmb-block-3 .content{padding:30px 34px 32px}
.fmb-block-3 .kicker,.fmb-block-3 .mini-label{color:var(--gold);font:800 10px/1.2 Arial,sans-serif;letter-spacing:.14em;text-transform:uppercase}
.fmb-block-3 h1,.fmb-block-3 h2,.fmb-block-3 h3{margin:0;color:var(--ink)}
.fmb-block-3 h1{margin-top:7px;font-size:44px;line-height:1}
.fmb-block-3 .subtitle{margin-top:7px;color:var(--green);font-size:20px;font-style:italic}
.fmb-block-3 .lead{margin:14px 0 0;max-width:930px;font-size:16px;line-height:1.62}
.fmb-block-3 .strip{margin-top:18px;display:flex;flex-wrap:wrap;gap:8px}
.fmb-block-3 .strip span{padding:8px 11px;border:1px solid var(--line);border-radius:999px;background:#fff;font:700 11px/1 Arial,sans-serif;color:var(--muted)}
.fmb-block-3 .strip strong{color:var(--ink)}
.fmb-block-3 .top-grid{margin-top:22px;display:grid;grid-template-columns:.78fr 1.22fr;gap:12px}
.fmb-block-3 .card{padding:17px 18px;border:1px solid var(--line);border-radius:16px;background:#fff}
.fmb-block-3 .card h2{margin-top:4px;font-size:23px}
.fmb-block-3 .item{padding:10px 0;border-top:1px solid #ece6dc}
.fmb-block-3 .item:first-of-type{border-top:0}
.fmb-block-3 .item strong{color:var(--ink);font-size:16px}
.fmb-block-3 .item p,.fmb-block-3 .psychic-line p,.fmb-block-3 .example,.fmb-block-3 .spell-row p,.fmb-block-3 .combat p,.fmb-block-3 .warning{margin:5px 0 0;font-size:13px;line-height:1.55}
.fmb-block-3 .psychic{border-color:#a8b9af;background:linear-gradient(180deg,#fff,#f6f9f7)}
.fmb-block-3 .psychic-line{display:grid;grid-template-columns:30px 1fr;gap:9px;align-items:start;margin-top:10px}
.fmb-block-3 .psychic-line b{width:26px;height:26px;border-radius:50%;display:grid;place-items:center;background:#173126;color:#fff;font:800 10px/1 Arial,sans-serif}
.fmb-block-3 .example{margin-top:10px;padding:9px 11px;border-left:3px solid var(--gold);background:#f7f4ed;border-radius:8px}
.fmb-block-3 .spell-row{margin-top:12px;display:grid;grid-template-columns:1.25fr .75fr;gap:12px}
.fmb-block-3 .spell-row>div{padding:15px 16px;border:1px solid var(--line);border-radius:14px;background:#fff}
.fmb-block-3 .spell-row p{margin-top:7px}
.fmb-block-3 .darkness{border-color:#486354!important;background:linear-gradient(135deg,#17231d,#21362b)!important;color:#e8efe9}
.fmb-block-3 .darkness strong{display:block;color:#fff;font-size:17px}
.fmb-block-3 .darkness .mini-label{color:#d2b97b}
.fmb-block-3 .combat{margin-top:12px;padding:16px 17px;border-left:4px solid var(--gold);background:#fff}
.fmb-block-3 .combat h2{margin-top:4px;font-size:23px}
.fmb-block-3 .priority{margin-top:10px;padding:10px 12px;border-radius:10px;background:var(--silver);font:800 11px/1.45 Arial,sans-serif;color:#36433b}
.fmb-block-3 .warning{margin-top:10px;padding:10px 12px;border:1px solid #c7cec9;border-radius:10px;background:#fafafa;color:#5e574f}
@media (max-width:760px){.fmb-block-3 .preview{width:calc(100% - 20px);margin:10px auto}
.fmb-block-3 .level{grid-template-columns:1fr}
.fmb-block-3 .progress-side{min-height:330px}
.fmb-block-3 .snake-wrap{margin:12px auto 8px;width:135px}
.fmb-block-3 .content{padding:24px 20px 26px}
.fmb-block-3 .top-grid,.fmb-block-3 .spell-row{grid-template-columns:1fr}
.fmb-block-3 h1{font-size:36px}}
/* Forja sidebar sheet — standardized compact levels */
.fmb-block-3 .fm-side-sheet{
  position:relative;
  z-index:5;
  width:100%;
  margin-top:4px;
  padding:16px 0 0;
  border-top:1px solid rgba(221,205,169,.24);
  background:#102419;
}
.fmb-block-3 .fm-side-section + .fm-side-section{margin-top:16px}
.fmb-block-3 .fm-side-label{
  display:block;
  margin-bottom:8px;
  color:#ddcda9;
  font:800 9px/1.2 Arial,sans-serif;
  letter-spacing:.14em;
  text-transform:uppercase;
  text-align:left;
}
.fmb-block-3 .fm-stats-grid{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:6px;
}
.fmb-block-3 .fm-stat{
  padding:7px 5px 6px;
  border:1px solid rgba(255,255,255,.12);
  border-radius:9px;
  background:rgba(255,255,255,.045);
  text-align:center;
}
.fmb-block-3 .fm-stat small{
  display:block;
  color:#b8c6bd;
  font:800 8px/1 Arial,sans-serif;
}
.fmb-block-3 .fm-stat strong{
  display:block;
  margin-top:3px;
  color:#fff;
  font-size:18px;
  line-height:1;
}
.fmb-block-3 .fm-stat span{
  display:block;
  margin-top:3px;
  color:#8fb09d;
  font:700 9px/1 Arial,sans-serif;
}
.fmb-block-3 .fm-panel{
  padding:11px 12px;
  border:1px solid rgba(255,255,255,.11);
  border-radius:11px;
  background:rgba(255,255,255,.04);
}
.fmb-block-3 .fm-row{
  display:flex;
  align-items:flex-start;
  justify-content:space-between;
  gap:10px;
  padding:6px 0;
  border-top:1px solid rgba(255,255,255,.08);
}
.fmb-block-3 .fm-row:first-of-type{border-top:0}
.fmb-block-3 .fm-row small{
  color:#b8c6bd;
  font:700 9px/1.25 Arial,sans-serif;
}
.fmb-block-3 .fm-row strong{
  max-width:92px;
  color:#fff;
  font-size:11px;
  line-height:1.2;
  text-align:right;
}
.fmb-block-3 .fm-resource-mini{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:8px;
}
.fmb-block-3 .fm-resource-mini > div{
  padding:9px 7px;
  border:1px solid rgba(255,255,255,.09);
  border-radius:9px;
  background:rgba(255,255,255,.035);
  text-align:center;
}
.fmb-block-3 .fm-resource-mini small{
  display:block;
  color:#b8c6bd;
  font:700 8px/1.25 Arial,sans-serif;
}
.fmb-block-3 .fm-resource-mini strong{
  display:block;
  margin-top:5px;
  color:#fff;
  font-size:20px;
  line-height:1;
}
.fmb-block-3 .fm-timeline-resume{
  position:relative;
  z-index:1;
  width:2px;
  height:110px;
  margin:0 auto -24px;
  background:linear-gradient(#6b8374,#244a37);
  opacity:.78;
}
@media (max-width:760px){.fmb-block-3 .fm-side-sheet{max-width:420px;margin:8px auto 0}
.fmb-block-3 .fm-timeline-resume{display:none}}
.fmb-block-3 .progress-side .timeline{bottom:auto!important;height:170px!important}
.fmb-block-3 .wishlist-panel{
  border-color:rgba(166,198,178,.26);
  background:rgba(41,84,61,.18);
}
.fmb-block-3 .wishlist-item{
  padding:10px;
  border:1px solid rgba(255,255,255,.10);
  border-radius:10px;
  background:rgba(255,255,255,.035);
}
.fmb-block-3 .wishlist-head{
  display:flex;
  justify-content:space-between;
  align-items:flex-start;
  gap:8px;
}
.fmb-block-3 .wishlist-head strong{
  color:#fff;
  font-size:12px;
  line-height:1.25;
}
.fmb-block-3 .wishlist-head span{
  flex:0 0 auto;
  padding:3px 6px;
  border:1px solid rgba(215,190,130,.35);
  border-radius:999px;
  color:#ddcda9;
  font:800 7px/1 Arial,sans-serif;
  text-transform:uppercase;
  letter-spacing:.08em;
}
.fmb-block-3 .wishlist-item > small{
  display:block;
  margin-top:3px;
  color:#9ab4a4;
  font:700 8px/1.2 Arial,sans-serif;
}
.fmb-block-3 .wishlist-item p{
  margin:8px 0 0;
  color:#d4ded8;
  font-size:10px;
  line-height:1.45;
}
.fmb-block-3 .wishlist-effect{
  display:grid;
  grid-template-columns:1fr auto;
  gap:5px 8px;
  margin-top:9px;
  padding-top:8px;
  border-top:1px solid rgba(255,255,255,.08);
}
.fmb-block-3 .wishlist-effect span{
  color:#9ab4a4;
  font:700 8px/1.2 Arial,sans-serif;
}
.fmb-block-3 .wishlist-effect strong{
  color:#fff;
  font-size:11px;
  text-align:right;
}
/* === Sidebar compacta padronizada: cobra + wishlist === */
.fmb-block-3 .progress-side .snake-wrap{
  width:158px !important;
  height:215px !important;
  min-height:215px !important;
  margin:12px auto 8px !important;
  display:flex !important;
  align-items:flex-start !important;
  justify-content:center !important;
  flex:0 0 215px !important;
}
.fmb-block-3 .progress-side .snake-wrap img{
  display:block !important;
  width:100% !important;
  height:100% !important;
  max-height:215px !important;
  object-fit:contain !important;
  object-position:center top !important;
}
.fmb-block-3 .progress-side .timeline{
  bottom:auto !important;
  height:170px !important;
}
.fmb-block-3 .wish-section,.fmb-block-3 .arcana-standard{
  position:relative;
  z-index:6;
  width:100%;
  margin-top:16px;
  padding:11px 12px;
  border:1px solid rgba(255,255,255,.11);
  border-radius:11px;
  background:rgba(255,255,255,.04);
}
.fmb-block-3 .wish-title,.fmb-block-3 .arcana-standard-title{
  display:block;
  margin-bottom:8px;
  color:#ddcda9;
  font:800 9px/1.2 Arial,sans-serif;
  letter-spacing:.14em;
  text-transform:uppercase;
}
.fmb-block-3 .wish-note{
  margin:0 0 9px;
  color:#9fb2a6;
  font:700 8px/1.4 Arial,sans-serif;
}
.fmb-block-3 .wish-item{
  padding:8px 9px;
  border:1px solid rgba(255,255,255,.09);
  border-radius:9px;
  background:rgba(255,255,255,.035);
}
.fmb-block-3 .wish-item + .wish-item{margin-top:7px}
.fmb-block-3 .wish-head{display:flex;gap:7px;align-items:flex-start;justify-content:space-between}
.fmb-block-3 .wish-head strong{color:#fff;font-size:11px;line-height:1.25}
.fmb-block-3 .wish-tag{
  flex:0 0 auto;padding:3px 5px;border:1px solid rgba(215,190,130,.32);
  border-radius:999px;color:#ddcda9;font:800 6.5px/1 Arial,sans-serif;
  letter-spacing:.06em;text-transform:uppercase
}
.fmb-block-3 .wish-item small{display:block;margin-top:3px;color:#9ab4a4;font:700 7.5px/1.25 Arial,sans-serif}
.fmb-block-3 .wish-item p{margin:6px 0 0;color:#d2ddd6;font-size:9px;line-height:1.42}
.fmb-block-3 .arcana-standard-row{
  padding:8px 9px;border:1px solid rgba(255,255,255,.09);border-radius:9px;
  background:rgba(255,255,255,.035)
}
.fmb-block-3 .arcana-standard-row + .arcana-standard-row{margin-top:7px}
.fmb-block-3 .arcana-standard-row small{display:block;color:#9ab4a4;font:700 7.5px/1.2 Arial,sans-serif;text-transform:uppercase}
.fmb-block-3 .arcana-standard-row strong{display:block;margin-top:4px;color:#fff;font-size:11px;line-height:1.25}
.fmb-block-3 .arcana-standard-row em{display:block;margin-top:2px;color:#b8c6bd;font:italic 8px/1.2 Georgia,serif}
@media (max-width:760px){.fmb-block-3 .progress-side .snake-wrap{
    width:145px !important;height:195px !important;min-height:195px !important;
    flex-basis:195px !important;margin:10px auto 6px !important
  }}
/* === Wishlist minimalista: somente próximo item prioritário === */
.fmb-block-3 .wish-section{
  position:relative;
  z-index:6;
  width:100%;
  margin-top:16px;
  padding:11px 12px;
  border:1px solid rgba(255,255,255,.11);
  border-radius:11px;
  background:rgba(255,255,255,.04);
}
.fmb-block-3 .wish-title{
  display:block;
  margin-bottom:7px;
  color:#ddcda9;
  font:800 9px/1.2 Arial,sans-serif;
  letter-spacing:.14em;
  text-transform:uppercase;
}
.fmb-block-3 .wish-note{
  margin:0 0 9px;
  color:#9fb2a6;
  font:700 8px/1.45 Arial,sans-serif;
}
.fmb-block-3 .wish-item{
  padding:9px 10px;
  border:1px solid rgba(255,255,255,.09);
  border-radius:9px;
  background:rgba(255,255,255,.035);
}
.fmb-block-3 .wish-head{
  display:flex;
  gap:7px;
  align-items:flex-start;
  justify-content:space-between;
}
.fmb-block-3 .wish-head strong{
  color:#fff;
  font-size:11px;
  line-height:1.25;
}
.fmb-block-3 .wish-tag{
  flex:0 0 auto;
  padding:3px 5px;
  border:1px solid rgba(215,190,130,.32);
  border-radius:999px;
  color:#ddcda9;
  font:800 6.5px/1 Arial,sans-serif;
  letter-spacing:.06em;
  text-transform:uppercase;
}
.fmb-block-3 .wish-item small{
  display:block;
  margin-top:3px;
  color:#9ab4a4;
  font:700 7.5px/1.25 Arial,sans-serif;
}
.fmb-block-3 .wish-item p{
  margin:6px 0 0;
  color:#d2ddd6;
  font-size:9px;
  line-height:1.42;
}

/* ===== BLOCO 4 ===== */
.fmb-block-4{
  --paper:#fbfaf6;
  --white:#fff;
  --ink:#1f1b17;
  --body:#403a33;
  --muted:#70675e;
  --line:#ddd4c5;
  --gold:#9b6b18;
  --green:#28513e;
  --green-soft:#f2f7f3;
  --silver:#eef1ef;
}
.fmb-block-4 *{box-sizing:border-box}
.fmb-block-4{
  margin:0;
  background:#f1f0ec;
  color:var(--body);
  font-family:Georgia,"Times New Roman",serif;
}
.fmb-block-4 .preview{
  width:min(1360px,calc(100% - 48px));
  margin:34px auto;
}
.fmb-block-4 .level{
  display:grid;
  grid-template-columns:210px minmax(0,1fr);
  overflow:hidden;
  border:1px solid var(--line);
  border-radius:24px;
  background:var(--paper);
}
.fmb-block-4 .progress-side{
  position:relative;
  height:100%;
  padding:28px 18px 24px;
  background:
    radial-gradient(circle at 50% 42%,rgba(81,122,96,.18),transparent 25%),
    linear-gradient(180deg,#14231c,#0d1712);
  color:#fff;
  display:flex;
  flex-direction:column;
  align-items:center;
  overflow:hidden;
}
.fmb-block-4 .phase{
  position:relative;
  z-index:4;
  font:800 10px/1.25 Arial,sans-serif;
  letter-spacing:.16em;
  text-transform:uppercase;
  color:#ddcda9;
  text-align:center;
}
.fmb-block-4 .level-no{
  position:relative;
  z-index:4;
  margin-top:14px;
  width:76px;
  height:76px;
  border-radius:50%;
  display:grid;
  place-items:center;
  background:#f6f3eb;
  border:3px solid #a8792d;
  color:#1f1b17;
  font:bold 34px/1 Georgia,serif;
}
.fmb-block-4 .timeline{
  position:absolute;
  z-index:1;
  top:118px;
  height:300px;
  left:50%;
  width:2px;
  transform:translateX(-50%);
  background:linear-gradient(#c5b79c,#73877a 56%,#2e493c);
  opacity:.72;
}
.fmb-block-4 .snake-wrap{
  position:relative;
  z-index:3;
  width:158px;
  margin-top:auto;
  margin-bottom:38px;
}
.fmb-block-4 .snake-wrap img{
  display:block;
  width:100%;
  height:auto;
  filter:drop-shadow(0 15px 22px rgba(0,0,0,.46));
}
.fmb-block-4 .side-note{
  position:relative;
  z-index:4;
  margin-top:auto;
  padding-top:24px;
  text-align:center;
}
.fmb-block-4 .side-note strong{
  display:block;
  font-size:18px;
}
.fmb-block-4 .side-note span{
  display:block;
  margin-top:5px;
  color:#c5d0c9;
  font:700 9px/1.45 Arial,sans-serif;
  letter-spacing:.08em;
  text-transform:uppercase;
}
.fmb-block-4 .content{
  padding:30px 34px 32px;
}
.fmb-block-4 .kicker,.fmb-block-4 .mini-label{
  color:var(--gold);
  font:800 10px/1.2 Arial,sans-serif;
  letter-spacing:.14em;
  text-transform:uppercase;
}
.fmb-block-4 h1,.fmb-block-4 h2,.fmb-block-4 h3{margin:0;color:var(--ink)}
.fmb-block-4 h1{
  margin-top:7px;
  font-size:42px;
  line-height:1;
}
.fmb-block-4 .lead{
  margin:13px 0 0;
  max-width:900px;
  font-size:16px;
  line-height:1.62;
}
.fmb-block-4 .strip{
  margin-top:18px;
  display:flex;
  flex-wrap:wrap;
  gap:8px;
}
.fmb-block-4 .strip span{
  padding:8px 11px;
  border:1px solid var(--line);
  border-radius:999px;
  background:#fff;
  font:700 11px/1 Arial,sans-serif;
  color:var(--muted);
}
.fmb-block-4 .strip strong{color:var(--ink)}
.fmb-block-4 .core{
  margin-top:22px;
  display:grid;
  grid-template-columns:1.05fr .95fr;
  gap:12px;
}
.fmb-block-4 .card{
  padding:17px 18px;
  border:1px solid var(--line);
  border-radius:16px;
  background:#fff;
}
.fmb-block-4 .card.primary{
  border-color:#9fb5a8;
  background:linear-gradient(180deg,#fff,var(--green-soft));
}
.fmb-block-4 .card h2{
  margin-top:4px;
  font-size:24px;
}
.fmb-block-4 .card h3{
  margin-top:4px;
  font-size:19px;
}
.fmb-block-4 .card p{
  margin:7px 0 0;
  font-size:14px;
  line-height:1.56;
}
.fmb-block-4 .telekinetic-points{
  margin-top:13px;
  display:grid;
  gap:9px;
}
.fmb-block-4 .point{
  display:grid;
  grid-template-columns:30px minmax(0,1fr);
  gap:9px;
  align-items:start;
}
.fmb-block-4 .point b{
  width:26px;
  height:26px;
  display:grid;
  place-items:center;
  border-radius:50%;
  background:#173126;
  color:#fff;
  font:800 10px/1 Arial,sans-serif;
}
.fmb-block-4 .point strong{
  display:block;
  color:var(--ink);
  font-size:14px;
}
.fmb-block-4 .point p{
  margin:3px 0 0;
  font-size:13px;
  line-height:1.5;
}
.fmb-block-4 .change-list{
  margin-top:13px;
  padding:0;
  list-style:none;
}
.fmb-block-4 .change-list li{
  padding:10px 0;
  border-top:1px solid #eee8de;
  font-size:14px;
  line-height:1.5;
}
.fmb-block-4 .change-list li:first-child{border-top:0;padding-top:0}
.fmb-block-4 .change-list strong{color:var(--ink)}
.fmb-block-4 .spell{
  margin-top:12px;
  padding:15px 16px;
  border:1px solid #b7a06f;
  border-radius:14px;
  background:#fcfaf5;
}
.fmb-block-4 .spell strong{
  display:block;
  color:var(--ink);
  font-size:17px;
}
.fmb-block-4 .spell p{
  margin:6px 0 0;
  font-size:13px;
  line-height:1.55;
}
.fmb-block-4 .tome-note{
  margin-top:12px;
  padding:11px 13px;
  border-left:4px solid var(--green);
  border-radius:10px;
  background:var(--silver);
  font-size:13px;
  line-height:1.5;
}
.fmb-block-4 .combat{
  margin-top:18px;
  padding:16px 17px;
  border-left:4px solid var(--gold);
  background:#fff;
}
.fmb-block-4 .combat h2{
  margin-top:4px;
  font-size:23px;
}
.fmb-block-4 .combat p{
  margin:8px 0 0;
  font-size:14px;
  line-height:1.6;
}
.fmb-block-4 .priority{
  margin-top:10px;
  padding:10px 12px;
  border-radius:10px;
  background:var(--silver);
  color:#36433b;
  font:800 11px/1.45 Arial,sans-serif;
}
@media (max-width:760px){.fmb-block-4 .preview{width:calc(100% - 20px);margin:10px auto}
.fmb-block-4 .level{grid-template-columns:1fr}
.fmb-block-4 .progress-side{min-height:350px}
.fmb-block-4 .content{padding:24px 20px 26px}
.fmb-block-4 .core{grid-template-columns:1fr}
.fmb-block-4 h1{font-size:35px}}
.fmb-block-4 .dark-lord-line{
  margin-top:12px;
  padding:11px 13px;
  border-left:3px solid var(--green);
  border-radius:9px;
  background:var(--green-soft);
  color:#35483e;
  font-size:13px;
  line-height:1.55;
  font-style:italic;
}
