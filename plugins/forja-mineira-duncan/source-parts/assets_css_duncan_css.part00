  color:#244a32!important;
  font-weight:700!important;
  margin:0!important;
}
.fmb-build-root--duncan :is(.fmb-block-18,.fmb-block-19) .combat h2{color:#fff0d0!important}
.fmb-build-root--duncan :is(.fmb-block-18,.fmb-block-19) .combat .mini-label{color:#eac18a!important}
.fmb-build-root--duncan :is(.fmb-block-18,.fmb-block-19) .combat p strong{color:#ffe3ac!important;display:inline!important}
.fmb-build-root--duncan :is(.fmb-block-18,.fmb-block-19) .fm-side-sheet{
   background:transparent!important;
   border-top:2px solid #c3a16e!important;
   padding:20px 0 0!important;
}
.fmb-build-root--duncan :is(.fmb-block-18,.fmb-block-19) .fm-stat strong{color:#fff8ea!important}
