.fmb-block-16 .side-sheet{position:relative;z-index:5;width:100%;margin-top:4px;padding:16px 0 0;border-top:1px solid rgba(221,205,169,.24);background:#102419}
.fmb-block-16 .side-section + .side-section{margin-top:16px}
.fmb-block-16 .side-label{display:block;margin-bottom:8px;color:#ddcda9;font:800 9px/1.2 Arial,sans-serif;letter-spacing:.14em;text-transform:uppercase;text-align:left}
.fmb-block-16 .stats-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:6px}
.fmb-block-16 .stat{padding:7px 5px 6px;border:1px solid rgba(255,255,255,.12);border-radius:9px;background:rgba(255,255,255,.045);text-align:center}
.fmb-block-16 .stat small{display:block;color:#b8c6bd;font:800 8px/1 Arial,sans-serif}
.fmb-block-16 .stat strong{display:block;margin-top:3px;color:#fff;font-size:18px;line-height:1}
.fmb-block-16 .stat span{display:block;margin-top:3px;color:#8fb09d;font:700 9px/1 Arial,sans-serif}
.fmb-block-16 .panel{padding:11px 12px;border:1px solid rgba(255,255,255,.11);border-radius:11px;background:rgba(255,255,255,.04)}
.fmb-block-16 .row{display:flex;align-items:flex-start;justify-content:space-between;gap:10px;padding:6px 0;border-top:1px solid rgba(255,255,255,.08)}
.fmb-block-16 .row:first-of-type{border-top:0}
.fmb-block-16 .row small{color:#b8c6bd;font:700 9px/1.25 Arial,sans-serif}
.fmb-block-16 .row strong{max-width:92px;color:#fff;font-size:11px;line-height:1.2;text-align:right}
.fmb-block-16 .resource-mini{display:grid;grid-template-columns:1fr 1fr;gap:8px}
.fmb-block-16 .resource-mini > div{padding:9px 7px;border:1px solid rgba(255,255,255,.09);border-radius:9px;background:rgba(255,255,255,.035);text-align:center}
.fmb-block-16 .resource-mini small{display:block;color:#b8c6bd;font:700 8px/1.25 Arial,sans-serif}
.fmb-block-16 .resource-mini strong{display:block;margin-top:5px;color:#fff;font-size:20px;line-height:1}
.fmb-block-16 .arcana-list{display:grid;gap:7px}
.fmb-block-16 .arcana-row{padding:8px 9px;border:1px solid rgba(255,255,255,.09);border-radius:9px;background:rgba(255,255,255,.035)}
.fmb-block-16 .arcana-row small{display:block;color:#9ab4a4;font:700 7.5px/1.2 Arial,sans-serif;text-transform:uppercase}
.fmb-block-16 .arcana-row strong{display:block;margin-top:4px;color:#fff;font-size:11px;line-height:1.25}
.fmb-block-16 .arcana-row em{display:block;margin-top:2px;color:#b8c6bd;font:italic 8px/1.2 Georgia,serif}
.fmb-block-16 .wishlist-panel{border-color:rgba(166,198,178,.26);background:rgba(41,84,61,.18)}
.fmb-block-16 .wishlist-item{padding:10px;border:1px solid rgba(255,255,255,.10);border-radius:10px;background:rgba(255,255,255,.035)}
.fmb-block-16 .wishlist-head{display:flex;justify-content:space-between;align-items:flex-start;gap:8px}
.fmb-block-16 .wishlist-head strong{color:#fff;font-size:12px;line-height:1.25}
.fmb-block-16 .wishlist-head span{flex:0 0 auto;padding:3px 6px;border:1px solid rgba(215,190,130,.35);border-radius:999px;color:#ddcda9;font:800 7px/1 Arial,sans-serif;text-transform:uppercase;letter-spacing:.08em}
.fmb-block-16 .wishlist-item>small{display:block;margin-top:3px;color:#9ab4a4;font:700 8px/1.2 Arial,sans-serif}
.fmb-block-16 .wishlist-item p{margin:8px 0 0;color:#d4ded8;font-size:10px;line-height:1.45}
.fmb-block-16 .wishlist-note{margin-top:9px;padding-top:8px;border-top:1px solid rgba(255,255,255,.08);color:#b9cbc0;font-size:9px;line-height:1.4}
.fmb-block-16 .wishlist-note strong{display:block;margin-bottom:3px;color:#fff;font-size:9px}
.fmb-block-16 .timeline-resume{position:relative;z-index:1;width:2px;height:110px;margin:0 auto -24px;background:linear-gradient(#6b8374,#244a37);opacity:.78}
.fmb-block-16 .content{padding:30px 34px 32px 22px}
.fmb-block-16 .kicker,.fmb-block-16 .mini-label{color:var(--gold);font:800 10px/1.2 Arial,sans-serif;letter-spacing:.14em;text-transform:uppercase}
.fmb-block-16 h1,.fmb-block-16 h2,.fmb-block-16 h3{margin:0;color:var(--ink)}
.fmb-block-16 h1{margin-top:7px;font-size:42px;line-height:1}
.fmb-block-16 .lead{margin:13px 0 0;max-width:1080px;font-size:16px;line-height:1.62}
.fmb-block-16 .strip{margin-top:18px;display:flex;flex-wrap:wrap;gap:8px}
.fmb-block-16 .strip span{padding:8px 11px;border:1px solid var(--line);border-radius:999px;background:#fff;font:700 11px/1 Arial,sans-serif;color:var(--muted)}
.fmb-block-16 .strip strong{color:var(--ink)}
.fmb-block-16 .feat-card{margin-top:22px;padding:19px 20px;border:1px solid #91ad9d;border-radius:16px;background:linear-gradient(180deg,#fff,var(--green-soft))}
.fmb-block-16 .feat-card h2{margin-top:4px;font-size:26px}
.fmb-block-16 .feat-card p{margin:8px 0 0;font-size:14px;line-height:1.58}
.fmb-block-16 .feat-grid{display:grid;grid-template-columns:.72fr 1.28fr;gap:12px;margin-top:13px}
.fmb-block-16 .ability-box{display:flex;align-items:center;gap:12px;padding:14px;border:1px solid #d6c39d;border-radius:12px;background:#faf7ef}
.fmb-block-16 .score{width:66px;height:66px;border-radius:50%;display:grid;place-items:center;flex:0 0 auto;background:#fff;border:2px solid var(--gold);font:bold 21px/1.05 Georgia,serif;color:var(--ink);text-align:center}
.fmb-block-16 .ability-box strong{display:block;color:var(--ink);font-size:16px}
.fmb-block-16 .ability-box span{display:block;margin-top:4px;color:var(--muted);font-size:12px;line-height:1.45}
.fmb-block-16 .spell-pair{display:grid;grid-template-columns:1fr 1fr;gap:9px}
.fmb-block-16 .spell-card{padding:13px 14px;border:1px solid #c7d3cb;border-radius:11px;background:#fff}
.fmb-block-16 .spell-card small{display:block;color:var(--green);font:800 9px/1.2 Arial,sans-serif;text-transform:uppercase;letter-spacing:.08em}
.fmb-block-16 .spell-card strong{display:block;margin-top:4px;color:var(--ink);font-size:16px}
.fmb-block-16 .spell-card p{margin:6px 0 0;font-size:12px;line-height:1.48}
.fmb-block-16 .section-break{margin-top:20px;padding-top:14px;border-top:1px solid var(--line)}
.fmb-block-16 .section-break span{color:var(--gold);font:800 10px/1.2 Arial,sans-serif;letter-spacing:.14em;text-transform:uppercase}
.fmb-block-16 .usage{margin-top:12px;display:grid;grid-template-columns:1fr 1fr;gap:12px}
.fmb-block-16 .card{padding:17px 18px;border:1px solid var(--line);border-radius:15px;background:#fff}
.fmb-block-16 .card.green{border-color:#a9bdb1;background:#f3f7f4}
.fmb-block-16 .card.gold{border-color:#d5bf95;background:#faf7ef}
.fmb-block-16 .card h2{margin-top:4px;font-size:22px}
.fmb-block-16 .card p{margin:7px 0 0;font-size:13px;line-height:1.56}
.fmb-block-16 .combat{margin-top:18px;padding:16px 17px;border-left:4px solid var(--green);background:#fff}
.fmb-block-16 .combat h2{margin-top:4px;font-size:23px}
.fmb-block-16 .combat p{margin:8px 0 0;font-size:14px;line-height:1.6}
.fmb-block-16 .tactic-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:9px;margin-top:12px}
.fmb-block-16 .tactic{padding:12px;border:1px solid #cad3cd;border-radius:11px;background:var(--silver)}
.fmb-block-16 .tactic small{display:block;color:var(--green);font:800 9px/1.2 Arial,sans-serif;text-transform:uppercase;letter-spacing:.08em}
.fmb-block-16 .tactic strong{display:block;margin-top:4px;color:var(--ink);font-size:14px}
.fmb-block-16 .tactic p{margin:5px 0 0;font-size:12px;line-height:1.45}
.fmb-block-16 .priority{margin-top:11px;padding:10px 12px;border-radius:10px;background:#17261f;color:#edf3ef;font:800 11px/1.45 Arial,sans-serif}
.fmb-block-16 .dark-lord-line{margin-top:11px;padding:11px 13px;border-left:3px solid var(--green);border-radius:9px;background:var(--green-soft);color:#35483e;font-size:13px;line-height:1.52;font-style:italic}
@media (max-width:900px){.fmb-block-16 .feat-grid,.fmb-block-16 .usage{grid-template-columns:1fr}}
@media (max-width:760px){.fmb-block-16 .preview{width:calc(100% - 20px);margin:10px auto}
.fmb-block-16 .level{grid-template-columns:1fr}
.fmb-block-16 .progress-side{min-height:760px}
.fmb-block-16 .snake-wrap{width:145px;height:195px;min-height:195px;flex-basis:195px;margin:10px auto 6px}
.fmb-block-16 .side-sheet{max-width:420px;margin:8px auto 0}
.fmb-block-16 .timeline-resume{display:none}
.fmb-block-16 .content{padding:24px 20px 26px}
.fmb-block-16 .spell-pair,.fmb-block-16 .tactic-grid{grid-template-columns:1fr}
.fmb-block-16 h1{font-size:35px}}
.fmb-block-16 .evocation-spells{
  margin-top:13px;
  padding:14px 15px;
  border:1px solid #b8cabf;
  border-radius:12px;
  background:rgba(255,255,255,.72);
}
.fmb-block-16 .evocation-grid{
  display:grid;
  grid-template-columns:repeat(5,minmax(0,1fr));
  gap:7px;
  margin-top:9px;
}
.fmb-block-16 .evocation-grid > div{
  padding:9px 8px;
  border:1px solid #cad6ce;
  border-radius:9px;
  background:#fff;
  text-align:center;
}
.fmb-block-16 .evocation-grid small{
  display:block;
  color:var(--green);
  font:800 8px/1 Arial,sans-serif;
}
.fmb-block-16 .evocation-grid strong{
  display:block;
  margin-top:4px;
  color:var(--ink);
  font-size:12px;
  line-height:1.2;
}
.fmb-block-16 .evocation-grid em{
  display:block;
  margin-top:3px;
  color:var(--muted);
  font-size:9px;
  line-height:1.2;
}
.fmb-block-16 .evocation-note{
  margin:10px 0 0;
  padding:9px 11px;
  border-left:3px solid var(--green);
  border-radius:8px;
  background:var(--green-soft);
  font-size:12px !important;
  line-height:1.5 !important;
}
@media (max-width:900px){.fmb-block-16 .evocation-grid{grid-template-columns:repeat(3,minmax(0,1fr))}}
@media (max-width:760px){.fmb-block-16 .evocation-grid{grid-template-columns:1fr 1fr}}

/* ===== BLOCO 17 ===== */
.fmb-block-17{
  --paper:#fbfaf6;--white:#fff;--ink:#1f1b17;--body:#403a33;--muted:#70675e;
  --line:#ddd4c5;--gold:#9b6b18;--green:#28513e;--green-soft:#f2f7f3;
  --silver:#eef1ef;--dark:#08100c;
}
.fmb-block-17 *{box-sizing:border-box}
.fmb-block-17{margin:0;background:#f1f0ec;color:var(--body);font-family:Georgia,"Times New Roman",serif}
.fmb-block-17 .preview{width:min(1360px,calc(100% - 48px));margin:34px auto}
.fmb-block-17 .level{border:1px solid var(--line);border-radius:26px;overflow:hidden;background:var(--paper)}
.fmb-block-17 .phase-open{display:grid;grid-template-columns:minmax(340px,34%) minmax(0,66%);background:#fff}
.fmb-block-17 .art{position:relative;min-height:860px;overflow:hidden;background:var(--dark)}
.fmb-block-17 .art img{display:block;width:100%;height:100%;min-height:860px;object-fit:cover;object-position:center 16%}
.fmb-block-17 .art:after{
  content:"";position:absolute;inset:0;
  background:
    linear-gradient(90deg,rgba(5,12,8,.01) 46%,rgba(5,12,8,.3)),
    linear-gradient(0deg,rgba(5,10,7,.78),transparent 36%);
  pointer-events:none
}
.fmb-block-17 .phase-tag{
  position:absolute;z-index:3;left:22px;top:22px;padding:8px 11px;border:1px solid rgba(255,255,255,.2);
  border-radius:999px;background:rgba(9,25,17,.8);color:#e7d5aa;
  font:800 10px/1 Arial,sans-serif;letter-spacing:.13em;text-transform:uppercase
}
.fmb-block-17 .level-badge{
  position:absolute;z-index:3;left:22px;bottom:24px;width:78px;height:78px;border-radius:50%;
  display:grid;place-items:center;background:#f7f3ea;border:3px solid #a8792d;color:#1f1b17;
  font:bold 30px/1 Georgia,serif
}
.fmb-block-17 .art-caption{position:absolute;z-index:3;left:118px;right:20px;bottom:31px;color:#fff}
.fmb-block-17 .art-caption strong{display:block;font-size:23px}
.fmb-block-17 .art-caption span{display:block;margin-top:4px;color:#d1dcd5;font:700 9px/1.4 Arial,sans-serif;letter-spacing:.1em;text-transform:uppercase}
.fmb-block-17 .content{padding:36px 38px 38px 18px;display:flex;flex-direction:column;justify-content:center}
.fmb-block-17 .kicker,.fmb-block-17 .mini-label{color:var(--gold);font:800 10px/1.2 Arial,sans-serif;letter-spacing:.14em;text-transform:uppercase}
.fmb-block-17 h1,.fmb-block-17 h2,.fmb-block-17 h3{margin:0;color:var(--ink)}
.fmb-block-17 h1{margin-top:7px;font-size:51px;line-height:.98}
.fmb-block-17 .subtitle{margin-top:8px;color:var(--green);font-size:21px;font-style:italic}
.fmb-block-17 .lead{margin:15px 0 0;max-width:920px;font-size:16px;line-height:1.65}
.fmb-block-17 .strip{margin-top:19px;display:flex;flex-wrap:wrap;gap:8px}
.fmb-block-17 .strip span{padding:8px 11px;border:1px solid var(--line);border-radius:999px;background:#fff;font:700 11px/1 Arial,sans-serif;color:var(--muted)}
.fmb-block-17 .strip strong{color:var(--ink)}
.fmb-block-17 .breakthrough{margin-top:22px;padding:14px 16px;border-left:4px solid var(--green);border-radius:10px;background:var(--green-soft);font-size:14px;line-height:1.55}
.fmb-block-17 .grid{margin-top:22px;display:grid;grid-template-columns:1.1fr .9fr;gap:12px;align-items:stretch}
.fmb-block-17 .card{padding:18px 19px;border:1px solid var(--line);border-radius:16px;background:#fff}
.fmb-block-17 .card.primary{border-color:#95b09f;background:linear-gradient(180deg,#fff,#f3f8f4)}
.fmb-block-17 .card h2{margin-top:4px;font-size:24px}
.fmb-block-17 .card p{margin:8px 0 0;font-size:13px;line-height:1.58}
.fmb-block-17 .kill{
  margin-top:12px;padding:15px 16px;border-radius:13px;background:#111d17;color:#f5f0e8
}
.fmb-block-17 .kill small{display:block;color:#d9bd7d;font:800 9px/1.2 Arial,sans-serif;letter-spacing:.1em;text-transform:uppercase}
.fmb-block-17 .kill strong{display:block;margin-top:5px;font-size:23px}
.fmb-block-17 .kill p{margin:7px 0 0;color:#dbe5df;font-size:13px;line-height:1.55}
.fmb-block-17 .fact-grid{margin-top:11px;display:grid;grid-template-columns:1fr 1fr;gap:8px}
.fmb-block-17 .fact{padding:10px 11px;border:1px solid #cad5ce;border-radius:10px;background:#fff}
.fmb-block-17 .fact strong{display:block;color:var(--ink);font-size:14px}
.fmb-block-17 .fact span{display:block;margin-top:4px;color:var(--muted);font-size:12px;line-height:1.44}
.fmb-block-17 .spell-card{margin-top:12px;padding:14px 15px;border:1px solid #d5bf95;border-radius:12px;background:#faf7ef}
.fmb-block-17 .spell-card strong{display:block;color:var(--ink);font-size:17px}
.fmb-block-17 .spell-card p{margin:6px 0 0;font-size:13px;line-height:1.52}
.fmb-block-17 .wishlist{
  margin-top:12px;padding:16px 17px;border:1px solid #9eb7a7;border-radius:15px;
  background:linear-gradient(180deg,#f8fbf9,#eef5f0)
}
.fmb-block-17 .wishlist-grid{display:grid;grid-template-columns:1fr auto;gap:14px;align-items:center;margin-top:9px}
.fmb-block-17 .wishlist strong{display:block;color:var(--ink);font-size:18px}
.fmb-block-17 .wishlist p{margin:6px 0 0;font-size:12px;line-height:1.5}
.fmb-block-17 .wishlist-badge{padding:9px 11px;border:1px solid #aac0b2;border-radius:999px;background:#fff;color:var(--green);font:800 9px/1 Arial,sans-serif;text-transform:uppercase;letter-spacing:.08em;white-space:nowrap}
.fmb-block-17 .combat{padding:28px 34px 32px;border-top:1px solid var(--line);background:#fff}
.fmb-block-17 .combat-wrap{display:grid;grid-template-columns:215px minmax(0,1fr);gap:22px;padding-left:18px;border-left:4px solid var(--gold)}
.fmb-block-17 .combat h2{margin-top:5px;font-size:26px}
.fmb-block-17 .combat p{margin:0 0 10px;font-size:14px;line-height:1.62}
.fmb-block-17 .tactic-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:9px;margin-top:12px}
.fmb-block-17 .tactic{padding:12px;border:1px solid #c7cec9;border-radius:11px;background:var(--silver)}
.fmb-block-17 .tactic small{display:block;color:var(--green);font:800 9px/1.2 Arial,sans-serif;text-transform:uppercase;letter-spacing:.08em}
.fmb-block-17 .tactic strong{display:block;margin-top:4px;color:var(--ink);font-size:14px}
.fmb-block-17 .tactic p{margin:5px 0 0;font-size:12px;line-height:1.45}
.fmb-block-17 .priority{margin-top:12px;padding:11px 13px;border-radius:10px;background:#17261f;color:#ecf3ee;font:800 11px/1.45 Arial,sans-serif}
.fmb-block-17 .quote{margin-top:12px;padding:11px 13px;border-left:3px solid var(--green);border-radius:9px;background:var(--green-soft);font-size:13px;line-height:1.5;font-style:italic;color:#35483e}
@media (max-width:1050px){.fmb-block-17 .phase-open{grid-template-columns:1fr}
.fmb-block-17 .art{min-height:560px}
.fmb-block-17 .art img{min-height:560px;object-position:center 18%}}
@media (max-width:760px){.fmb-block-17 .preview{width:calc(100% - 20px);margin:10px auto}
.fmb-block-17 .level{border-radius:18px}
.fmb-block-17 .content,.fmb-block-17 .combat{padding:24px 20px 26px}
.fmb-block-17 .grid,.fmb-block-17 .fact-grid,.fmb-block-17 .combat-wrap,.fmb-block-17 .tactic-grid,.fmb-block-17 .wishlist-grid{grid-template-columns:1fr}
.fmb-block-17 .wishlist-badge{justify-self:start}
.fmb-block-17 h1{font-size:38px}}

/* ===== BLOCO 18 ===== */
.fmb-block-18{
  --paper:#fbfaf6;--white:#fff;--ink:#1f1b17;--body:#403a33;--muted:#70675e;
  --line:#ddd4c5;--gold:#9b6b18;--green:#28513e;--green-soft:#f2f7f3;
  --silver:#eef1ef;--dark:#08100c;
}
.fmb-block-18 *{box-sizing:border-box}
.fmb-block-18{margin:0;background:#f1f0ec;color:var(--body);font-family:Georgia,"Times New Roman",serif}
.fmb-block-18 .preview{width:min(1360px,calc(100% - 48px));margin:34px auto}
.fmb-block-18 .level{
  display:grid;grid-template-columns:210px minmax(0,1fr);
  border:1px solid var(--line);border-radius:24px;overflow:hidden;background:var(--paper)
}
.fmb-block-18 .progress-side{
  position:relative;height:auto;min-height:100%;padding:28px 18px 24px;
  background:radial-gradient(circle at 50% 35%,rgba(58,125,84,.36),transparent 29%),
             linear-gradient(180deg,#0d1c14,#07100b);
  color:#fff;display:flex;flex-direction:column;align-items:center;overflow:hidden
}
.fmb-block-18 .phase{position:relative;z-index:4;font:800 10px/1.25 Arial,sans-serif;letter-spacing:.16em;text-transform:uppercase;color:#ddcda9;text-align:center}
.fmb-block-18 .level-no{position:relative;z-index:4;margin-top:14px;width:76px;height:76px;border-radius:50%;display:grid;place-items:center;background:#f6f3eb;border:3px solid #a8792d;color:#1f1b17;font:bold 34px/1 Georgia,serif}
.fmb-block-18 .timeline{position:absolute;z-index:1;top:118px;height:170px;left:50%;width:2px;transform:translateX(-50%);background:linear-gradient(#c5b79c,#6b8374 55%,#244a37);opacity:.78}
.fmb-block-18 .snake-wrap{position:relative;z-index:3;width:158px;height:215px;min-height:215px;margin:12px auto 8px;display:flex;align-items:flex-start;justify-content:center;flex:0 0 215px}
.fmb-block-18 .snake-wrap img{display:block;width:100%;height:100%;max-height:215px;object-fit:contain;object-position:center top;filter:drop-shadow(0 15px 22px rgba(0,0,0,.48))}
.fmb-block-18 .side-sheet{position:relative;z-index:5;width:100%;margin-top:4px;padding:16px 0 0;border-top:1px solid rgba(221,205,169,.24);background:#102419}
.fmb-block-18 .side-section + .side-section{margin-top:16px}
.fmb-block-18 .side-label{display:block;margin-bottom:8px;color:#ddcda9;font:800 9px/1.2 Arial,sans-serif;letter-spacing:.14em;text-transform:uppercase;text-align:left}
.fmb-block-18 .stats-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:6px}
.fmb-block-18 .stat{padding:7px 5px 6px;border:1px solid rgba(255,255,255,.12);border-radius:9px;background:rgba(255,255,255,.045);text-align:center}
.fmb-block-18 .stat small{display:block;color:#b8c6bd;font:800 8px/1 Arial,sans-serif}
.fmb-block-18 .stat strong{display:block;margin-top:3px;color:#fff;font-size:18px;line-height:1}
.fmb-block-18 .stat span{display:block;margin-top:3px;color:#8fb09d;font:700 9px/1 Arial,sans-serif}
.fmb-block-18 .panel{padding:11px 12px;border:1px solid rgba(255,255,255,.11);border-radius:11px;background:rgba(255,255,255,.04)}
.fmb-block-18 .row{display:flex;align-items:flex-start;justify-content:space-between;gap:10px;padding:6px 0;border-top:1px solid rgba(255,255,255,.08)}
.fmb-block-18 .row:first-of-type{border-top:0}
.fmb-block-18 .row small{color:#b8c6bd;font:700 9px/1.25 Arial,sans-serif}
.fmb-block-18 .row strong{max-width:92px;color:#fff;font-size:11px;line-height:1.2;text-align:right}
.fmb-block-18 .resource-mini{display:grid;grid-template-columns:1fr 1fr;gap:8px}
.fmb-block-18 .resource-mini > div{padding:9px 7px;border:1px solid rgba(255,255,255,.09);border-radius:9px;background:rgba(255,255,255,.035);text-align:center}
.fmb-block-18 .resource-mini small{display:block;color:#b8c6bd;font:700 8px/1.25 Arial,sans-serif}
.fmb-block-18 .resource-mini strong{display:block;margin-top:5px;color:#fff;font-size:20px;line-height:1}
.fmb-block-18 .arcana-list{display:grid;gap:7px}
.fmb-block-18 .arcana-row{padding:8px 9px;border:1px solid rgba(255,255,255,.09);border-radius:9px;background:rgba(255,255,255,.035)}
.fmb-block-18 .arcana-row small{display:block;color:#9ab4a4;font:700 7.5px/1.2 Arial,sans-serif;text-transform:uppercase}
.fmb-block-18 .arcana-row strong{display:block;margin-top:4px;color:#fff;font-size:11px;line-height:1.25}
.fmb-block-18 .arcana-row em{display:block;margin-top:2px;color:#b8c6bd;font:italic 8px/1.2 Georgia,serif}
.fmb-block-18 .wishlist-panel{border-color:rgba(166,198,178,.26);background:rgba(41,84,61,.18)}
.fmb-block-18 .wishlist-item{padding:10px;border:1px solid rgba(255,255,255,.10);border-radius:10px;background:rgba(255,255,255,.035)}
.fmb-block-18 .wishlist-head{display:flex;justify-content:space-between;align-items:flex-start;gap:8px}
.fmb-block-18 .wishlist-head strong{color:#fff;font-size:12px;line-height:1.25}
.fmb-block-18 .wishlist-head span{flex:0 0 auto;padding:3px 6px;border:1px solid rgba(215,190,130,.35);border-radius:999px;color:#ddcda9;font:800 7px/1 Arial,sans-serif;text-transform:uppercase;letter-spacing:.08em}
.fmb-block-18 .wishlist-item>small{display:block;margin-top:3px;color:#9ab4a4;font:700 8px/1.2 Arial,sans-serif}
.fmb-block-18 .wishlist-item p{margin:8px 0 0;color:#d4ded8;font-size:10px;line-height:1.45}
.fmb-block-18 .wishlist-note{margin-top:9px;padding-top:8px;border-top:1px solid rgba(255,255,255,.08);color:#b9cbc0;font-size:9px;line-height:1.4}
.fmb-block-18 .wishlist-note strong{display:block;margin-bottom:3px;color:#fff;font-size:9px}
.fmb-block-18 .timeline-resume{position:relative;z-index:1;width:2px;height:110px;margin:0 auto -24px;background:linear-gradient(#6b8374,#244a37);opacity:.78}
.fmb-block-18 .content{padding:30px 34px 0 22px}
.fmb-block-18 .kicker,.fmb-block-18 .mini-label{color:var(--gold);font:800 10px/1.2 Arial,sans-serif;letter-spacing:.14em;text-transform:uppercase}
.fmb-block-18 h1,.fmb-block-18 h2,.fmb-block-18 h3{margin:0;color:var(--ink)}
.fmb-block-18 h1{margin-top:7px;font-size:42px;line-height:1}
.fmb-block-18 .lead{margin:13px 0 0;max-width:1080px;font-size:16px;line-height:1.62}
.fmb-block-18 .strip{margin-top:18px;display:flex;flex-wrap:wrap;gap:8px}
.fmb-block-18 .strip span{padding:8px 11px;border:1px solid var(--line);border-radius:999px;background:#fff;font:700 11px/1 Arial,sans-serif;color:var(--muted)}
.fmb-block-18 .strip strong{color:var(--ink)}
.fmb-block-18 .hero-card{margin-top:22px;padding:19px 20px;border:1px solid #91ad9d;border-radius:16px;background:linear-gradient(180deg,#fff,var(--green-soft))}
.fmb-block-18 .hero-card h2{margin-top:4px;font-size:26px}
.fmb-block-18 .hero-card p{margin:8px 0 0;font-size:14px;line-height:1.58}
.fmb-block-18 .range-box{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:9px;margin-top:13px;align-items:stretch}
.fmb-block-18 .range-number{display:grid;place-items:center;padding:18px;border:1px solid #d6c39d;border-radius:12px;background:#faf7ef;text-align:center;height:100%}
.fmb-block-18 .range-number small{display:block;color:var(--gold);font:800 9px/1.2 Arial,sans-serif;text-transform:uppercase;letter-spacing:.08em}
.fmb-block-18 .range-number strong{display:block;margin-top:5px;color:var(--ink);font-size:34px;line-height:1}
.fmb-block-18 .range-number span{display:block;margin-top:4px;color:var(--muted);font-size:11px}
.fmb-block-18 .range-explain{grid-column:span 2;padding:14px 15px;border:1px solid #c7d3cb;border-radius:12px;background:#fff;display:flex;flex-direction:column;justify-content:center}
.fmb-block-18 .range-explain strong{display:block;color:var(--ink);font-size:17px}
.fmb-block-18 .range-explain p{margin:6px 0 0;font-size:13px;line-height:1.52}
.fmb-block-18 .use-grid{margin-top:9px;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:9px}
.fmb-block-18 .use-card{padding:13px 14px;border:1px solid var(--line);border-radius:12px;background:#fff}
.fmb-block-18 .use-card small{display:block;color:var(--green);font:800 9px/1.2 Arial,sans-serif;text-transform:uppercase;letter-spacing:.08em}
.fmb-block-18 .use-card strong{display:block;margin-top:4px;color:var(--ink);font-size:15px}
.fmb-block-18 .use-card p{margin:6px 0 0;font-size:12px;line-height:1.48}
.fmb-block-18 .section-break{margin-top:20px;padding-top:14px;border-top:1px solid var(--line)}
.fmb-block-18 .section-break span{color:var(--gold);font:800 10px/1.2 Arial,sans-serif;letter-spacing:.14em;text-transform:uppercase}
.fmb-block-18 .combat{margin-top:12px;padding:16px 17px;border-left:4px solid var(--green);background:#fff}
.fmb-block-18 .combat h2{margin-top:4px;font-size:23px}
.fmb-block-18 .combat p{margin:8px 0 0;font-size:14px;line-height:1.6}
.fmb-block-18 .tactic-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:9px;margin-top:12px}
.fmb-block-18 .tactic{padding:12px;border:1px solid #cad3cd;border-radius:11px;background:var(--silver)}
.fmb-block-18 .tactic small{display:block;color:var(--green);font:800 9px/1.2 Arial,sans-serif;text-transform:uppercase;letter-spacing:.08em}
.fmb-block-18 .tactic strong{display:block;margin-top:4px;color:var(--ink);font-size:14px}
.fmb-block-18 .tactic p{margin:5px 0 0;font-size:12px;line-height:1.45}
.fmb-block-18 .priority{margin-top:11px;padding:10px 12px;border-radius:10px;background:#17261f;color:#edf3ef;font:800 11px/1.45 Arial,sans-serif}
.fmb-block-18 .dark-lord-line{margin-top:11px;padding:11px 13px;border-left:3px solid var(--green);border-radius:9px;background:var(--green-soft);color:#35483e;font-size:13px;line-height:1.52;font-style:italic}
@media (max-width:900px){.fmb-block-18 .range-box{grid-template-columns:1fr}
.fmb-block-18 .range-explain{grid-column:auto}}
@media (max-width:760px){.fmb-block-18 .preview{width:calc(100% - 20px);margin:10px auto}
.fmb-block-18 .level{grid-template-columns:1fr}
.fmb-block-18 .progress-side{min-height:780px}
.fmb-block-18 .snake-wrap{width:145px;height:195px;min-height:195px;flex-basis:195px;margin:10px auto 6px}
.fmb-block-18 .side-sheet{max-width:420px;margin:8px auto 0}
.fmb-block-18 .timeline-resume{display:none}
.fmb-block-18 .content{padding:24px 20px 26px}
.fmb-block-18 .use-grid,.fmb-block-18 .tactic-grid{grid-template-columns:1fr}
.fmb-block-18 h1{font-size:35px}}
.fmb-block-18 .final-art-banner{
  position:relative;
  margin-top:18px;
  margin-bottom:0;
  min-height:410px;
  border:1px solid var(--line);
  border-radius:16px;
  overflow:hidden;
  background:#0b1510;
}
.fmb-block-18 .final-art-banner > img{
  position:absolute;
  inset:0;
  display:block;
  width:100%;
  height:100%;
  object-fit:cover;
  object-position:center center;
}
.fmb-block-18 .final-art-shade{
  position:absolute;
  inset:0;
  background:
    linear-gradient(90deg,rgba(5,12,8,.55) 0%,rgba(5,12,8,.32) 36%,rgba(5,12,8,.08) 66%,rgba(5,12,8,.02) 100%),
    linear-gradient(0deg,rgba(5,10,7,.28),rgba(5,10,7,.02) 60%);
}
.fmb-block-18 .final-art-overlay{
  position:relative;
  z-index:2;
  width:min(560px,47%);
  min-height:410px;
  padding:42px 38px;
  display:flex;
  flex-direction:column;
  justify-content:flex-end;
  color:#fff;
}
.fmb-block-18 .final-art-overlay .mini-label{
  color:#e1c98e;
}
.fmb-block-18 .final-art-overlay h2{
  margin-top:7px;
  max-width:520px;
  color:#fff;
  font-size:32px;
  line-height:1.06;
  text-shadow:0 2px 12px rgba(0,0,0,.34);
}
.fmb-block-18 .final-art-overlay p{
  margin:10px 0 0;
  max-width:520px;
  color:#e7eee9;
  font-size:14px;
  line-height:1.62;
  text-shadow:0 1px 8px rgba(0,0,0,.34);
}
@media (max-width:760px){.fmb-block-18 .final-art-banner{min-height:340px}
.fmb-block-18 .final-art-overlay{
    width:100%;
    min-height:340px;
    padding:26px 22px;
    justify-content:flex-end;
  }
.fmb-block-18 .final-art-overlay h2{font-size:26px}}

/* ===== BLOCO 19 ===== */
.fmb-block-19{
  --paper:#fbfaf6;--white:#fff;--ink:#1f1b17;--body:#403a33;--muted:#70675e;
  --line:#ddd4c5;--gold:#9b6b18;--green:#28513e;--green-soft:#f2f7f3;
  --silver:#eef1ef;--dark:#08100c;
}
.fmb-block-19 *{box-sizing:border-box}
.fmb-block-19{margin:0;background:#f1f0ec;color:var(--body);font-family:Georgia,"Times New Roman",serif}
.fmb-block-19 .preview{width:min(1360px,calc(100% - 48px));margin:34px auto}
.fmb-block-19 .level{
  display:grid;grid-template-columns:210px minmax(0,1fr);
  border:1px solid var(--line);border-radius:24px;overflow:hidden;background:var(--paper)
}
.fmb-block-19 .progress-side{
  position:relative;height:auto;min-height:100%;padding:28px 18px 24px;
  background:radial-gradient(circle at 50% 35%,rgba(58,125,84,.36),transparent 29%),
             linear-gradient(180deg,#0d1c14,#07100b);
  color:#fff;display:flex;flex-direction:column;align-items:center;overflow:hidden
}
.fmb-block-19 .phase{position:relative;z-index:4;font:800 10px/1.25 Arial,sans-serif;letter-spacing:.16em;text-transform:uppercase;color:#ddcda9;text-align:center}
.fmb-block-19 .level-no{position:relative;z-index:4;margin-top:14px;width:76px;height:76px;border-radius:50%;display:grid;place-items:center;background:#f6f3eb;border:3px solid #a8792d;color:#1f1b17;font:bold 34px/1 Georgia,serif}
.fmb-block-19 .timeline{position:absolute;z-index:1;top:118px;height:170px;left:50%;width:2px;transform:translateX(-50%);background:linear-gradient(#c5b79c,#6b8374 55%,#244a37);opacity:.78}
.fmb-block-19 .snake-wrap{position:relative;z-index:3;width:158px;height:215px;min-height:215px;margin:12px auto 8px;display:flex;align-items:flex-start;justify-content:center;flex:0 0 215px}
.fmb-block-19 .snake-wrap img{display:block;width:100%;height:100%;max-height:215px;object-fit:contain;object-position:center top;filter:drop-shadow(0 15px 22px rgba(0,0,0,.48))}
.fmb-block-19 .side-sheet{position:relative;z-index:5;width:100%;margin-top:4px;padding:16px 0 0;border-top:1px solid rgba(221,205,169,.24);background:#102419}
.fmb-block-19 .side-section + .side-section{margin-top:16px}
.fmb-block-19 .side-label{display:block;margin-bottom:8px;color:#ddcda9;font:800 9px/1.2 Arial,sans-serif;letter-spacing:.14em;text-transform:uppercase;text-align:left}
.fmb-block-19 .stats-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:6px}
.fmb-block-19 .stat{padding:7px 5px 6px;border:1px solid rgba(255,255,255,.12);border-radius:9px;background:rgba(255,255,255,.045);text-align:center}
.fmb-block-19 .stat small{display:block;color:#b8c6bd;font:800 8px/1 Arial,sans-serif}
.fmb-block-19 .stat strong{display:block;margin-top:3px;color:#fff;font-size:18px;line-height:1}
.fmb-block-19 .stat span{display:block;margin-top:3px;color:#8fb09d;font:700 9px/1 Arial,sans-serif}
.fmb-block-19 .panel{padding:11px 12px;border:1px solid rgba(255,255,255,.11);border-radius:11px;background:rgba(255,255,255,.04)}
.fmb-block-19 .row{display:flex;align-items:flex-start;justify-content:space-between;gap:10px;padding:6px 0;border-top:1px solid rgba(255,255,255,.08)}
.fmb-block-19 .row:first-of-type{border-top:0}
.fmb-block-19 .row small{color:#b8c6bd;font:700 9px/1.25 Arial,sans-serif}
.fmb-block-19 .row strong{max-width:92px;color:#fff;font-size:11px;line-height:1.2;text-align:right}
.fmb-block-19 .resource-mini{display:grid;grid-template-columns:1fr 1fr;gap:8px}
.fmb-block-19 .resource-mini > div{padding:9px 7px;border:1px solid rgba(255,255,255,.09);border-radius:9px;background:rgba(255,255,255,.035);text-align:center}
.fmb-block-19 .resource-mini small{display:block;color:#b8c6bd;font:700 8px/1.25 Arial,sans-serif}
.fmb-block-19 .resource-mini strong{display:block;margin-top:5px;color:#fff;font-size:20px;line-height:1}
.fmb-block-19 .arcana-list{display:grid;gap:7px}
.fmb-block-19 .arcana-row{padding:8px 9px;border:1px solid rgba(255,255,255,.09);border-radius:9px;background:rgba(255,255,255,.035)}
.fmb-block-19 .arcana-row small{display:block;color:#9ab4a4;font:700 7.5px/1.2 Arial,sans-serif;text-transform:uppercase}
.fmb-block-19 .arcana-row strong{display:block;margin-top:4px;color:#fff;font-size:11px;line-height:1.25}
.fmb-block-19 .arcana-row em{display:block;margin-top:2px;color:#b8c6bd;font:italic 8px/1.2 Georgia,serif}
.fmb-block-19 .wishlist-panel{border-color:rgba(166,198,178,.26);background:rgba(41,84,61,.18)}
.fmb-block-19 .wishlist-item{padding:10px;border:1px solid rgba(255,255,255,.10);border-radius:10px;background:rgba(255,255,255,.035)}
.fmb-block-19 .wishlist-head{display:flex;justify-content:space-between;align-items:flex-start;gap:8px}
.fmb-block-19 .wishlist-head strong{color:#fff;font-size:12px;line-height:1.25}
.fmb-block-19 .wishlist-head span{flex:0 0 auto;padding:3px 6px;border:1px solid rgba(215,190,130,.35);border-radius:999px;color:#ddcda9;font:800 7px/1 Arial,sans-serif;text-transform:uppercase;letter-spacing:.08em}
.fmb-block-19 .wishlist-item>small{display:block;margin-top:3px;color:#9ab4a4;font:700 8px/1.2 Arial,sans-serif}
.fmb-block-19 .wishlist-item p{margin:8px 0 0;color:#d4ded8;font-size:10px;line-height:1.45}
.fmb-block-19 .wishlist-note{margin-top:9px;padding-top:8px;border-top:1px solid rgba(255,255,255,.08);color:#b9cbc0;font-size:9px;line-height:1.4}
.fmb-block-19 .wishlist-note strong{display:block;margin-bottom:3px;color:#fff;font-size:9px}
.fmb-block-19 .timeline-resume{position:relative;z-index:1;width:2px;height:110px;margin:0 auto -24px;background:linear-gradient(#6b8374,#244a37);opacity:.78}
.fmb-block-19 .content{padding:30px 34px 32px 22px}
.fmb-block-19 .kicker,.fmb-block-19 .mini-label{color:var(--gold);font:800 10px/1.2 Arial,sans-serif;letter-spacing:.14em;text-transform:uppercase}
.fmb-block-19 h1,.fmb-block-19 h2,.fmb-block-19 h3{margin:0;color:var(--ink)}
.fmb-block-19 h1{margin-top:7px;font-size:42px;line-height:1}
.fmb-block-19 .lead{margin:13px 0 0;max-width:1080px;font-size:16px;line-height:1.62}
.fmb-block-19 .strip{margin-top:18px;display:flex;flex-wrap:wrap;gap:8px}
.fmb-block-19 .strip span{padding:8px 11px;border:1px solid var(--line);border-radius:999px;background:#fff;font:700 11px/1 Arial,sans-serif;color:var(--muted)}
.fmb-block-19 .strip strong{color:var(--ink)}
.fmb-block-19 .boon-card{margin-top:22px;padding:19px 20px;border:1px solid #91ad9d;border-radius:16px;background:linear-gradient(180deg,#fff,var(--green-soft))}
.fmb-block-19 .boon-card h2{margin-top:4px;font-size:26px}
.fmb-block-19 .boon-card p{margin:8px 0 0;font-size:14px;line-height:1.58}
.fmb-block-19 .boon-grid{display:grid;grid-template-columns:.72fr 1.28fr;gap:12px;margin-top:13px}
.fmb-block-19 .ability-box{display:flex;align-items:center;gap:12px;padding:14px;border:1px solid #d6c39d;border-radius:12px;background:#faf7ef}
.fmb-block-19 .score{width:66px;height:66px;border-radius:50%;display:grid;place-items:center;flex:0 0 auto;background:#fff;border:2px solid var(--gold);font:bold 21px/1.05 Georgia,serif;color:var(--ink);text-align:center}
.fmb-block-19 .ability-box strong{display:block;color:var(--ink);font-size:16px}
.fmb-block-19 .ability-box span{display:block;margin-top:4px;color:var(--muted);font-size:12px;line-height:1.45}
.fmb-block-19 .fate-box{padding:14px 15px;border:1px solid #c7d3cb;border-radius:12px;background:#fff}
.fmb-block-19 .fate-box strong{display:block;color:var(--ink);font-size:18px}
.fmb-block-19 .fate-box p{margin:6px 0 0;font-size:13px;line-height:1.52}
.fmb-block-19 .fate-highlight{margin-top:10px;padding:10px 12px;border-left:4px solid var(--green);border-radius:9px;background:#f3f7f4;font-size:12px;line-height:1.5}
.fmb-block-19 .section-break{margin-top:20px;padding-top:14px;border-top:1px solid var(--line)}
.fmb-block-19 .section-break span{color:var(--gold);font:800 10px/1.2 Arial,sans-serif;letter-spacing:.14em;text-transform:uppercase}
.fmb-block-19 .spell-section{margin-top:12px;display:grid;grid-template-columns:1.1fr .9fr;gap:12px}
.fmb-block-19 .card{padding:17px 18px;border:1px solid var(--line);border-radius:15px;background:#fff}
.fmb-block-19 .card.green{border-color:#a9bdb1;background:#f3f7f4}
.fmb-block-19 .card.gold{border-color:#d5bf95;background:#faf7ef}
.fmb-block-19 .card h2{margin-top:4px;font-size:22px}
.fmb-block-19 .card p{margin:7px 0 0;font-size:13px;line-height:1.56}
.fmb-block-19 .storm-stats{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-top:11px}
.fmb-block-19 .storm-stat{padding:10px;border:1px solid #cad5ce;border-radius:10px;background:#fff;text-align:center}
.fmb-block-19 .storm-stat small{display:block;color:var(--green);font:800 8px/1.2 Arial,sans-serif;text-transform:uppercase}
.fmb-block-19 .storm-stat strong{display:block;margin-top:4px;color:var(--ink);font-size:15px}
.fmb-block-19 .storm-stat span{display:block;margin-top:3px;color:var(--muted);font-size:10px;line-height:1.35}
.fmb-block-19 .combat{margin-top:18px;padding:16px 17px;border-left:4px solid var(--green);background:#fff}
.fmb-block-19 .combat h2{margin-top:4px;font-size:23px}
.fmb-block-19 .combat p{margin:8px 0 0;font-size:14px;line-height:1.6}
.fmb-block-19 .tactic-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:9px;margin-top:12px}
.fmb-block-19 .tactic{padding:12px;border:1px solid #cad3cd;border-radius:11px;background:var(--silver)}
.fmb-block-19 .tactic small{display:block;color:var(--green);font:800 9px/1.2 Arial,sans-serif;text-transform:uppercase;letter-spacing:.08em}
.fmb-block-19 .tactic strong{display:block;margin-top:4px;color:var(--ink);font-size:14px}
.fmb-block-19 .tactic p{margin:5px 0 0;font-size:12px;line-height:1.45}
.fmb-block-19 .priority{margin-top:11px;padding:10px 12px;border-radius:10px;background:#17261f;color:#edf3ef;font:800 11px/1.45 Arial,sans-serif}
.fmb-block-19 .dark-lord-line{margin-top:11px;padding:11px 13px;border-left:3px solid var(--green);border-radius:9px;background:var(--green-soft);color:#35483e;font-size:13px;line-height:1.52;font-style:italic}
@media (max-width:900px){.fmb-block-19 .boon-grid,.fmb-block-19 .spell-section{grid-template-columns:1fr}}
@media (max-width:760px){.fmb-block-19 .preview{width:calc(100% - 20px);margin:10px auto}
.fmb-block-19 .level{grid-template-columns:1fr}
.fmb-block-19 .progress-side{min-height:780px}
.fmb-block-19 .snake-wrap{width:145px;height:195px;min-height:195px;flex-basis:195px;margin:10px auto 6px}
.fmb-block-19 .side-sheet{max-width:420px;margin:8px auto 0}
.fmb-block-19 .timeline-resume{display:none}
.fmb-block-19 .content{padding:24px 20px 26px}
.fmb-block-19 .storm-stats,.fmb-block-19 .tactic-grid{grid-template-columns:1fr}
.fmb-block-19 h1{font-size:35px}}
.fmb-block-19 .tome-synergy{
  margin-top:12px;
  padding:16px 17px;
  border:1px solid #9fb5a8;
  border-radius:14px;
  background:linear-gradient(180deg,#f8fbf9,#edf5f0);
}
.fmb-block-19 .tome-synergy h2{margin-top:4px;font-size:22px}
.fmb-block-19 .tome-synergy p{margin:7px 0 0;font-size:13px;line-height:1.58}

