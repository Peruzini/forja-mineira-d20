@media (max-width:760px){.fmb-block-4 .fm-side-sheet{max-width:420px;margin:18px auto 0}
.fmb-block-4 .fm-timeline-resume{display:none}}
.fmb-block-4 .progress-side .timeline{bottom:auto!important;height:300px!important}
/* === Sidebar compacta padronizada: cobra + wishlist === */
.fmb-block-4 .progress-side .snake-wrap{
  width:158px !important;
  height:215px !important;
  min-height:215px !important;
  margin:12px auto 8px !important;
  display:flex !important;
  align-items:flex-start !important;
  justify-content:center !important;
  flex:0 0 215px !important;
}
.fmb-block-4 .progress-side .snake-wrap img{
  display:block !important;
  width:100% !important;
  height:100% !important;
  max-height:215px !important;
  object-fit:contain !important;
  object-position:center top !important;
}
.fmb-block-4 .progress-side .timeline{
  bottom:auto !important;
  height:170px !important;
}
.fmb-block-4 .wish-section,.fmb-block-4 .arcana-standard{
  position:relative;
  z-index:6;
  width:100%;
  margin-top:16px;
  padding:11px 12px;
  border:1px solid rgba(255,255,255,.11);
  border-radius:11px;
  background:rgba(255,255,255,.04);
}
.fmb-block-4 .wish-title,.fmb-block-4 .arcana-standard-title{
  display:block;
  margin-bottom:8px;
  color:#ddcda9;
  font:800 9px/1.2 Arial,sans-serif;
  letter-spacing:.14em;
  text-transform:uppercase;
}
.fmb-block-4 .wish-note{
  margin:0 0 9px;
  color:#9fb2a6;
  font:700 8px/1.4 Arial,sans-serif;
}
.fmb-block-4 .wish-item{
  padding:8px 9px;
  border:1px solid rgba(255,255,255,.09);
  border-radius:9px;
  background:rgba(255,255,255,.035);
}
.fmb-block-4 .wish-item + .wish-item{margin-top:7px}
.fmb-block-4 .wish-head{display:flex;gap:7px;align-items:flex-start;justify-content:space-between}
.fmb-block-4 .wish-head strong{color:#fff;font-size:11px;line-height:1.25}
.fmb-block-4 .wish-tag{
  flex:0 0 auto;padding:3px 5px;border:1px solid rgba(215,190,130,.32);
  border-radius:999px;color:#ddcda9;font:800 6.5px/1 Arial,sans-serif;
  letter-spacing:.06em;text-transform:uppercase
}
.fmb-block-4 .wish-item small{display:block;margin-top:3px;color:#9ab4a4;font:700 7.5px/1.25 Arial,sans-serif}
.fmb-block-4 .wish-item p{margin:6px 0 0;color:#d2ddd6;font-size:9px;line-height:1.42}
.fmb-block-4 .arcana-standard-row{
  padding:8px 9px;border:1px solid rgba(255,255,255,.09);border-radius:9px;
  background:rgba(255,255,255,.035)
}
.fmb-block-4 .arcana-standard-row + .arcana-standard-row{margin-top:7px}
.fmb-block-4 .arcana-standard-row small{display:block;color:#9ab4a4;font:700 7.5px/1.2 Arial,sans-serif;text-transform:uppercase}
.fmb-block-4 .arcana-standard-row strong{display:block;margin-top:4px;color:#fff;font-size:11px;line-height:1.25}
.fmb-block-4 .arcana-standard-row em{display:block;margin-top:2px;color:#b8c6bd;font:italic 8px/1.2 Georgia,serif}
@media (max-width:760px){.fmb-block-4 .progress-side .snake-wrap{
    width:145px !important;height:195px !important;min-height:195px !important;
    flex-basis:195px !important;margin:10px auto 6px !important
  }}
/* === Wishlist minimalista: somente próximo item prioritário === */
.fmb-block-4 .wish-section{
  position:relative;
  z-index:6;
  width:100%;
  margin-top:16px;
  padding:11px 12px;
  border:1px solid rgba(255,255,255,.11);
  border-radius:11px;
  background:rgba(255,255,255,.04);
}
.fmb-block-4 .wish-title{
  display:block;
  margin-bottom:7px;
  color:#ddcda9;
  font:800 9px/1.2 Arial,sans-serif;
  letter-spacing:.14em;
  text-transform:uppercase;
}
.fmb-block-4 .wish-note{
  margin:0 0 9px;
  color:#9fb2a6;
  font:700 8px/1.45 Arial,sans-serif;
}
.fmb-block-4 .wish-item{
  padding:9px 10px;
  border:1px solid rgba(255,255,255,.09);
  border-radius:9px;
  background:rgba(255,255,255,.035);
}
.fmb-block-4 .wish-head{
  display:flex;
  gap:7px;
  align-items:flex-start;
  justify-content:space-between;
}
.fmb-block-4 .wish-head strong{
  color:#fff;
  font-size:11px;
  line-height:1.25;
}
.fmb-block-4 .wish-tag{
  flex:0 0 auto;
  padding:3px 5px;
  border:1px solid rgba(215,190,130,.32);
  border-radius:999px;
  color:#ddcda9;
  font:800 6.5px/1 Arial,sans-serif;
  letter-spacing:.06em;
  text-transform:uppercase;
}
.fmb-block-4 .wish-item small{
  display:block;
  margin-top:3px;
  color:#9ab4a4;
  font:700 7.5px/1.25 Arial,sans-serif;
}
.fmb-block-4 .wish-item p{
  margin:6px 0 0;
  color:#d2ddd6;
  font-size:9px;
  line-height:1.42;
}

/* ===== BLOCO 5 ===== */
.fmb-block-5{
  --paper:#fbfaf6;--white:#fff;--ink:#1f1b17;--body:#403a33;--muted:#70675e;
  --line:#ddd4c5;--gold:#9b6b18;--green:#28513e;--green2:#496d59;
  --green-soft:#f2f7f3;--silver:#eef1ef;--dark:#0e1813;
}
.fmb-block-5 *{box-sizing:border-box}
.fmb-block-5{margin:0;background:#f1f0ec;color:var(--body);font-family:Georgia,"Times New Roman",serif}
.fmb-block-5 .preview{width:min(1360px,calc(100% - 48px));margin:34px auto}
.fmb-block-5 .level{border:1px solid var(--line);border-radius:26px;overflow:hidden;background:var(--paper)}
.fmb-block-5 .phase-open{
  display:grid;
  grid-template-columns:minmax(330px,38%) minmax(0,62%);
  background:#fff;
}
.fmb-block-5 .art{
  position:relative;
  min-height:680px;
  overflow:hidden;
  background:var(--dark);
}
.fmb-block-5 .art img{
  display:block;width:100%;height:100%;min-height:680px;
  object-fit:cover;object-position:center 24%;
}
.fmb-block-5 .art:after{
  content:"";position:absolute;inset:0;
  background:
    linear-gradient(90deg,rgba(8,15,11,.02) 50%,rgba(8,15,11,.32)),
    linear-gradient(0deg,rgba(6,12,9,.68),transparent 34%);
  pointer-events:none;
}
.fmb-block-5 .phase-tag{
  position:absolute;z-index:3;left:22px;top:22px;
  padding:8px 11px;border:1px solid rgba(255,255,255,.2);border-radius:999px;
  background:rgba(11,27,20,.72);color:#ead8ad;
  font:800 10px/1 Arial,sans-serif;letter-spacing:.13em;text-transform:uppercase
}
.fmb-block-5 .level-badge{
  position:absolute;z-index:3;left:22px;bottom:24px;
  width:72px;height:72px;border-radius:50%;
  display:grid;place-items:center;background:#f7f3ea;border:3px solid #a8792d;
  color:#1f1b17;font:bold 32px/1 Georgia,serif
}
.fmb-block-5 .art-caption{
  position:absolute;z-index:3;left:112px;right:20px;bottom:30px;color:#fff
}
.fmb-block-5 .art-caption strong{display:block;font-size:22px}
.fmb-block-5 .art-caption span{
  display:block;margin-top:4px;color:#d1dcd5;
  font:700 9px/1.4 Arial,sans-serif;letter-spacing:.1em;text-transform:uppercase
}
.fmb-block-5 .content{padding:34px 38px 36px;display:flex;flex-direction:column;justify-content:center}
.fmb-block-5 .kicker,.fmb-block-5 .mini-label{
  color:var(--gold);font:800 10px/1.2 Arial,sans-serif;letter-spacing:.14em;text-transform:uppercase
}
.fmb-block-5 h1,.fmb-block-5 h2,.fmb-block-5 h3{margin:0;color:var(--ink)}
.fmb-block-5 h1{margin-top:7px;font-size:48px;line-height:.98}
.fmb-block-5 .subtitle{margin-top:8px;color:var(--green);font-size:21px;font-style:italic}
.fmb-block-5 .lead{margin:15px 0 0;max-width:860px;font-size:16px;line-height:1.65}
.fmb-block-5 .strip{margin-top:19px;display:flex;flex-wrap:wrap;gap:8px}
.fmb-block-5 .strip span{
  padding:8px 11px;border:1px solid var(--line);border-radius:999px;background:#fff;
  font:700 11px/1 Arial,sans-serif;color:var(--muted)
}
.fmb-block-5 .strip strong{color:var(--ink)}
.fmb-block-5 .breakthrough{
  margin-top:22px;padding:14px 16px;border-left:4px solid var(--green);
  border-radius:10px;background:var(--green-soft);font-size:14px;line-height:1.55
}
.fmb-block-5 .changes{margin-top:22px;display:grid;grid-template-columns:1fr 1fr;gap:12px}
.fmb-block-5 .card{padding:17px 18px;border:1px solid var(--line);border-radius:16px;background:#fff}
.fmb-block-5 .card.primary{border-color:#9fb5a8;background:linear-gradient(180deg,#fff,#f5f8f6)}
.fmb-block-5 .card h2{margin-top:4px;font-size:23px}
.fmb-block-5 .card p{margin:7px 0 0;font-size:13px;line-height:1.55}
.fmb-block-5 .item{padding:10px 0;border-top:1px solid #ece6dc}
.fmb-block-5 .item:first-of-type{border-top:0}
.fmb-block-5 .item strong{display:block;color:var(--ink);font-size:16px}
.fmb-block-5 .item span{display:block;margin-top:4px;color:var(--muted);font-size:12px;line-height:1.45}
.fmb-block-5 .spells{
  margin-top:12px;padding:16px 17px;border:1px solid var(--line);
  border-radius:15px;background:#fff
}
.fmb-block-5 .spell-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:10px}
.fmb-block-5 .spell-choice,.fmb-block-5 .patron-spells{padding:13px 14px;border-radius:12px}
.fmb-block-5 .spell-choice{background:#faf7ef;border:1px solid #d4c09a}
.fmb-block-5 .patron-spells{background:#f3f7f4;border:1px solid #aabdb1}
.fmb-block-5 .spell-choice strong,.fmb-block-5 .patron-spells strong{display:block;color:var(--ink);font-size:16px}
.fmb-block-5 .spell-choice p,.fmb-block-5 .patron-spells p{margin:5px 0 0;font-size:13px;line-height:1.5}
.fmb-block-5 .combat{
  padding:28px 34px 32px;border-top:1px solid var(--line);background:#fff
}
.fmb-block-5 .combat-wrap{
  display:grid;grid-template-columns:215px minmax(0,1fr);gap:22px;
  padding-left:18px;border-left:4px solid var(--gold)
}
.fmb-block-5 .combat h2{margin-top:5px;font-size:26px}
.fmb-block-5 .combat p{margin:0 0 10px;font-size:14px;line-height:1.62}
.fmb-block-5 .tactic-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:9px;margin-top:12px}
.fmb-block-5 .tactic{padding:12px;border:1px solid #c7cec9;border-radius:11px;background:var(--silver)}
.fmb-block-5 .tactic small{
  display:block;color:var(--green);font:800 9px/1.2 Arial,sans-serif;
  text-transform:uppercase;letter-spacing:.08em
}
.fmb-block-5 .tactic strong{display:block;margin-top:4px;color:var(--ink);font-size:14px}
.fmb-block-5 .tactic p{margin:5px 0 0;font-size:12px;line-height:1.45}
.fmb-block-5 .priority{
  margin-top:12px;padding:11px 13px;border-radius:10px;
  background:#17261f;color:#ecf3ee;font:800 11px/1.45 Arial,sans-serif
}
@media (max-width:1050px){.fmb-block-5 .phase-open{grid-template-columns:1fr}
.fmb-block-5 .art{min-height:470px}
.fmb-block-5 .art img{min-height:470px;object-position:center 20%}}
@media (max-width:760px){.fmb-block-5 .preview{width:calc(100% - 20px);margin:10px auto}
.fmb-block-5 .level{border-radius:18px}
.fmb-block-5 .content,.fmb-block-5 .combat{padding:24px 20px 26px}
.fmb-block-5 .changes,.fmb-block-5 .spell-grid,.fmb-block-5 .tactic-grid,.fmb-block-5 .combat-wrap{grid-template-columns:1fr}
.fmb-block-5 h1{font-size:38px}}

/* ===== BLOCO 6 ===== */
.fmb-block-6{
  --paper:#fbfaf6;--white:#fff;--ink:#1f1b17;--body:#403a33;--muted:#70675e;
  --line:#ddd4c5;--gold:#9b6b18;--green:#28513e;--green-soft:#f2f7f3;--silver:#eef1ef;
}
.fmb-block-6 *{box-sizing:border-box}
.fmb-block-6{margin:0;background:#f1f0ec;color:var(--body);font-family:Georgia,"Times New Roman",serif}
.fmb-block-6 .preview{width:min(1360px,calc(100% - 48px));margin:34px auto}
.fmb-block-6 .level{
  display:grid;grid-template-columns:210px minmax(0,1fr);
  border:1px solid var(--line);border-radius:24px;overflow:hidden;background:var(--paper)
}
.fmb-block-6 .progress-side{
  position:relative;height:100%;padding:28px 18px 24px;
  background:radial-gradient(circle at 50% 45%,rgba(81,122,96,.22),transparent 25%),linear-gradient(180deg,#14231c,#0d1712);
  color:#fff;display:flex;flex-direction:column;align-items:center;overflow:hidden
}
.fmb-block-6 .phase{position:relative;z-index:4;font:800 10px/1.25 Arial,sans-serif;letter-spacing:.16em;text-transform:uppercase;color:#ddcda9;text-align:center}
.fmb-block-6 .level-no{position:relative;z-index:4;margin-top:14px;width:76px;height:76px;border-radius:50%;display:grid;place-items:center;background:#f6f3eb;border:3px solid #a8792d;color:#1f1b17;font:bold 34px/1 Georgia,serif}
.fmb-block-6 .timeline{position:absolute;z-index:1;top:118px;height:300px;left:50%;width:2px;transform:translateX(-50%);background:linear-gradient(#c5b79c,#73877a 56%,#2e493c);opacity:.72}
.fmb-block-6 .snake-wrap{position:relative;z-index:3;width:158px;margin-top:auto;margin-bottom:42px}
.fmb-block-6 .snake-wrap img{display:block;width:100%;height:auto;filter:drop-shadow(0 15px 22px rgba(0,0,0,.46))}
.fmb-block-6 .content{padding:30px 34px 32px}
.fmb-block-6 .kicker,.fmb-block-6 .mini-label{color:var(--gold);font:800 10px/1.2 Arial,sans-serif;letter-spacing:.14em;text-transform:uppercase}
.fmb-block-6 h1,.fmb-block-6 h2{margin:0;color:var(--ink)}
.fmb-block-6 h1{margin-top:7px;font-size:42px;line-height:1}
.fmb-block-6 .lead{margin:13px 0 0;max-width:900px;font-size:16px;line-height:1.62}
.fmb-block-6 .strip{margin-top:18px;display:flex;flex-wrap:wrap;gap:8px}
.fmb-block-6 .strip span{padding:8px 11px;border:1px solid var(--line);border-radius:999px;background:#fff;font:700 11px/1 Arial,sans-serif;color:var(--muted)}
.fmb-block-6 .strip strong{color:var(--ink)}
.fmb-block-6 .core{margin-top:22px;display:grid;grid-template-columns:1.05fr .95fr;gap:12px}
.fmb-block-6 .card{padding:17px 18px;border:1px solid var(--line);border-radius:16px;background:#fff}
.fmb-block-6 .card.primary{border-color:#9fb5a8;background:linear-gradient(180deg,#fff,var(--green-soft))}
.fmb-block-6 .card h2{margin-top:4px;font-size:24px}
.fmb-block-6 .card p{margin:7px 0 0;font-size:14px;line-height:1.56}
.fmb-block-6 .effects{margin-top:12px;display:grid;gap:9px}
.fmb-block-6 .effect{display:grid;grid-template-columns:30px minmax(0,1fr);gap:9px;align-items:start}
.fmb-block-6 .effect b{width:26px;height:26px;border-radius:50%;display:grid;place-items:center;background:#173126;color:#fff;font:800 10px/1 Arial,sans-serif}
.fmb-block-6 .effect strong{display:block;color:var(--ink);font-size:14px}
.fmb-block-6 .effect p{margin:3px 0 0;font-size:13px;line-height:1.5}
.fmb-block-6 .spell{margin-top:10px;padding:13px 14px;border:1px solid #d5c09a;border-radius:12px;background:#faf7ef}
.fmb-block-6 .spell strong{display:block;color:var(--ink);font-size:17px}
.fmb-block-6 .spell p{margin:5px 0 0;font-size:13px;line-height:1.52}
.fmb-block-6 .combat{margin-top:18px;padding:16px 17px;border-left:4px solid var(--gold);background:#fff}
.fmb-block-6 .combat h2{margin-top:4px;font-size:23px}
.fmb-block-6 .combat p{margin:8px 0 0;font-size:14px;line-height:1.6}
.fmb-block-6 .priority{margin-top:10px;padding:10px 12px;border-radius:10px;background:var(--silver);color:#36433b;font:800 11px/1.45 Arial,sans-serif}
@media (max-width:760px){.fmb-block-6 .preview{width:calc(100% - 20px);margin:10px auto}
.fmb-block-6 .level{grid-template-columns:1fr}
.fmb-block-6 .progress-side{min-height:330px}
.fmb-block-6 .snake-wrap{width:135px;margin-bottom:22px}
.fmb-block-6 .content{padding:24px 20px 26px}
.fmb-block-6 .core{grid-template-columns:1fr}
.fmb-block-6 h1{font-size:35px}}
/* Forja sidebar sheet — standardized compact levels */
.fmb-block-6 .fm-side-sheet{
  position:relative;
  z-index:5;
  width:100%;
  margin-top:18px;
  padding:16px 0 0;
  border-top:1px solid rgba(221,205,169,.24);
  background:#102419;
}
.fmb-block-6 .fm-side-section + .fm-side-section{margin-top:16px}
.fmb-block-6 .fm-side-label{
  display:block;
  margin-bottom:8px;
  color:#ddcda9;
  font:800 9px/1.2 Arial,sans-serif;
  letter-spacing:.14em;
  text-transform:uppercase;
  text-align:left;
}
.fmb-block-6 .fm-stats-grid{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:6px;
}
.fmb-block-6 .fm-stat{
  padding:7px 5px 6px;
  border:1px solid rgba(255,255,255,.12);
  border-radius:9px;
  background:rgba(255,255,255,.045);
  text-align:center;
}
.fmb-block-6 .fm-stat small{
  display:block;
  color:#b8c6bd;
  font:800 8px/1 Arial,sans-serif;
}
.fmb-block-6 .fm-stat strong{
  display:block;
  margin-top:3px;
  color:#fff;
  font-size:18px;
  line-height:1;
}
.fmb-block-6 .fm-stat span{
  display:block;
  margin-top:3px;
  color:#8fb09d;
  font:700 9px/1 Arial,sans-serif;
}
.fmb-block-6 .fm-panel{
  padding:11px 12px;
  border:1px solid rgba(255,255,255,.11);
  border-radius:11px;
  background:rgba(255,255,255,.04);
}
.fmb-block-6 .fm-row{
  display:flex;
  align-items:flex-start;
  justify-content:space-between;
  gap:10px;
  padding:6px 0;
  border-top:1px solid rgba(255,255,255,.08);
}
.fmb-block-6 .fm-row:first-of-type{border-top:0}
.fmb-block-6 .fm-row small{
  color:#b8c6bd;
  font:700 9px/1.25 Arial,sans-serif;
}
.fmb-block-6 .fm-row strong{
  max-width:92px;
  color:#fff;
  font-size:11px;
  line-height:1.2;
  text-align:right;
}
.fmb-block-6 .fm-resource-mini{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:8px;
}
.fmb-block-6 .fm-resource-mini > div{
  padding:9px 7px;
  border:1px solid rgba(255,255,255,.09);
  border-radius:9px;
  background:rgba(255,255,255,.035);
  text-align:center;
}
.fmb-block-6 .fm-resource-mini small{
  display:block;
  color:#b8c6bd;
  font:700 8px/1.25 Arial,sans-serif;
}
.fmb-block-6 .fm-resource-mini strong{
  display:block;
  margin-top:5px;
  color:#fff;
  font-size:20px;
  line-height:1;
}
.fmb-block-6 .fm-timeline-resume{
  position:relative;
  z-index:1;
  width:2px;
  height:110px;
  margin:0 auto -24px;
  background:linear-gradient(#6b8374,#244a37);
  opacity:.78;
}
@media (max-width:760px){.fmb-block-6 .fm-side-sheet{max-width:420px;margin:18px auto 0}
.fmb-block-6 .fm-timeline-resume{display:none}}
.fmb-block-6 .progress-side .timeline{bottom:auto!important;height:300px!important}
/* === Sidebar compacta padronizada: cobra + wishlist === */
.fmb-block-6 .progress-side .snake-wrap{
  width:158px !important;
  height:215px !important;
  min-height:215px !important;
  margin:12px auto 8px !important;
  display:flex !important;
  align-items:flex-start !important;
  justify-content:center !important;
  flex:0 0 215px !important;
}
.fmb-block-6 .progress-side .snake-wrap img{
  display:block !important;
  width:100% !important;
  height:100% !important;
  max-height:215px !important;
  object-fit:contain !important;
  object-position:center top !important;
}
.fmb-block-6 .progress-side .timeline{
  bottom:auto !important;
  height:170px !important;
}
.fmb-block-6 .wish-section,.fmb-block-6 .arcana-standard{
  position:relative;
  z-index:6;
  width:100%;
  margin-top:16px;
  padding:11px 12px;
  border:1px solid rgba(255,255,255,.11);
  border-radius:11px;
  background:rgba(255,255,255,.04);
}
.fmb-block-6 .wish-title,.fmb-block-6 .arcana-standard-title{
  display:block;
  margin-bottom:8px;
  color:#ddcda9;
  font:800 9px/1.2 Arial,sans-serif;
  letter-spacing:.14em;
  text-transform:uppercase;
}
.fmb-block-6 .wish-note{
  margin:0 0 9px;
  color:#9fb2a6;
  font:700 8px/1.4 Arial,sans-serif;
}
.fmb-block-6 .wish-item{
  padding:8px 9px;
  border:1px solid rgba(255,255,255,.09);
  border-radius:9px;
  background:rgba(255,255,255,.035);
}
.fmb-block-6 .wish-item + .wish-item{margin-top:7px}
.fmb-block-6 .wish-head{display:flex;gap:7px;align-items:flex-start;justify-content:space-between}
.fmb-block-6 .wish-head strong{color:#fff;font-size:11px;line-height:1.25}
.fmb-block-6 .wish-tag{
  flex:0 0 auto;padding:3px 5px;border:1px solid rgba(215,190,130,.32);
  border-radius:999px;color:#ddcda9;font:800 6.5px/1 Arial,sans-serif;
  letter-spacing:.06em;text-transform:uppercase
}
.fmb-block-6 .wish-item small{display:block;margin-top:3px;color:#9ab4a4;font:700 7.5px/1.25 Arial,sans-serif}
.fmb-block-6 .wish-item p{margin:6px 0 0;color:#d2ddd6;font-size:9px;line-height:1.42}
.fmb-block-6 .arcana-standard-row{
  padding:8px 9px;border:1px solid rgba(255,255,255,.09);border-radius:9px;
  background:rgba(255,255,255,.035)
}
.fmb-block-6 .arcana-standard-row + .arcana-standard-row{margin-top:7px}
.fmb-block-6 .arcana-standard-row small{display:block;color:#9ab4a4;font:700 7.5px/1.2 Arial,sans-serif;text-transform:uppercase}
.fmb-block-6 .arcana-standard-row strong{display:block;margin-top:4px;color:#fff;font-size:11px;line-height:1.25}
.fmb-block-6 .arcana-standard-row em{display:block;margin-top:2px;color:#b8c6bd;font:italic 8px/1.2 Georgia,serif}
@media (max-width:760px){.fmb-block-6 .progress-side .snake-wrap{
    width:145px !important;height:195px !important;min-height:195px !important;
    flex-basis:195px !important;margin:10px auto 6px !important
  }}
