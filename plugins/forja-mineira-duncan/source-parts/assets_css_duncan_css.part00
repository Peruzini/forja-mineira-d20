/* Legibilidade dos cards: separar as escolhas sem alterar o padrão homologado anterior. */
.fmb-build-root--duncan :is(.fmb-block-11,.fmb-block-12) .card .item{padding:12px 0 10px;margin:0;border-bottom:1px solid rgba(126,103,68,.25)}
.fmb-build-root--duncan :is(.fmb-block-11,.fmb-block-12) .card .item:last-child{border-bottom:0;padding-bottom:0}
.fmb-build-root--duncan :is(.fmb-block-11,.fmb-block-12) .card .item strong{display:block!important;margin-bottom:6px}
.fmb-build-root--duncan :is(.fmb-block-11,.fmb-block-12) .card .item p{margin:0!important}

/* Nível 12: reintroduz a estrutura fm-* de ficha lateral ausente no original do bloco 12. */
/* Forja sidebar sheet — standardized compact levels */
.fmb-block-12 .fm-side-sheet{
  position:relative;
  z-index:5;
  width:100%;
  margin-top:18px;
  padding:16px 0 0;
  border-top:1px solid rgba(221,205,169,.24);
  background:#102419;
}
.fmb-block-12 .fm-side-section + .fm-side-section{margin-top:16px}
.fmb-block-12 .fm-side-label{
  display:block;
  margin-bottom:8px;
  color:#ddcda9;
  font:800 9px/1.2 Arial,sans-serif;
  letter-spacing:.14em;
  text-transform:uppercase;
  text-align:left;
}
.fmb-block-12 .fm-stats-grid{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:6px;
}
.fmb-block-12 .fm-stat{
  padding:7px 5px 6px;
  border:1px solid rgba(255,255,255,.12);
  border-radius:9px;
  background:rgba(255,255,255,.045);
  text-align:center;
}
.fmb-block-12 .fm-stat small{
  display:block;
  color:#b8c6bd;
  font:800 8px/1 Arial,sans-serif;
}
.fmb-block-12 .fm-stat strong{
  display:block;
  margin-top:3px;
  color:#fff;
  font-size:18px;
  line-height:1;
}
.fmb-block-12 .fm-stat span{
  display:block;
  margin-top:3px;
  color:#8fb09d;
  font:700 9px/1 Arial,sans-serif;
}
.fmb-block-12 .fm-panel{
  padding:11px 12px;
  border:1px solid rgba(255,255,255,.11);
  border-radius:11px;
  background:rgba(255,255,255,.04);
}
.fmb-block-12 .fm-row{
  display:flex;
  align-items:flex-start;
  justify-content:space-between;
  gap:10px;
  padding:6px 0;
  border-top:1px solid rgba(255,255,255,.08);
}
.fmb-block-12 .fm-row:first-of-type{border-top:0}
.fmb-block-12 .fm-row small{
  color:#b8c6bd;
  font:700 9px/1.25 Arial,sans-serif;
}
.fmb-block-12 .fm-row strong{
  max-width:92px;
  color:#fff;
  font-size:11px;
  line-height:1.2;
  text-align:right;
}
.fmb-block-12 .fm-resource-mini{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:8px;
}
.fmb-block-12 .fm-resource-mini > div{
  padding:9px 7px;
  border:1px solid rgba(255,255,255,.09);
  border-radius:9px;
  background:rgba(255,255,255,.035);
  text-align:center;
}
.fmb-block-12 .fm-resource-mini small{
  display:block;
  color:#b8c6bd;
  font:700 8px/1.25 Arial,sans-serif;
}
.fmb-block-12 .fm-resource-mini strong{
  display:block;
  margin-top:5px;
  color:#fff;
  font-size:20px;
  line-height:1;
}
.fmb-block-12 .fm-timeline-resume{
  position:relative;
  z-index:1;
  width:2px;
  height:110px;
  margin:0 auto -24px;
  background:linear-gradient(#6b8374,#244a37);
  opacity:.78;
}
@media (max-width:760px){.fmb-block-12 .fm-side-sheet{max-width:420px;margin:18px auto 0}
.fmb-block-12 .fm-timeline-resume{display:none}}

/* Novos níveis preservam composição e paleta, com ajustes editoriais dos conteúdos homologados. */
.fmb-build-root--duncan :is(.fmb-block-11,.fmb-block-12,.fmb-block-13) .duncan-fact-card .duncan-facts>div{min-width:0}
.fmb-build-root--duncan :is(.fmb-block-11,.fmb-block-12,.fmb-block-13) .card .item strong{display:inline!important;max-width:none;white-space:normal!important;overflow-wrap:break-word;font:700 16px/1.35 Georgia,serif;color:#204d32}
.fmb-build-root--duncan :is(.fmb-block-11,.fmb-block-12,.fmb-block-13) .card .item p{margin-top:7px;font:14px/1.65 Arial,sans-serif;color:#465047}
.fmb-build-root--duncan :is(.fmb-block-11,.fmb-block-12,.fmb-block-13) .card h2{line-height:1.25}
.fmb-build-root--duncan .fmb-block-13 .phase-open .art{background:radial-gradient(circle at 50% 25%,rgba(222,187,110,.13),transparent 30%),repeating-linear-gradient(143deg,rgba(255,255,255,.02) 0,rgba(255,255,255,.02) 1px,transparent 1px,transparent 9px),linear-gradient(145deg,#0c1c15,#153329 44%,#284c3b 74%,#34535a)}
.fmb-build-root--duncan .fmb-block-13 .duncan-changes{margin:20px 0;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}
.fmb-build-root--duncan .fmb-block-13 .duncan-changes .card{padding:20px}
.fmb-build-root--duncan .fmb-block-13 .duncan-changes .card h2{margin:7px 0 14px}
.fmb-build-root--duncan .fmb-block-13 .duncan-changes .card .item{padding:10px 0;border-top:1px solid rgba(62,91,68,.2)}
.fmb-build-root--duncan .fmb-block-13 .duncan-changes .card .item:first-of-type{border-top:0}
@media(max-width:700px){.fmb-build-root--duncan .fmb-block-13 .duncan-changes{grid-template-columns:1fr}.fmb-build-root--duncan .fmb-block-13 .duncan-changes .card{padding:17px}}



