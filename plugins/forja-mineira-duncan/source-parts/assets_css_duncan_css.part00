.fmb-block-8 .stat small{display:block;color:var(--muted);font:700 9px/1.2 Arial,sans-serif;text-transform:uppercase;letter-spacing:.07em}
.fmb-block-8 .stat strong{display:block;margin-top:4px;color:var(--ink);font-size:18px}
.fmb-block-8 .spell{margin-top:12px;padding:14px 15px;border:1px solid #d5c09a;border-radius:12px;background:#faf7ef}
.fmb-block-8 .spell strong{display:block;color:var(--ink);font-size:18px}
.fmb-block-8 .spell p{margin:5px 0 0;font-size:13px;line-height:1.52}
.fmb-block-8 .combat{margin-top:18px;padding:16px 17px;border-left:4px solid var(--gold);background:#fff}
.fmb-block-8 .combat h2{margin-top:4px;font-size:23px}
.fmb-block-8 .combat p{margin:8px 0 0;font-size:14px;line-height:1.6}
.fmb-block-8 .priority{margin-top:10px;padding:10px 12px;border-radius:10px;background:var(--silver);color:#36433b;font:800 11px/1.45 Arial,sans-serif}
.fmb-block-8 .dark-lord-line{
  margin-top:11px;padding:10px 12px;border-left:3px solid var(--green);border-radius:9px;
  background:var(--green-soft);color:#35483e;font-size:13px;line-height:1.52;font-style:italic
}
@media (max-width:760px){.fmb-block-8 .preview{width:calc(100% - 20px);margin:10px auto}
.fmb-block-8 .level{grid-template-columns:1fr}
.fmb-block-8 .progress-side{min-height:330px}
.fmb-block-8 .snake-wrap{width:135px;margin-bottom:22px}
.fmb-block-8 .content{padding:24px 20px 26px}
.fmb-block-8 .core,.fmb-block-8 .statline{grid-template-columns:1fr}
.fmb-block-8 h1{font-size:35px}}
/* Forja sidebar sheet — standardized compact levels */
.fmb-block-8 .fm-side-sheet{
  position:relative;
  z-index:5;
  width:100%;
  margin-top:18px;
  padding:16px 0 0;
  border-top:1px solid rgba(221,205,169,.24);
  background:#102419;
}
.fmb-block-8 .fm-side-section + .fm-side-section{margin-top:16px}
.fmb-block-8 .fm-side-label{
  display:block;
  margin-bottom:8px;
  color:#ddcda9;
  font:800 9px/1.2 Arial,sans-serif;
  letter-spacing:.14em;
  text-transform:uppercase;
  text-align:left;
}
.fmb-block-8 .fm-stats-grid{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:6px;
}
.fmb-block-8 .fm-stat{
  padding:7px 5px 6px;
  border:1px solid rgba(255,255,255,.12);
  border-radius:9px;
  background:rgba(255,255,255,.045);
  text-align:center;
}
.fmb-block-8 .fm-stat small{
  display:block;
  color:#b8c6bd;
  font:800 8px/1 Arial,sans-serif;
}
.fmb-block-8 .fm-stat strong{
  display:block;
  margin-top:3px;
  color:#fff;
  font-size:18px;
  line-height:1;
}
.fmb-block-8 .fm-stat span{
  display:block;
  margin-top:3px;
  color:#8fb09d;
  font:700 9px/1 Arial,sans-serif;
}
.fmb-block-8 .fm-panel{
  padding:11px 12px;
  border:1px solid rgba(255,255,255,.11);
  border-radius:11px;
  background:rgba(255,255,255,.04);
}
.fmb-block-8 .fm-row{
  display:flex;
  align-items:flex-start;
  justify-content:space-between;
  gap:10px;
  padding:6px 0;
  border-top:1px solid rgba(255,255,255,.08);
}
.fmb-block-8 .fm-row:first-of-type{border-top:0}
.fmb-block-8 .fm-row small{
  color:#b8c6bd;
  font:700 9px/1.25 Arial,sans-serif;
}
.fmb-block-8 .fm-row strong{
  max-width:92px;
  color:#fff;
  font-size:11px;
  line-height:1.2;
  text-align:right;
}
.fmb-block-8 .fm-resource-mini{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:8px;
}
.fmb-block-8 .fm-resource-mini > div{
  padding:9px 7px;
  border:1px solid rgba(255,255,255,.09);
  border-radius:9px;
  background:rgba(255,255,255,.035);
  text-align:center;
}
.fmb-block-8 .fm-resource-mini small{
  display:block;
  color:#b8c6bd;
  font:700 8px/1.25 Arial,sans-serif;
}
.fmb-block-8 .fm-resource-mini strong{
  display:block;
  margin-top:5px;
  color:#fff;
  font-size:20px;
  line-height:1;
}
.fmb-block-8 .fm-timeline-resume{
  position:relative;
  z-index:1;
  width:2px;
  height:110px;
  margin:0 auto -24px;
  background:linear-gradient(#6b8374,#244a37);
  opacity:.78;
}
@media (max-width:760px){.fmb-block-8 .fm-side-sheet{max-width:420px;margin:18px auto 0}
.fmb-block-8 .fm-timeline-resume{display:none}}
.fmb-block-8 .progress-side .timeline{bottom:auto!important;height:300px!important}
/* === Sidebar compacta padronizada: cobra + wishlist === */
.fmb-block-8 .progress-side .snake-wrap{
  width:158px !important;
  height:215px !important;
  min-height:215px !important;
  margin:12px auto 8px !important;
  display:flex !important;
  align-items:flex-start !important;
  justify-content:center !important;
  flex:0 0 215px !important;
}
.fmb-block-8 .progress-side .snake-wrap img{
  display:block !important;
  width:100% !important;
  height:100% !important;
  max-height:215px !important;
  object-fit:contain !important;
  object-position:center top !important;
}
.fmb-block-8 .progress-side .timeline{
  bottom:auto !important;
  height:170px !important;
}
.fmb-block-8 .wish-section,.fmb-block-8 .arcana-standard{
  position:relative;
  z-index:6;
  width:100%;
  margin-top:16px;
  padding:11px 12px;
  border:1px solid rgba(255,255,255,.11);
  border-radius:11px;
  background:rgba(255,255,255,.04);
}
.fmb-block-8 .wish-title,.fmb-block-8 .arcana-standard-title{
  display:block;
  margin-bottom:8px;
  color:#ddcda9;
  font:800 9px/1.2 Arial,sans-serif;
  letter-spacing:.14em;
  text-transform:uppercase;
}
.fmb-block-8 .wish-note{
  margin:0 0 9px;
  color:#9fb2a6;
  font:700 8px/1.4 Arial,sans-serif;
}
.fmb-block-8 .wish-item{
  padding:8px 9px;
  border:1px solid rgba(255,255,255,.09);
  border-radius:9px;
  background:rgba(255,255,255,.035);
}
.fmb-block-8 .wish-item + .wish-item{margin-top:7px}
.fmb-block-8 .wish-head{display:flex;gap:7px;align-items:flex-start;justify-content:space-between}
.fmb-block-8 .wish-head strong{color:#fff;font-size:11px;line-height:1.25}
.fmb-block-8 .wish-tag{
  flex:0 0 auto;padding:3px 5px;border:1px solid rgba(215,190,130,.32);
  border-radius:999px;color:#ddcda9;font:800 6.5px/1 Arial,sans-serif;
  letter-spacing:.06em;text-transform:uppercase
}
.fmb-block-8 .wish-item small{display:block;margin-top:3px;color:#9ab4a4;font:700 7.5px/1.25 Arial,sans-serif}
.fmb-block-8 .wish-item p{margin:6px 0 0;color:#d2ddd6;font-size:9px;line-height:1.42}
.fmb-block-8 .arcana-standard-row{
  padding:8px 9px;border:1px solid rgba(255,255,255,.09);border-radius:9px;
  background:rgba(255,255,255,.035)
}
.fmb-block-8 .arcana-standard-row + .arcana-standard-row{margin-top:7px}
.fmb-block-8 .arcana-standard-row small{display:block;color:#9ab4a4;font:700 7.5px/1.2 Arial,sans-serif;text-transform:uppercase}
.fmb-block-8 .arcana-standard-row strong{display:block;margin-top:4px;color:#fff;font-size:11px;line-height:1.25}
.fmb-block-8 .arcana-standard-row em{display:block;margin-top:2px;color:#b8c6bd;font:italic 8px/1.2 Georgia,serif}
@media (max-width:760px){.fmb-block-8 .progress-side .snake-wrap{
    width:145px !important;height:195px !important;min-height:195px !important;
    flex-basis:195px !important;margin:10px auto 6px !important
  }}
/* === Wishlist minimalista: somente próximo item prioritário === */
.fmb-block-8 .wish-section{
  position:relative;
  z-index:6;
  width:100%;
  margin-top:16px;
  padding:11px 12px;
  border:1px solid rgba(255,255,255,.11);
  border-radius:11px;
  background:rgba(255,255,255,.04);
}
.fmb-block-8 .wish-title{
  display:block;
  margin-bottom:7px;
  color:#ddcda9;
  font:800 9px/1.2 Arial,sans-serif;
  letter-spacing:.14em;
  text-transform:uppercase;
}
.fmb-block-8 .wish-note{
  margin:0 0 9px;
  color:#9fb2a6;
  font:700 8px/1.45 Arial,sans-serif;
}
.fmb-block-8 .wish-item{
  padding:9px 10px;
  border:1px solid rgba(255,255,255,.09);
  border-radius:9px;
  background:rgba(255,255,255,.035);
}
.fmb-block-8 .wish-head{
  display:flex;
  gap:7px;
  align-items:flex-start;
  justify-content:space-between;
}
.fmb-block-8 .wish-head strong{
  color:#fff;
  font-size:11px;
  line-height:1.25;
}
.fmb-block-8 .wish-tag{
  flex:0 0 auto;
  padding:3px 5px;
  border:1px solid rgba(215,190,130,.32);
  border-radius:999px;
  color:#ddcda9;
  font:800 6.5px/1 Arial,sans-serif;
  letter-spacing:.06em;
  text-transform:uppercase;
}
.fmb-block-8 .wish-item small{
  display:block;
  margin-top:3px;
  color:#9ab4a4;
  font:700 7.5px/1.25 Arial,sans-serif;
}
.fmb-block-8 .wish-item p{
  margin:6px 0 0;
  color:#d2ddd6;
  font-size:9px;
  line-height:1.42;
}

/* ===== BLOCO 9 ===== */
.fmb-block-9{
  --paper:#fbfaf6;--white:#fff;--ink:#1f1b17;--body:#403a33;--muted:#70675e;
  --line:#ddd4c5;--gold:#9b6b18;--green:#28513e;--green-soft:#f2f7f3;
  --silver:#eef1ef;--dark:#0b1510;
}
.fmb-block-9 *{box-sizing:border-box}
.fmb-block-9{margin:0;background:#f1f0ec;color:var(--body);font-family:Georgia,"Times New Roman",serif}
.fmb-block-9 .preview{width:min(1360px,calc(100% - 48px));margin:34px auto}
.fmb-block-9 .level{border:1px solid var(--line);border-radius:26px;overflow:hidden;background:var(--paper)}
.fmb-block-9 .phase-open{display:grid;grid-template-columns:minmax(320px,34%) minmax(0,66%);background:#fff}
.fmb-block-9 .art{position:relative;min-height:690px;overflow:hidden;background:var(--dark)}
.fmb-block-9 .art img{display:block;width:100%;height:100%;min-height:690px;object-fit:cover;object-position:center 24%}
.fmb-block-9 .art:after{
  content:"";position:absolute;inset:0;
  background:linear-gradient(90deg,rgba(5,12,8,.02) 48%,rgba(5,12,8,.34)),
             linear-gradient(0deg,rgba(5,10,7,.78),transparent 38%);
  pointer-events:none
}
.fmb-block-9 .phase-tag{
  position:absolute;z-index:3;left:22px;top:22px;padding:8px 11px;border:1px solid rgba(255,255,255,.2);
  border-radius:999px;background:rgba(11,27,20,.74);color:#e7d5aa;
  font:800 10px/1 Arial,sans-serif;letter-spacing:.13em;text-transform:uppercase
}
.fmb-block-9 .level-badge{
  position:absolute;z-index:3;left:22px;bottom:24px;width:72px;height:72px;border-radius:50%;
  display:grid;place-items:center;background:#f7f3ea;border:3px solid #a8792d;color:#1f1b17;font:bold 32px/1 Georgia,serif
}
.fmb-block-9 .art-caption{position:absolute;z-index:3;left:112px;right:20px;bottom:30px;color:#fff}
.fmb-block-9 .art-caption strong{display:block;font-size:22px}
.fmb-block-9 .art-caption span{display:block;margin-top:4px;color:#d1dcd5;font:700 9px/1.4 Arial,sans-serif;letter-spacing:.1em;text-transform:uppercase}
.fmb-block-9 .content{padding:34px 34px 36px 18px;display:flex;flex-direction:column;justify-content:center}
.fmb-block-9 .kicker,.fmb-block-9 .mini-label{color:var(--gold);font:800 10px/1.2 Arial,sans-serif;letter-spacing:.14em;text-transform:uppercase}
.fmb-block-9 h1,.fmb-block-9 h2,.fmb-block-9 h3{margin:0;color:var(--ink)}
.fmb-block-9 h1{margin-top:7px;font-size:50px;line-height:.98}
.fmb-block-9 .subtitle{margin-top:8px;color:var(--green);font-size:21px;font-style:italic}
.fmb-block-9 .lead{margin:15px 0 0;max-width:880px;font-size:16px;line-height:1.65}
.fmb-block-9 .strip{margin-top:19px;display:flex;flex-wrap:wrap;gap:8px}
.fmb-block-9 .strip span{padding:8px 11px;border:1px solid var(--line);border-radius:999px;background:#fff;font:700 11px/1 Arial,sans-serif;color:var(--muted)}
.fmb-block-9 .strip strong{color:var(--ink)}
.fmb-block-9 .breakthrough{margin-top:22px;padding:14px 16px;border-left:4px solid var(--green);border-radius:10px;background:var(--green-soft);font-size:14px;line-height:1.55}
.fmb-block-9 .grid{margin-top:22px;display:grid;grid-template-columns:1fr 1fr;gap:12px;position:relative;align-items:stretch}
.fmb-block-9 .card{padding:18px 19px;border:1px solid var(--line);border-radius:16px;background:#fff;display:flex;flex-direction:column}
.fmb-block-9 .card.primary{border-color:#9fb5a8;background:linear-gradient(180deg,#fff,#f5f8f6)}
.fmb-block-9 .card h2{margin-top:4px;font-size:23px}
.fmb-block-9 .card p{margin:7px 0 0;font-size:13px;line-height:1.55}
.fmb-block-9 .item{padding:10px 0;border-top:1px solid #ece6dc}
.fmb-block-9 .item:first-of-type{border-top:0}
.fmb-block-9 .item strong{display:block;color:var(--ink);font-size:16px}
.fmb-block-9 .item span{display:block;margin-top:4px;color:var(--muted);font-size:12px;line-height:1.45}
.fmb-block-9 .spells{margin-top:12px;padding:16px 17px;border:1px solid var(--line);border-radius:15px;background:#fff}
.fmb-block-9 .spell-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:10px}
.fmb-block-9 .spell-choice,.fmb-block-9 .patron-spells{padding:13px 14px;border-radius:12px}
.fmb-block-9 .spell-choice{background:#faf7ef;border:1px solid #d4c09a}
.fmb-block-9 .patron-spells{background:#f3f7f4;border:1px solid #aabdb1}
.fmb-block-9 .spell-choice strong,.fmb-block-9 .patron-spells strong{display:block;color:var(--ink);font-size:16px}
.fmb-block-9 .spell-choice p,.fmb-block-9 .patron-spells p{margin:5px 0 0;font-size:13px;line-height:1.5}
.fmb-block-9 .combat{padding:28px 34px 32px;border-top:1px solid var(--line);background:#fff}
.fmb-block-9 .combat-wrap{display:grid;grid-template-columns:215px minmax(0,1fr);gap:22px;padding-left:18px;border-left:4px solid var(--gold)}
.fmb-block-9 .combat h2{margin-top:5px;font-size:26px}
.fmb-block-9 .combat p{margin:0 0 10px;font-size:14px;line-height:1.62}
.fmb-block-9 .tactic-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:9px;margin-top:12px}
.fmb-block-9 .tactic{padding:12px;border:1px solid #c7cec9;border-radius:11px;background:var(--silver)}
.fmb-block-9 .tactic small{display:block;color:var(--green);font:800 9px/1.2 Arial,sans-serif;text-transform:uppercase;letter-spacing:.08em}
.fmb-block-9 .tactic strong{display:block;margin-top:4px;color:var(--ink);font-size:14px}
.fmb-block-9 .tactic p{margin:5px 0 0;font-size:12px;line-height:1.45}
.fmb-block-9 .priority{margin-top:12px;padding:11px 13px;border-radius:10px;background:#17261f;color:#ecf3ee;font:800 11px/1.45 Arial,sans-serif}
@media (max-width:1050px){.fmb-block-9 .phase-open{grid-template-columns:1fr}
.fmb-block-9 .art{min-height:470px}
.fmb-block-9 .art img{
    height:100%;
    min-height:470px;
    object-position:center 18%;
    transform:none;
  }}
@media (max-width:760px){.fmb-block-9 .preview{width:calc(100% - 20px);margin:10px auto}
.fmb-block-9 .level{border-radius:18px}
.fmb-block-9 .content,.fmb-block-9 .combat{padding:24px 20px 26px}
.fmb-block-9 .grid,.fmb-block-9 .spell-grid,.fmb-block-9 .tactic-grid,.fmb-block-9 .combat-wrap{grid-template-columns:1fr}
.fmb-block-9 .shared-note{
    grid-column:1;
    margin-top:0;
  }
.fmb-block-9 h1{font-size:38px}}
.fmb-block-9 .shared-note{
  position:static;
  grid-column:1 / -1;
  padding:14px 16px;
  border-left:4px solid var(--green);
  border-radius:10px;
  background:var(--green-soft);
  color:#35483e;
  font-size:13px;
  line-height:1.58;
  font-style:italic;
  box-shadow:0 0 0 1px rgba(40,81,62,.03);
  margin-top:2px;
}
.fmb-block-9 .shared-note strong{
  color:var(--ink);
}

/* ===== BLOCO 10 ===== */
.fmb-block-10{
  --paper:#fbfaf6;--white:#fff;--ink:#1f1b17;--body:#403a33;--muted:#70675e;
  --line:#ddd4c5;--gold:#9b6b18;--green:#28513e;--green-soft:#f2f7f3;
  --silver:#eef1ef;--dark:#0e1712;
}
.fmb-block-10 *{box-sizing:border-box}
.fmb-block-10{margin:0;background:#f1f0ec;color:var(--body);font-family:Georgia,"Times New Roman",serif}
.fmb-block-10 .preview{width:min(1360px,calc(100% - 48px));margin:34px auto}
.fmb-block-10 .level{
  display:grid;grid-template-columns:210px minmax(0,1fr);
  border:1px solid var(--line);border-radius:24px;overflow:hidden;background:var(--paper)
}
.fmb-block-10 .progress-side{
  position:relative;height:100%;padding:28px 18px 24px;
  background:
    radial-gradient(circle at 50% 38%,rgba(55,113,80,.28),transparent 27%),
    linear-gradient(180deg,#101d17,#08100c);
  color:#fff;display:flex;flex-direction:column;align-items:center;overflow:hidden
}
.fmb-block-10 .phase{position:relative;z-index:4;font:800 10px/1.25 Arial,sans-serif;letter-spacing:.16em;text-transform:uppercase;color:#ddcda9;text-align:center}
.fmb-block-10 .level-no{position:relative;z-index:4;margin-top:14px;width:76px;height:76px;border-radius:50%;display:grid;place-items:center;background:#f6f3eb;border:3px solid #a8792d;color:#1f1b17;font:bold 34px/1 Georgia,serif}
.fmb-block-10 .timeline{position:absolute;z-index:1;top:118px;height:300px;left:50%;width:2px;transform:translateX(-50%);background:linear-gradient(#c5b79c,#6b8374 55%,#244a37);opacity:.78}
.fmb-block-10 .snake-wrap{position:relative;z-index:3;width:162px;margin-top:auto;margin-bottom:34px}
.fmb-block-10 .snake-wrap img{display:block;width:100%;height:auto;filter:drop-shadow(0 15px 22px rgba(0,0,0,.48))}
.fmb-block-10 .content{padding:30px 34px 32px 24px}
.fmb-block-10 .kicker,.fmb-block-10 .mini-label{color:var(--gold);font:800 10px/1.2 Arial,sans-serif;letter-spacing:.14em;text-transform:uppercase}
.fmb-block-10 h1,.fmb-block-10 h2,.fmb-block-10 h3{margin:0;color:var(--ink)}
.fmb-block-10 h1{margin-top:7px;font-size:42px;line-height:1}
.fmb-block-10 .lead{margin:13px 0 0;max-width:1030px;font-size:16px;line-height:1.62}
.fmb-block-10 .strip{margin-top:18px;display:flex;flex-wrap:wrap;gap:8px}
.fmb-block-10 .strip span{padding:8px 11px;border:1px solid var(--line);border-radius:999px;background:#fff;font:700 11px/1 Arial,sans-serif;color:var(--muted)}
.fmb-block-10 .strip strong{color:var(--ink)}
.fmb-block-10 .core{margin-top:22px;display:grid;grid-template-columns:1fr 1fr;gap:12px;align-items:stretch}
.fmb-block-10 .card{padding:18px 19px;border:1px solid var(--line);border-radius:16px;background:#fff}
.fmb-block-10 .card.primary{border-color:#91ad9d;background:linear-gradient(180deg,#fff,var(--green-soft))}
.fmb-block-10 .card h2{margin-top:4px;font-size:24px}
.fmb-block-10 .card p{margin:8px 0 0;font-size:14px;line-height:1.58}
.fmb-block-10 .rule{margin-top:12px;padding:12px 13px;border-radius:11px;background:#fff;border:1px solid #d5ded8}
.fmb-block-10 .rule strong{display:block;color:var(--ink);font-size:15px}
.fmb-block-10 .rule span{display:block;margin-top:4px;color:var(--muted);font-size:12px;line-height:1.5}
.fmb-block-10 .progression{margin-top:12px;display:grid;grid-template-columns:1fr 1fr;gap:12px}
.fmb-block-10 .progress-card{padding:15px 16px;border:1px solid #d5c09a;border-radius:13px;background:#faf7ef}
.fmb-block-10 .progress-card.green{border-color:#a9beb1;background:#f3f7f4}
.fmb-block-10 .progress-card strong{display:block;margin-top:4px;color:var(--ink);font-size:18px}
.fmb-block-10 .progress-card p{margin:6px 0 0;font-size:13px;line-height:1.55}
.fmb-block-10 .combo{margin-top:18px;padding:18px 19px;border:1px solid var(--line);border-radius:15px;background:#fff}
.fmb-block-10 .combo h2{margin-top:4px;font-size:23px}
.fmb-block-10 .combo-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:9px;margin-top:12px}
.fmb-block-10 .step{padding:12px;border:1px solid #cad3cd;border-radius:11px;background:var(--silver)}
.fmb-block-10 .step small{display:block;color:var(--green);font:800 9px/1.2 Arial,sans-serif;text-transform:uppercase;letter-spacing:.08em}
.fmb-block-10 .step strong{display:block;margin-top:4px;color:var(--ink);font-size:14px}
.fmb-block-10 .step p{margin:5px 0 0;font-size:12px;line-height:1.45}
.fmb-block-10 .warning{margin-top:12px;padding:11px 13px;border-left:4px solid var(--gold);border-radius:9px;background:#faf6ec;font-size:13px;line-height:1.55}
.fmb-block-10 .combat{margin-top:18px;padding:16px 17px;border-left:4px solid var(--green);background:#fff}
.fmb-block-10 .combat h2{margin-top:4px;font-size:23px}
.fmb-block-10 .combat p{margin:8px 0 0;font-size:14px;line-height:1.6}
.fmb-block-10 .priority{margin-top:11px;padding:10px 12px;border-radius:10px;background:#17261f;color:#edf3ef;font:800 11px/1.45 Arial,sans-serif}
.fmb-block-10 .dark-lord-line{margin-top:11px;padding:11px 13px;border-left:3px solid var(--green);border-radius:9px;background:var(--green-soft);color:#35483e;font-size:13px;line-height:1.52;font-style:italic}
@media (max-width:760px){.fmb-block-10 .preview{width:calc(100% - 20px);margin:10px auto}
.fmb-block-10 .level{grid-template-columns:1fr}
.fmb-block-10 .progress-side{min-height:330px}
.fmb-block-10 .snake-wrap{width:138px;margin-bottom:22px}
.fmb-block-10 .content{padding:24px 20px 26px}
.fmb-block-10 .core,.fmb-block-10 .progression,.fmb-block-10 .combo-grid{grid-template-columns:1fr}
.fmb-block-10 h1{font-size:35px}}
/* Forja sidebar sheet — standardized compact levels */
.fmb-block-10 .fm-side-sheet{
  position:relative;
  z-index:5;
  width:100%;
  margin-top:18px;
  padding:16px 0 0;
  border-top:1px solid rgba(221,205,169,.24);
  background:#102419;
}
.fmb-block-10 .fm-side-section + .fm-side-section{margin-top:16px}
.fmb-block-10 .fm-side-label{
  display:block;
  margin-bottom:8px;
  color:#ddcda9;
  font:800 9px/1.2 Arial,sans-serif;
  letter-spacing:.14em;
  text-transform:uppercase;
  text-align:left;
}
.fmb-block-10 .fm-stats-grid{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:6px;
}
.fmb-block-10 .fm-stat{
  padding:7px 5px 6px;
  border:1px solid rgba(255,255,255,.12);
  border-radius:9px;
  background:rgba(255,255,255,.045);
  text-align:center;
}
.fmb-block-10 .fm-stat small{
  display:block;
  color:#b8c6bd;
  font:800 8px/1 Arial,sans-serif;
}
.fmb-block-10 .fm-stat strong{
  display:block;
  margin-top:3px;
  color:#fff;
  font-size:18px;
  line-height:1;
}
.fmb-block-10 .fm-stat span{
  display:block;
  margin-top:3px;
  color:#8fb09d;
  font:700 9px/1 Arial,sans-serif;
}
.fmb-block-10 .fm-panel{
  padding:11px 12px;
  border:1px solid rgba(255,255,255,.11);
  border-radius:11px;
  background:rgba(255,255,255,.04);
}
.fmb-block-10 .fm-row{
  display:flex;
  align-items:flex-start;
  justify-content:space-between;
  gap:10px;
  padding:6px 0;
  border-top:1px solid rgba(255,255,255,.08);
}
.fmb-block-10 .fm-row:first-of-type{border-top:0}
.fmb-block-10 .fm-row small{
  color:#b8c6bd;
  font:700 9px/1.25 Arial,sans-serif;
}
.fmb-block-10 .fm-row strong{
  max-width:92px;
  color:#fff;
  font-size:11px;
  line-height:1.2;
  text-align:right;
}
.fmb-block-10 .fm-resource-mini{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:8px;
}
.fmb-block-10 .fm-resource-mini > div{
  padding:9px 7px;
  border:1px solid rgba(255,255,255,.09);
  border-radius:9px;
  background:rgba(255,255,255,.035);
  text-align:center;
}
.fmb-block-10 .fm-resource-mini small{
  display:block;
  color:#b8c6bd;
  font:700 8px/1.25 Arial,sans-serif;
}
.fmb-block-10 .fm-resource-mini strong{
  display:block;
  margin-top:5px;
  color:#fff;
  font-size:20px;
  line-height:1;
}
.fmb-block-10 .fm-timeline-resume{
  position:relative;
  z-index:1;
  width:2px;
  height:110px;
  margin:0 auto -24px;
  background:linear-gradient(#6b8374,#244a37);
  opacity:.78;
}
@media (max-width:760px){.fmb-block-10 .fm-side-sheet{max-width:420px;margin:18px auto 0}
.fmb-block-10 .fm-timeline-resume{display:none}}
.fmb-block-10 .progress-side .timeline{bottom:auto!important;height:300px!important}
/* === Sidebar compacta padronizada: cobra + wishlist === */
.fmb-block-10 .progress-side .snake-wrap{
  width:158px !important;
  height:215px !important;
  min-height:215px !important;
  margin:12px auto 8px !important;
  display:flex !important;
  align-items:flex-start !important;
  justify-content:center !important;
  flex:0 0 215px !important;
}
.fmb-block-10 .progress-side .snake-wrap img{
  display:block !important;
  width:100% !important;
  height:100% !important;
  max-height:215px !important;
  object-fit:contain !important;
  object-position:center top !important;
}
.fmb-block-10 .progress-side .timeline{
  bottom:auto !important;
  height:170px !important;
}
.fmb-block-10 .wish-section,.fmb-block-10 .arcana-standard{
  position:relative;
  z-index:6;
  width:100%;
  margin-top:16px;
  padding:11px 12px;
  border:1px solid rgba(255,255,255,.11);
  border-radius:11px;
  background:rgba(255,255,255,.04);
}
.fmb-block-10 .wish-title,.fmb-block-10 .arcana-standard-title{
  display:block;
  margin-bottom:8px;
  color:#ddcda9;
  font:800 9px/1.2 Arial,sans-serif;
  letter-spacing:.14em;
  text-transform:uppercase;
}
.fmb-block-10 .wish-note{
  margin:0 0 9px;
  color:#9fb2a6;
  font:700 8px/1.4 Arial,sans-serif;
}
.fmb-block-10 .wish-item{
  padding:8px 9px;
  border:1px solid rgba(255,255,255,.09);
  border-radius:9px;
  background:rgba(255,255,255,.035);
}
.fmb-block-10 .wish-item + .wish-item{margin-top:7px}
.fmb-block-10 .wish-head{display:flex;gap:7px;align-items:flex-start;justify-content:space-between}
.fmb-block-10 .wish-head strong{color:#fff;font-size:11px;line-height:1.25}
.fmb-block-10 .wish-tag{
  flex:0 0 auto;padding:3px 5px;border:1px solid rgba(215,190,130,.32);
  border-radius:999px;color:#ddcda9;font:800 6.5px/1 Arial,sans-serif;
  letter-spacing:.06em;text-transform:uppercase
}
.fmb-block-10 .wish-item small{display:block;margin-top:3px;color:#9ab4a4;font:700 7.5px/1.25 Arial,sans-serif}
.fmb-block-10 .wish-item p{margin:6px 0 0;color:#d2ddd6;font-size:9px;line-height:1.42}
.fmb-block-10 .arcana-standard-row{
  padding:8px 9px;border:1px solid rgba(255,255,255,.09);border-radius:9px;
  background:rgba(255,255,255,.035)
}
.fmb-block-10 .arcana-standard-row + .arcana-standard-row{margin-top:7px}
.fmb-block-10 .arcana-standard-row small{display:block;color:#9ab4a4;font:700 7.5px/1.2 Arial,sans-serif;text-transform:uppercase}
.fmb-block-10 .arcana-standard-row strong{display:block;margin-top:4px;color:#fff;font-size:11px;line-height:1.25}
.fmb-block-10 .arcana-standard-row em{display:block;margin-top:2px;color:#b8c6bd;font:italic 8px/1.2 Georgia,serif}
@media (max-width:760px){.fmb-block-10 .progress-side .snake-wrap{
    width:145px !important;height:195px !important;min-height:195px !important;
    flex-basis:195px !important;margin:10px auto 6px !important
  }}
/* === Wishlist minimalista: somente próximo item prioritário === */
.fmb-block-10 .wish-section{
  position:relative;
  z-index:6;
  width:100%;
  margin-top:16px;
  padding:11px 12px;
  border:1px solid rgba(255,255,255,.11);
  border-radius:11px;
  background:rgba(255,255,255,.04);
}
.fmb-block-10 .wish-title{
  display:block;
  margin-bottom:7px;
  color:#ddcda9;
  font:800 9px/1.2 Arial,sans-serif;
  letter-spacing:.14em;
  text-transform:uppercase;
}
.fmb-block-10 .wish-note{
  margin:0 0 9px;
  color:#9fb2a6;
  font:700 8px/1.45 Arial,sans-serif;
}
.fmb-block-10 .wish-item{
  padding:9px 10px;
  border:1px solid rgba(255,255,255,.09);
  border-radius:9px;
  background:rgba(255,255,255,.035);
}
.fmb-block-10 .wish-head{
  display:flex;
  gap:7px;
  align-items:flex-start;
  justify-content:space-between;
}
.fmb-block-10 .wish-head strong{
  color:#fff;
  font-size:11px;
  line-height:1.25;
}
.fmb-block-10 .wish-tag{
  flex:0 0 auto;
  padding:3px 5px;
  border:1px solid rgba(215,190,130,.32);
  border-radius:999px;
  color:#ddcda9;
  font:800 6.5px/1 Arial,sans-serif;
  letter-spacing:.06em;
  text-transform:uppercase;
}
.fmb-block-10 .wish-item small{
  display:block;
  margin-top:3px;
  color:#9ab4a4;
  font:700 7.5px/1.25 Arial,sans-serif;
}
.fmb-block-10 .wish-item p{
  margin:6px 0 0;
  color:#d2ddd6;
  font-size:9px;
  line-height:1.42;
}

/* ===== BLOCO 11 ===== */
.fmb-block-11{
  --paper:#fbfaf6;--white:#fff;--ink:#1f1b17;--body:#403a33;--muted:#70675e;
  --line:#ddd4c5;--gold:#9b6b18;--green:#28513e;--green-soft:#f2f7f3;
  --silver:#eef1ef;--dark:#0e1712;
}
.fmb-block-11 *{box-sizing:border-box}
.fmb-block-11{margin:0;background:#f1f0ec;color:var(--body);font-family:Georgia,"Times New Roman",serif}
.fmb-block-11 .preview{width:min(1360px,calc(100% - 48px));margin:34px auto}
.fmb-block-11 .level{
  display:grid;grid-template-columns:210px minmax(0,1fr);
  border:1px solid var(--line);border-radius:24px;overflow:hidden;background:var(--paper)
}
.fmb-block-11 .progress-side{
  position:relative;height:100%;padding:28px 18px 24px;
  background:
    radial-gradient(circle at 50% 36%,rgba(54,116,80,.28),transparent 28%),
    linear-gradient(180deg,#101d17,#08100c);
  color:#fff;display:flex;flex-direction:column;align-items:center;overflow:hidden
}
.fmb-block-11 .phase{position:relative;z-index:4;font:800 10px/1.25 Arial,sans-serif;letter-spacing:.16em;text-transform:uppercase;color:#ddcda9;text-align:center}
.fmb-block-11 .level-no{position:relative;z-index:4;margin-top:14px;width:76px;height:76px;border-radius:50%;display:grid;place-items:center;background:#f6f3eb;border:3px solid #a8792d;color:#1f1b17;font:bold 34px/1 Georgia,serif}
.fmb-block-11 .timeline{position:absolute;z-index:1;top:118px;height:300px;left:50%;width:2px;transform:translateX(-50%);background:linear-gradient(#c5b79c,#6b8374 55%,#244a37);opacity:.78}
.fmb-block-11 .snake-wrap{position:relative;z-index:3;width:162px;margin-top:auto;margin-bottom:36px}
.fmb-block-11 .snake-wrap img{display:block;width:100%;height:auto;filter:drop-shadow(0 15px 22px rgba(0,0,0,.48))}
.fmb-block-11 .content{padding:30px 34px 32px 22px}
.fmb-block-11 .kicker,.fmb-block-11 .mini-label{color:var(--gold);font:800 10px/1.2 Arial,sans-serif;letter-spacing:.14em;text-transform:uppercase}
.fmb-block-11 h1,.fmb-block-11 h2,.fmb-block-11 h3{margin:0;color:var(--ink)}
.fmb-block-11 h1{margin-top:7px;font-size:42px;line-height:1}
.fmb-block-11 .lead{margin:13px 0 0;max-width:1080px;font-size:16px;line-height:1.62}
.fmb-block-11 .strip{margin-top:18px;display:flex;flex-wrap:wrap;gap:8px}
.fmb-block-11 .strip span{padding:8px 11px;border:1px solid var(--line);border-radius:999px;background:#fff;font:700 11px/1 Arial,sans-serif;color:var(--muted)}
.fmb-block-11 .strip strong{color:var(--ink)}
.fmb-block-11 .milestone{margin-top:22px;display:grid;grid-template-columns:1.12fr .88fr;gap:12px;align-items:stretch}
.fmb-block-11 .card{padding:18px 19px;border:1px solid var(--line);border-radius:16px;background:#fff}
.fmb-block-11 .card.primary{border-color:#86a995;background:linear-gradient(180deg,#fff,var(--green-soft))}
.fmb-block-11 .card h2{margin-top:5px;font-size:25px}
.fmb-block-11 .card p{margin:8px 0 0;font-size:14px;line-height:1.58}
.fmb-block-11 .arcanum-name{margin-top:12px;padding:14px 15px;border-radius:12px;background:#17261f;color:#f5f0e8}
.fmb-block-11 .arcanum-name small{display:block;color:#d7be82;font:800 9px/1.2 Arial,sans-serif;letter-spacing:.1em;text-transform:uppercase}
.fmb-block-11 .arcanum-name strong{display:block;margin-top:5px;font-size:22px}
.fmb-block-11 .arcanum-name span{display:block;margin-top:6px;color:#dbe5df;font-size:12px;line-height:1.48}
.fmb-block-11 .fact-grid{margin-top:12px;display:grid;grid-template-columns:repeat(3,1fr);gap:8px}
.fmb-block-11 .fact{padding:10px 11px;border:1px solid #cad4cd;border-radius:10px;background:#fff}
.fmb-block-11 .fact small{display:block;color:var(--green);font:800 9px/1.2 Arial,sans-serif;text-transform:uppercase;letter-spacing:.08em}
.fmb-block-11 .fact strong{display:block;margin-top:3px;color:var(--ink);font-size:14px}
.fmb-block-11 .fact span{display:block;margin-top:4px;color:var(--muted);font-size:11px;line-height:1.42}
.fmb-block-11 .resource{margin-top:12px;padding:13px 14px;border:1px solid #d7c49e;border-radius:12px;background:#faf7ef}
.fmb-block-11 .resource strong{display:block;color:var(--ink);font-size:17px}
.fmb-block-11 .resource p{margin:5px 0 0;font-size:13px;line-height:1.5}
.fmb-block-11 .progression{margin-top:12px;display:grid;grid-template-columns:1fr 1fr;gap:12px}
.fmb-block-11 .progress-card{padding:16px 17px;border:1px solid var(--line);border-radius:14px;background:#fff}
.fmb-block-11 .progress-card.green{background:#f3f7f4;border-color:#a8bdb0}
.fmb-block-11 .progress-card.gold{background:#faf7ef;border-color:#d5bf95}
.fmb-block-11 .progress-card strong{display:block;margin-top:4px;color:var(--ink);font-size:18px}
.fmb-block-11 .progress-card p{margin:6px 0 0;font-size:13px;line-height:1.55}
.fmb-block-11 .command{margin-top:18px;padding:18px 19px;border:1px solid var(--line);border-radius:15px;background:#fff}
.fmb-block-11 .command h2{margin-top:4px;font-size:23px}
.fmb-block-11 .command-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:9px;margin-top:12px}
.fmb-block-11 .step{padding:12px;border:1px solid #cad3cd;border-radius:11px;background:var(--silver)}
.fmb-block-11 .step small{display:block;color:var(--green);font:800 9px/1.2 Arial,sans-serif;text-transform:uppercase;letter-spacing:.08em}
.fmb-block-11 .step strong{display:block;margin-top:4px;color:var(--ink);font-size:14px}
.fmb-block-11 .step p{margin:5px 0 0;font-size:12px;line-height:1.45}
.fmb-block-11 .combat{margin-top:18px;padding:16px 17px;border-left:4px solid var(--green);background:#fff}
.fmb-block-11 .combat h2{margin-top:4px;font-size:23px}
.fmb-block-11 .combat p{margin:8px 0 0;font-size:14px;line-height:1.6}
.fmb-block-11 .priority{margin-top:11px;padding:10px 12px;border-radius:10px;background:#17261f;color:#edf3ef;font:800 11px/1.45 Arial,sans-serif}
.fmb-block-11 .dark-lord-line{margin-top:11px;padding:11px 13px;border-left:3px solid var(--green);border-radius:9px;background:var(--green-soft);color:#35483e;font-size:13px;line-height:1.52;font-style:italic}
@media (max-width:900px){.fmb-block-11 .milestone,.fmb-block-11 .progression{grid-template-columns:1fr}}
@media (max-width:760px){.fmb-block-11 .preview{width:calc(100% - 20px);margin:10px auto}
.fmb-block-11 .level{grid-template-columns:1fr}
.fmb-block-11 .progress-side{min-height:330px}
.fmb-block-11 .snake-wrap{width:138px;margin-bottom:22px}
.fmb-block-11 .content{padding:24px 20px 26px}
.fmb-block-11 .fact-grid,.fmb-block-11 .command-grid{grid-template-columns:1fr}
.fmb-block-11 h1{font-size:35px}}
