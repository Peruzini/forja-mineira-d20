@media(max-width:700px){.fmb-build-root--duncan .duncan-facts,.fmb-build-root--duncan .duncan-maneuver-list{grid-template-columns:1fr}.fmb-build-root--duncan .fmb-block-5 .duncan-phase-art{min-height:300px;margin:13px}.fmb-build-root--duncan .fmb-block-5 .combat{padding:20px 14px}}

/* QA visual final 5–7: regras específicas do template não devem transformar ênfases internas em blocos. */
.fmb-build-root--duncan .fmb-block-5 .changes .card .item p strong,
.fmb-build-root--duncan .fmb-block-5 .changes .card .item span strong,
.fmb-build-root--duncan .fmb-block-6 .core .card .effect p strong,
.fmb-build-root--duncan .fmb-block-6 .core .card .item p strong,
.fmb-build-root--duncan .fmb-block-7 .core .card .item p strong,
.fmb-build-root--duncan .fmb-block-7 .duncan-maneuver p strong{
  display:inline!important;
  font:inherit!important;
  font-weight:800!important;
  color:#224f35!important;
  white-space:normal!important;
}
.fmb-build-root--duncan .fmb-block-5 .strip span,
.fmb-build-root--duncan .fmb-block-6 .strip span,
.fmb-build-root--duncan .fmb-block-7 .strip span{
  background:linear-gradient(145deg,#193e2c,#2a523b)!important;
  border:1px solid #c9a063!important;
  border-top:3px solid #e6bf7e!important;
  color:#fff4d9!important;
  box-shadow:0 7px 14px rgba(20,39,25,.17)!important;
}
.fmb-build-root--duncan :is(.fmb-block-5,.fmb-block-6,.fmb-block-7) .strip strong{color:#fff5e1!important}
.fmb-build-root--duncan .fmb-block-6 .core .card:not(.primary),
.fmb-build-root--duncan .fmb-block-7 .core .card:not(.primary){
  background:linear-gradient(150deg,#f3eadb,#e7dbc8)!important;
  border:1px solid #bda079!important;
  border-top:4px solid #647e7d!important;
}
.fmb-build-root--duncan .fmb-block-6 .combat,
.fmb-build-root--duncan .fmb-block-7 .combat{
  background:linear-gradient(115deg,#123024,#204b36 70%,#2b513e)!important;
  border:1px solid #d0a463!important;
  border-left:6px solid #d0a463!important;
  border-radius:12px!important;
  box-shadow:0 12px 23px rgba(10,28,19,.21);
