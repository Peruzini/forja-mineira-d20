  line-height:1.27!important;
  margin:10px 0 14px!important;
}
.fmb-build-root--duncan :is(.fmb-block-18,.fmb-block-19) .card .mini-label{color:#9a522e!important}
.fmb-build-root--duncan :is(.fmb-block-18,.fmb-block-19) .card .item{
  padding:12px 0 11px!important;
  border-bottom:1px solid rgba(126,103,68,.25)!important;
}
.fmb-build-root--duncan :is(.fmb-block-18,.fmb-block-19) .card .item strong{
  display:block!important;
  color:#214d32!important;
  font:700 16px/1.35 Georgia,serif!important;
  margin:0 0 7px!important;
  white-space:normal!important;
}
.fmb-build-root--duncan :is(.fmb-block-18,.fmb-block-19) .card .item p{
  color:#465047!important;
  font:14px/1.6 Arial,sans-serif!important;
  margin:0!important;
  line-height:1.65!important;
}
.fmb-build-root--duncan :is(.fmb-block-18,.fmb-block-19) .card .item p strong{
