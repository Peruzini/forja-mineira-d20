/* DUNCAN 14–16: camada heráldica aprovada, sem layout novo ou assets externos. */
.fmb-build-root--duncan :is(.fmb-block-14,.fmb-block-15,.fmb-block-16) .level{background:#efe5d1;border:2px solid #d0a663;overflow:hidden}
.fmb-build-root--duncan :is(.fmb-block-14,.fmb-block-15,.fmb-block-16) .content{min-width:0;background:linear-gradient(180deg,#153a2b 0 13px,#f4e9d6 13px,#e9ddc9 100%);color:#2c3a2f}
