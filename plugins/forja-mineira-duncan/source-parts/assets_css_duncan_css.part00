.fmb-build-root--duncan :is(.fmb-block-14,.fmb-block-15,.fmb-block-16) .card .mini-label{color:#9a522e!important}
.fmb-build-root--duncan :is(.fmb-block-14,.fmb-block-15,.fmb-block-16) .card .item{
