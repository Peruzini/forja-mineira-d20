.fmb-build-root--duncan .fmb-block-13 .phase-open .art:after{pointer-events:none}
.fmb-build-root--duncan .fmb-block-13 .duncan-phase-art{height:100%;min-height:490px;display:flex;align-items:center;justify-content:center;flex-direction:column;color:#f8ead0;gap:16px;border:1px solid #c9a66b;box-shadow:inset 0 0 0 6px rgba(4,23,12,.3);margin:22px;border-radius:8px;text-align:center;padding:32px}
.fmb-build-root--duncan .fmb-block-13 .duncan-phase-art small{font:700 11px Arial,sans-serif;letter-spacing:.25em;color:#ecc27e}
.fmb-build-root--duncan .fmb-block-13 .duncan-phase-art strong{font:normal clamp(55px,6vw,87px) Georgia,serif;color:#fff1d3}
