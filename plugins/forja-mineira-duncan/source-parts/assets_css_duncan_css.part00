.fmb-build-root--duncan :is(.fmb-block-18,.fmb-block-19) .duncan-level-callout{padding:16px 20px;margin:15px 0 20px;background:linear-gradient(110deg,#163629,#325740);border:1px solid #c69f65;border-left:6px solid #dba860;color:#fff0d4;border-radius:11px;font:600 14px/1.6 Arial,sans-serif;box-shadow:0 10px 19px rgba(22,38,26,.2)}
.fmb-build-root--duncan :is(.fmb-block-18,.fmb-block-19) .duncan-level-callout strong{color:#ffe7ae}
