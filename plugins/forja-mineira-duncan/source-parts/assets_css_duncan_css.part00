/* ===== BLOCO 13 ===== */
.fmb-block-13{
  --paper:#fbfaf6;--white:#fff;--ink:#1f1b17;--body:#403a33;--muted:#70675e;
  --line:#ddd4c5;--gold:#9b6b18;--green:#28513e;--green-soft:#f2f7f3;
  --silver:#eef1ef;--dark:#0b1510;
}
.fmb-block-13 *{box-sizing:border-box}
.fmb-block-13{margin:0;background:#f1f0ec;color:var(--body);font-family:Georgia,"Times New Roman",serif}
.fmb-block-13 .preview{width:min(1360px,calc(100% - 48px));margin:34px auto}
.fmb-block-13 .level{border:1px solid var(--line);border-radius:26px;overflow:hidden;background:var(--paper)}
.fmb-block-13 .phase-open{display:grid;grid-template-columns:minmax(330px,34%) minmax(0,66%);background:#fff}
.fmb-block-13 .art{position:relative;min-height:820px;overflow:hidden;background:var(--dark)}
.fmb-block-13 .art img{display:block;width:100%;height:100%;min-height:820px;object-fit:cover;object-position:center 18%}
.fmb-block-13 .art:after{
  content:"";position:absolute;inset:0;
  background:linear-gradient(90deg,rgba(5,12,8,.02) 48%,rgba(5,12,8,.28)),
             linear-gradient(0deg,rgba(5,10,7,.76),transparent 34%);
  pointer-events:none
}
.fmb-block-13 .phase-tag{
  position:absolute;z-index:3;left:22px;top:22px;padding:8px 11px;border:1px solid rgba(255,255,255,.2);
  border-radius:999px;background:rgba(11,27,20,.78);color:#e7d5aa;
  font:800 10px/1 Arial,sans-serif;letter-spacing:.13em;text-transform:uppercase
}
.fmb-block-13 .level-badge{
  position:absolute;z-index:3;left:22px;bottom:24px;width:76px;height:76px;border-radius:50%;
  display:grid;place-items:center;background:#f7f3ea;border:3px solid #a8792d;color:#1f1b17;font:bold 31px/1 Georgia,serif
}
.fmb-block-13 .art-caption{position:absolute;z-index:3;left:116px;right:20px;bottom:30px;color:#fff}
.fmb-block-13 .art-caption strong{display:block;font-size:22px}
.fmb-block-13 .art-caption span{display:block;margin-top:4px;color:#d1dcd5;font:700 9px/1.4 Arial,sans-serif;letter-spacing:.1em;text-transform:uppercase}
.fmb-block-13 .content{padding:36px 36px 38px 18px;display:flex;flex-direction:column;justify-content:center}
.fmb-block-13 .kicker,.fmb-block-13 .mini-label{color:var(--gold);font:800 10px/1.2 Arial,sans-serif;letter-spacing:.14em;text-transform:uppercase}
.fmb-block-13 h1,.fmb-block-13 h2,.fmb-block-13 h3{margin:0;color:var(--ink)}
.fmb-block-13 h1{margin-top:7px;font-size:50px;line-height:.98}
.fmb-block-13 .subtitle{margin-top:8px;color:var(--green);font-size:21px;font-style:italic}
.fmb-block-13 .lead{margin:15px 0 0;max-width:900px;font-size:16px;line-height:1.65}
.fmb-block-13 .strip{margin-top:19px;display:flex;flex-wrap:wrap;gap:8px}
.fmb-block-13 .strip span{padding:8px 11px;border:1px solid var(--line);border-radius:999px;background:#fff;font:700 11px/1 Arial,sans-serif;color:var(--muted)}
.fmb-block-13 .strip strong{color:var(--ink)}
.fmb-block-13 .breakthrough{margin-top:22px;padding:14px 16px;border-left:4px solid var(--green);border-radius:10px;background:var(--green-soft);font-size:14px;line-height:1.55}
.fmb-block-13 .grid{margin-top:22px;display:grid;grid-template-columns:1fr 1fr;gap:12px}
.fmb-block-13 .card{padding:18px 19px;border:1px solid var(--line);border-radius:16px;background:#fff}
.fmb-block-13 .card.primary{border-color:#9fb5a8;background:linear-gradient(180deg,#fff,#f5f8f6)}
.fmb-block-13 .card h2{margin-top:4px;font-size:23px}
.fmb-block-13 .card p{margin:7px 0 0;font-size:13px;line-height:1.58}
.fmb-block-13 .item{padding:10px 0;border-top:1px solid #ece6dc}
.fmb-block-13 .item:first-of-type{border-top:0}
.fmb-block-13 .item strong{display:block;color:var(--ink);font-size:16px}
.fmb-block-13 .item span{display:block;margin-top:4px;color:var(--muted);font-size:12px;line-height:1.48}
.fmb-block-13 .arcanum{margin-top:12px;padding:16px 17px;border-radius:14px;background:#17261f;color:#eef5f0}
.fmb-block-13 .arcanum small{display:block;color:#d7be82;font:800 9px/1.2 Arial,sans-serif;text-transform:uppercase;letter-spacing:.1em}
.fmb-block-13 .arcanum strong{display:block;margin-top:5px;font-size:22px}
.fmb-block-13 .arcanum p{margin:7px 0 0;color:#dbe5df;font-size:13px;line-height:1.55}
.fmb-block-13 .servants{margin-top:12px;padding:16px 17px;border:1px solid var(--line);border-radius:15px;background:#fff}
.fmb-block-13 .servant-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:10px}
.fmb-block-13 .servant-card{padding:14px 15px;border-radius:12px}
.fmb-block-13 .servant-card.gold{background:#faf7ef;border:1px solid #d4c09a}
.fmb-block-13 .servant-card.green{background:#f3f7f4;border:1px solid #aabdb1}
.fmb-block-13 .servant-card strong{display:block;color:var(--ink);font-size:17px}
.fmb-block-13 .servant-card p{margin:6px 0 0;font-size:13px;line-height:1.52}
.fmb-block-13 .combat{padding:28px 34px 32px;border-top:1px solid var(--line);background:#fff}
.fmb-block-13 .combat-wrap{display:grid;grid-template-columns:215px minmax(0,1fr);gap:22px;padding-left:18px;border-left:4px solid var(--gold)}
.fmb-block-13 .combat h2{margin-top:5px;font-size:26px}
.fmb-block-13 .combat p{margin:0 0 10px;font-size:14px;line-height:1.62}
.fmb-block-13 .tactic-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:9px;margin-top:12px}
.fmb-block-13 .tactic{padding:12px;border:1px solid #c7cec9;border-radius:11px;background:var(--silver)}
.fmb-block-13 .tactic small{display:block;color:var(--green);font:800 9px/1.2 Arial,sans-serif;text-transform:uppercase;letter-spacing:.08em}
.fmb-block-13 .tactic strong{display:block;margin-top:4px;color:var(--ink);font-size:14px}
.fmb-block-13 .tactic p{margin:5px 0 0;font-size:12px;line-height:1.45}
.fmb-block-13 .priority{margin-top:12px;padding:11px 13px;border-radius:10px;background:#17261f;color:#ecf3ee;font:800 11px/1.45 Arial,sans-serif}
@media (max-width:1050px){.fmb-block-13 .phase-open{grid-template-columns:1fr}
.fmb-block-13 .art{min-height:540px}
.fmb-block-13 .art img{min-height:540px;object-position:center 18%}}
@media (max-width:760px){.fmb-block-13 .preview{width:calc(100% - 20px);margin:10px auto}
.fmb-block-13 .level{border-radius:18px}
.fmb-block-13 .content,.fmb-block-13 .combat{padding:24px 20px 26px}
.fmb-block-13 .grid,.fmb-block-13 .servant-grid,.fmb-block-13 .tactic-grid,.fmb-block-13 .combat-wrap{grid-template-columns:1fr}
.fmb-block-13 h1{font-size:38px}}

/* ===== BLOCO 14 ===== */
.fmb-block-14{
  --paper:#fbfaf6;--white:#fff;--ink:#1f1b17;--body:#403a33;--muted:#70675e;
  --line:#ddd4c5;--gold:#9b6b18;--green:#28513e;--green-soft:#f2f7f3;
  --silver:#eef1ef;--dark:#0e1712;
}
.fmb-block-14 *{box-sizing:border-box}
.fmb-block-14{margin:0;background:#f1f0ec;color:var(--body);font-family:Georgia,"Times New Roman",serif}
.fmb-block-14 .preview{width:min(1360px,calc(100% - 48px));margin:34px auto}
.fmb-block-14 .level{
  display:grid;grid-template-columns:210px minmax(0,1fr);
  border:1px solid var(--line);border-radius:24px;overflow:hidden;background:var(--paper)
}
.fmb-block-14 .progress-side{
  position:relative;height:auto;min-height:100%;padding:28px 18px 24px;
  background:
    radial-gradient(circle at 50% 35%,rgba(55,113,80,.33),transparent 28%),
    linear-gradient(180deg,#101d17,#08100c);
  color:#fff;display:flex;flex-direction:column;align-items:center;overflow:hidden
}
.fmb-block-14 .phase{position:relative;z-index:4;font:800 10px/1.25 Arial,sans-serif;letter-spacing:.16em;text-transform:uppercase;color:#ddcda9;text-align:center}
.fmb-block-14 .level-no{position:relative;z-index:4;margin-top:14px;width:76px;height:76px;border-radius:50%;display:grid;place-items:center;background:#f6f3eb;border:3px solid #a8792d;color:#1f1b17;font:bold 34px/1 Georgia,serif}
.fmb-block-14 .timeline{position:absolute;z-index:1;top:118px;height:300px;left:50%;width:2px;transform:translateX(-50%);background:linear-gradient(#c5b79c,#6b8374 55%,#244a37);opacity:.78}
.fmb-block-14 .snake-wrap{position:relative;z-index:3;width:150px;margin-top:38px;margin-bottom:8px}
.fmb-block-14 .snake-wrap img{display:block;width:100%;height:auto;filter:drop-shadow(0 15px 22px rgba(0,0,0,.48))}
.fmb-block-14 .side-sheet{position:relative;z-index:5;width:100%;margin-top:18px;padding:16px 0 0;border-top:1px solid rgba(221,205,169,.24);background:#102419}
.fmb-block-14 .side-section + .side-section{margin-top:16px}
.fmb-block-14 .side-label{display:block;margin-bottom:8px;color:#ddcda9;font:800 9px/1.2 Arial,sans-serif;letter-spacing:.14em;text-transform:uppercase;text-align:left}
.fmb-block-14 .stats-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:6px}
.fmb-block-14 .stat{padding:7px 5px 6px;border:1px solid rgba(255,255,255,.12);border-radius:9px;background:rgba(255,255,255,.045);text-align:center}
.fmb-block-14 .stat small{display:block;color:#b8c6bd;font:800 8px/1 Arial,sans-serif}
.fmb-block-14 .stat strong{display:block;margin-top:3px;color:#fff;font-size:18px;line-height:1}
.fmb-block-14 .stat span{display:block;margin-top:3px;color:#8fb09d;font:700 9px/1 Arial,sans-serif}
.fmb-block-14 .panel{padding:11px 12px;border:1px solid rgba(255,255,255,.11);border-radius:11px;background:rgba(255,255,255,.04)}
.fmb-block-14 .row{display:flex;align-items:flex-start;justify-content:space-between;gap:10px;padding:6px 0;border-top:1px solid rgba(255,255,255,.08)}
.fmb-block-14 .row:first-of-type{border-top:0}
.fmb-block-14 .row small{color:#b8c6bd;font:700 9px/1.25 Arial,sans-serif}
.fmb-block-14 .row strong{max-width:92px;color:#fff;font-size:11px;line-height:1.2;text-align:right}
.fmb-block-14 .resource-mini{display:grid;grid-template-columns:1fr 1fr;gap:8px}
.fmb-block-14 .resource-mini > div{padding:9px 7px;border:1px solid rgba(255,255,255,.09);border-radius:9px;background:rgba(255,255,255,.035);text-align:center}
.fmb-block-14 .resource-mini small{display:block;color:#b8c6bd;font:700 8px/1.25 Arial,sans-serif}
.fmb-block-14 .resource-mini strong{display:block;margin-top:5px;color:#fff;font-size:20px;line-height:1}
.fmb-block-14 .timeline-resume{position:relative;z-index:1;width:2px;height:110px;margin:0 auto -24px;background:linear-gradient(#6b8374,#244a37);opacity:.78}
.fmb-block-14 .content{padding:30px 34px 32px 22px}
.fmb-block-14 .kicker,.fmb-block-14 .mini-label{color:var(--gold);font:800 10px/1.2 Arial,sans-serif;letter-spacing:.14em;text-transform:uppercase}
.fmb-block-14 h1,.fmb-block-14 h2,.fmb-block-14 h3{margin:0;color:var(--ink)}
.fmb-block-14 h1{margin-top:7px;font-size:42px;line-height:1}
.fmb-block-14 .lead{margin:13px 0 0;max-width:1080px;font-size:16px;line-height:1.62}
.fmb-block-14 .strip{margin-top:18px;display:flex;flex-wrap:wrap;gap:8px}
.fmb-block-14 .strip span{padding:8px 11px;border:1px solid var(--line);border-radius:999px;background:#fff;font:700 11px/1 Arial,sans-serif;color:var(--muted)}
.fmb-block-14 .strip strong{color:var(--ink)}
.fmb-block-14 .hero-card{margin-top:22px;padding:19px 20px;border:1px solid #8eac9b;border-radius:16px;background:linear-gradient(180deg,#fff,var(--green-soft))}
.fmb-block-14 .hero-card h2{margin-top:4px;font-size:26px}
.fmb-block-14 .hero-card p{margin:8px 0 0;font-size:14px;line-height:1.58}
.fmb-block-14 .feature-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:9px;margin-top:14px}
.fmb-block-14 .feature{padding:12px 13px;border:1px solid #c9d5cd;border-radius:11px;background:#fff}
.fmb-block-14 .feature small{display:block;color:var(--green);font:800 9px/1.2 Arial,sans-serif;text-transform:uppercase;letter-spacing:.08em}
.fmb-block-14 .feature strong{display:block;margin-top:4px;color:var(--ink);font-size:15px}
.fmb-block-14 .feature p{margin:5px 0 0;font-size:12px;line-height:1.48}
.fmb-block-14 .combo{margin-top:12px;display:grid;grid-template-columns:1fr 1fr;gap:12px}
.fmb-block-14 .card{padding:17px 18px;border:1px solid var(--line);border-radius:15px;background:#fff}
.fmb-block-14 .card.green{border-color:#a9bdb1;background:#f3f7f4}
.fmb-block-14 .card.gold{border-color:#d5bf95;background:#faf7ef}
.fmb-block-14 .card h2{margin-top:4px;font-size:22px}
.fmb-block-14 .card p{margin:7px 0 0;font-size:13px;line-height:1.56}
.fmb-block-14 .callout{margin-top:11px;padding:11px 13px;border-left:4px solid var(--green);border-radius:9px;background:#fff;font-size:13px;line-height:1.55}
.fmb-block-14 .combat{margin-top:18px;padding:16px 17px;border-left:4px solid var(--green);background:#fff}
.fmb-block-14 .combat h2{margin-top:4px;font-size:23px}
.fmb-block-14 .combat p{margin:8px 0 0;font-size:14px;line-height:1.6}
.fmb-block-14 .tactic-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:9px;margin-top:12px}
.fmb-block-14 .tactic{padding:12px;border:1px solid #cad3cd;border-radius:11px;background:var(--silver)}
.fmb-block-14 .tactic small{display:block;color:var(--green);font:800 9px/1.2 Arial,sans-serif;text-transform:uppercase;letter-spacing:.08em}
.fmb-block-14 .tactic strong{display:block;margin-top:4px;color:var(--ink);font-size:14px}
.fmb-block-14 .tactic p{margin:5px 0 0;font-size:12px;line-height:1.45}
.fmb-block-14 .priority{margin-top:11px;padding:10px 12px;border-radius:10px;background:#17261f;color:#edf3ef;font:800 11px/1.45 Arial,sans-serif}
.fmb-block-14 .dark-lord-line{margin-top:11px;padding:11px 13px;border-left:3px solid var(--green);border-radius:9px;background:var(--green-soft);color:#35483e;font-size:13px;line-height:1.52;font-style:italic}
@media (max-width:900px){.fmb-block-14 .combo{grid-template-columns:1fr}}
@media (max-width:760px){.fmb-block-14 .preview{width:calc(100% - 20px);margin:10px auto}
.fmb-block-14 .level{grid-template-columns:1fr}
.fmb-block-14 .progress-side{min-height:650px}
.fmb-block-14 .snake-wrap{width:138px;margin:26px auto 10px}
.fmb-block-14 .side-sheet{max-width:420px;margin:18px auto 0}
.fmb-block-14 .timeline-resume{display:none}
.fmb-block-14 .content{padding:24px 20px 26px}
.fmb-block-14 .feature-grid,.fmb-block-14 .tactic-grid{grid-template-columns:1fr}
.fmb-block-14 h1{font-size:35px}}
.fmb-block-14 .arcana-list{
  display:grid;
  gap:7px;
}
.fmb-block-14 .arcana-row{
  padding:8px 9px;
  border:1px solid rgba(255,255,255,.09);
  border-radius:9px;
  background:rgba(255,255,255,.035);
}
.fmb-block-14 .arcana-row small{
  display:block;
  color:#b8c6bd;
  font:700 8px/1.2 Arial,sans-serif;
  text-transform:uppercase;
  letter-spacing:.05em;
}
.fmb-block-14 .arcana-row strong{
  display:block;
  margin-top:4px;
  color:#fff;
  font-size:11px;
  line-height:1.28;
}
/* === Sidebar compacta padronizada: cobra + wishlist === */
.fmb-block-14 .progress-side .snake-wrap{
  width:158px !important;
  height:215px !important;
  min-height:215px !important;
  margin:12px auto 8px !important;
  display:flex !important;
  align-items:flex-start !important;
  justify-content:center !important;
  flex:0 0 215px !important;
}
.fmb-block-14 .progress-side .snake-wrap img{
  display:block !important;
  width:100% !important;
  height:100% !important;
  max-height:215px !important;
  object-fit:contain !important;
  object-position:center top !important;
}
.fmb-block-14 .progress-side .timeline{
  bottom:auto !important;
  height:170px !important;
}
.fmb-block-14 .wish-section,.fmb-block-14 .arcana-standard{
  position:relative;
  z-index:6;
  width:100%;
  margin-top:16px;
  padding:11px 12px;
  border:1px solid rgba(255,255,255,.11);
  border-radius:11px;
  background:rgba(255,255,255,.04);
}
.fmb-block-14 .wish-title,.fmb-block-14 .arcana-standard-title{
  display:block;
  margin-bottom:8px;
  color:#ddcda9;
  font:800 9px/1.2 Arial,sans-serif;
  letter-spacing:.14em;
  text-transform:uppercase;
}
.fmb-block-14 .wish-note{
  margin:0 0 9px;
  color:#9fb2a6;
  font:700 8px/1.4 Arial,sans-serif;
}
.fmb-block-14 .wish-item{
  padding:8px 9px;
  border:1px solid rgba(255,255,255,.09);
  border-radius:9px;
  background:rgba(255,255,255,.035);
}
.fmb-block-14 .wish-item + .wish-item{margin-top:7px}
.fmb-block-14 .wish-head{display:flex;gap:7px;align-items:flex-start;justify-content:space-between}
.fmb-block-14 .wish-head strong{color:#fff;font-size:11px;line-height:1.25}
.fmb-block-14 .wish-tag{
  flex:0 0 auto;padding:3px 5px;border:1px solid rgba(215,190,130,.32);
  border-radius:999px;color:#ddcda9;font:800 6.5px/1 Arial,sans-serif;
  letter-spacing:.06em;text-transform:uppercase
}
.fmb-block-14 .wish-item small{display:block;margin-top:3px;color:#9ab4a4;font:700 7.5px/1.25 Arial,sans-serif}
.fmb-block-14 .wish-item p{margin:6px 0 0;color:#d2ddd6;font-size:9px;line-height:1.42}
.fmb-block-14 .arcana-standard-row{
  padding:8px 9px;border:1px solid rgba(255,255,255,.09);border-radius:9px;
  background:rgba(255,255,255,.035)
}
.fmb-block-14 .arcana-standard-row + .arcana-standard-row{margin-top:7px}
.fmb-block-14 .arcana-standard-row small{display:block;color:#9ab4a4;font:700 7.5px/1.2 Arial,sans-serif;text-transform:uppercase}
.fmb-block-14 .arcana-standard-row strong{display:block;margin-top:4px;color:#fff;font-size:11px;line-height:1.25}
.fmb-block-14 .arcana-standard-row em{display:block;margin-top:2px;color:#b8c6bd;font:italic 8px/1.2 Georgia,serif}
@media (max-width:760px){.fmb-block-14 .progress-side .snake-wrap{
    width:145px !important;height:195px !important;min-height:195px !important;
    flex-basis:195px !important;margin:10px auto 6px !important
  }}
/* Level 14: keep Arcana + Wishlist fully visible */
.fmb-block-14 .progress-side{
  height:auto !important;
  min-height:100% !important;
}
.fmb-block-14 .wish-section{
  margin-bottom:18px;
}
/* === Wishlist minimalista: somente próximo item prioritário === */
.fmb-block-14 .wish-section{
  position:relative;
  z-index:6;
  width:100%;
  margin-top:16px;
  padding:11px 12px;
  border:1px solid rgba(255,255,255,.11);
  border-radius:11px;
  background:rgba(255,255,255,.04);
}
.fmb-block-14 .wish-title{
  display:block;
  margin-bottom:7px;
  color:#ddcda9;
  font:800 9px/1.2 Arial,sans-serif;
  letter-spacing:.14em;
  text-transform:uppercase;
}
.fmb-block-14 .wish-note{
  margin:0 0 9px;
  color:#9fb2a6;
  font:700 8px/1.45 Arial,sans-serif;
}
.fmb-block-14 .wish-item{
  padding:9px 10px;
  border:1px solid rgba(255,255,255,.09);
  border-radius:9px;
  background:rgba(255,255,255,.035);
}
.fmb-block-14 .wish-head{
  display:flex;
  gap:7px;
  align-items:flex-start;
  justify-content:space-between;
}
.fmb-block-14 .wish-head strong{
  color:#fff;
  font-size:11px;
  line-height:1.25;
}
.fmb-block-14 .wish-tag{
  flex:0 0 auto;
  padding:3px 5px;
  border:1px solid rgba(215,190,130,.32);
  border-radius:999px;
  color:#ddcda9;
  font:800 6.5px/1 Arial,sans-serif;
  letter-spacing:.06em;
  text-transform:uppercase;
}
.fmb-block-14 .wish-item small{
  display:block;
  margin-top:3px;
  color:#9ab4a4;
  font:700 7.5px/1.25 Arial,sans-serif;
}
.fmb-block-14 .wish-item p{
  margin:6px 0 0;
  color:#d2ddd6;
  font-size:9px;
  line-height:1.42;
}

/* ===== BLOCO 15 ===== */
.fmb-block-15{
  --paper:#fbfaf6;--white:#fff;--ink:#1f1b17;--body:#403a33;--muted:#70675e;
  --line:#ddd4c5;--gold:#9b6b18;--green:#28513e;--green-soft:#f2f7f3;
  --silver:#eef1ef;--dark:#0e1712;
}
.fmb-block-15 *{box-sizing:border-box}
.fmb-block-15{margin:0;background:#f1f0ec;color:var(--body);font-family:Georgia,"Times New Roman",serif}
.fmb-block-15 .preview{width:min(1360px,calc(100% - 48px));margin:34px auto}
.fmb-block-15 .level{
  display:grid;grid-template-columns:210px minmax(0,1fr);
  border:1px solid var(--line);border-radius:24px;overflow:hidden;background:var(--paper)
}
.fmb-block-15 .progress-side{
  position:relative;height:auto;min-height:100%;padding:28px 18px 24px;
  background:
    radial-gradient(circle at 50% 35%,rgba(55,113,80,.33),transparent 28%),
    linear-gradient(180deg,#101d17,#08100c);
  color:#fff;display:flex;flex-direction:column;align-items:center;overflow:hidden
}
.fmb-block-15 .phase{position:relative;z-index:4;font:800 10px/1.25 Arial,sans-serif;letter-spacing:.16em;text-transform:uppercase;color:#ddcda9;text-align:center}
.fmb-block-15 .level-no{position:relative;z-index:4;margin-top:14px;width:76px;height:76px;border-radius:50%;display:grid;place-items:center;background:#f6f3eb;border:3px solid #a8792d;color:#1f1b17;font:bold 34px/1 Georgia,serif}
.fmb-block-15 .timeline{position:absolute;z-index:1;top:118px;height:170px;left:50%;width:2px;transform:translateX(-50%);background:linear-gradient(#c5b79c,#6b8374 55%,#244a37);opacity:.78}
.fmb-block-15 .snake-wrap{position:relative;z-index:3;width:158px;height:215px;min-height:215px;margin:12px auto 8px;display:flex;align-items:flex-start;justify-content:center;flex:0 0 215px}
.fmb-block-15 .snake-wrap img{display:block;width:100%;height:100%;max-height:215px;object-fit:contain;object-position:center top;filter:drop-shadow(0 15px 22px rgba(0,0,0,.48))}
.fmb-block-15 .side-sheet{position:relative;z-index:5;width:100%;margin-top:4px;padding:16px 0 0;border-top:1px solid rgba(221,205,169,.24);background:#102419}
.fmb-block-15 .side-section + .side-section{margin-top:16px}
.fmb-block-15 .side-label{display:block;margin-bottom:8px;color:#ddcda9;font:800 9px/1.2 Arial,sans-serif;letter-spacing:.14em;text-transform:uppercase;text-align:left}
.fmb-block-15 .stats-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:6px}
.fmb-block-15 .stat{padding:7px 5px 6px;border:1px solid rgba(255,255,255,.12);border-radius:9px;background:rgba(255,255,255,.045);text-align:center}
.fmb-block-15 .stat small{display:block;color:#b8c6bd;font:800 8px/1 Arial,sans-serif}
.fmb-block-15 .stat strong{display:block;margin-top:3px;color:#fff;font-size:18px;line-height:1}
.fmb-block-15 .stat span{display:block;margin-top:3px;color:#8fb09d;font:700 9px/1 Arial,sans-serif}
.fmb-block-15 .panel{padding:11px 12px;border:1px solid rgba(255,255,255,.11);border-radius:11px;background:rgba(255,255,255,.04)}
.fmb-block-15 .row{display:flex;align-items:flex-start;justify-content:space-between;gap:10px;padding:6px 0;border-top:1px solid rgba(255,255,255,.08)}
.fmb-block-15 .row:first-of-type{border-top:0}
.fmb-block-15 .row small{color:#b8c6bd;font:700 9px/1.25 Arial,sans-serif}
.fmb-block-15 .row strong{max-width:92px;color:#fff;font-size:11px;line-height:1.2;text-align:right}
.fmb-block-15 .resource-mini{display:grid;grid-template-columns:1fr 1fr;gap:8px}
.fmb-block-15 .resource-mini > div{padding:9px 7px;border:1px solid rgba(255,255,255,.09);border-radius:9px;background:rgba(255,255,255,.035);text-align:center}
.fmb-block-15 .resource-mini small{display:block;color:#b8c6bd;font:700 8px/1.25 Arial,sans-serif}
.fmb-block-15 .resource-mini strong{display:block;margin-top:5px;color:#fff;font-size:20px;line-height:1}
.fmb-block-15 .arcana-list{display:grid;gap:7px}
.fmb-block-15 .arcana-row{padding:8px 9px;border:1px solid rgba(255,255,255,.09);border-radius:9px;background:rgba(255,255,255,.035)}
.fmb-block-15 .arcana-row small{display:block;color:#9ab4a4;font:700 7.5px/1.2 Arial,sans-serif;text-transform:uppercase}
.fmb-block-15 .arcana-row strong{display:block;margin-top:4px;color:#fff;font-size:11px;line-height:1.25}
.fmb-block-15 .arcana-row em{display:block;margin-top:2px;color:#b8c6bd;font:italic 8px/1.2 Georgia,serif}
.fmb-block-15 .timeline-resume{position:relative;z-index:1;width:2px;height:110px;margin:0 auto -24px;background:linear-gradient(#6b8374,#244a37);opacity:.78}
.fmb-block-15 .content{padding:30px 34px 32px 22px}
.fmb-block-15 .kicker,.fmb-block-15 .mini-label{color:var(--gold);font:800 10px/1.2 Arial,sans-serif;letter-spacing:.14em;text-transform:uppercase}
.fmb-block-15 h1,.fmb-block-15 h2,.fmb-block-15 h3{margin:0;color:var(--ink)}
.fmb-block-15 h1{margin-top:7px;font-size:42px;line-height:1}
.fmb-block-15 .lead{margin:13px 0 0;max-width:1080px;font-size:16px;line-height:1.62}
.fmb-block-15 .strip{margin-top:18px;display:flex;flex-wrap:wrap;gap:8px}
.fmb-block-15 .strip span{padding:8px 11px;border:1px solid var(--line);border-radius:999px;background:#fff;font:700 11px/1 Arial,sans-serif;color:var(--muted)}
.fmb-block-15 .strip strong{color:var(--ink)}
.fmb-block-15 .top-grid{margin-top:22px;display:grid;grid-template-columns:1.08fr .92fr;gap:12px;align-items:stretch}
.fmb-block-15 .card{padding:18px 19px;border:1px solid var(--line);border-radius:16px;background:#fff}
.fmb-block-15 .card.primary{border-color:#91ad9d;background:linear-gradient(180deg,#fff,var(--green-soft))}
.fmb-block-15 .card h2{margin-top:4px;font-size:24px}
.fmb-block-15 .card p{margin:8px 0 0;font-size:14px;line-height:1.58}
.fmb-block-15 .arcanum{margin-top:12px;padding:14px 15px;border-radius:12px;background:#17261f;color:#f5f0e8}
.fmb-block-15 .arcanum small{display:block;color:#d7be82;font:800 9px/1.2 Arial,sans-serif;letter-spacing:.1em;text-transform:uppercase}
.fmb-block-15 .arcanum strong{display:block;margin-top:5px;font-size:22px}
.fmb-block-15 .arcanum span{display:block;margin-top:6px;color:#dbe5df;font-size:12px;line-height:1.48}
.fmb-block-15 .rule-list{margin-top:11px;display:grid;gap:8px}
.fmb-block-15 .rule{padding:10px 11px;border:1px solid #cbd6cf;border-radius:10px;background:#fff}
.fmb-block-15 .rule strong{display:block;color:var(--ink);font-size:14px}
.fmb-block-15 .rule span{display:block;margin-top:3px;color:var(--muted);font-size:12px;line-height:1.45}
.fmb-block-15 .progression{margin-top:22px;display:grid;grid-template-columns:1fr 1fr;gap:12px;position:relative}
.fmb-block-15 .progress-card{padding:16px 17px;border:1px solid var(--line);border-radius:14px;background:#fff}
.fmb-block-15 .progress-card.green{background:#f3f7f4;border-color:#a8bdb0}
.fmb-block-15 .progress-card.gold{background:#faf7ef;border-color:#d5bf95}
.fmb-block-15 .progress-card strong{display:block;margin-top:4px;color:var(--ink);font-size:18px}
.fmb-block-15 .progress-card p{margin:6px 0 0;font-size:13px;line-height:1.55}
.fmb-block-15 .combat{margin-top:18px;padding:16px 17px;border-left:4px solid var(--green);background:#fff}
.fmb-block-15 .combat h2{margin-top:4px;font-size:23px}
.fmb-block-15 .combat p{margin:8px 0 0;font-size:14px;line-height:1.6}
.fmb-block-15 .tactic-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:9px;margin-top:12px}
.fmb-block-15 .tactic{padding:12px;border:1px solid #cad3cd;border-radius:11px;background:var(--silver)}
.fmb-block-15 .tactic small{display:block;color:var(--green);font:800 9px/1.2 Arial,sans-serif;text-transform:uppercase;letter-spacing:.08em}
.fmb-block-15 .tactic strong{display:block;margin-top:4px;color:var(--ink);font-size:14px}
.fmb-block-15 .tactic p{margin:5px 0 0;font-size:12px;line-height:1.45}
.fmb-block-15 .priority{margin-top:11px;padding:10px 12px;border-radius:10px;background:#17261f;color:#edf3ef;font:800 11px/1.45 Arial,sans-serif}
.fmb-block-15 .dark-lord-line{margin-top:11px;padding:11px 13px;border-left:3px solid var(--green);border-radius:9px;background:var(--green-soft);color:#35483e;font-size:13px;line-height:1.52;font-style:italic}
@media (max-width:900px){.fmb-block-15 .top-grid,.fmb-block-15 .progression{grid-template-columns:1fr}}
@media (max-width:760px){.fmb-block-15 .preview{width:calc(100% - 20px);margin:10px auto}
.fmb-block-15 .level{grid-template-columns:1fr}
.fmb-block-15 .progress-side{min-height:760px}
.fmb-block-15 .snake-wrap{width:145px;height:195px;min-height:195px;flex-basis:195px;margin:10px auto 6px}
.fmb-block-15 .side-sheet{max-width:420px;margin:8px auto 0}
.fmb-block-15 .timeline-resume{display:none}
.fmb-block-15 .content{padding:24px 20px 26px}
.fmb-block-15 .tactic-grid{grid-template-columns:1fr}
.fmb-block-15 h1{font-size:35px}}
.fmb-block-15 .section-break{
  margin-top:20px;
  padding-top:14px;
  border-top:1px solid var(--line);
}
.fmb-block-15 .section-break span{
  color:var(--gold);
  font:800 10px/1.2 Arial,sans-serif;
  letter-spacing:.14em;
  text-transform:uppercase;
}
.fmb-block-15 .wishlist-panel{
  border-color:rgba(166,198,178,.26);
  background:rgba(41,84,61,.18);
}
.fmb-block-15 .wishlist-item{
  padding:10px;
  border:1px solid rgba(255,255,255,.10);
  border-radius:10px;
  background:rgba(255,255,255,.035);
}
.fmb-block-15 .wishlist-head{
  display:flex;
  justify-content:space-between;
  align-items:flex-start;
  gap:8px;
}
.fmb-block-15 .wishlist-head strong{
  color:#fff;
  font-size:12px;
  line-height:1.25;
}
.fmb-block-15 .wishlist-head span{
  flex:0 0 auto;
  padding:3px 6px;
  border:1px solid rgba(215,190,130,.35);
  border-radius:999px;
  color:#ddcda9;
  font:800 7px/1 Arial,sans-serif;
  text-transform:uppercase;
  letter-spacing:.08em;
}
.fmb-block-15 .wishlist-item > small{
  display:block;
  margin-top:3px;
  color:#9ab4a4;
  font:700 8px/1.2 Arial,sans-serif;
}
.fmb-block-15 .wishlist-item p{
  margin:8px 0 0;
  color:#d4ded8;
  font-size:10px;
  line-height:1.45;
}
.fmb-block-15 .wishlist-note{
  margin-top:9px;
  padding-top:8px;
  border-top:1px solid rgba(255,255,255,.08);
  color:#b9cbc0;
  font-size:9px;
  line-height:1.4;
}
.fmb-block-15 .wishlist-note strong{
  display:block;
  margin-bottom:3px;
  color:#fff;
  font-size:9px;
}

/* ===== BLOCO 16 ===== */
.fmb-block-16{
  --paper:#fbfaf6;--white:#fff;--ink:#1f1b17;--body:#403a33;--muted:#70675e;
