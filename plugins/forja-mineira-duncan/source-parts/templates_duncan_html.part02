<div class="fm-resource-mini"><div><small class="duncan-sup-nowrap">Superioridade</small><strong>6d10</strong></div><div><small>Retomar o Fôlego</small><strong>4</strong></div></div>
<div class="fm-row"><small>Manobras conhecidas</small><strong>9</strong></div><div class="fm-row"><small>Surto de Ação</small><strong>1</strong></div>
